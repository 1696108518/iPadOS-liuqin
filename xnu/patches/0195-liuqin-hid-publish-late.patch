+/*
+ * backboardd arms an IOService notification for HIDServiceSupport = true when
+ * it starts (~50 s in) and, on this port, never opened a service that had been
+ * published before that.  The services are therefore kept unpublished until
+ * liuqinhidpublish seconds after boot (default 120 s, 0 = publish immediately,
+ * which is what every build up to touch46 did).
+ */
+static UInt32
+liuqin_hid_publish_secs(void)
+{
+	UInt32 secs = 120;
+
+	PE_parse_boot_argn("liuqinhidpublish", &secs, sizeof(secs));
+	return secs;
+}
+
+/* Publish after the delay, or immediately when the delay is zero. */
+static void
+liuqin_hid_publish(IOService *service, IOTimerEventSource **timer, UInt32 secs,
+    void (*fired)(OSObject *, IOTimerEventSource *), const char *who)
+{
+	if (secs == 0) {
+		service->registerService();
+		IOLog("LIUQIN HID: %s published now\n", who);
+		return;
+	}
+	*timer = IOTimerEventSource::timerEventSource(service, fired);
+	if (*timer != NULL && service->getWorkLoop()->addEventSource(*timer) == kIOReturnSuccess) {
+		(*timer)->setTimeoutMS(secs * 1000);
+		IOLog("LIUQIN HID: %s publishes in %u s\n", who, secs);
+	} else {
+		service->registerService();
+		IOLog("LIUQIN HID: %s published now (no timer)\n", who);
+	}
+}
 
