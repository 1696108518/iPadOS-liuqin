diff --git a/iokit/NativeAdreno/NativeAdrenoCpu.cpp b/iokit/NativeAdreno/NativeAdrenoCpu.cpp
index 862de46..69dcd04 100644
--- a/iokit/NativeAdreno/NativeAdrenoCpu.cpp
+++ b/iokit/NativeAdreno/NativeAdrenoCpu.cpp
@@ -36,9 +36,18 @@ IOReturn NativeAdrenoQueryCpu4K(NativeAdrenoCpuState *out)
     out->kernel_page_bytes=page_size;
     out->kernel_map_page_bytes=vm_map_page_size(kernel_map);
     enable_preemption();
-    bool native=PAGE_SIZE==4096 && out->kernel_page_bytes==4096 && out->kernel_map_page_bytes==4096 &&
-        ((out->tcr>>14)&3)==0 && ((out->tcr>>30)&3)==2 &&
-        (out->sctlr&1) && (out->ttbr1&UINT64_C(0x0000fffffffff000));
+    /* The GPU's page tables and the SMMU are 4 KiB; the CPU may use 16 KiB
+     * granules (this kernel does).  TG0/TG1 are 0/2 for 4 KiB and 2/1 for
+     * 16 KiB.  The allocator still hands out 4 KiB multiples, which are
+     * sub-pages of a 16 KiB page here. */
+    bool native=false;
+    if(PAGE_SIZE==4096)
+        native=out->kernel_page_bytes==4096 && out->kernel_map_page_bytes==4096 &&
+            ((out->tcr>>14)&3)==0 && ((out->tcr>>30)&3)==2;
+    else if(PAGE_SIZE==16384)
+        native=out->kernel_page_bytes==16384 && out->kernel_map_page_bytes==16384 &&
+            ((out->tcr>>14)&3)==2 && ((out->tcr>>30)&3)==1;
+    native=native && (out->sctlr&1) && (out->ttbr1&UINT64_C(0x0000fffffffff000));
     return native?kIOReturnSuccess:kIOReturnUnsupported;
 }
 static IOReturn maintainOwnedPages(void *mapping,size_t bytes,NativeAdrenoCacheOperation op)
diff --git a/iokit/NativeAdreno/NativeAdrenoUserClient.cpp b/iokit/NativeAdreno/NativeAdrenoUserClient.cpp
