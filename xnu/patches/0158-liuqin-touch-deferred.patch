+
+/* The SPI bring-up runs from its own thread a few seconds after the boot has
+ * settled, not from the mount path: a hang here must not take the boot down
+ * with it, and by then the persistent log has flushed everything that led to
+ * it.  The boot marks are drawn even with liuqinmute=1, so the screen alone
+ * tells how far it got. */
+static void
+liuqin_touch_setup_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int delay_s = 10;
+
+	(void)PE_parse_boot_argn("liuqintouchdelay", &delay_s, sizeof(delay_s));
+	if (delay_s < 0) {
+		delay_s = 0;
+	}
+	if (delay_s > 120) {
+		delay_s = 120;
 	}
+	printf("LIUQIN TOUCH: SPI bring-up in %d s\n", delay_s);
+	(void)tsleep(&liuqin_touch_chan, PZERO, "liuqintspi", hz * delay_s);
+
+	liuqin_boot_mark("touch spi start");
+	if (liuqin_touch_spi_setup() != 0) {
+		liuqin_boot_mark("touch spi failed");
+		return;
+	}
+	tch_novatek_info();
+	liuqin_boot_mark("touch id read");
+	liuqin_touch_reports_start();
+	liuqin_boot_mark("touch reports up");
 }
 
