+
+/* The firmware area (ADT memory map LIUQINFW, built by tools/mkfwarea.py from
+ * ~/liuqin-root/fw) carries novatek_nt36532_m81_fw_csot.bin now, the same
+ * 245760 bytes the vendor driver downloads after every handover. */
+extern const void *liuqin_fw_get(const char *name, uint32_t *size);
+
+static const uint8_t *
+tch_fw_image(uint32_t *size)
+{
+	const uint8_t *fw = liuqin_fw_get("novatek_nt36532_m81_fw_csot.bin", size);
+
+	if (fw == NULL) {
+		printf("LIUQIN TOUCH: touch firmware missing from the firmware area\n");
+		return NULL;
+	}
+	printf("LIUQIN TOUCH: touch firmware %u bytes at %p (%02x %02x %02x %02x %02x %02x)\n",
+	    *size, fw, fw[0], fw[1], fw[2], fw[3], fw[4], fw[5]);
+	return fw;
+}
+
+/* Read the firmware state register (event 0x60) at both candidate bases; the
+ * vendor expects 0xa0..0xaf once the application firmware runs. */
+static void
+tch_fw_state(void)
+{
+	static const uint32_t bases[] = { 0x11a00u, 0x1f64eu };
+
+	for (unsigned i = 0; i < 2; i++) {
+		uint8_t st[4] = { 0 };
+
+		(void)tch_nvt_read(bases[i] + 0x60, st, sizeof(st));
+		printf("LIUQIN TOUCH: fw state @0x%05x: %02x %02x %02x %02x (%s)\n",
+		    bases[i] + 0x60, st[0], st[1], st[2], st[3],
+		    st[0] >= 0xa0 && st[0] <= 0xaf ? "running" : "not ready");
 	}
 }
 
