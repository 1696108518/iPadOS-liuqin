+/* The vendor memory map puts the event buffer at 0x11a00 for this family
+ * (mainline nt36xxx: evtbuf 0x11a00, pipe0 0x10000, pipe1 0x12000,
+ * flash_csum 0x14000, flash_data 0x14002).  The state register is 0x60 in that
+ * page and reads 0xa0..0xaf when the firmware is running; FWINFO is 0x78.
+ * Read both that base and the old nabu one so the log shows which answers. */
 static void
+tch_dump_chip_state(void)
+{
+	static const uint32_t bases[] = { 0x11a00, 0x2fe00 };
+
+	for (unsigned i = 0; i < 2; i++) {
+		uint8_t st[4] = { 0 };
+		uint8_t fw[17] = { 0 };
+
+		(void)tch_nvt_read(bases[i] + 0x60, st, sizeof(st));
+		(void)tch_nvt_read(bases[i] + 0x78, fw, sizeof(fw));
+		printf("LIUQIN TOUCH: @0x%05x state %02x %02x %02x %02x | fw %02x %02x %02x %02x %02x "
+		    "%02x %02x %02x %02x (ver %02x/~%02x %s)\n",
+		    bases[i], st[0], st[1], st[2], st[3],
+		    fw[0], fw[1], fw[2], fw[3], fw[4], fw[5], fw[6], fw[7], fw[8],
+		    fw[1], fw[2],
+		    (uint8_t)(fw[1] + fw[2]) == 0xff ? "valid" : "unusable");
+	}
+}
