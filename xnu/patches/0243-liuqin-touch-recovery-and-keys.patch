+/*
+ * touch183 keys-spmi-map: one diagnostic pass, then the normal 50 ms poll.
+ *
+ * The first SPMI access waits 120 s so this thread cannot shift the touch
+ * bring-up, which is the exact failure mode touch173 hit: its synchronous
+ * 3 x 768-entry scan in probe moved "touch clocks+pins ready" from 47 s to
+ * 130 s.  A thread of its own, started after the panel is up, costs nothing.
+ */
+static void
+liuqin_keys_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t pon_apid = (uint32_t)-1, volup_apid = (uint32_t)-1;
+	uint32_t arb_version, features0, features1, count;
+	uint32_t apid, mapped, shown;
+	uint64_t t0, ns;
+	uint32_t status;
+	uint8_t v;
+	int slow;
+
+	if (pmic_core == 0 || pmic_obs == 0) {
+		return;
+	}
+	printf("LIUQIN KEYS: thread up, waiting 120 s before the first SPMI read\n");
+	(void)tsleep(&liuqin_keys_chan, PZERO, "liuqinkeys", 120 * hz);
+
+	t0 = mach_absolute_time();
+	arb_version = tch_rd(pmic_core, SPMI_REG_VERSION);
+	ns = pmic_ns_since(t0);
+	features0 = tch_rd(pmic_core, SPMI_REG_FEATURES0);
+	features1 = tch_rd(pmic_core, SPMI_REG_FEATURES1);
+	count = features0 & SPMI_FEATURES_MASK;
+	pmic_bus0_apids = count;
+	pmic_bus1_apids = features1 & SPMI_FEATURES_MASK;
+	printf("LIUQIN KEYS: arbiter version 0x%08x read in %llu ns\n",
+	    arb_version, ns);
+	printf("LIUQIN KEYS: features 0x%08x/0x%08x -> bus0 %u apids, bus1 %u apids\n",
+	    features0, features1, pmic_bus0_apids, pmic_bus1_apids);
+	if (arb_version < 0x70000000u || arb_version >= 0x80000000u) {
+		printf("LIUQIN KEYS: not a v7 arbiter (the 0x2000 table is v7-only), stopping\n");
+		return;
+	}
+	if (count == 0 || count > SPMI_APID_MAX) {
+		printf("LIUQIN KEYS: bad bus0 APID count, stopping\n");
+		return;
+	}
+	if (pmic_bus1_apids > SPMI_APID_MAX - count) {
+		pmic_bus1_apids = SPMI_APID_MAX - count;
+	}
+
+	/* The handoff's first guess: APID == PPID == 0x13.  One transaction,
+	 * before the table scan, tells us whether the bus works at all. */
+	if (pmic_read_ex(19, PMIC_PON_RT_STS, &v, 1, &status, &ns) == 0) {
+		printf("LIUQIN KEYS: direct apid 19 addr 0x1310 -> 0x%02x "
+		    "(status 0x%08x, %llu us)\n", v, status, ns / 1000ull);
+	} else {
+		printf("LIUQIN KEYS: direct apid 19 addr 0x1310 failed "
+		    "(status 0x%08x, %llu us)\n", status, ns / 1000ull);
+	}
+
+	/* Time the first table read: if the old 26 ms cost is still there, do
+	 * not stall for 20 s scanning 768 entries. */
+	t0 = mach_absolute_time();
+	(void)tch_rd(pmic_core, SPMI_APID_MAP(0));
+	ns = pmic_ns_since(t0);
+	slow = ns > 2000ull * 1000ull;
+	printf("LIUQIN KEYS: first map read at 0x%x took %llu ns%s\n",
+	    SPMI_APID_MAP(0), ns, slow ? " (slow: the scan yields every 64 APIDs)" : "");
+
+	{
+		uint32_t scanned;
+
+		t0 = mach_absolute_time();
+		mapped = 0;
+		shown = 0;
+		for (apid = 0; apid < count; apid++) {
+			const uint32_t m = tch_rd(pmic_core, SPMI_APID_MAP(apid));
+			const uint32_t ppid = (m >> 8) & SPMI_PPID_MASK;
+
+			if (m != 0) {
+				mapped++;
+				if (shown < 24) {
+					printf("LIUQIN KEYS: map[%u] ppid 0x%03x irq %u\n",
+					    apid, ppid, (m & SPMI_IRQ_OWNER) ? 1 : 0);
+					shown++;
+				}
+				if (ppid == 0x013 && pon_apid == (uint32_t)-1) {
+					pon_apid = apid;
+				}
+				if (ppid == 0x18d && volup_apid == (uint32_t)-1) {
+					volup_apid = apid;
+				}
+			}
+			if (pon_apid != (uint32_t)-1 && volup_apid != (uint32_t)-1) {
+				break;
+			}
+			if (slow && (apid & 63u) == 63u) {
+				printf("LIUQIN KEYS: bus0 scan %u/%u\n", apid + 1, count);
+				(void)tsleep(&liuqin_keys_chan, PZERO,
+				    "liuqinkeys", hz / 50);
+			}
+		}
+		scanned = (apid < count) ? apid + 1 : count;
+		ns = pmic_ns_since(t0);
+		printf("LIUQIN KEYS: bus0 scan %u apids in %llu us "
+		    "(%llu ns/read), %u mapped\n", scanned, ns / 1000ull,
+		    scanned ? ns / scanned : 0, mapped);
+	}
+	printf("LIUQIN KEYS: bus0 lookup: power 0x013 -> %d, volume up 0x18d -> %d\n",
+	    (int)pon_apid, (int)volup_apid);
+
+	/* If the PON block is not on bus 0, try bus 1.  v7 splits the APID
+	 * space: bus1 starts at bus0's count, and its table entries and
+	 * ownership table use the global APID. */
+	if ((pon_apid == (uint32_t)-1 || volup_apid == (uint32_t)-1) &&
+	    pmic_bus1_apids != 0) {
+		const uint32_t first = pmic_bus0_apids;
+		const uint32_t scan = pmic_bus1_apids;
+		uint32_t scanned;
+
+		printf("LIUQIN KEYS: trying bus1 apids %u..%u\n",
+		    first, first + scan - 1);
+		t0 = mach_absolute_time();
+		for (apid = first; apid < first + scan; apid++) {
+			const uint32_t m = tch_rd(pmic_core, SPMI_APID_MAP(apid));
+			const uint32_t ppid = (m >> 8) & SPMI_PPID_MASK;
+
+			if (m != 0) {
+				if (ppid == 0x013 && pon_apid == (uint32_t)-1) {
+					pon_apid = apid;
+				}
+				if (ppid == 0x18d && volup_apid == (uint32_t)-1) {
+					volup_apid = apid;
+				}
+			}
+			if (pon_apid != (uint32_t)-1 && volup_apid != (uint32_t)-1) {
+				break;
+			}
+			if (slow && ((apid - first) & 63u) == 63u) {
+				printf("LIUQIN KEYS: bus1 scan %u/%u\n",
+				    apid - first + 1, scan);
+				(void)tsleep(&liuqin_keys_chan, PZERO,
+				    "liuqinkeys", hz / 50);
+			}
+		}
+		scanned = (apid < first + scan) ? apid - first + 1 : scan;
+		ns = pmic_ns_since(t0);
+		printf("LIUQIN KEYS: bus1 scan %u apids in %llu us: "
+		    "power -> %d, volume up -> %d\n", scanned,
+		    ns / 1000ull, (int)pon_apid, (int)volup_apid);
+	}
+	if (pon_apid == (uint32_t)-1 && volup_apid == (uint32_t)-1) {
+		printf("LIUQIN KEYS: neither PPID found; stopping (no polling)\n");
+		return;
+	}
+	if (pon_apid != (uint32_t)-1) {
+		printf("LIUQIN KEYS: power/volume down ppid 0x013 -> apid %u "
+		    "(owner EE %u)\n", pon_apid, pmic_owner(pon_apid));
+	}
+	if (volup_apid != (uint32_t)-1) {
+		printf("LIUQIN KEYS: volume up ppid 0x18d -> apid %u "
+		    "(owner EE %u)\n", volup_apid, pmic_owner(volup_apid));
+	}
+
+	/* One annotated read of each register before the poll starts. */
+	{
+		uint8_t pon = 0;
+		uint8_t volup = 0;
+		uint32_t pon_st = 0, volup_st = 0;
+
+		if (pon_apid != (uint32_t)-1) {
+			if (pmic_read_ex(pon_apid, PMIC_PON_RT_STS, &pon, 1,
+			    &pon_st, NULL) == 0) {
+				printf("LIUQIN KEYS: pon reads 0x%02x "
+				    "(power %s, volume down %s)\n", pon,
+				    (pon & PMIC_PON_KPDPWR) ? "pressed" : "released",
+				    (pon & PMIC_PON_RESIN) ? "pressed" : "released");
+			} else {
+				printf("LIUQIN KEYS: pon read failed (status 0x%08x)\n",
+				    pon_st);
+				pon_apid = (uint32_t)-1;
+			}
+		}
+		if (volup_apid != (uint32_t)-1) {
+			if (pmic_read_ex(volup_apid, PMIC_VOLUP_RT_STS, &volup, 1,
+			    &volup_st, NULL) == 0) {
+				printf("LIUQIN KEYS: volume up reads 0x%02x "
+				    "(active low: %s)\n", volup,
+				    (volup & PMIC_GPIO_VAL) ? "released" : "pressed");
+			} else {
+				printf("LIUQIN KEYS: volume up read failed "
+				    "(status 0x%08x)\n", volup_st);
+				volup_apid = (uint32_t)-1;
+			}
+		}
+	}
+	if (pon_apid == (uint32_t)-1 && volup_apid == (uint32_t)-1) {
+		printf("LIUQIN KEYS: no readable key register, stopping\n");
+		return;
+	}
+
+	printf("LIUQIN KEYS: polling power/volume down every 50 ms; "
+	    "press a key (volume up is active low)\n");
+	{
+		uint8_t last_pon = 0, last_volup = 0;
+		bool power = false, voldown = false, volup = false;
+		unsigned agree_power = 0, agree_voldown = 0, agree_volup = 0;
+		unsigned failures = 0;
+		bool have_pon = false, have_volup = false;
+		const int ticks = (hz / 20) > 0 ? hz / 20 : 1;
+
+		for (;;) {
+			uint8_t pon = last_pon, vu = last_volup;
+			bool power_now = power, voldown_now = voldown;
+			bool volup_now = volup;
+
+			(void)tsleep(&liuqin_keys_chan, PZERO, "liuqinkeys", ticks);
+			if (pon_apid != (uint32_t)-1) {
+				if (pmic_read(pon_apid, PMIC_PON_RT_STS, &pon, 1) == 0) {
+					failures = 0;
+					have_pon = true;
+					power_now = (pon & PMIC_PON_KPDPWR) != 0;
+					voldown_now = (pon & PMIC_PON_RESIN) != 0;
+				} else {
+					failures++;
+				}
+			}
+			if (volup_apid != (uint32_t)-1) {
+				if (pmic_read(volup_apid, PMIC_VOLUP_RT_STS, &vu, 1) == 0) {
+					failures = 0;
+					have_volup = true;
+					/* DTS: gpios = <&pm8350_gpios 6 GPIO_ACTIVE_LOW> */
+					volup_now = (vu & PMIC_GPIO_VAL) == 0;
+				} else {
+					failures++;
+				}
+			}
+			if (failures >= 20) {
+				printf("LIUQIN KEYS: 20 consecutive SPMI failures, stopping\n");
+				return;
+			}
+			if ((have_pon && pon != last_pon) ||
+			    (have_volup && vu != last_volup)) {
+				printf("LIUQIN KEYS: raw pon 0x%02x volup 0x%02x\n",
+				    pon, vu);
+				last_pon = pon;
+				last_volup = vu;
+			}
+
+			/* Two equal samples (100 ms) debounce a press. */
+			if (power_now != power) {
+				if (++agree_power >= 2) {
+					power = power_now;
+					agree_power = 0;
+					liuqin_touch_post(power ? LIUQIN_BUTTON_DOWN :
+					    LIUQIN_BUTTON_UP, LIUQIN_BUTTON_LOCK, 0, 0);
+					printf("LIUQIN KEYS: power %s\n",
+					    power ? "down" : "up");
+				}
+			} else {
+				agree_power = 0;
+			}
+			if (voldown_now != voldown) {
+				if (++agree_voldown >= 2) {
+					voldown = voldown_now;
+					agree_voldown = 0;
+					liuqin_touch_post(voldown ? LIUQIN_BUTTON_DOWN :
+					    LIUQIN_BUTTON_UP, LIUQIN_BUTTON_VOLUME_DOWN, 0, 0);
+					printf("LIUQIN KEYS: volume down %s\n",
+					    voldown ? "down" : "up");
+				}
+			} else {
+				agree_voldown = 0;
+			}
+			if (volup_now != volup) {
+				if (++agree_volup >= 2) {
+					volup = volup_now;
+					agree_volup = 0;
+					liuqin_touch_post(volup ? LIUQIN_BUTTON_DOWN :
+					    LIUQIN_BUTTON_UP, LIUQIN_BUTTON_VOLUME_UP, 0, 0);
+					printf("LIUQIN KEYS: volume up %s\n",
+					    volup ? "down" : "up");
+				}
+			} else {
+				agree_volup = 0;
+			}
+		}
+	}
+}
+
+/*
+ * touch183 keys-spmi-map: this diagnostic build enables the poller by default
+ * because the 567-byte boot line must not change.  The released driver keeps
+ * the keys off unless liuqinkeys=1; `liuqinkeys=0` still disables this build.
+ */
+static void
+liuqin_keys_start(void)
+{
+	int on = 1;
+	thread_t thread;
+
+	if (PE_parse_boot_argn("liuqinkeys", &on, sizeof(on)) && on == 0) {
+		printf("LIUQIN KEYS: disabled by liuqinkeys=0\n");
+		return;
+	}
+	pmic_core = ml_io_map(SPMI_CORE_PA, SPMI_CORE_SIZE);
+	pmic_obs = ml_io_map(SPMI_OBS_PA, SPMI_OBS_SIZE);
+	pmic_cfg0 = ml_io_map(SPMI_CFG0_PA, SPMI_CFG_SIZE);
+	pmic_cfg1 = ml_io_map(SPMI_CFG1_PA, SPMI_CFG_SIZE);
+	if (pmic_core == 0 || pmic_obs == 0) {
+		printf("LIUQIN KEYS: spmi map failed (core %d obs %d)\n",
+		    pmic_core != 0, pmic_obs != 0);
+		return;
+	}
+	printf("LIUQIN KEYS: touch183 diagnostic build, keys enabled by default "
+	    "(liuqinkeys=0 disables)\n");
+	if (kernel_thread_start(liuqin_keys_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("LIUQIN KEYS: thread not started\n");
+	}
+}
+
 #endif /* ARM64_BOARD_CONFIG_LIUQIN */
