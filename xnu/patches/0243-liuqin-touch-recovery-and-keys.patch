+/*
+ * ---------------------------------------------------------------- PMIC keys
+ *
+ * None of the tablet's three buttons is on a TLMM pin.  The device tree (both
+ * the stock overlay and the mainline liuqin DTS) puts them on the PMICs, which
+ * are only reachable over SPMI:
+ *
+ *   power        PMK8350 PON, SPMI SID 0, PON_RT_STS at 0x1310, bit 7
+ *                (qcom,pmk8350-pwrkey, code KEY_POWER)
+ *   volume down  the same PON byte, bit 6 - PON RESIN, wired to
+ *                qcom,pmk8350-resin with linux,code = KEY_VOLUMEDOWN
+ *   volume up    PM8350 GPIO6, SPMI SID 1, base 0x8d00, RT_STS at 0x8d10
+ *                (gpio-keys/key-volume-up, PM8350_ACTIVE_LOW)
+ *
+ * The SPMI master is the PMIC arbiter at 0xc42d000 ("qcom,spmi-pmic-arb").
+ * This part is arbiter v7.  Two details matter, and both were wrong in
+ * touch173, which is why ppid 0x013 was never found:
+ *
+ *   - the v7 APID->PPID table is at core + 0x2000 + 4*apid, not at 0x0b00
+ *     (Linux drivers/spmi/spmi-pmic-arb.c: pmic_arb_apid_map_offset_v7());
+ *   - an entry is (ppid << 8) | flags and PPID is 12 bits
+ *     (PMIC_ARB_PPID_MASK = 0xfff), so masking 13 bits folds the reserved
+ *     bit 20 into the comparison.
+ *
+ * Reading the reserved 0x0b00 window is also what made each old scan read cost
+ * ~26 ms: those offsets are not implemented and the interconnect waits for a
+ * timeout.  The real table reads take a normal MMIO access.
+ *
+ * Only reads are used here: writing a PMIC register from a port with no PMIC
+ * driver would be able to change a rail, and nothing about the buttons needs
+ * it.  The arbiter's own command register is written; that is the SPMI master,
+ * not a PMIC register.
+ */
+#define SPMI_CORE_PA            0x0c400000u
+#define SPMI_CORE_SIZE          0x3000u
+#define SPMI_CFG0_PA            0x0c42d000u
+#define SPMI_CFG1_PA            0x0c432000u
+#define SPMI_CFG_SIZE           0x4000u
+#define SPMI_OBS_PA             0x0c440000u
+#define SPMI_OBS_SIZE           0x80000u
+
+#define SPMI_REG_VERSION        0x0000u
+#define SPMI_REG_FEATURES0      0x0004u
+#define SPMI_REG_FEATURES1      0x0008u
+#define SPMI_FEATURES_MASK      0x7ffu
+#define SPMI_APID_MAP(i)        (0x2000u + 4u * (i))
+#define SPMI_APID_MAX           1024u
+#define SPMI_PPID_MASK          0x0fffu
+#define SPMI_IRQ_OWNER          (1u << 24)
+#define SPMI_OWNER(apid)        (4u * (apid))
+
+#define SPMI_CH_CMD             0x00u
+#define SPMI_CH_STATUS          0x08u
+#define SPMI_CH_RDATA0          0x18u
+#define SPMI_CH_STRIDE          0x20u
+#define SPMI_OP_READ            15u
+#define SPMI_ST_DONE            (1u << 0)
+#define SPMI_ST_ERR             0x7eu
+
+#define PMIC_PON_RT_STS         0x1310u
+#define PMIC_PON_KPDPWR         (1u << 7)
+#define PMIC_PON_RESIN          (1u << 6)
+#define PMIC_VOLUP_RT_STS       0x8d10u
+#define PMIC_GPIO_VAL           (1u << 0)
+
+/* A real SPMI byte read is tens of microseconds.  Anything past this is a bad
+ * APID or an unimplemented offset; the hardware's own timeout can be ~26 ms,
+ * and waiting for it on every sample would make the poll useless. */
+#define PMIC_READ_TIMEOUT_NS    (20ull * 1000 * 1000)
+
+static vm_offset_t pmic_core, pmic_cfg0, pmic_cfg1, pmic_obs;
+static uint32_t pmic_bus0_apids, pmic_bus1_apids;
+static int liuqin_keys_chan;
+
+static uint64_t
+pmic_ns_since(uint64_t t0)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	return ns;
+}
+
+/* Owner (EE) of an APID.  v7 keeps one ownership table per bus, indexed from
+ * that bus's base APID, inside that bus's "cfg" region. */
+static uint32_t
+pmic_owner(uint32_t apid)
+{
+	if (apid < pmic_bus0_apids) {
+		return pmic_cfg0 == 0 ? 0xfu :
+		    (tch_rd(pmic_cfg0, SPMI_OWNER(apid)) & 0x7u);
+	}
+	if (apid < pmic_bus0_apids + pmic_bus1_apids) {
+		return pmic_cfg1 == 0 ? 0xfu :
+		    (tch_rd(pmic_cfg1,
+		    SPMI_OWNER(apid - pmic_bus0_apids)) & 0x7u);
+	}
+	return 0xfu;
+}
+
+/*
+ * One SPMI register read.  The command word is the arbiter's own format
+ * (opcode << 27 | register << 4 | byte-count-1); the channel reports
+ * completion in STATUS bit 0 and any bus failure in bits 1..6.
+ *
+ * The timeout is wall-clock.  If a read is aimed at an APID that is not
+ * mapped, the status read itself can take ~26 ms; the old fixed 4000-iteration
+ * loop would then wait for over a minute.
+ */
+static int
+pmic_read_ex(uint32_t apid, uint32_t addr, uint8_t *buf, size_t len,
+    uint32_t *status_out, uint64_t *ns_out)
+{
+	const uint32_t ch = apid * SPMI_CH_STRIDE;
+	const uint32_t cmd = (SPMI_OP_READ << 27) |
+	    ((addr & 0xffu) << 4) | (uint32_t)(len - 1);
+	const uint64_t t0 = mach_absolute_time();
+	uint32_t st = 0;
+	unsigned i;
+
+	tch_wr(pmic_obs, ch + SPMI_CH_CMD, cmd);
+	for (i = 0; i < 100000; i++) {
+		st = tch_rd(pmic_obs, ch + SPMI_CH_STATUS);
+		if ((st & SPMI_ST_DONE) != 0) {
+			break;
+		}
+		if (pmic_ns_since(t0) >= PMIC_READ_TIMEOUT_NS) {
+			break;
+		}
+		delay(1);
+	}
+	if (ns_out != NULL) {
+		*ns_out = pmic_ns_since(t0);
+	}
+	if (status_out != NULL) {
+		*status_out = st;
+	}
+	if ((st & SPMI_ST_DONE) == 0 || (st & SPMI_ST_ERR) != 0) {
+		return -1;
+	}
+	for (i = 0; i < len; i++) {
+		const uint32_t r = tch_rd(pmic_obs,
+		    ch + (i < 4 ? SPMI_CH_RDATA0 : SPMI_CH_RDATA0 + 4u));
+		buf[i] = (uint8_t)((r >> (8 * (i & 3))) & 0xff);
+	}
+	return 0;
+}
+
+static int
+pmic_read(uint32_t apid, uint32_t addr, uint8_t *buf, size_t len)
+{
+	return pmic_read_ex(apid, addr, buf, len, NULL, NULL);
+}
