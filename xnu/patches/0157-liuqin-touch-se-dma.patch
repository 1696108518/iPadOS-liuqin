+/* geni_se_select_mode(GENI_SE_DMA): the SE moves the data itself. */
+static void
+tch_dma_mode(void)
+{
+	tch_irq_clear();
+	tch_wr(tch.se, SE_GENI_DMA_MODE_EN,
+	    tch_rd(tch.se, SE_GENI_DMA_MODE_EN) | GENI_DMA_MODE_EN);
+}
+
+static void
+tch_dma_abort(void)
+{
+	tch_wr(tch.se, SE_GENI_M_CMD_CTRL_REG, M_GENI_CMD_ABORT);
+	for (unsigned i = 0; i < 200; i++) {
+		if (tch_status() & M_CMD_ABORT_EN) {
+			break;
+		}
+		delay(50);
+	}
+	tch_wr(tch.se, SE_GENI_M_IRQ_CLEAR, 0xffffffff);
+}
