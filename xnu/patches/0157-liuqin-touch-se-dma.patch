+/* One page of staging memory for the SE DMA, physically contiguous because the
+ * engine is handed a physical address and is not cache coherent. */
+static int
+tch_dma_alloc(void)
+{
+	if (tch.dma != 0) {
+		return 0;
+	}
+	if (kmem_alloc_contig(kernel_map, &tch.dma, PAGE_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("LIUQIN TOUCH: no contiguous DMA memory\n");
+		tch.dma = 0;
+		return -1;
+	}
+	const ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)tch.dma);
+
+	if (pn == 0) {
+		printf("LIUQIN TOUCH: DMA page has no physical address\n");
+		return -1;
+	}
+	tch.dma_pa = ptoa_64(pn);
+	printf("LIUQIN TOUCH: DMA staging page at 0x%llx (phys 0x%llx)\n",
+	    (uint64_t)tch.dma, tch.dma_pa);
+	return 0;
+}
