+/* One SPI transfer through the serial engine's own DMA engine: what an SE with
+ * FIFO_IF_DISABLE set needs (geni_se_tx/rx_init_dma, then poll the DMA status,
+ * exactly as geni_se_tx/rx_init_dma() and the U-Boot GENI SPI driver do). */
+static int
+tch_dma_xfer(const uint8_t *tx, uint8_t *rx, size_t len)
+{
+	const uint64_t tx_pa = tch.dma_pa + TCH_DMA_TX_OFF;
+	const uint64_t rx_pa = tch.dma_pa + TCH_DMA_RX_OFF;
+	const uint32_t cmd = (tx != NULL && rx != NULL) ? SPI_TX_RX :
+	    (tx != NULL ? SPI_TX_ONLY : SPI_RX_ONLY);
+	uint32_t txst = 0, rxst = 0, irq = 0;
+	bool ok;
+
+	if (tch.dma == 0 || len == 0 || len > TCH_DMA_MAX) {
+		return -1;
+	}
+	if (tx != NULL) {
+		memcpy((void *)(tch.dma + TCH_DMA_TX_OFF), tx, len);
+		flush_dcache64((addr64_t)tx_pa, (unsigned)len, TRUE);
+	}
+	if (rx != NULL) {
+		/* Nothing dirty may survive into the buffer the engine is about
+		 * to overwrite, and nothing stale may survive the transfer. */
+		memset((void *)(tch.dma + TCH_DMA_RX_OFF), 0, len);
+		flush_dcache64((addr64_t)rx_pa, (unsigned)len, TRUE);
+	}
+	tch_wr(tch.se, SE_SPI_TX_TRANS_LEN, tx != NULL ? (uint32_t)len : 0);
+	tch_wr(tch.se, SE_SPI_RX_TRANS_LEN, rx != NULL ? (uint32_t)len : 0);
+	tch_dma_mode();
+	tch_wr(tch.se, SE_GENI_M_CMD0, (cmd << M_OPCODE_SHFT) | FRAGMENTATION);
+	if (rx != NULL) {
+		tch_wr(tch.se, SE_DMA_RX_IRQ_EN_SET, DMA_IRQ_EN);
+		tch_wr(tch.se, SE_DMA_RX_PTR_L, (uint32_t)rx_pa);
+		tch_wr(tch.se, SE_DMA_RX_PTR_H, (uint32_t)(rx_pa >> 32));
+		tch_wr(tch.se, SE_DMA_RX_ATTR, 0);
+		tch_wr(tch.se, SE_DMA_RX_LEN, (uint32_t)len);
+	}
+	if (tx != NULL) {
+		tch_wr(tch.se, SE_DMA_TX_IRQ_EN_SET, DMA_IRQ_EN);
+		tch_wr(tch.se, SE_DMA_TX_PTR_L, (uint32_t)tx_pa);
+		tch_wr(tch.se, SE_DMA_TX_PTR_H, (uint32_t)(tx_pa >> 32));
+		tch_wr(tch.se, SE_DMA_TX_ATTR, GENI_SE_DMA_EOT_BUF);
+		tch_wr(tch.se, SE_DMA_TX_LEN, (uint32_t)len);
+	}
+	for (unsigned i = 0; i < 50 * 20; i++) {
+		txst = tx != NULL ? tch_rd(tch.se, SE_DMA_TX_IRQ_STAT) : 0;
+		rxst = rx != NULL ? tch_rd(tch.se, SE_DMA_RX_IRQ_STAT) : 0;
+		irq = tch_status();
+		if (irq & TCH_IRQ_ERRS) {
+			break;
+		}
+		if ((tx == NULL || (txst & TX_DMA_DONE)) &&
+		    (rx == NULL || (rxst & RX_DMA_DONE))) {
+			break;
+		}
+		delay(50);
+	}
+	tch.dma_tx_status = txst;
+	tch.dma_rx_status = rxst;
+	tch.last_irq = irq;
+	ok = (tx == NULL || (txst & TX_DMA_DONE)) &&
+	    (rx == NULL || (rxst & RX_DMA_DONE)) && (irq & TCH_IRQ_ERRS) == 0;
+	if (tx != NULL && txst != 0) {
+		tch_wr(tch.se, SE_DMA_TX_IRQ_CLR, txst);
+	}
+	if (rx != NULL && rxst != 0) {
+		tch_wr(tch.se, SE_DMA_RX_IRQ_CLR, rxst);
+	}
+	if (irq != 0) {
+		tch_wr(tch.se, SE_GENI_M_IRQ_CLEAR, irq);
+	}
+	if (!ok) {
+		if (tx != NULL) {
+			tch_wr(tch.se, SE_DMA_TX_FSM_RST, 1);
+		}
+		if (rx != NULL) {
+			tch_wr(tch.se, SE_DMA_RX_FSM_RST, 1);
+		}
+		tch_dma_abort();
+		return -1;
+	}
+	if (rx != NULL) {
+		flush_dcache64((addr64_t)rx_pa, (unsigned)len, TRUE);
+		memcpy(rx, (void *)(tch.dma + TCH_DMA_RX_OFF), len);
+	}
+	return 0;
+}
+
+static int
+tch_xfer(const uint8_t *tx, uint8_t *rx, size_t len)
+{
+	return tch.fifo_capable ? tch_fifo_xfer(tx, rx, len) : tch_dma_xfer(tx, rx, len);
+}
