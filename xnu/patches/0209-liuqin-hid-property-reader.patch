+static const char *
+liuqin_current_proc_name(char *buf, size_t len)
+{
+	proc_t proc = (proc_t)get_bsdtask_info(current_task());
+
+	if (proc) {
+		proc_name(proc_pid(proc), buf, (int)len);
+	} else {
+		snprintf(buf, len, "kernel");
+	}
+	return buf;
+}
