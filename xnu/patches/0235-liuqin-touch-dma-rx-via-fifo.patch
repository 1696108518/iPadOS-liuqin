+/*
+ * touch164 settled it: with the RX DMA disarmed the RX FIFO fills (wc 2 for an
+ * 8-byte read) and the CPU can read its words, while the RX DMA writes
+ * "10 00 00 00 02 01 aa aa" no matter what.  So TX keeps going through the
+ * engine's DMA - which the wire capture proved byte exact - and the received
+ * bytes are pulled straight out of the FIFO while the command runs, the same
+ * way the FIFO-mode path does it.
  */
 static int
+tch_dma_fifo_xfer(const uint8_t *tx, uint8_t *rx, size_t len)
+{
+	const uint32_t cmd = (tx != NULL && rx != NULL) ? SPI_TX_RX :
+	    (tx != NULL ? SPI_TX_ONLY : SPI_RX_ONLY);
+	size_t got = 0;
+	uint32_t irq = 0;
+	unsigned i;
+
+	if (tch.dma == 0 || len == 0 || len > TCH_DMA_MAX) {
+		return -1;
+	}
+	if (tch_rx_via_fifo && rx != NULL) {
+		return tch_dma_fifo_xfer(tx, rx, len);
+	}
+	if (tx != NULL) {
+		tch_dma_put(TCH_DMA_TX_OFF, tx, len);
+	}
+	tch_wr(tch.se, SE_SPI_TX_TRANS_LEN, tx != NULL ? (uint32_t)len : 0);
+	tch_wr(tch.se, SE_SPI_RX_TRANS_LEN, rx != NULL ? (uint32_t)len : 0);
+	tch_dma_mode();
+	tch_wr(tch.se, SE_GENI_M_CMD0, (cmd << M_OPCODE_SHFT) | FRAGMENTATION);
+	/* RX deliberately not armed: the FIFO must keep the bytes. */
+	tch_dma_arm(tx != NULL, false, tch.dma_pa + TCH_DMA_TX_OFF, 0, len);
+
+	for (i = 0; i < 50 * 100; i++) {
+		if (rx != NULL) {
+			tch_drain_rx(rx, len, &got);
+		}
+		irq = tch_status();
+		if (irq & (M_CMD_DONE_EN | TCH_IRQ_ERRS)) {
+			break;
+		}
+		delay(10);
+	}
+	if (rx != NULL) {
+		tch_drain_rx(rx, len, &got);
+	}
+	tch_wr(tch.se, SE_GENI_M_IRQ_CLEAR, irq ? irq : 0xffffffff);
+	tch.last_irq = irq;
+	if ((irq & M_CMD_DONE_EN) == 0 || (irq & TCH_IRQ_ERRS) != 0) {
+		return -1;
+	}
+	if (rx != NULL && got < len) {
+		return -1;
+	}
+	return 0;
+}
