+static void
+tch_read_id_line(const char *what)
+{
+	uint8_t id[6] = { 0 };
+
+	(void)tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id));
+	printf("LIUQIN TOUCH: %s: %02x %02x %02x %02x %02x %02x%s\n",
+	    what, id[0], id[1], id[2], id[3], id[4], id[5],
+	    (id[3] == 0x65 && id[4] == 0x03) ? "  <-- ANSWER" : "");
+}
+
+/* On the discovered pins the controller answers, but the bytes are not stable
+ * between boots (83 80 3a 4f bb 9d then 83 81 3a 47 bb 9c) and one direct
+ * attempt read ff - a marginal read rather than a protocol mismatch.  Measure
+ * the knobs one at a time, all on cs17/clk18/mosi19/miso16, 15/7 page split. */
+static void
+tch_diag_matrix(void)
+{
+	tch_roles(17, 18, 19, 16);
+	tch.page8 = false;
+	tch.dummy = 1;
+	tch.bb_pace_us = 5;
+	tch_bb_dir(16, false, 0);                       /* MISO, no bias */
+
+	tch_nvt_bringup();
+	tch_read_id_line("baseline: 5 us half period, one dummy byte");
+
+	tch.bb_pace_us = 25;
+	tch_nvt_bringup();
+	tch_read_id_line("slow: 25 us half period");
+	tch.bb_pace_us = 5;
+
+	/* A line the controller drives ignores a pull-up; a floating one reads 1 */
+	tch_wr(tch.tlmm, TLMM_CTL(16), (0u << 2) | (3u << 0) | (2u << 6));
+	delay(2000);
+	tch_nvt_bringup();
+	tch_read_id_line("MISO with pull-up");
+	tch_bb_dir(16, false, 0);
+
+	tch.dummy = 0;
+	tch_nvt_bringup();
+	tch_read_id_line("no dummy byte");
+	tch.dummy = 2;
+	tch_nvt_bringup();
+	tch_read_id_line("two dummy bytes");
+	tch.dummy = 1;
 }
 
