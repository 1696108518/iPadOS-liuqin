+/* The clock tree as it stands after the setup, with rates computed from the
+ * RCG configs rather than assumed. */
+static void
+ufs_gcc_report(void)
+{
+	uint32_t axid = 0, axis = 0;
+	uint32_t axi = gcc_rcg_rate(GCC_UFS_PHY_AXI_RCGR, &axid, &axis);
+	uint32_t ice = gcc_rcg_rate(GCC_UFS_PHY_ICE_RCGR, NULL, NULL);
+	uint32_t uni = gcc_rcg_rate(GCC_UFS_PHY_UNIPRO_RCGR, NULL, NULL);
+	uint32_t aux = gcc_rcg_rate(GCC_UFS_PHY_AUX_RCGR, NULL, NULL);
+
+	printf("LIUQIN UFS: gcc gdsc 0x%x bcr 0x%x\n",
+	    gcc_rd(GCC_UFS_PHY_GDSCR), gcc_rd(GCC_UFS_PHY_BCR));
+	printf("LIUQIN UFS: gcc rates axi %u.%03u MHz (src %u div %u) unipro %u.%03u MHz ice %u.%03u MHz aux %u.%03u MHz\n",
+	    axi / 1000000, (axi / 1000) % 1000, axis, axid,
+	    uni / 1000000, (uni / 1000) % 1000,
+	    ice / 1000000, (ice / 1000) % 1000,
+	    aux / 1000000, (aux / 1000) % 1000);
+	printf("LIUQIN UFS: gcc cbcr axi 0x%x ahb 0x%x unipro 0x%x ice 0x%x aux 0x%x aggre 0x%x qref 0x%x sym tx 0x%x rx0 0x%x rx1 0x%x\n",
+	    gcc_rd(GCC_UFS_PHY_AXI_CBCR), gcc_rd(GCC_UFS_PHY_AHB_CBCR),
+	    gcc_rd(GCC_UFS_PHY_UNIPRO_CBCR), gcc_rd(GCC_UFS_PHY_ICE_CBCR),
+	    gcc_rd(GCC_UFS_PHY_AUX_CBCR), gcc_rd(GCC_AGGRE_UFS_PHY_AXI_CBCR),
+	    gcc_rd(GCC_UFS_0_CLKREF_EN), gcc_rd(GCC_UFS_PHY_TX_SYMBOL_CBCR),
+	    gcc_rd(GCC_UFS_PHY_RX_SYMBOL0_CBCR),
+	    gcc_rd(GCC_UFS_PHY_RX_SYMBOL1_CBCR));
+}
+
+/* Bring the whole UFS_PHY clock tree up.  The core/unipro/ice rates are only
+ * touched for HS: the default PWM path keeps ABL's rates so a failure here
+ * cannot take a working boot down with it. */
+static int
+ufs_gcc_clocks_on(int hs)
+{
+	int err = 0;
+
+	if (!su.gcc) {
+		return EIO;
+	}
+	gcc_ufs_power_domain_on();
+
+	if (hs) {
+		err |= gcc_rcg_set(GCC_UFS_PHY_AXI_RCGR,
+		    GCC_RCG_DIV_300MHZ, 1, "axi");
+		err |= gcc_rcg_set(GCC_UFS_PHY_UNIPRO_RCGR,
+		    GCC_RCG_DIV_300MHZ, 1, "unipro");
+		err |= gcc_rcg_set(GCC_UFS_PHY_ICE_RCGR,
+		    GCC_RCG_DIV_300MHZ, 1, "ice");
+	}
+	err |= gcc_rcg_set(GCC_UFS_PHY_AUX_RCGR, GCC_RCG_DIV_19P2MHZ, 0, "aux");
+
+	err |= gcc_branch_on(GCC_UFS_PHY_AXI_CBCR, "axi");
+	err |= gcc_branch_on(GCC_UFS_PHY_AHB_CBCR, "ahb");
+	err |= gcc_branch_on(GCC_UFS_PHY_UNIPRO_CBCR, "unipro");
+	err |= gcc_branch_on(GCC_UFS_PHY_ICE_CBCR, "ice");
+	err |= gcc_branch_on(GCC_UFS_PHY_AUX_CBCR, "aux");
+	err |= gcc_branch_on(GCC_AGGRE_UFS_PHY_AXI_CBCR, "aggre");
+	if (hs) {
+		/* HS uses both lanes, so the PHY symbol clocks and the 19.2 MHz
+		 * reference buffer (qref) have to be running.  The minimal PWM
+		 * bring-up never needed any of them. */
+		err |= gcc_branch_on(GCC_UFS_PHY_TX_SYMBOL_CBCR, "tx_sym");
+		err |= gcc_branch_on(GCC_UFS_PHY_RX_SYMBOL0_CBCR, "rx_sym0");
+		err |= gcc_branch_on(GCC_UFS_PHY_RX_SYMBOL1_CBCR, "rx_sym1");
+		err |= gcc_branch_on(GCC_UFS_0_CLKREF_EN, "qref");
 	}
 	delay(1000);
+
+	{
+		extern int liuqin_console_force;
+		liuqin_console_force = 1;
+		ufs_gcc_report();
+		liuqin_console_force = 0;
+	}
+	return err ? EIO : 0;
+}
+
+static int ufs_uic(uint8_t opcode, uint32_t a1, uint32_t a2, uint32_t a3,
+    uint32_t *out);
+
+/* Host-side clocks.  The UTP timers count core_clk, and UniPro needs its
+ * mode select; Linux programs both from the actual rates
+ * (ufs_qcom_select_unipro_mode(), ufs_qcom_cfg_timers()). */
+static void
+ufs_hc_clock_init(void)
+{
+	uint32_t ver = ufs_rd(REG_UFS_HW_VERSION);
+	uint32_t major = (ver >> 28) & 0xf;
+	uint32_t axi = su.gcc ? gcc_rcg_rate(GCC_UFS_PHY_AXI_RCGR, NULL, NULL) : 0;
+
+	if (!axi) {
+		axi = 300000000;
+	}
+	ufs_wr(REG_UFS_CFG1, ufs_rd(REG_UFS_CFG1) | CFG1_QUNIPRO_SEL);
+	if (major >= 5) {
+		/* HW v5 only supports HS-G5 rate A (ufs_qcom_select_unipro_mode). */
+		ufs_wr(REG_UFS_CFG0, ufs_rd(REG_UFS_CFG0) & ~CFG0_QUNIPRO_G4_SEL);
+	}
+	ufs_wr(REG_UFS_SYS1CLK_1US, axi / 1000000);
+	(void)ufs_rd(REG_UFS_SYS1CLK_1US);
+	printf("LIUQIN UFS: hc ver 0x%x cfg1 0x%x sys1clk %u MHz\n",
+	    ver, ufs_rd(REG_UFS_CFG1), ufs_rd(REG_UFS_SYS1CLK_1US));
+}
+
+/* Device reference clock (CFG1 bit 26).  Linux enables it before a power
+ * mode change to HS (ufs_qcom_pwr_change_notify, PRE_CHANGE). */
+static void
+ufs_dev_ref_clock(int on)
+{
+	uint32_t v = ufs_rd(REG_UFS_CFG1);
+
+	if (on) {
+		v |= CFG1_DEV_REF_CLK_EN;
+	} else {
+		v &= ~CFG1_DEV_REF_CLK_EN;
+	}
+	ufs_wr(REG_UFS_CFG1, v);
+	(void)ufs_rd(REG_UFS_CFG1);
+	delay(10);
+	printf("LIUQIN UFS: device ref clock %s (cfg1 0x%x)\n",
+	    on ? "on" : "off", v);
+}
+
+/* DME attributes that tell UniPro how fast its clocks run.  Values mirror
+ * ufs_qcom_set_core_clk_ctrl(): 1 us is core_clk_unipro in MHz (300) and
+ * 40 ns is core_clk_unipro / 25 = 12 cycles, with the divider disabled. */
+static void
+ufs_dme_clock_init(void)
+{
+	uint32_t cycles = 300;                 /* core_clk_unipro, MHz */
+	uint32_t v = 0;
+	int r;
+
+	r = ufs_uic(0x01, 0xD002u << 16, 0, 0, &v);
+	if (!r) {
+		v &= ~(0x3ffu << 16);
+		v |= (cycles & 0x3ff) << 16;
+		v &= ~(1u << 8);               /* DME_VS_CORE_CLK_CTRL_DIV_EN */
+		r = ufs_uic(0x02, 0xD002u << 16, 0, v, NULL);
+	}
+	printf("LIUQIN UFS: dme core clk ctrl 0x%x -> %d\n", v, r);
+
+	v = 0;
+	r = ufs_uic(0x01, 0x9007u << 16, 0, 0, &v);
+	if (!r) {
+		v = (v & ~0x7fu) | (cycles / 25);
+		r = ufs_uic(0x02, 0x9007u << 16, 0, v, NULL);
+	}
+	printf("LIUQIN UFS: dme 40ns cycles 0x%x -> %d\n", v, r);
+}
