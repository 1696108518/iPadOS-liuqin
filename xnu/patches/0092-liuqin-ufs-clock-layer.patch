+/*
+ * ---------------------------------------------------------------------------
+ * GCC UFS_PHY clock layer
+ *
+ * Linux drives this block through the clock framework: a power domain, one
+ * branch clock per GCC output, an RCG rate per clock source and a block
+ * reset.  This driver only ever flipped the branch enable bits, so every
+ * rate stayed at whatever ABL programmed and the PHY's qref clock was never
+ * enabled at all.
+ *
+ * Offsets are from drivers/clk/qcom/gcc-sm8450.c (SM8475 uses the same GCC):
+ *   ufs_phy_gdsc              0x87004  bit 0 collapse, bit 31 power-on
+ *   gcc_ufs_phy_axi_clk       0x87018  rcg 0x8702c
+ *   gcc_ufs_phy_ahb_clk       0x87020
+ *   gcc_ufs_phy_tx_symbol_0   0x87024
+ *   gcc_ufs_phy_rx_symbol_0   0x87028
+ *   gcc_ufs_phy_unipro_core   0x87064  rcg 0x8708c
+ *   gcc_ufs_phy_ice_core      0x8706c  rcg 0x87074
+ *   gcc_ufs_phy_phy_aux       0x870a4  rcg 0x870a8
+ *   gcc_ufs_phy_rx_symbol_1   0x870c0
+ *   gcc_aggre_ufs_phy_axi     0x870d4
+ *   gcc_ufs_0_clkref_en       0x9c000  PHY qref
+ *
+ * RCG layout (drivers/clk/qcom/clk-rcg2.c): command at +0 (bit 0 update,
+ * bit 1 root enable), config at +4 (bits 0..4 divider, 8..10 source,
+ * bit 20 hardware control).  The divider field is 2*div-1, so 300 MHz from
+ * GPLL0 main (600 MHz) is field 3 source 1, and 19.2 MHz from XO is field 1
+ * source 0.
+ */
+#define GCC_UFS_PHY_BCR              0x87000
+#define GCC_UFS_PHY_GDSCR            0x87004
+#define GCC_UFS_PHY_AXI_CBCR         0x87018
+#define GCC_UFS_PHY_AHB_CBCR         0x87020
+#define GCC_UFS_PHY_TX_SYMBOL_CBCR   0x87024
+#define GCC_UFS_PHY_RX_SYMBOL0_CBCR  0x87028
+#define GCC_UFS_PHY_UNIPRO_CBCR      0x87064
+#define GCC_UFS_PHY_ICE_CBCR         0x8706c
+#define GCC_UFS_PHY_AUX_CBCR         0x870a4
+#define GCC_UFS_PHY_RX_SYMBOL1_CBCR  0x870c0
+#define GCC_AGGRE_UFS_PHY_AXI_CBCR   0x870d4
+#define GCC_UFS_0_CLKREF_EN          0x9c000
+
+#define GCC_UFS_PHY_AXI_RCGR         0x8702c
+#define GCC_UFS_PHY_ICE_RCGR         0x87074
+#define GCC_UFS_PHY_UNIPRO_RCGR      0x8708c
+#define GCC_UFS_PHY_AUX_RCGR         0x870a8
+
+#define GCC_RCG_UPDATE               (1u << 0)
+#define GCC_RCG_ROOT_EN              (1u << 1)
+#define GCC_RCG_DIV_MASK             0x1fu
+#define GCC_RCG_SRC_MASK             (0x7u << 8)
+#define GCC_RCG_MODE_MASK            (0x3u << 12)
+#define GCC_RCG_HW_CTRL              (1u << 20)
+#define GCC_CBCR_HW_CTRL             (1u << 1)
+#define GCC_CBCR_CLK_OFF             (1u << 31)
+#define GCC_GDSC_PWR_ON              (1u << 31)
+
+#define GCC_RCG_DIV_300MHZ           3       /* GPLL0 main 600 MHz / 2 */
+#define GCC_RCG_DIV_19P2MHZ          1       /* XO / 1 */
+
+static inline uint32_t
+gcc_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(su.gcc + off);
+}
+
+static inline void
+gcc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(su.gcc + off) = v;
+}
+
+/* Rate of one UFS RCG, for the boot log; the parent map is
+ * gcc_parent_map_0 (XO 0, GPLL0 main 1, GPLL0 even 6) for every RCG here
+ * except phy_aux, which only has XO. */
+static uint32_t
+gcc_rcg_rate(uint32_t cmd_rcgr, uint32_t *divp, uint32_t *srcp)
+{
+	uint32_t cfg = gcc_rd(cmd_rcgr + 4);
+	uint32_t div = cfg & GCC_RCG_DIV_MASK;
+	uint32_t src = (cfg >> 8) & 0x7;
+	uint32_t parent;
+
+	switch (src) {
+	case 0:  parent = 19200000;  break;     /* bi_tcxo */
+	case 1:  parent = 600000000; break;     /* gcc_gpll0_out_main */
+	case 6:  parent = 300000000; break;     /* gcc_gpll0_out_even */
+	default: parent = 0;         break;
+	}
+	if (divp) {
+		*divp = div;
+	}
+	if (srcp) {
+		*srcp = src;
+	}
+	return parent ? parent * 2 / (div + 1) : 0;
+}
+
+/* Reproduce clk_rcg2_configure() + update_config(). */
+static int
+gcc_rcg_set(uint32_t cmd_rcgr, uint32_t div, uint32_t src, const char *name)
+{
+	uint32_t cmd = gcc_rd(cmd_rcgr);
+	uint32_t cfg = gcc_rd(cmd_rcgr + 4);
+	int i;
+
+	if (!(cmd & GCC_RCG_ROOT_EN)) {
+		gcc_wr(cmd_rcgr, cmd | GCC_RCG_ROOT_EN);
+	}
+	cfg &= ~(GCC_RCG_DIV_MASK | GCC_RCG_SRC_MASK | GCC_RCG_MODE_MASK);
+	cfg |= div | (src << 8) | GCC_RCG_HW_CTRL;
+	gcc_wr(cmd_rcgr + 4, cfg);
+	gcc_wr(cmd_rcgr, gcc_rd(cmd_rcgr) | GCC_RCG_UPDATE);
+	for (i = 0; i < 100; i++) {
+		if (!(gcc_rd(cmd_rcgr) & GCC_RCG_UPDATE)) {
+			return 0;
+		}
+		delay(1);
+	}
+	printf("LIUQIN UFS: gcc %s rate update timed out (cmd 0x%x)\n",
+	    name, gcc_rd(cmd_rcgr));
+	return ETIMEDOUT;
+}
+
+/* Branch clock: set ENABLE and wait for the halt status like
+ * clk_branch2_enable() does.  A hardware-gated branch has no usable halt
+ * bit, so bit 1 means "on" there. */
+static int
+gcc_branch_on(uint32_t cbcr, const char *name)
+{
+	uint32_t v = gcc_rd(cbcr);
+	int i;
+
+	if (!(v & 1u)) {
+		gcc_wr(cbcr, v | 1u);
+	}
+	for (i = 0; i < 200; i++) {
+		v = gcc_rd(cbcr);
+		if (!(v & GCC_CBCR_CLK_OFF) || (v & GCC_CBCR_HW_CTRL)) {
+			return 0;
+		}
+		delay(1);
+	}
+	printf("LIUQIN UFS: gcc %s did not start (cbcr 0x%x)\n", name, v);
+	return ETIMEDOUT;
+}
