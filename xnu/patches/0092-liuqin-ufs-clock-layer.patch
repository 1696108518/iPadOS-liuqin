+/*
+ * Request HS mode.  PA_PWRMODE packs two nibbles - RX mode in 7..4, TX mode
+ * in 3..0 - so FAST/FAST is 0x11, not 1.  The earlier probe wrote 1 and the
+ * device answered "invalid value" (UIC result 10); that is unrelated to
+ * READ_ATTR bCurrentPowerMode, which returns 0x11 for SLOW (PWM).  The rest
+ * of the sequence is ufshcd_change_power_mode(): RX attributes first, then
+ * TX, HS series, and only then the power mode that retrains the link.
+ */
+static int
+ufs_set_hs_gear(const char *tag)
+{
+	uint32_t maxhs = 0, tx = 0, rx = 0, pm = 0, txl = 0, rxl = 0;
+	uint32_t want, cs = 0xff;
+	int e1, e2, e3, e4, e5, e6;
+	int s_rx, s_lane_rx, s_tx, s_lane_tx, s_adapt, s_pm = -1;
+	int series = 1;
+
+	e1 = ufs_uic(0x01, 0x1587u << 16, 0, 0, &maxhs);   /* PA_MAXRXHSGEAR */
+	e2 = ufs_uic(0x01, 0x1568u << 16, 0, 0, &tx);      /* PA_TXGEAR */
+	e3 = ufs_uic(0x01, 0x1583u << 16, 0, 0, &rx);      /* PA_RXGEAR */
+	e4 = ufs_uic(0x01, 0x1571u << 16, 0, 0, &pm);      /* PA_PWRMODE */
+	e5 = ufs_uic(0x01, 0x1560u << 16, 0, 0, &txl);     /* PA_ACTIVETXDATALANES */
+	e6 = ufs_uic(0x01, 0x1580u << 16, 0, 0, &rxl);     /* PA_ACTIVERXDATALANES */
+	if (e1 || maxhs < 1) {
+		printf("LIUQIN UFS: %s no HS gear (maxhs %u err %d)\n",
+		    tag, maxhs, e1);
+		return EIO;
+	}
+	want = maxhs > 4 ? 4 : maxhs;
+
+	s_rx = ufs_uic(0x02, 0x1583u << 16, 0, want, NULL);
+	s_lane_rx = ufs_uic(0x02, 0x1580u << 16, 0, 2, NULL);
+	ufs_uic(0x02, 0x1584u << 16, 0, 1, NULL);          /* RX termination */
+	s_tx = ufs_uic(0x02, 0x1568u << 16, 0, want, NULL);
+	s_lane_tx = ufs_uic(0x02, 0x1560u << 16, 0, 2, NULL);
+	ufs_uic(0x02, 0x1569u << 16, 0, 1, NULL);          /* TX termination */
+	s_adapt = ufs_uic(0x02, 0x15D4u << 16, 0, 1, NULL); /* PA_INITIAL_ADAPT */
+
+	/* Rate A first, then B; the device only has to accept one. */
+	for (series = 1; series <= 2; series++) {
+		ufs_uic(0x02, 0x156Au << 16, 0, (uint32_t)series, NULL); /* PA_HSSERIES */
+		s_pm = ufs_uic(0x02, 0x1571u << 16, 0, 0x11u, NULL);     /* FAST/FAST */
+		if (!s_pm) {
+			break;
+		}
