+IOReturn NativeAdrenoVm::pagetable(uint64_t *ttbr0,unsigned *asid) const
+{
+    if(!context_)return kIOReturnNotReady;
+    ArmSmmu4KContextImage image;
+    if(ArmSmmu4KEncodeContext(context_,&image)!=ArmSmmu4KSuccess)return kIOReturnError;
+    if(ttbr0)*ttbr0=image.ttbr0;
+    if(asid)*asid=context_->asid;
+    return kIOReturnSuccess;
