+/* One SPI transfer with chip select held: mode 0, 8-bit words, both
+ * directions when rx is given (the FIFO duplex opcode is TX|RX). */
+static int
+tch_xfer(const uint8_t *tx, uint8_t *rx, size_t len)
+{
+	uint32_t cmd = 0;
+	size_t got = 0;
+
+	if (len == 0 || len > TRANS_LEN_MSK) {
+		return -1;
+	}
+	if (tx != NULL) {
+		tch_wr(tch.se, SE_SPI_TX_TRANS_LEN, (uint32_t)len & TRANS_LEN_MSK);
+		cmd |= SPI_TX_ONLY;
+	}
+	if (rx != NULL) {
+		tch_wr(tch.se, SE_SPI_RX_TRANS_LEN, (uint32_t)len & TRANS_LEN_MSK);
+		cmd |= SPI_RX_ONLY;
+	}
+	tch_fifo_mode();
+	const uint32_t irq = tch_run_cmd((cmd << M_OPCODE_SHFT) | FRAGMENTATION,
+	    tx, tx != NULL ? len : 0, rx, rx != NULL ? len : 0, &got, 50);
+	if ((irq & M_CMD_DONE_EN) == 0) {
+		return -1;
+	}
+	if (rx != NULL && got < len) {
+		return -1;
+	}
+	return 0;
+}
+
+/* SPI_CS_ASSERT (8) / SPI_CS_DEASSERT (9); the transfer itself does not
+ * toggle the line because CS_TOGGLE was cleared at init. */
+static int
+tch_cs(bool assert)
+{
+	tch_fifo_mode();
+	const uint32_t irq = tch_run_cmd(((assert ? SPI_CS_ASSERT : SPI_CS_DEASSERT) << M_OPCODE_SHFT),
+	    NULL, 0, NULL, 0, NULL, 20);
+	return (irq & M_CMD_DONE_EN) ? 0 : -1;
+}
