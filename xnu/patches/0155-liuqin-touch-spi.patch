+	{
+		int div = 16, swap = 0, flip = 0;
+
+		(void)PE_parse_boot_argn("liuqintouchdiv", &div, sizeof(div));
+		(void)PE_parse_boot_argn("liuqintouchswap", &swap, sizeof(swap));
+		(void)PE_parse_boot_argn("liuqintouchflip", &flip, sizeof(flip));
+		tch.div = div < 2 ? 2 : (div > (int)CLK_DIV_MSK ? CLK_DIV_MSK : (uint32_t)div);
+		tch.swap = swap != 0;
+		tch.flip_x = (flip & 1) != 0;
+		tch.flip_y = (flip & 2) != 0;
