+/* geni_se_irq_clear(): drop every pending interrupt source. */
+static void
+tch_irq_clear(void)
+{
+	tch_wr(tch.se, SE_GSI_EVENT_EN, 0);
+	tch_wr(tch.se, SE_GENI_M_IRQ_CLEAR, 0xffffffff);
+	tch_wr(tch.se, SE_GENI_S_IRQ_CLEAR, 0xffffffff);
+	tch_wr(tch.se, SE_DMA_TX_IRQ_CLR, 0xffffffff);
+	tch_wr(tch.se, SE_DMA_RX_IRQ_CLR, 0xffffffff);
+	tch_wr(tch.se, SE_IRQ_EN, 0xffffffff);
+}
