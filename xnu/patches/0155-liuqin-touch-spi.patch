+/* geni_se_config_packing(), reduced to byte-aligned words (8 bits here):
+ * each 8-bit word is one packing vector, MSB first, and the FIFO word takes
+ * `pack_words` of them. */
+static void
+tch_config_packing(uint32_t bpw, uint32_t pack_words)
+{
+	uint32_t cfg[4] = { 0, 0, 0, 0 };
+	const uint32_t ceil_bpw = (bpw + 7) & ~7u;
+	const uint32_t iter = (ceil_bpw * pack_words) / 8;
+	const int idx_start = (int)bpw - 1;             /* msb_to_lsb */
+	int32_t temp_bpw = (int32_t)bpw;
+	int idx = idx_start;
+
+	if (iter == 0 || iter > 4) {
+		return;
+	}
+	for (uint32_t i = 0; i < iter; i++) {
+		const int len = (temp_bpw < 8 ? temp_bpw : 8) - 1;
+		cfg[i] = ((uint32_t)idx << 5) | (1u << 4) | ((uint32_t)len << 1);
+		if (temp_bpw <= 8) {
+			idx = (int)((i + 1) * 8) + idx_start;
+			temp_bpw = (int32_t)bpw;
+		} else {
+			idx -= 8;
+			temp_bpw -= 8;
+		}
+	}
+	cfg[iter - 1] |= 1u;                            /* PACKING_STOP_BIT */
+	tch_wr(tch.se, SE_GENI_TX_PACKING_CFG0, cfg[0] | (cfg[1] << 10));
+	tch_wr(tch.se, SE_GENI_TX_PACKING_CFG1, cfg[2] | (cfg[3] << 10));
+	tch_wr(tch.se, SE_GENI_RX_PACKING_CFG0, cfg[0] | (cfg[1] << 10));
+	tch_wr(tch.se, SE_GENI_RX_PACKING_CFG1, cfg[2] | (cfg[3] << 10));
+	/* Protocol words per FIFO entry: 0 = 4x8, 1 = 2x16, 2 = 1x32. */
+	tch_wr(tch.se, SE_GENI_BYTE_GRAN, (bpw / 16) & 3u);
+}
