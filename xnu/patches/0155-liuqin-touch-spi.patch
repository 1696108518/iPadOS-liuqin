+/* geni_se_select_mode(GENI_SE_FIFO): non-UART, so only the primary
+ * sequencer is interesting; DMA mode is off and the four FIFO interrupts
+ * that the polled transfer watches are on. */
+static void
+tch_fifo_mode(void)
+{
+	tch_irq_clear();
+	tch_wr(tch.se, SE_GENI_M_IRQ_EN, tch_rd(tch.se, SE_GENI_M_IRQ_EN) |
+	    M_CMD_DONE_EN | M_TX_FIFO_WATERMARK_EN |
+	    M_RX_FIFO_WATERMARK_EN | M_RX_FIFO_LAST_EN);
+	tch_wr(tch.se, SE_GENI_DMA_MODE_EN,
+	    tch_rd(tch.se, SE_GENI_DMA_MODE_EN) & ~GENI_DMA_MODE_EN);
+}
