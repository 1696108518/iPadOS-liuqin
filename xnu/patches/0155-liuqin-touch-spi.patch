+/* Novatek page/address framing: three bytes set the page, then the address
+ * with bit 7 clear selects a read, the part returns one dummy byte and then
+ * the data.  Mirrors nvt_spi_read() in the vendor driver (and the
+ * tools/touch-novatek harness). */
+static int
+tch_nvt_read(uint32_t addr, uint8_t *out, size_t len)
+{
+	uint8_t page[3];
+	uint8_t tx[NVT_BUF_MAX];
+	uint8_t rx[NVT_BUF_MAX];
+	int err = -1;
+
+	if (len + 2 > sizeof(tx) || len == 0) {
+		return -1;
+	}
+	if (tch_cs(true) != 0) {
+		return -1;
+	}
+	page[0] = 0xff;                                 /* set page */
+	page[1] = (uint8_t)((addr >> 15) & 0xff);
+	page[2] = (uint8_t)((addr >> 7) & 0xff);
+	if (tch_xfer(page, NULL, sizeof(page)) == 0) {
+		memset(tx, 0, len + 2);
+		memset(rx, 0, len + 2);
+		tx[0] = (uint8_t)(addr & 0x7f);         /* address, read */
+		if (tch_xfer(tx, rx, len + 2) == 0) {
+			memcpy(out, rx + 2, len);
+			err = 0;
+		}
+	}
+	if (tch_cs(false) != 0) {
+		err = -1;
+	}
+	return err;
+}
+
+static const char *
+tch_chip_name(const uint8_t id[6])
+{
+	/* The last three trim-id bytes are the model: 0x23 0x65 0x03 encodes
+	 * "2365" (NT36523), 0x32 0x65 0x03 "3265" (NT36532).  The mapping for
+	 * the 36532 follows the shape of the vendor's trim table, not a table
+	 * entry we have seen, so the raw bytes are logged as well. */
+	if (id[3] == 0x32 && id[4] == 0x65 && id[5] == 0x03) {
+		return "NT36532";
+	}
+	if (id[3] == 0x23 && id[4] == 0x65 && id[5] == 0x03) {
+		return "NT36523";
+	}
+	return NULL;
+}
