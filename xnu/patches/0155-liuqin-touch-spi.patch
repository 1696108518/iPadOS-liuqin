+ * driver, then the Novatek trim id. */
+static int
+liuqin_touch_spi_setup(void)
+{
+	const uint32_t fwrev = tch_rd(tch.se, GENI_FW_REVISION_RO);
+	const uint32_t proto = (fwrev & FW_REV_PROTOCOL_MSK) >> FW_REV_PROTOCOL_SHFT;
+
+	printf("LIUQIN TOUCH: SE4 GENI protocol %u (%s) fwrev 0x%08x\n", proto,
+	    proto == GENI_SE_SPI ? "SPI" : "not SPI", fwrev);
+	if (proto != GENI_SE_SPI) {
+		return -1;
+	}
+	vm_offset_t wrap = ml_io_map(QUP0_PA, QUP0_SIZE);
+	if (wrap == 0) {
+		printf("LIUQIN TOUCH: QUP wrapper map failed\n");
+		return -1;
+	}
+	const uint32_t hw = tch_rd(wrap, QUP_HW_VER_REG);
+	const uint32_t major = (hw >> 28) & 0xf;
+	const uint32_t minor = (hw >> 16) & 0xfff;
+	const uint32_t param0 = tch_rd(tch.se, SE_HW_PARAM_0);
+	const uint32_t param1 = tch_rd(tch.se, SE_HW_PARAM_1);
+	const uint32_t depth_msk = ((major == 3 && minor >= 10) || major > 3) ?
+	    FIFO_DEPTH_MSK_256 : FIFO_DEPTH_MSK;
+	const uint32_t width = (param0 & TX_FIFO_WIDTH_MSK) >> TX_FIFO_WIDTH_SHFT;
+
+	tch.tx_fifo_depth = (param0 & depth_msk) >> FIFO_DEPTH_SHFT;
+	printf("LIUQIN TOUCH: QUP hw 0x%08x (v%u.%u) TX fifo %u words x %u bit, RX fifo %u words\n",
+	    hw, major, minor, tch.tx_fifo_depth, width,
+	    (param1 & depth_msk) >> FIFO_DEPTH_SHFT);
+	if (width == 0 || tch.tx_fifo_depth < 4) {
+		printf("LIUQIN TOUCH: unusable FIFO geometry, SPI not started\n");
+		return -1;
+	}
+	tch.bytes_per_fifo_word = width / 8;
+	if (tch.bytes_per_fifo_word == 0) {
+		tch.bytes_per_fifo_word = 1;
+	}
+
+	/* geni_se_init(se, tx_fifo_depth - 3, tx_fifo_depth - 2) and
+	 * geni_se_io_init()/geni_se_io_set_mode(). */
+	tch_irq_clear();
+	tch_wr(tch.se, GENI_CGC_CTRL, tch_rd(tch.se, GENI_CGC_CTRL) | DEFAULT_CGC_EN);
+	tch_wr(tch.se, SE_DMA_GENERAL_CFG,
+	    tch_rd(tch.se, SE_DMA_GENERAL_CFG) | DMA_GENERAL_CFG_DEFAULT);
+	tch_wr(tch.se, GENI_OUTPUT_CTRL, DEFAULT_IO_OUTPUT_CTRL_MSK);
+	tch_wr(tch.se, GENI_FORCE_DEFAULT_REG, FORCE_DEFAULT);
+	tch_wr(tch.se, SE_IRQ_EN, tch_rd(tch.se, SE_IRQ_EN) | SE_IRQ_EN_DEFAULT);
+	tch_wr(tch.se, SE_GENI_DMA_MODE_EN,
+	    tch_rd(tch.se, SE_GENI_DMA_MODE_EN) & ~GENI_DMA_MODE_EN);
+	tch_wr(tch.se, SE_GSI_EVENT_EN, 0);
+	tch_wr(tch.se, SE_GENI_RX_WATERMARK_REG, tch.tx_fifo_depth - 3);
+	tch_wr(tch.se, SE_GENI_RX_RFR_WATERMARK_REG, tch.tx_fifo_depth - 2);
+	tch_wr(tch.se, SE_GENI_M_IRQ_EN,
+	    tch_rd(tch.se, SE_GENI_M_IRQ_EN) | M_COMMON_GENI_M_IRQ_EN);
+	tch_wr(tch.se, SE_GENI_S_IRQ_EN,
+	    tch_rd(tch.se, SE_GENI_S_IRQ_EN) | S_COMMON_GENI_S_IRQ_EN);
+
+	/* FIFO mode, and "we always control CS manually". */
+	tch_fifo_mode();
+	tch_wr(tch.se, SE_SPI_TRANS_CFG, tch_rd(tch.se, SE_SPI_TRANS_CFG) & ~CS_TOGGLE);
+
+	/* setup_fifo_params(): 8-bit words, SPI mode 0, chip select 0. */
+	const uint32_t pack_words = (width % 8) ? 1 : width / 8;
+	tch_config_packing(8, pack_words);
+	tch_wr(tch.se, SE_SPI_WORD_LEN, (8 - MIN_WORD_LEN) & WORD_LEN_MSK);
+	tch_wr(tch.se, SE_SPI_LOOPBACK, 0);
+	tch_wr(tch.se, SE_SPI_DEMUX_SEL, 0);
+	tch_wr(tch.se, SE_SPI_CPHA, 0);
+	tch_wr(tch.se, SE_SPI_CPOL, 0);
+	tch_wr(tch.se, SE_SPI_DEMUX_OUTPUT_INV, 0);
+
+	/* geni_spi_set_clock_and_bw(): the SE clock is BI_TCXO (19.2 MHz) with
+	 * no prescaler, so SER_M_CLK_CFG's divider is the whole story. */
+	tch_wr(tch.se, SE_GENI_CLK_SEL, 0);
+	tch_wr(tch.se, GENI_SER_M_CLK_CFG, ((tch.div & CLK_DIV_MSK) << CLK_DIV_SHFT) | SER_CLK_EN);
+	tch.spi_hz = SE_CLK_HZ / tch.div;
+	printf("LIUQIN TOUCH: SPI master mode 0, 8-bit words, CS0, %u kHz (19.2 MHz / %u), "
+	    "fifo %u byte/word, trans_cfg 0x%08x slave_en 0x%08x\n",
+	    tch.spi_hz / 1000, tch.div, tch.bytes_per_fifo_word,
+	    tch_rd(tch.se, SE_SPI_TRANS_CFG), tch_rd(tch.se, SE_SPI_SLAVE_EN));
+	return 0;
+}
+
+static void
+tch_novatek_info(void)
+{
+	uint8_t id[6] = { 0 };
+	const int have_id = tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id)) == 0;
+	const char *name = have_id ? tch_chip_name(id) : NULL;
+
+	printf("LIUQIN TOUCH: Novatek trim id %02x %02x %02x %02x %02x %02x (%s) irq 0x%08x\n",
+	    id[0], id[1], id[2], id[3], id[4], id[5],
+	    have_id ? (name != NULL ? name : "unknown id") : "read failed",
+	    tch.last_irq);
+
+	uint8_t fw[16] = { 0 };
+	if (tch_nvt_read(NVT_FWINFO_ADDR, fw, sizeof(fw)) == 0) {
+		const uint32_t max_x = ((uint32_t)fw[4] << 8) | fw[5];
+		const uint32_t max_y = ((uint32_t)fw[6] << 8) | fw[7];
+		const bool sane = ((fw[0] + fw[1]) & 0xff) == 0xff &&
+		    max_x > 0 && max_y > 0 && max_x <= 4096 && max_y <= 4096;
+
+		if (sane) {
+			tch.max_x = max_x;
+			tch.max_y = max_y;
+		}
+		printf("LIUQIN TOUCH: fwinfo %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x "
+		    "%02x %02x %02x %02x %02x %02x (%s)\n",
+		    fw[0], fw[1], fw[2], fw[3], fw[4], fw[5], fw[6], fw[7],
+		    fw[8], fw[9], fw[10], fw[11], fw[12], fw[13], fw[14], fw[15],
+		    sane ? "valid" : "broken, using the panel size");
+		printf("LIUQIN TOUCH: report space %ux%u, %u fingers, %u buttons, chip 0x%02x\n",
+		    tch.max_x, tch.max_y, fw[9], fw[10], fw[14]);
+	} else {
+		printf("LIUQIN TOUCH: fwinfo read failed, report space %ux%u\n",
+		    tch.max_x, tch.max_y);
+	}
+}
+
+static uint32_t
+tch_scale(uint32_t v, uint32_t max, uint32_t out)
+{
+	const uint32_t r = max ? (uint32_t)(((uint64_t)v * out) / max) : 0;
+
+	return r >= out ? out - 1 : r;
+}
+
+/* A frame with no finger record at all is not news: the buffer can read back
+ * as zeros or 0xff between reports, and treating that as a lift would release
+ * a finger that is still down.  Novatek sends an explicit release record
+ * (event 3) when a finger lifts, so real lifts always decode. */
+static bool
+tch_frame_valid(const uint8_t *frame)
+{
+	for (int i = 0; i < NVT_MAX_FINGERS; i++) {
+		const uint8_t *p = frame + 1 + 6 * i;
+		const unsigned id = p[0] >> 3;
+		const unsigned event = p[0] & 7u;
+
+		if (id >= 1 && id <= NVT_MAX_FINGERS && event >= 1 && event <= 3) {
+			return true;
+		}
+	}
+	return false;
 }
 
+/* One frame: 65 bytes at 0x2fe00, event byte first, then ten 6-byte records
+ * (id << 3 | event, x high, y high, x low nibble << 4 | y low nibble,
+ * weight, pressure).  Finger ids are 1-based and become HID slots 0..9.
+ * Returns how many fingers the frame reports. */
+static int
+tch_frame_decode(const uint8_t *frame, bool *down)
+{
+	uint32_t mask = 0;
+
+	for (int i = 0; i < NVT_MAX_FINGERS; i++) {
+		const uint8_t *p = frame + 1 + 6 * i;
+		const unsigned id = p[0] >> 3;
+		const unsigned event = p[0] & 7u;
+
+		if (id == 0 || id > NVT_MAX_FINGERS) {
+			continue;
+		}
+		if (event != 1 && event != 2) {         /* 3 = release, 0/4+ invalid */
+			continue;
+		}
+		unsigned x = ((unsigned)p[1] << 4) | (p[3] >> 4);
+		unsigned y = ((unsigned)p[2] << 4) | (p[3] & 0x0fu);
+		uint32_t rx = tch.max_x, ry = tch.max_y;
+
+		if (tch.swap) {
+			const unsigned t = x;
+
+			x = y;
+			y = t;
+			rx = tch.max_y;
+			ry = tch.max_x;
+		}
+		if (x > rx || y > ry) {
+			continue;
+		}
+		unsigned sx = tch_scale(x, rx, NVT_TOUCH_W);
+		unsigned sy = tch_scale(y, ry, NVT_TOUCH_H);
+
+		if (tch.flip_x) {
+			sx = NVT_TOUCH_W - 1 - sx;
+		}
+		if (tch.flip_y) {
+			sy = NVT_TOUCH_H - 1 - sy;
+		}
+		mask |= 1u << (id - 1);
+		liuqin_hid_touch((int)id - 1, 1, (int)sx, (int)sy);
+	}
+	for (int slot = 0; slot < NVT_MAX_FINGERS; slot++) {
+		if (down[slot] && !(mask & (1u << slot))) {
+			liuqin_hid_touch(slot, 0, 0, 0);
+		}
+		down[slot] = (mask & (1u << slot)) != 0;
+	}
+	return __builtin_popcount(mask);
+}
+
+static void
+tch_dump_frame(const char *what, const uint8_t *frame)
+{
+	printf("LIUQIN TOUCH: %s %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    what, frame[0], frame[1], frame[2], frame[3], frame[4],
+	    frame[5], frame[6], frame[7], frame[8], frame[9]);
+	printf("LIUQIN TOUCH: %s %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    what, frame[10], frame[11], frame[12], frame[13], frame[14],
+	    frame[15], frame[16], frame[17], frame[18], frame[19]);
+}
+
+static void
+liuqin_touch_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint8_t frame[NVT_POINT_LEN];
+	uint8_t last[NVT_POINT_LEN];
+	bool down[NVT_MAX_FINGERS] = { false };
+	unsigned errors = 0;
+	unsigned idle = 0;
+	int force_poll = 0;
+	bool saw_gpio = false;
+	bool dumped = false;
+
+	PE_parse_boot_argn("liuqintouchpoll", &force_poll, sizeof(force_poll));
+	memset(frame, 0, sizeof(frame));
+	memset(last, 0, sizeof(last));
+	printf("LIUQIN TOUCH: report thread up, %s\n",
+	    force_poll ? "event-buffer polling" : "INT on gpio21");
+
+	for (;;) {
+		const int ticks = hz / 100 > 0 ? hz / 100 : 1;
+		const uint32_t gpio = tch_rd(tch.tlmm, TLMM_CTL(21) + TLMM_IN_OUT);
+		bool go = force_poll || (gpio & TLMM_IN_BIT) != 0;
+
+		if (!saw_gpio) {
+			saw_gpio = true;
+			printf("LIUQIN TOUCH: gpio21 in/out 0x%08x (in %u out %u) mux %u pull %u\n",
+			    gpio, (gpio & TLMM_IN_BIT) ? 1 : 0, (gpio & TLMM_OUT_BIT) ? 1 : 0,
+			    TLMM_MUX(tch_rd(tch.tlmm, TLMM_CTL(21))),
+			    TLMM_PULL(tch_rd(tch.tlmm, TLMM_CTL(21))));
+		}
+		if (!go) {
+			/* Once a second, read anyway: that keeps the path alive
+			 * if the interrupt line reads wrong, and the frame
+			 * comparison below makes a stale buffer harmless. */
+			if (++idle < 64) {
+				(void)tsleep(&liuqin_touch_chan, PZERO, "liuqintouch", ticks);
+				continue;
+			}
+			idle = 0;
+		}
+		const bool health = !go;
+		if (tch_nvt_read(NVT_EVENT_BUF_ADDR, frame, sizeof(frame)) != 0) {
+			if (errors++ < 4) {
+				printf("LIUQIN TOUCH: event read failed (irq 0x%08x)\n", tch.last_irq);
+			}
+		} else if (tch_frame_valid(frame)) {
+			if (memcmp(frame, last, sizeof(frame)) != 0) {
+				if (!dumped) {
+					dumped = true;
+					tch_dump_frame("first frame", frame);
+				}
+				memcpy(last, frame, sizeof(frame));
+				const int fingers = tch_frame_decode(frame, down);
+
+				if (health && !force_poll && fingers > 0) {
+					/* A touch arrived without the interrupt line
+					 * asserting: wrong pin read, wrong polarity or
+					 * no INT at all.  Poll from now on. */
+					force_poll = 1;
+					printf("LIUQIN TOUCH: gpio21 did not assert for a touch, "
+					    "polling the event buffer\n");
+				}
+			}
+		}
+		(void)tsleep(&liuqin_touch_chan, PZERO, "liuqintouch", ticks);
+	}
+}
+
+static void
+liuqin_touch_reports_start(void)
+{
+	thread_t thread;
+
+	if (kernel_thread_start(liuqin_touch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("LIUQIN TOUCH: report thread not started\n");
+	}
+}
