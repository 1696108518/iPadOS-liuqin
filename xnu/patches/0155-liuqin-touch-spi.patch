+/* Pull whatever the RX FIFO holds into rx[].  Called while a command runs so
+ * that a transfer longer than the FIFO cannot overflow it. */
+static void
+tch_drain_rx(uint8_t *rx, size_t rxlen, size_t *rxgot)
+{
+	uint32_t wc = tch_rd(tch.se, SE_GENI_RX_FIFO_STATUS) & RX_FIFO_WC_MSK;
+
+	while (wc-- > 0) {
+		const uint32_t word = tch_rd(tch.se, SE_GENI_RX_FIFOn);
+		for (uint32_t b = 0; b < tch.bytes_per_fifo_word; b++) {
+			if (*rxgot < rxlen) {
+				rx[(*rxgot)++] = (uint8_t)(word >> (8 * b));
+			}
+		}
+	}
+}
+
+static uint32_t
+tch_status(void)
+{
+	return tch_rd(tch.se, SE_GENI_M_IRQ_STATUS);
+}
+
+/* Issue one M_CMD0 opcode and wait for it, feeding the TX FIFO from tx[] and
+ * draining the RX FIFO into rx[] meanwhile.  Returns the final
+ * M_IRQ_STATUS; M_CMD_DONE_EN set means the command completed. */
+static uint32_t
+tch_run_cmd(uint32_t cmd, const uint8_t *tx, size_t txlen,
+    uint8_t *rx, size_t rxlen, size_t *rxgot, unsigned ms)
+{
+	const uint32_t errs = M_CMD_OVERRUN_EN | M_ILLEGAL_CMD_EN |
+	    M_CMD_FAILURE_EN | M_CMD_CANCEL_EN | M_CMD_ABORT_EN |
+	    M_RX_FIFO_RD_ERR_EN | M_RX_FIFO_WR_ERR_EN |
+	    M_TX_FIFO_RD_ERR_EN | M_TX_FIFO_WR_ERR_EN;
+	size_t txdone = 0;
+	uint32_t irq = 0;
+
+	tch_wr(tch.se, SE_GENI_M_CMD0, cmd);
+	for (unsigned i = 0; i < ms * 20; i++) {
+		if (tx != NULL && txdone < txlen) {
+			const uint32_t wc = tch_rd(tch.se, SE_GENI_TX_FIFO_STATUS) & TX_FIFO_WC_MSK;
+			uint32_t room = tch.tx_fifo_depth > wc ? tch.tx_fifo_depth - wc : 0;
+
+			while (room > 0 && txdone < txlen) {
+				uint32_t word = 0;
+
+				for (uint32_t b = 0; b < tch.bytes_per_fifo_word && txdone < txlen; b++) {
+					word |= (uint32_t)tx[txdone++] << (8 * b);
+				}
+				tch_wr(tch.se, SE_GENI_TX_FIFOn, word);
+				room--;
+			}
+		}
+		if (rx != NULL) {
+			tch_drain_rx(rx, rxlen, rxgot);
+		}
+		irq = tch_status();
+		if (irq & (M_CMD_DONE_EN | errs)) {
+			break;
+		}
+		delay(50);
+	}
+	if (rx != NULL) {
+		tch_drain_rx(rx, rxlen, rxgot);
+	}
+	tch_wr(tch.se, SE_GENI_M_IRQ_CLEAR, irq ? irq : 0xffffffff);
+	tch.last_irq = irq;
+	return irq;
+}
