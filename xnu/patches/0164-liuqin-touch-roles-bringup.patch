+/* Novatek write: page, then the address with bit 7 set and the data. */
+static int
+tch_nvt_write8(uint32_t addr, uint8_t val)
+{
+	uint8_t page[3];
+	uint8_t tx[2];
+	int err;
+
+	page[0] = 0xff;
+	page[1] = (uint8_t)((addr >> 15) & 0xff);
+	page[2] = (uint8_t)((addr >> 7) & 0xff);
+	tx[0] = (uint8_t)((addr & 0x7f) | 0x80);
+	tx[1] = val;
+	if (tch_cs(true) != 0) {
+		return -1;
+	}
+	err = tch_xfer(page, NULL, sizeof(page));
+	if (err == 0) {
+		err = tch_xfer(tx, NULL, sizeof(tx));
+	}
+	if (tch_cs(false) != 0) {
+		err = -1;
+	}
+	return err;
+}
+
+/* The vendor driver's bring-up, in its order: bootloader reset, software reset
+ * to idle, unlock.  It is what it does before trusting the bus when the id does
+ * not match, and the NT36532 answers it from ROM even when the RAM firmware is
+ * not running. */
+static void
+tch_nvt_bringup(void)
+{
+	(void)tch_nvt_write8(0x00000, 0x69);            /* bootloader reset */
+	delay(40 * 1000);
+	(void)tch_nvt_write8(0x00000, 0xa5);            /* software reset idle */
+	delay(20 * 1000);
+	(void)tch_nvt_write8(0x00000, 0x35);            /* unlock */
+	delay(20 * 1000);
+}
