+    /* The ladder's a6xx_gmu_resume tail: the initial GX perf/bandwidth vote
+     * (HFI 30) that makes the GMU raise the GPU's own (GX) domain.  Without it
+     * the core stays off and every GPU register reads zero even though the
+     * startup sequence was acknowledged.  Payload order is the ladder's:
+     * 0, blocking ack, perf level 1 (220 MHz), bandwidth level 3. */
+    {
+        const uint32_t vote[4]={0,1,1,3};
+        status=hfi_exchange(d,c,limits,30,vote,4,output,16,&returned,&wire,&r->protocol,&r->load);
+        if(wire)++r->protocol.published_commands;
+        if(status!=ShengGmuSuccess)goto failed;
+        status=hfi_health(d,&r->load);
+        if(status!=ShengGmuSuccess)goto failed;
+    }
     d->startup.completed=1;r->protocol_status=AdrenoHfiStartupSuccess;
     r->protocol.stage=AdrenoHfiStageComplete;
     if(d->services.now_us(d->services.cookie,&now) || now<begin)return ShengGmuClockError;
