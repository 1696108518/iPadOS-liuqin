+/* Whole 4 KiB pages around the touched range: the maintenance helper refuses
+ * unaligned extents, and these buffers are page mapped either way. */
+static int maintainPhysical(uint64_t physical,size_t bytes,NativeAdrenoCacheOperation op)
+{
+    if(!physical || !bytes)return 1;
+    const uint64_t first=physical&~UINT64_C(0xfff);
+    const uint64_t end=(physical+bytes+0xfff)&~UINT64_C(0xfff);
+    return NativeAdrenoMaintainPhysicalPages(first,size_t(end-first),op)?1:0;
+}
+int NativeAdrenoGpuService::gpu_ring_publish(void *cookie,const volatile uint32_t *words,size_t bytes)
+{
+    GpuCtxCache *cache=static_cast<GpuCtxCache *>(cookie);
+    if(!cache || !words || !bytes)return 1;
+    const uintptr_t at=reinterpret_cast<uintptr_t>(words);
+    if(at<cache->ring_va || at-cache->ring_va>cache->ring_bytes ||
+        bytes>cache->ring_bytes-(at-cache->ring_va))return 1;
+    return maintainPhysical(cache->ring_phys+(at-cache->ring_va),bytes,NativeAdrenoClean);
+}
+int NativeAdrenoGpuService::gpu_fence_acquire(void *cookie,volatile uint32_t *words,size_t bytes)
+{
+    GpuCtxCache *cache=static_cast<GpuCtxCache *>(cookie);
+    if(!cache || !words || !bytes)return 1;
+    const uintptr_t at=reinterpret_cast<uintptr_t>(words);
+    if(at<cache->fence_va || at-cache->fence_va>cache->fence_bytes ||
+        bytes>cache->fence_bytes-(at-cache->fence_va))return 1;
+    return maintainPhysical(cache->fence_phys+(at-cache->fence_va),bytes,NativeAdrenoInvalidate);
+}
