+		 * while the previous one was still clocking - the panel saw half a
+		 * transaction (garbage IDs) and every second command died with
+		 * M_CMD_OVERRUN (irq 0x2).  M_CMD_DONE is the end of the shift. */
+		if (irq & M_CMD_DONE_EN) {
 			break;
 		}
