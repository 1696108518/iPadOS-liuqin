+/*
+ * Record layout of this part, from the vendor module's nvt_ts_work_func: the
+ * records start at the event buffer itself (stride 6), byte 0 is
+ * (id << 3) | event, and x and y are big-endian 16-bit values at +1 and +3 -
+ * not the packed x/y of the older nt36xxx parts.  The vendor also rejects
+ * event 0 and anything above 2 (3 is a release, reported through the slot
+ * tracking instead).
+ */
+static unsigned
+tch_rec_id(const uint8_t *frame, int i)
+{
+	return frame[6 * i] >> 3;
+}
+
+static unsigned
+tch_rec_event(const uint8_t *frame, int i)
+{
+	return frame[6 * i] & 7u;
+}
+
+static unsigned
+tch_rec_x(const uint8_t *frame, int i)
+{
+	return ((unsigned)frame[6 * i + 1] << 8) | frame[6 * i + 2];
+}
+
+static unsigned
+tch_rec_y(const uint8_t *frame, int i)
+{
+	return ((unsigned)frame[6 * i + 3] << 8) | frame[6 * i + 4];
+}
