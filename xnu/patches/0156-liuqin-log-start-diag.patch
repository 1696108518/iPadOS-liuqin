Report the persistent-log start inputs (liuqinlog on, device writable,
partition bounds, ring base override) and the kernel_thread_start result through
the mute gate: the ring has never flushed on this port and the flush thread's own
line is too late to explain why.
---
--- a/bsd/dev/liuqin_ufs.c
+++ b/bsd/dev/liuqin_ufs.c
@@ -2141,8 +2141,19 @@
 {
 	uint32_t on = 1;
 	thread_t thread;
+	kern_return_t kr;
 
 	PE_parse_boot_argn("liuqinlog", &on, sizeof(on));
+	{
+		/* LIUQIN: the ring has never flushed on this port; report the exact
+		 * inputs and the thread result on the panel (forced through the mute
+		 * gate) so one boot answers why. */
+		extern int liuqin_console_force;
+		liuqin_console_force = 1;
+		printf("LIUQIN LOGSTART: on=%u rw=%d first=0x%llx nblocks=0x%llx ovr=0x%llx\n",
+		    on, su.writable, su.first_block, su.nblocks, liuqin_log_base_override);
+		liuqin_console_force = 0;
+	}
 	if (!on || !su.writable || su.nblocks < 2 * LIUQIN_LOG_BLOCKS) {
 		return;
 	}
@@ -2151,7 +2162,14 @@
 	if (liuqin_log_secs == 0 || liuqin_log_secs > 60) {
 		liuqin_log_secs = LIUQIN_LOG_SECS;
 	}
-	if (kernel_thread_start(liuqin_log_thread, NULL, &thread) == KERN_SUCCESS) {
+	kr = kernel_thread_start(liuqin_log_thread, NULL, &thread);
+	{
+		extern int liuqin_console_force;
+		liuqin_console_force = 1;
+		printf("LIUQIN LOGSTART: thread_start=0x%x\n", kr);
+		liuqin_console_force = 0;
+	}
+	if (kr == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
 	liuqin_wdt_start();
