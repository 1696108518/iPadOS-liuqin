+		    "%02x %02x %02x %02x %02x %02x | page %02x %02x %02x %02x%s\n",
 		    n, tch.pin_cs, tch.pin_clk, tch.pin_mosi, tch.pin_miso,
 		    id[0], id[1], id[2], id[3], id[4], id[5],
-		    fw[0], fw[1], fw[2], fw[3], ok ? "  <-- ANSWER" : "");
+		    old[0], old[1], old[2], old[3], ok ? "  <-- ANSWER" : "");
 	} else {
 		printf("LIUQIN TOUCH: %s: cs gpio%u clk gpio%u mosi gpio%u miso gpio%u -> "
-		    "%02x %02x %02x %02x %02x %02x | fw %02x %02x %02x %02x%s\n",
+		    "%02x %02x %02x %02x %02x %02x | page %02x %02x %02x %02x%s\n",
