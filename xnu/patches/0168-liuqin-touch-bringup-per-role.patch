  * qup_spi4_cs group) and stays one. */
+/* The vendor driver's chip-info page; the SPI trim id sits at 0x3f004, and
+ * older parts answer on the page address instead. */
+#define NVT_CHIP_INFO_PAGE      0x1f64eu
+
 /* One trim-id + FWINFO read with the current role assignment. */
 static int
 tch_probe_roles(const char *what, unsigned n)
 {
 	uint8_t id[6] = { 0 };
+	uint8_t old[6] = { 0 };
 	uint8_t fw[16] = { 0 };
 
 	(void)tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id));
 	(void)tch_nvt_read(NVT_FWINFO_ADDR, fw, sizeof(fw));
-	const bool ok = (id[3] == 0x65 && id[4] == 0x03) ||
-	    (uint8_t)(fw[0] + fw[1]) == 0xff;
+	(void)tch_nvt_read(NVT_CHIP_INFO_PAGE, old, sizeof(old));
+	const bool id_ok = (id[3] == 0x65 && id[4] == 0x03) ||
+	    (old[3] == 0x65 && old[4] == 0x03) ||
+	    (id[0] != 0x00 && id[0] != 0xff) || (old[0] != 0x00 && old[0] != 0xff);
+	const bool ok = id_ok || (uint8_t)(fw[0] + fw[1]) == 0xff;
 
 	if (n != 0) {
 		printf("LIUQIN TOUCH: bitbang %u: cs gpio%u clk gpio%u mosi gpio%u miso gpio%u -> "
