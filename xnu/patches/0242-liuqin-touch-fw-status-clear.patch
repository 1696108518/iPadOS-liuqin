+/* The handshake byte the vendor clears in nvt_clear_fw_status(). */
+static uint8_t
+tch_fw_status_byte(void)
+{
+	uint8_t v = 0xff;
+
+	(void)tch_nvt_read(NVT_FW_STATUS_BYTE, &v, 1);
+	return v;
+}
+
+static unsigned tch_status_clears;
+
+static void
+tch_clear_fw_status(const char *why)
+{
+	uint8_t before = tch_fw_status_byte(), after = before;
+	unsigned i = 0;
+
+	for (i = 0; i < 20; i++) {
+		(void)tch_nvt_write8(NVT_FW_STATUS_BYTE, 0x00);
+		after = tch_fw_status_byte();
+		if (after == 0x00) {
+			break;
+		}
+		delay(10 * 1000);
+	}
+	printf("LIUQIN TOUCH: %s: fw status 0x51 0x%02x -> 0x%02x in %u clears\n",
+	    why, before, after, i + 1);
+}
+
