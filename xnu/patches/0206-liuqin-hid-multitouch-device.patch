  * kIOReturnUnsupported but logs the selector, so one boot tells us exactly the
@@ -672,10 +699,10 @@
 	}
 
 	{
-		IOHIDDevice *dev = OSTypeAlloc(IOHIDDevice);
+		AppleMultitouchDevice *dev = OSTypeAlloc(AppleMultitouchDevice);
 
 		if (dev && dev->init() && dev->attach(nub) && dev->start(nub)) {
-			IOLog("LIUQIN HID: IOHIDDevice stub relaunched\n");
+			IOLog("LIUQIN HID: multitouch device relaunched\n");
 		} else if (dev) {
 			dev->release();
