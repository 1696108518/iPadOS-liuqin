 /*
+ * Apple's digitizer on iOS is an IOHIDDevice subclass called
+ * AppleMultitouchDevice (vendor usage page 0xff00 / usage 0xf).  Matching only
+ * "IOHIDDevice" is not enough for backboardd's HID stack, so the stub is
+ * published under that class name - one boot shows whether the class name is
+ * what the digitizer client waits for.
+ */
+class AppleMultitouchDevice : public IOHIDDevice
+{
+	OSDeclareDefaultStructors(AppleMultitouchDevice)
+
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMultitouchDevice, IOHIDDevice)
+
+bool
+AppleMultitouchDevice::start(IOService *provider)
+{
+	if (!IOHIDDevice::start(provider)) {
+		return false;
+	}
+	IOLog("LIUQIN HID: AppleMultitouchDevice started (0xff00/0xf)\n");
+	return true;
+}
+
+/*
  * Placesholder user client for the 'HID' connect type (0x00484944,
