+/* The QUP's DMA master reaches memory through the wrapper's AHB port.  Its
+ * register interface can look perfectly alive - every SE read answers - while
+ * that port is gated, and then the engine's first transaction never completes
+ * and the interconnect hangs with no panic.  The wrapper's clocks are bits
+ * 6..9 of GCC_QUPV3_WRAP0_CBCR (clk-qcom: one branch per clock, all
+ * BRANCH_HALT_VOTED), and the bit-banged path never needed any of them.
+ * Read, enable what is missing, read back.  liuqintouchqupclk=0 skips it. */
+static void
+tch_qup_dma_clocks(void)
+{
+	const uint32_t off = GCC_QUPV3_WRAP0_CBCR - 0x62000u;
+	const uint32_t want = QUP_CBCR_M_AHB | QUP_CBCR_S_AHB |
+	    QUP_CBCR_CORE | QUP_CBCR_CORE_2X;
+	int on = 1;
+	vm_offset_t gcc;
+	uint32_t v;
 
+	(void)PE_parse_boot_argn("liuqintouchqupclk", &on, sizeof(on));
+	if (on <= 0) {
+		printf("LIUQIN TOUCH: QUP DMA clocks left as they are\n");
+		return;
+	}
+	gcc = ml_io_map(GCC_PA + 0x62000u, 0x4000u);
+	if (gcc == 0) {
+		printf("LIUQIN TOUCH: GCC 0x%x map failed\n", GCC_PA + 0x62000u);
+		return;
+	}
+	v = tch_rd(gcc, off);
+	printf("LIUQIN TOUCH: QUP CBCR 0x%08x [m_ahb %d s_ahb %d core %d core2x %d "
+	    "s4 %d]\n", v, (v & QUP_CBCR_M_AHB) != 0, (v & QUP_CBCR_S_AHB) != 0,
+	    (v & QUP_CBCR_CORE) != 0, (v & QUP_CBCR_CORE_2X) != 0,
+	    (v & QUP_CBCR_S4) != 0);
+	if ((v & want) != want) {
+		tch_wr(gcc, off, v | want);
+		printf("LIUQIN TOUCH: QUP CBCR forced 0x%08x -> 0x%08x (AHB master for DMA)\n",
+		    v, tch_rd(gcc, off));
+	}
+}
