+/*
+ * qsmmu writes S2CR TYPE=BYPASS as TYPE=FAULT (measured: 0x00010000 came back
+ * 0x00020000), which is why the "just bypass the stream" plan can never work
+ * here.  Linux' arm-smmu-qcom handles the same quirk by reserving a context
+ * bank, setting CBAR to S1_TRANS_S2_BYPASS with SCTLR=0, and pointing the
+ * stream at that bank with TYPE=TRANS.  Do the same and return the bank, or
+ * 0xff when the geometry or the accesses do not work out.
+ *
+ * Geometry from IDR1 (arm-smmu.h): PAGESIZE bit31, NUMPAGENDXB [30:28],
+ * NUMCB [7:0]; GR1 page = 1 << pgshift, CBAR(n) = GR1 + 4*n,
+ * CB(n) = (numpage + n) << pgshift.
+ */
+static unsigned
+tch_smmu_bypass_cb(vm_offset_t gr0)
+{
+	int enable = 1;
+	uint32_t idr1, pgshift, numpage, ncb, cbndx, gr1_off, cb_off;
+	vm_offset_t gr1, cb;
+
+	(void)PE_parse_boot_argn("liuqintouchbypass", &enable, sizeof(enable));
+	if (enable <= 0) {
+		printf("LIUQIN TOUCH: SMMU bypass CB disabled by boot arg\n");
+		return 0xffu;
+	}
+	idr1 = tch_rd(gr0, SMMU_IDR1);
+	pgshift = (idr1 & (1u << 31)) ? 16u : 12u;
+	numpage = 1u << (((idr1 >> 28) & 7u) + 1u);
+	ncb = idr1 & 0xffu;
+	cbndx = (ncb > 1u) ? ncb - 1u : 77u;
+	gr1_off = (1u << pgshift);
+	cb_off = (numpage + cbndx) << pgshift;
+	printf("LIUQIN TOUCH: SMMU quirk: idr1 0x%08x (pgshift %u, numpage %u, numcb %u)"
+	    " -> bypass CB %u, CBAR at +0x%x, CB at +0x%x\n",
+	    idr1, pgshift, numpage, ncb, cbndx, gr1_off + 4u * cbndx, cb_off);
+	if (cb_off >= 0x100000u || gr1_off >= 0x100000u) {
+		/* The device tree says the block is 1 MiB; a CB outside it means the
+		 * IDR1 geometry is not what we think, so do not poke it. */
+		printf("LIUQIN TOUCH: SMMU CB/CBAR outside the 1 MiB block; not touching it\n");
+		return 0xffu;
+	}
+
+	gr1 = ml_io_map(APPS_SMMU_PA + gr1_off, PAGE_SIZE);
+	cb = ml_io_map(APPS_SMMU_PA + cb_off, PAGE_SIZE);
+	if (gr1 == 0 || cb == 0) {
+		printf("LIUQIN TOUCH: SMMU cannot map CBAR/CB (0x%llx/0x%llx)\n",
+		    (uint64_t)gr1, (uint64_t)cb);
+		return 0xffu;
+	}
+	printf("LIUQIN TOUCH: SMMU CBAR 0x%08x SCTLR 0x%08x (before)\n",
+	    tch_rd(gr1, 4u * cbndx), tch_rd(cb, 0));
+	tch_wr(gr1, 4u * cbndx, CBAR_TYPE_S1_S2_BYPASS << 16);
+	tch_wr(cb, 0, 0);
+	printf("LIUQIN TOUCH: SMMU CBAR 0x%08x SCTLR 0x%08x (after)\n",
+	    tch_rd(gr1, 4u * cbndx), tch_rd(cb, 0));
+	return cbndx;
+}
