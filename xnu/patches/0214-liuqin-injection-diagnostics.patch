+/*
+ * Does the flashed root really carry the injected library and the plist that
+ * asks for it?  Nothing in user space can tell us until the library runs, so the
+ * kernel looks (vnode_lookup + a size query) and says so in the log.
+ */
+static void
+tch_probe_injection_files(void)
+{
+	static const char *const paths[] = {
+		"/usr/lib/libliuqintouch.dylib",
+		"/System/Library/LaunchDaemons/com.apple.backboardd.plist",
+	};
+
+	for (unsigned i = 0; i < sizeof(paths) / sizeof(paths[0]); i++) {
+		vnode_t vp = NULLVP;
+		struct vnode_attr va;
+		errno_t err = vnode_lookup(paths[i], 0, &vp, vfs_context_current());
+
+		if (err != 0 || vp == NULLVP) {
+			printf("LIUQIN INPUT: %s missing (%d)\n", paths[i], err);
+			continue;
+		}
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_data_size);
+		if (vnode_getattr(vp, &va, vfs_context_current()) == 0) {
+			printf("LIUQIN INPUT: %s present, %lld bytes\n", paths[i],
+			    (long long)va.va_data_size);
+		}
+		vnode_put(vp);
+	}
+}
