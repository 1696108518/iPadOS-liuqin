--- a/bsd/dev/liuqin_ufs.c
+++ b/bsd/dev/liuqin_ufs.c
@@ -1829,6 +1829,12 @@
 #define LIUQIN_LOG_SIZE          (4u << 20)
 #define LIUQIN_LOG_BLOCKS        (1 + LIUQIN_LOG_SIZE / UFS_BLOCK)
 
+/* liuqinlogblk=N pins the ring at device block N instead of the last 4 MiB
+ * of the partition.  Both the previous-boot tail dump and the flush thread
+ * use it: the default end-of-partition block is unreadable on this port and
+ * the dump's hung read kept the flush thread from ever writing a header. */
+uint64_t liuqin_log_base_override;
+
 #include <libkern/crypto/sha2.h>
 
 /*
