32-bit liuqinlogblk plus a raw probe block.  The 8-byte PE_parse_boot_argn
path stored garbage (observed ovr=0x8), and the default ring base is
first_block + nblocks - 1025 where nblocks comes out ~8x the partition, so the
base lands past the end of the device and every flush fails.  With a 32-bit
override the caller pins the ring inside userdata, and the probe block records
the start inputs where recovery can read them.
---
--- a/bsd/dev/liuqin_ufs.c
+++ b/bsd/dev/liuqin_ufs.c
@@ -1829,6 +1829,10 @@
 #define LIUQIN_LOG_SIZE          (4u << 20)
 #define LIUQIN_LOG_BLOCKS        (1 + LIUQIN_LOG_SIZE / UFS_BLOCK)
 
+/* liuqinlogblk=N (32-bit device block) pins the ring; the 8-byte
+ * PE_parse_boot_argn path stored garbage on this kernel. */
+uint32_t liuqin_log_base_override;
+
 #include <libkern/crypto/sha2.h>
 
 /*
@@ -1992,7 +1996,8 @@
 liuqin_log_thread(__unused void *arg, __unused wait_result_t wr)
 {
 	liuqin_log_dump();
-	uint64_t base = su.first_block + su.nblocks - LIUQIN_LOG_BLOCKS;
+	uint64_t base = liuqin_log_base_override ? liuqin_log_base_override :
+	    su.first_block + su.nblocks - LIUQIN_LOG_BLOCKS;
 	uint64_t flushed = 0, seq = 0;
 	void *bounce = (void *)(su.dma + DMA_BOUNCE);
 
@@ -2049,7 +2054,8 @@
 static void
 liuqin_log_dump(void)
 {
-	uint64_t base = su.first_block + su.nblocks - LIUQIN_LOG_BLOCKS;
+	uint64_t base = liuqin_log_base_override ? liuqin_log_base_override :
+	    su.first_block + su.nblocks - LIUQIN_LOG_BLOCKS;
 	void *bounce = (void *)(su.dma + DMA_BOUNCE);
 	struct liuqin_log_header *h = (struct liuqin_log_header *)bounce;
 	uint32_t want = 4000;
@@ -2147,12 +2153,39 @@
 		return;
 	}
 	PE_parse_boot_argn("ufslogsecs", &liuqin_log_secs, sizeof(liuqin_log_secs));
+	PE_parse_boot_argn("liuqinlogblk", &liuqin_log_base_override,
+	    sizeof(liuqin_log_base_override));
 	PE_parse_boot_argn("liuqinra", &ra_enable, sizeof(ra_enable));
 	if (liuqin_log_secs == 0 || liuqin_log_secs > 60) {
 		liuqin_log_secs = LIUQIN_LOG_SECS;
 	}
-	if (kernel_thread_start(liuqin_log_thread, NULL, &thread) == KERN_SUCCESS) {
-		thread_deallocate(thread);
+	{
+		/*
+		 * LIUQIN probe: store the start inputs as one raw block at
+		 * liuqinlogblk+64 so recovery can dd them back; the panel prints
+		 * happen before the framebuffer console exists.
+		 */
+		kern_return_t kr = KERN_FAILURE;
+		void *bounce = (void *)(su.dma + DMA_BOUNCE);
+		if (liuqin_log_base_override) {
+			int pe;
+			bzero(bounce, UFS_BLOCK);
+			snprintf((char *)bounce, UFS_BLOCK,
+			    "LIUQINPROBE on=1 rw=%d first=0x%llx nblocks=0x%llx ovr=0x%x\n",
+			    su.writable, su.first_block, su.nblocks,
+			    liuqin_log_base_override);
+			pe = ufs_write_blocks((uint64_t)liuqin_log_base_override + 64, 1);
+			if (pe == 0) {
+				pe = ufs_sync_cache();
+			}
+			kr = (kern_return_t)pe;
+		}
+		if (kernel_thread_start(liuqin_log_thread, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+			if (liuqin_log_base_override) {
+				kr = KERN_SUCCESS;
+			}
+		}
 	}
 	liuqin_wdt_start();
 }
