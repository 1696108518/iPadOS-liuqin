+	printf("LIUQIN LOG: ring at block 0x%llx (first 0x%llx nblocks 0x%llx ovr 0x%llx)\n",
+	    base, su.first_block, su.nblocks, liuqin_log_base_override);
+	liuqin_console_force = 0;
