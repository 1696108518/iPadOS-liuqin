+	(void)PE_parse_boot_argn("liuqintouchdmaif", &on, sizeof(on));
+	before = tch_rd(tch.se, SE_DMA_IF_EN);
+	printf("LIUQIN TOUCH: SE4 clk_ctrl 0x%08x dma_if_en 0x%08x (ro 0x%08x) "
+	    "fifo_if_disable 0x%08x gsi_ev 0x%08x\n", tch_rd(tch.se, SE_GENI_CLK_CTRL),
+	    before, tch_rd(tch.se, DMA_IF_EN_RO), tch_rd(tch.se, SE_FIFO_IF_DISABLE),
+	    tch_rd(tch.se, SE_GSI_EVENT_EN));
+	if (on <= 0 || (before & DMA_IF_EN)) {
+		return;
+	}
+	tch_wr(tch.se, SE_DMA_IF_EN, before | DMA_IF_EN);
+	after = tch_rd(tch.se, SE_DMA_IF_EN);
+	printf("LIUQIN TOUCH: SE4 dma_if_en 0x%08x -> 0x%08x (%s)\n", before, after,
+	    (after & DMA_IF_EN) ? "set" : "write ignored");
