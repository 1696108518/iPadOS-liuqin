--- a/bsd/dev/liuqin_usb.c
+++ b/bsd/dev/liuqin_usb.c
@@ -44,20 +44,36 @@
 
 #define GCC_PA                  0x00100000
 #define GCC_SIZE                0x00090000
-#define GCC_USB30_PRIM_GDSCR    0x0f004         /* bit 31: power on */
+/*
+ * SM8450 GCC offsets (Linux drivers/clk/qcom/gcc-sm8450.c).  The first version
+ * of this table was sdmmagpie's - sweet's numbers - and writing them here
+ * gated unrelated clocks: the GPU ladder then took an external abort on its
+ * first CP register access.  usb30_prim_gdsc is at 0x49004 and the branches sit
+ * in the same 0x49xxx block.
+ */
+#define GCC_USB30_PRIM_GDSCR    0x49004         /* bit 31: power on */
 #define CBCR_CLK_OFF            (1u << 31)
 
+enum {
+	USB_CLK_MASTER, USB_CLK_SLEEP, USB_CLK_MOCK_UTMI, USB_CLK_CFG_NOC,
+	USB_CLK_AGGRE, USB_CLK_PHY_AUX, USB_CLK_PHY_COM_AUX, USB_CLK_PHY_PIPE,
+	USB_CLK_REF_USB3, USB_CLK_REF_EUSB3, USB_CLK_COUNT
+};
+
 static const struct {
 	const char *name;
 	uint32_t    off;
-} usb_cbcr[] = {
-	{ "master", 0x0f010 },
-	{ "sleep", 0x0f014 },
-	{ "utmi", 0x0f018 },
-	{ "cfg-noc-axi", 0x0502c },
-	{ "aggre-axi", 0x8201c },
-	{ "ahb2phy", 0x6a004 },
-	{ "clkref", 0x8c010 },
+} usb_cbcr[USB_CLK_COUNT] = {
+	[USB_CLK_MASTER]        = { "master", 0x49018 },
+	[USB_CLK_SLEEP]         = { "sleep", 0x49020 },
+	[USB_CLK_MOCK_UTMI]     = { "mock-utmi", 0x49024 },
+	[USB_CLK_CFG_NOC]       = { "cfg-noc-axi", 0x49084 },
+	[USB_CLK_AGGRE]         = { "aggre-axi", 0x49088 },
+	[USB_CLK_PHY_AUX]       = { "phy-aux", 0x4905c },
+	[USB_CLK_PHY_COM_AUX]   = { "phy-com-aux", 0x49060 },
+	[USB_CLK_PHY_PIPE]      = { "phy-pipe", 0x49064 },
+	[USB_CLK_REF_USB3]      = { "clkref-usb3", 0x9c010 },
+	[USB_CLK_REF_EUSB3]     = { "clkref-eusb3", 0x9c00c },
 };
 
 #define DWC3_PA                 0x0a600000
@@ -108,7 +124,7 @@
 		if (!(cbcr[i] & CBCR_CLK_OFF)) {
 			continue;
 		}
-		if (usb_cbcr[i].off == 0x8c010) {
+		if (usb_cbcr[i].off == 0x9c010 || usb_cbcr[i].off == 0x9c00c) {
 			continue;   /* stays on from ABL; not ours to gate */
 		}
 		usb_wr(gcc, usb_cbcr[i].off, (cbcr[i] & ~CBCR_CLK_OFF) | 1u);
@@ -155,7 +171,7 @@
 	/* DWC3 registers need the GDSC, the master clock and the config-NoC path.
 	 * When starting the device, raise them first instead of giving up: after
 	 * `fastboot boot` ABL has collapsed the domain. */
-	clocks_on = (gdscr & (1u << 31)) && !(cbcr[0] & CBCR_CLK_OFF) && !(cbcr[3] & CBCR_CLK_OFF);
+	clocks_on = (gdscr & (1u << 31)) && !(cbcr[USB_CLK_MASTER] & CBCR_CLK_OFF) && !(cbcr[USB_CLK_CFG_NOC] & CBCR_CLK_OFF);
 	if (!clocks_on && enabled >= 2) {
 		const unsigned count = sizeof(usb_cbcr) / sizeof(usb_cbcr[0]);
 		if (!usb_power_up(gcc, gdscr, cbcr, count)) {
@@ -166,7 +182,7 @@
 		for (unsigned i = 0; i < count; i++) {
 			cbcr[i] = usb_rd(gcc, usb_cbcr[i].off);
 		}
-		clocks_on = (gdscr & (1u << 31)) && !(cbcr[0] & CBCR_CLK_OFF) && !(cbcr[3] & CBCR_CLK_OFF);
+		clocks_on = (gdscr & (1u << 31)) && !(cbcr[USB_CLK_MASTER] & CBCR_CLK_OFF) && !(cbcr[USB_CLK_CFG_NOC] & CBCR_CLK_OFF);
 	}
 	if (!clocks_on) {
 		printf("LIUQIN USB: controller unpowered or unclocked; DWC3 not read\n");
@@ -205,7 +221,7 @@
 		printf("LIUQIN USB: QUSB2 PHY probe skipped (liuqinusbphy=1 to try)\n");
 		return;
 	}
-	if (cbcr[5] & CBCR_CLK_OFF) {
+	if (cbcr[USB_CLK_PHY_PIPE] & CBCR_CLK_OFF) {
 		printf("LIUQIN USB: ahb2phy clock off; QUSB2 PHY not read\n");
 		return;
 	}
