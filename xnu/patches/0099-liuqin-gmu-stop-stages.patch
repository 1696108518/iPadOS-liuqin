     const ShengGmuMemory *memory[]={&c->icache,&c->dummy,&c->debug,&c->log};
@@ -160,6 +166,7 @@ ShengGmuStatus ShengGmuLoadAndStartHfi(ShengGmuDevice *d,const ShengGmuConfig *c
             if(value!=le32(c->firmware+b->payload_offset+at)) {status=ShengGmuStateMismatch;goto failed;}
         }
     }
+    if(sheng_gmu_stop_stage==3) {sheng_gmu_stopped_at=3;return ShengGmuStateMismatch;}
