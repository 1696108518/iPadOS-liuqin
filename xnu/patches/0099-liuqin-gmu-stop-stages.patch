 #include "ShengGmuSource.h"
+/* liuqin port: sheng-gpu-stop=N returns after stage N without any cleanup
+ * write, to bisect a board reset in the write path. */
+volatile uint32_t sheng_gmu_stop_stage;
+volatile uint32_t sheng_gmu_stopped_at;
 #if !defined(__aarch64__) || __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
 #error sheng GMU requires little-endian AArch64
@@ -116,11 +120,13 @@ ShengGmuStatus ShengGmuLoadAndStartHfi(ShengGmuDevice *d,const ShengGmuConfig *c
         if(write32(d,w->window,w->byte_offset,w->value,r)) {status=ShengGmuIoError;goto failed;}
     }
     if(d->io.barrier(d->io.cookie)) {status=ShengGmuIoError;goto failed;}
+    if(sheng_gmu_stop_stage==1) {sheng_gmu_stopped_at=1;return ShengGmuStateMismatch;}
     if(core_write(d,REG_GPU_GMU_CX_GMU_CX_FALNEXT_INTF,1,r) ||
         core_write(d,REG_GPU_GMU_CX_GMU_CX_FAL_INTF,1,r) ||
         write32(d,ShengGmuCxMisc,REG_CX_MISC_TCM_RET_CNTL*4,1,r)) {status=ShengGmuIoError;goto failed;}
     if(d->io.barrier(d->io.cookie) || read32(d,ShengGmuCxMisc,REG_CX_MISC_TCM_RET_CNTL*4,&value,r)) {status=ShengGmuIoError;goto failed;}
     if(value!=1) {status=ShengGmuStateMismatch;goto failed;}
+    if(sheng_gmu_stop_stage==2) {sheng_gmu_stopped_at=2;return ShengGmuStateMismatch;}
     /* All shared allocations are real owned coherent memory, not simulated
