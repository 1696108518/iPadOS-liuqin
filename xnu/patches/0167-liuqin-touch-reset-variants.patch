+/* Configure the four pads for one role assignment (CS left deasserted). */
+static void
+tch_roles(uint32_t cs, uint32_t clk, uint32_t mosi, uint32_t miso)
+{
+	tch.pin_cs = cs;
+	tch.pin_clk = clk;
+	tch.pin_mosi = mosi;
+	tch.pin_miso = miso;
+	tch_bb_dir(tch.pin_cs, true, tch.cs_high ? 0 : 1);
+	tch_bb_dir(tch.pin_clk, true, 0);
+	tch_bb_dir(tch.pin_mosi, true, 0);
+	tch_bb_dir(tch.pin_miso, false, 0);
+}
+
+/* Every pad can be the chip select, the other three take the six
+ * clk/mosi/miso orders. */
+static int
+tch_sweep(bool cs_high, unsigned *combos)
+{
 	static const uint32_t pads[4] = { 16, 17, 18, 19 };
 	static const uint8_t perm[6][3] = {
 		{ 0, 1, 2 }, { 0, 2, 1 }, { 1, 0, 2 },
 		{ 1, 2, 0 }, { 2, 0, 1 }, { 2, 1, 0 },
 	};
+
+	tch.cs_high = cs_high;
+	if (cs_high) {
+		printf("LIUQIN TOUCH: sweeping again with chip select active high\n");
+	}
+	for (unsigned cs = 0; cs < 4; cs++) {
+		uint32_t data[3];
+		unsigned n = 0;
+
+		for (unsigned i = 0; i < 4; i++) {
+			if (i != cs) {
+				data[n++] = pads[i];
+			}
+		}
+		for (unsigned p = 0; p < 6; p++) {
+			tch_roles(pads[cs], data[perm[p][0]], data[perm[p][1]], data[perm[p][2]]);
+			(*combos)++;
+			if (tch_probe_roles("bitbang", *combos) == 0) {
+				return 0;
+			}
+		}
+	}
+	return -1;
+}
