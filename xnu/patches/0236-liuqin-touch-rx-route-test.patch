+/*
+ * touch166: one place that answers "can this engine receive at all".
+ *
+ * touch165 proved the receive side is the only broken half: the transmit DMA
+ * is byte exact on the wire, the panel answers, and yet every byte the engine
+ * reports as received is zero.  Two things can still be wrong - the pad is not
+ * the serial input the SPI firmware samples, or the engine's receive block is
+ * not enabled - and each has a different test:
+ *
+ *  A. duplex opcode 3 (what spi-geni-qcom builds) instead of 7 (what the
+ *     vendor firmware in this SE was flashed for);
+ *  B. SE_SPI_LOOPBACK, which feeds the engine's own MOSI straight back into
+ *     the receiver and bypasses the pad entirely: if loopback returns our
+ *     pattern, the receive path is good and only the pad is in the way;
+ *  C. the FIFO word count after a drain, printed by tch_rx_fifo_test().
+ *
+ * Returns true when a route returned the ROM trim id, and leaves that route
+ * selected for the rest of the boot.
+ */
+static bool
+tch_rx_route_test(void)
+{
+	static const unsigned opcodes[2] = { 7, 3 };
+	static const uint8_t pat[4] = { 0xde, 0xad, 0xbe, 0xef };
+	uint8_t id[6];
+	bool ok = false;
+	unsigned keep = 0;
+
+	tch_rx_via_fifo = 0;
+	for (unsigned i = 0; i < 2; i++) {
+		memset(id, 0, sizeof(id));
+		tch_opcode = (int)opcodes[i];
+		const int err = tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id));
+
+		printf("LIUQIN TOUCH: rx route A%u opcode %u: %02x %02x %02x %02x %02x %02x "
+		    "(%s)\n", i, opcodes[i], id[0], id[1], id[2], id[3], id[4], id[5],
+		    err != 0 ? "read failed" :
+		    (id[4] == 0x65 && id[5] == 0x03) ? "MATCH" : "no match");
+		if (err == 0 && id[4] == 0x65 && id[5] == 0x03 && !ok) {
+			ok = true;
+			keep = opcodes[i];
+		}
+	}
+
+	/* B: internal loopback.  The engine shifts its own MOSI back in, so the
+	 * answer is known exactly - 0xde 0xad 0xbe 0xef out, the same back. */
+	tch_opcode = (int)SPI_TX_RX;
+	tch_wr(tch.se, SE_SPI_LOOPBACK, 1);
+	{
+		uint8_t rb[4] = { 0 };
+		const int err = tch_dma_xfer(pat, rb, sizeof(pat));
+		const uint32_t irq = tch_rd(tch.se, SE_DMA_RX_IRQ_STAT);
+
+		printf("LIUQIN TOUCH: rx route B loopback tx de ad be ef -> rx %02x %02x %02x "
+		    "%02x (err %d, rx dma irq 0x%08x len_in %u fifo 0x%08x)\n",
+		    rb[0], rb[1], rb[2], rb[3], err, irq,
+		    tch_rd(tch.se, SE_DMA_RX_LEN_IN),
+		    tch_rd(tch.se, SE_GENI_RX_FIFO_STATUS));
+	}
+	tch_wr(tch.se, SE_SPI_LOOPBACK, 0);
+
+	tch_opcode = ok ? (int)keep : 0;
+	tch_rx_ok = ok;
+	return ok;
 }
 
