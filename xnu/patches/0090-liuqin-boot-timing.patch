+
+/* Boot-phase timestamps: "LIUQIN BOOT: <what> at N.nnn s" where N counts from
+ * reset (mach_absolute_time).  Printing costs nothing next to what it measures,
+ * and it is the only way to tell which phase a slow boot spends its time in
+ * without pulling the persistent log.  bootarg liuqinboot marks=0 hides them. */
+static int liuqin_boot_marks = 1;
+
+void
+liuqin_boot_mark(const char *what)
+{
+	static int parsed;
+	uint64_t ns = 0;
+	extern int liuqin_console_force;
+
+	if (!parsed) {
+		parsed = 1;
+		PE_parse_boot_argn("liuqinboot", &liuqin_boot_marks,
+		    sizeof(liuqin_boot_marks));
+	}
+	if (!liuqin_boot_marks) {
+		return;
+	}
+	static uint64_t last_ns;
+	uint64_t delta_ms = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	if (last_ns && ns > last_ns) {
+		delta_ms = (ns - last_ns) / 1000000ULL;
+	}
+	last_ns = ns;
+	/* Drawn even when liuqinmute=1: this is the boot's time axis.  The delta
+	 * makes a slow phase visible without subtracting screenfuls of numbers. */
+	liuqin_console_force = 1;
+	printf("LIUQIN BOOT: %s at %llu.%03llu s (+%llu ms)\n", what,
+	    ns / 1000000000ULL, (ns / 1000000ULL) % 1000ULL, delta_ms);
+	liuqin_console_force = 0;
+}
