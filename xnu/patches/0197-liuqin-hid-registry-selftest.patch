+/*
+ * Self-test for the registry side: run the same match backboardd runs
+ * (`IOProviderClass = IOService`, `IOPropertyMatch HIDServiceSupport = true`)
+ * from inside the kernel and report how many services it finds and whether
+ * ours are among them.  This also exercises matchPropertyTable(), which is the
+ * same hook a user-space match would hit.
+ */
+static void
+liuqin_hid_matchtest(void)
+{
+	OSDictionary *match = OSDictionary::withCapacity(2);
+	OSDictionary *props = OSDictionary::withCapacity(1);
+	OSString *cls = OSString::withCString("IOService");
+	unsigned count = 0, ours = 0;
+
+	if (match && props && cls) {
+		props->setObject("HIDServiceSupport", kOSBooleanTrue);
+		match->setObject("IOPropertyMatch", props);
+		match->setObject("IOProviderClass", cls);
+		OSIterator *it = IOService::getMatchingServices(match);
+		if (it) {
+			OSObject *obj;
+
+			while ((obj = it->getNextObject()) != NULL) {
+				count++;
+				if (obj == gLiuqinTouch || obj == gLiuqinButtons) {
+					ours++;
+				}
+			}
+			it->release();
+		}
+	}
+	IOLog("LIUQIN HID: selftest: HIDServiceSupport match found %u services, %u ours\n",
+	    count, ours);
+	OSSafeReleaseNULL(match);
+	OSSafeReleaseNULL(props);
+	OSSafeReleaseNULL(cls);
+}
+
