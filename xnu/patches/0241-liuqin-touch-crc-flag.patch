@@ -2862,6 +2862,11 @@
 #define NVT_TX_AUTO_COPY_VAL    0x56u           /* hw_crc == 2 in the vendor module */
 #define NVT_SPI_DMA_TX_INFO     0x1fc914u      /* map+144 */
 #define NVT_SW_RESET_ADDR       0x1fb43eu      /* swrst_sif, vendor dmesg */
+/* crc_err_flag_addr=0x1fb535 in the vendor's own dmesg (NT36523's 0x3f135
+ * shifted by 0x1c4400, like every other address on this part).  When it is
