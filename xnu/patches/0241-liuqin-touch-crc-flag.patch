+
+/*
+ * nvt_stop_crc_reboot(): the part latches "CRC error" and then reboots into a
+ * loop that answers 0xfc at the trim address and fills the report area with
+ * 0xfd.  The vendor's escape is two idle commands (0xaa to the swrst address)
+ * followed by 0xa5 written to CRC_ERR_FLAG, verified by reading it back.
+ *
+ * touch170 wrote that 0xa5 to address 0x00000 - the first byte of ILM - and so
+ * never cleared the flag at all.  The flag is read here on every download and
+ * cleared if it is set, which is the only way to tell a stale latch (the part
+ * has been in the loop since some earlier boot) from a fresh failure.
+ */
+static void
+tch_crc_flag(const char *why, bool fix)
+{
+	uint8_t flag = 0, after = 0, id[4] = { 0 };
+	bool in_loop;
+	unsigned tries = 0;
+
+	(void)tch_nvt_read(NVT_CRC_ERR_FLAG, &flag, 1);
+	(void)tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id));
+	in_loop = id[0] == 0xfc ||
+	    (id[0] == 0xff && id[1] == 0xff && id[2] == 0xff);
+	if (!fix) {
+		printf("LIUQIN TOUCH: %s: crc flag 0x%02x, trim %02x %02x %02x %02x%s\n",
+		    why, flag, id[0], id[1], id[2], id[3],
+		    in_loop ? " (in the crc reboot loop)" : "");
+		return;
+	}
+	/*
+	 * The vendor's nvt_stop_crc_reboot(): the part has to be put back into
+	 * idle first (0xaa twice to the swrst address) and the flag cleared with
+	 * 0xa5, then read back to prove it took.  Without the idle commands the
+	 * write is swallowed, which is why touch170's write to 0x00000 - the
+	 * first byte of ILM, not the flag at all - never stopped anything.
+	 */
+	if (flag != 0xa5 || in_loop) {
+		for (tries = 0; tries < 5; tries++) {
+			(void)tch_nvt_write8(NVT_SW_RESET_ADDR, 0xaa);
+			(void)tch_nvt_write8(NVT_SW_RESET_ADDR, 0xaa);
+			delay(1000);
+			(void)tch_nvt_write8(NVT_CRC_ERR_FLAG, 0xa5);
+			(void)tch_nvt_read(NVT_CRC_ERR_FLAG, &after, 1);
+			if (after == 0xa5) {
+				break;
+			}
+		}
+	} else {
+		after = flag;
+	}
+	printf("LIUQIN TOUCH: %s: crc flag 0x%02x -> 0x%02x in %u tries, trim "
+	    "%02x %02x %02x %02x%s\n", why, flag, after, tries, id[0], id[1],
+	    id[2], id[3], in_loop ? " (was in the crc reboot loop)" : "");
 }
 
