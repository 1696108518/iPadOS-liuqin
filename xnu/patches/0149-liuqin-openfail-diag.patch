Log every ENOENT open() done by pid 1 (launchd/dyld) on the LIUQIN bring-up.

dyld fails to find its shared cache with no diagnostic; this prints the exact
paths dyld probes so we can see which cache location it is looking at.
---
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -5058,6 +5058,16 @@
 
 	error = open1at(ctx, ndp, flags, vap, NULL, NULL, retval, fd, AUTH_OPEN_NOAUTHFD);
 
+#if defined(ARM64_BOARD_CONFIG_LIUQIN)
+	if (error == ENOENT && vfs_context_proc(ctx)->p_pid == 1) {
+		char kpath[256];
+		size_t done = 0;
+		if (copyinstr(path, kpath, sizeof(kpath), &done) == 0) {
+			printf("LIUQIN OPENFAIL pid 1: '%s' flags=%d\n", kpath, flags);
+		}
+	}
+#endif
+
 	kfree_type(typeof(*__open_data), __open_data);
 
 	return error;
