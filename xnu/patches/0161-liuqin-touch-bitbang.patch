+/*
+ * Software SPI on the four touch pads.
+ *
+ * This serial engine has no FIFO interface (GENI_IF_DISABLE_RO) and its own
+ * DMA wedges the interconnect on this port's memory map, so the pads are
+ * driven as plain GPIOs instead: mode 0, MSB first, clock stretching harmless.
+ * The TLMM register is one 0x1000 block per pin; its IO register is at +0x4
+ * with the output value in bit 1 and the input in bit 0 (SM8450 PINGROUP).
+ */
+static void
+tch_bb_dir(uint32_t pin, bool out, int level)
+{
+	uint32_t io = tch_rd(tch.tlmm, TLMM_CTL(pin) + TLMM_IN_OUT);
+
+	io = (io & ~TLMM_OUT_BIT) | (level ? TLMM_OUT_BIT : 0);
+	tch_wr(tch.tlmm, TLMM_CTL(pin) + TLMM_IN_OUT, io);
+	/* mux 0 (GPIO), no pull, 6 mA, output enable in bit 9 */
+	tch_wr(tch.tlmm, TLMM_CTL(pin), (out ? (1u << 9) : 0) | (2u << 6));
 }
 
+static inline void
+bb_set(uint32_t pin, int level)
+{
+	volatile uint32_t *io = (volatile uint32_t *)(tch.tlmm + TLMM_CTL(pin) + TLMM_IN_OUT);
+	const uint32_t v = *io;
+
+	*io = (v & ~TLMM_OUT_BIT) | (level ? TLMM_OUT_BIT : 0);
+}
+
+static inline int
+bb_get(uint32_t pin)
+{
+	const uint32_t v = *(volatile uint32_t *)(tch.tlmm + TLMM_CTL(pin) + TLMM_IN_OUT);
+
+	return (v & TLMM_IN_BIT) != 0;
+}
+
+static inline void
+bb_pace(void)
+{
+	for (int i = 0; i < 8; i++) {
+		__asm__ volatile ("nop");
+	}
+}
+
+static void
+tch_bb_xfer(const uint8_t *tx, uint8_t *rx, size_t len)
+{
+	for (size_t i = 0; i < len; i++) {
+		const uint8_t out = tx != NULL ? tx[i] : 0xff;
+		uint8_t in = 0;
+
+		for (int b = 7; b >= 0; b--) {
+			bb_set(tch.pin_mosi, (out >> b) & 1);
+			bb_pace();
+			bb_set(tch.pin_clk, 1);
+			bb_pace();
+			in = (uint8_t)((in << 1) | (bb_get(tch.pin_miso) ? 1 : 0));
+			bb_set(tch.pin_clk, 0);
+			bb_pace();
+		}
+		if (rx != NULL) {
+			rx[i] = in;
+		}
+	}
+}
+
 /* SPI_CS_ASSERT (8) / SPI_CS_DEASSERT (9); the transfer itself does not
  * toggle the line because CS_TOGGLE was cleared at init. */
 static int
 tch_cs(bool assert)
 {
+	if (tch.bitbang) {
+		bb_set(tch.pin_cs, assert ? 0 : 1);     /* active low */
+		bb_pace();
+		bb_pace();
+		return 0;
+	}
 	tch_fifo_mode();
 	const uint32_t irq = tch_run_cmd(((assert ? SPI_CS_ASSERT : SPI_CS_DEASSERT) << M_OPCODE_SHFT),
 	    NULL, 0, NULL, 0, NULL, 20);
@@ -787,6 +862,13 @@
 static int
 tch_xfer(const uint8_t *tx, uint8_t *rx, size_t len)
 {
+	if (tch.bitbang) {
+		if (len == 0 || len > 256) {
+			return -1;
+		}
+		tch_bb_xfer(tx, rx, len);
+		return 0;
+	}
 	return tch.fifo_capable ? tch_fifo_xfer(tx, rx, len) : tch_dma_xfer(tx, rx, len);
 }
 
