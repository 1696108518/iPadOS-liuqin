+/* Find which pad is the clock, which is MOSI and which is MISO: nothing in the
+ * device tree names the roles, so try the six assignments and keep the one
+ * that answers with a Novatek trim id.  gpio19 is the chip select (the DT's
+ * qup_spi4_cs group) and stays one. */
+static int
+tch_bitbang_start(void)
+{
+	static const uint32_t data_pins[3] = { 16, 17, 18 };
+	static const uint8_t perm[6][3] = {
+		{ 0, 1, 2 }, { 0, 2, 1 }, { 1, 0, 2 },
+		{ 1, 2, 0 }, { 2, 0, 1 }, { 2, 1, 0 },
+	};
+	uint8_t id[6];
+
+	tch.pin_cs = 19;
+	tch_bb_dir(tch.pin_cs, true, 1);                /* chip select deasserted */
+	tch.bitbang = true;
+	tch.cs_manual = true;
+
+	for (unsigned p = 0; p < 6; p++) {
+		tch.pin_clk = data_pins[perm[p][0]];
+		tch.pin_mosi = data_pins[perm[p][1]];
+		tch.pin_miso = data_pins[perm[p][2]];
+		tch_bb_dir(tch.pin_clk, true, 0);
+		tch_bb_dir(tch.pin_mosi, true, 0);
+		tch_bb_dir(tch.pin_miso, false, 0);
+		memset(id, 0, sizeof(id));
+		const int err = tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id));
+
+		printf("LIUQIN TOUCH: bitbang %u: clk gpio%u mosi gpio%u miso gpio%u -> "
+		    "%02x %02x %02x %02x %02x %02x%s\n",
+		    p, tch.pin_clk, tch.pin_mosi, tch.pin_miso,
+		    id[0], id[1], id[2], id[3], id[4], id[5],
+		    err != 0 ? " (read failed)" : "");
+		if (err == 0 && id[3] == 0x65 && id[4] == 0x03) {
+			printf("LIUQIN TOUCH: bit-banged SPI: clk gpio%u mosi gpio%u miso gpio%u cs gpio%u\n",
+			    tch.pin_clk, tch.pin_mosi, tch.pin_miso, tch.pin_cs);
+			return 0;
+		}
+	}
+	printf("LIUQIN TOUCH: no pad assignment answered with a Novatek id\n");
+	return -1;
 }
 
