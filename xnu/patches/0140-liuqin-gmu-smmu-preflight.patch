+    /* Read-only SMMU preflight: the CP fetches its microcode through the GPU's
+     * stream, so a stale global fault or a bank that did not take the tables
+     * explains a stalled fetch without needing the register write to survive.
+     * Geometry from IDR1 as the ladder derives it: page size bit 31, context
+     * banks start at (2 << ((IDR1 >> 28) & 7)) pages. */
+    if(smmu_base_) {
+        volatile uint32_t *sm=reinterpret_cast<volatile uint32_t *>(smmu_base_);
+        const uint32_t idr1=sm[0x24/4];
+        const unsigned page=(idr1>>31)?0x10000u:0x1000u;
+        const unsigned pages=2u<<((idr1>>28)&7);
+        volatile uint32_t *cb=sm+(size_t)(pages+2)*page/4;
+        IOLog("NativeAdreno: SMMU preflight idr1=0x%x cb2base=0x%x sgfsr=0x%x sctlr=0x%x tcr=0x%x ttbr0=0x%x%08x fsr=0x%x\n",
+            idr1,(unsigned)((pages+2)*page),sm[0x48/4],cb[0x00/4],cb[0x30/4],cb[0x24/4],cb[0x20/4],cb[0x50/4]);
+    } else IOLog("NativeAdreno: SMMU preflight skipped (no window)\n");
