 static void
+liuqin_fw_load(void)
+{
+	void const *prop = NULL;
+	unsigned int len = 0;
+	DTEntry mmap;
+	uint64_t phys = 0, size = 0;
+
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mmap) != kSuccess ||
+	    SecureDTGetProperty(mmap, "LIUQINFW", &prop, &len) != kSuccess ||
+	    len < 2 * sizeof(uint64_t)) {
+		printf("LIUQIN FW: no LIUQINFW firmware area in the memory map\n");
+		return;
+	}
+	memcpy(&phys, prop, sizeof(uint64_t));
+	memcpy(&size, (const char *)prop + sizeof(uint64_t), sizeof(uint64_t));
+	if (size < sizeof(struct liuqin_fw_header) || size > (64u << 20)) {
+		printf("LIUQIN FW: bad firmware area (0x%llx phys, 0x%llx bytes)\n", phys, size);
+		return;
+	}
+	vm_offset_t io = ml_io_map(phys, (vm_size_t)size);
+	if (!io) {
+		printf("LIUQIN FW: cannot map the firmware area\n");
+		return;
+	}
+	/*
+	 * The memory map points at Device memory: unaligned or wide accesses
+	 * there fault (the first attempt panicked in memcpy). Copy it into
+	 * normal kernel memory with 4-byte aligned reads and parse that.
+	 */
+	vm_offset_t copy = 0;
+	if (kmem_alloc(kernel_map, &copy, (vm_size_t)size, KMA_DATA | KMA_ZERO,
+	    VM_KERN_MEMORY_BSD) != KERN_SUCCESS) {
+		printf("LIUQIN FW: no memory to copy the firmware area\n");
+		return;
+	}
+	const volatile uint32_t *src = (const volatile uint32_t *)io;
+	uint32_t *dst = (uint32_t *)copy;
+	for (uint64_t i = 0; i < size / 4; i++) {
+		dst[i] = src[i];
+	}
+	liuqin_fw_data = (uint8_t *)copy;
+	memcpy(&liuqin_fw_hdr, liuqin_fw_data, sizeof(liuqin_fw_hdr));
+	if (memcmp(liuqin_fw_hdr.magic, "LIUQINFW", 8) != 0 ||
+	    liuqin_fw_hdr.version != 1 || liuqin_fw_hdr.count > LIUQIN_FW_MAX) {
+		printf("LIUQIN FW: no firmware area (magic %.8s count %u)\n",
+		    liuqin_fw_hdr.magic, liuqin_fw_hdr.count);
+		liuqin_fw_data = NULL;
+		return;
+	}
+	for (uint32_t i = 0; i < liuqin_fw_hdr.count; i++) {
+		struct liuqin_fw_entry *e = &liuqin_fw_hdr.entry[i];
+		if (e->offset + e->size <= size && e->offset >= sizeof(liuqin_fw_hdr)) {
+			liuqin_fw_ok |= 1u << i;
+		}
+	}
+	printf("LIUQIN FW: %u files at 0x%llx (%llu KiB, mask 0x%x)\n",
+	    liuqin_fw_hdr.count, phys, size >> 10, liuqin_fw_ok);
+	for (uint32_t i = 0; i < liuqin_fw_hdr.count; i++) {
+		printf("LIUQIN FW: %.48s %u bytes\n", liuqin_fw_hdr.entry[i].name,
+		    liuqin_fw_hdr.entry[i].size);
+	}
+}
