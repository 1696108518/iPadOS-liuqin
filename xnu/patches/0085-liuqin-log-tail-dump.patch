+const void *
+liuqin_fw_get(const char *name, uint32_t *size)
+{
+	for (uint32_t i = 0; liuqin_fw_data && i < liuqin_fw_hdr.count && i < LIUQIN_FW_MAX; i++) {
+		if ((liuqin_fw_ok & (1u << i)) &&
+		    strncmp(liuqin_fw_hdr.entry[i].name, name, 48) == 0) {
+			*size = liuqin_fw_hdr.entry[i].size;
+			return liuqin_fw_data + liuqin_fw_hdr.entry[i].offset;
+		}
+	}
+	return NULL;
