+/*
+ * Print the tail of the persistent console log left by the previous boot.
+ * A hang in userland then shows up on screen after a power cycle.
+ */
 static void
+liuqin_log_dump(void)
+{
+	uint64_t base = su.first_block + su.nblocks - LIUQIN_LOG_BLOCKS;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	struct liuqin_log_header *h = (struct liuqin_log_header *)bounce;
+	uint32_t want = 4000;
+
+	int e = ufs_read_blocks(base, 1);
+	printf("LIUQIN LOG: hdr rd=%d magic=%02x%02x%02x%02x%02x%02x%02x%02x ver=%u size=%u total=%llu\n",
+	    e, (uint8_t)h->magic[0], (uint8_t)h->magic[1], (uint8_t)h->magic[2], (uint8_t)h->magic[3],
+	    (uint8_t)h->magic[4], (uint8_t)h->magic[5], (uint8_t)h->magic[6], (uint8_t)h->magic[7],
+	    h->version, h->size, h->total);
+	if (e != 0) {
+		return;
+	}
+	if (memcmp(h->magic, "SWEETLOG", 8) != 0 &&
+	    memcmp(h->magic, "LIUQINLOG", 8) != 0) {
+		return;
+	}
+	uint64_t total = h->total;
+	uint32_t size = h->size;
+	if (size == 0 || size > LIUQIN_LOG_SIZE) {
+		return;
+	}
+	if (total < want) {
+		want = (uint32_t)total;
+	}
+	uint64_t start = total - want;
+	uint64_t ring_off = start % size;
+	if (ring_off + want > size) {
+		want = (uint32_t)(size - ring_off);
+	}
+	uint32_t block = (uint32_t)(ring_off / UFS_BLOCK);
+	uint32_t in_block = (uint32_t)(ring_off % UFS_BLOCK);
+	uint32_t nblocks = (in_block + want + UFS_BLOCK - 1) / UFS_BLOCK;
+	if (ufs_read_blocks(base + 1 + block, nblocks) != 0) {
+		return;
+	}
+	uint8_t *tp = (uint8_t *)bounce + in_block;
+	for (uint32_t i = 0; i < want; i++) {
+		if (tp[i] == 0) {
+			tp[i] = '.';
+		}
+	}
+	printf("LIUQIN LOG: previous boot tail (%u of %llu bytes):\n", want, total);
+	printf("%.*s\n", (int)want, (char *)tp);
+	printf("LIUQIN LOG: end of previous tail\n");
+	delay(60000000);        /* 60 s so the screen can be photographed */
+}
+
+/*
+ * Boot watchdog: if userland has not finished booting after 180 s, print the
+ * tail of the in-memory console ring (authoritative, no disk round-trip) and
+ * panic so the text stays on screen.
+ */
+static void
+liuqin_wdt_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static char tail[2400];
+	uint32_t secs = 0;
+
+	PE_parse_boot_argn("liuqinwdt", &secs, sizeof(secs));
+	if (secs == 0) {
+		return;
+	}
+	delay((uint64_t)secs * 1000000);
+	uint64_t total = os_atomic_load(&liuqin_log_total, relaxed);
+	uint32_t want = (uint32_t)MIN(total, (uint64_t)sizeof(tail));
+	uint64_t start = total - want;
+	for (uint32_t i = 0; i < want; i++) {
+		char c = liuqin_log_ring[(start + i) % LIUQIN_LOG_SIZE];
+		tail[i] = (c == 0) ? '.' : c;
+	}
+	extern int liuqin_console_muted;
+	liuqin_console_muted = 0;       /* draw the tail even when muted */
+	printf("LIUQIN WDT: ring tail (%u of %llu):\n", want, total);
+	printf("%.*s\n", (int)want, tail);
+	panic("LIUQIN watchdog: boot did not finish in 180 s");
+}
+
+static void
+liuqin_wdt_start(void)
+{
+	thread_t t;
+	if (kernel_thread_start(liuqin_wdt_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
