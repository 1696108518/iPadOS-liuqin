+			rxst = rx != NULL ? tch_rd(tch.se, SE_DMA_RX_IRQ_STAT) : 0;
+			ok = (tx == NULL || (txst & TX_DMA_DONE) != 0) &&
+			    (rx == NULL || (rxst & RX_DMA_DONE) != 0);
