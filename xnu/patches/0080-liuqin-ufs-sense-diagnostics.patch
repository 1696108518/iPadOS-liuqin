+static const uint8_t *ucd_dbg;
+
+static int
+ufs_query(uint8_t opcode, uint8_t idn, uint8_t index, uint16_t length,
+    uint32_t value, uint32_t *out)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = 0x16;			/* QUERY REQUEST UPIU */
+	ucd->cmd[1] = 0;
+	ucd->cmd[2] = 0;			/* LUN 0 */
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[4] = 0;
+	ucd->cmd[5] = (opcode == 0x01 || opcode == 0x03 ||
+	    opcode == 0x05) ? 0x01 : 0x81;	/* read / write function */
+	ucd->cmd[6] = 0;
+	ucd->cmd[7] = 0;
+	ucd->cmd[12] = opcode;
+	ucd->cmd[13] = idn;
+	ucd->cmd[14] = index;
+	ucd->cmd[15] = 0;
+	/* reserved_osf is bytes 16-17, the descriptor length is 18-19 */
+	ucd->cmd[18] = (uint8_t)(length >> 8);
+	ucd->cmd[19] = (uint8_t)length;
+	ucd->cmd[20] = (uint8_t)(value >> 24);
+	ucd->cmd[21] = (uint8_t)(value >> 16);
+	ucd->cmd[22] = (uint8_t)(value >> 8);
+	ucd->cmd[23] = (uint8_t)value;
+
+	/* Query commands are native UFS commands (command type 1). */
+	utrd->dw0 = (1u << 28) | (1u << 24);
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			printf("LIUQIN UFS: query 0x%02x timed out\n", opcode);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	ucd_dbg = ucd->resp;
+
+	if (ucd->resp[0] != 0x36 || ucd->resp[6]) {
+		printf("LIUQIN UFS: query 0x%02x idn 0x%02x failed: upiu 0x%x response 0x%x\n",
+		    opcode, idn, ucd->resp[0], ucd->resp[6]);
 		return EIO;
 	}
+	if (out) {
+		*out = (uint32_t)ucd->resp[20] << 24 |
+		    (uint32_t)ucd->resp[21] << 16 |
+		    (uint32_t)ucd->resp[22] << 8 | ucd->resp[23];
+	}
 	return 0;
 }
 
+/* Same, addressed to an explicit LUN (0x81 is the REPORT LUNS well-known LU). */
+static int
+ufs_scsi_lun(uint32_t lun, const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	uint32_t save = su.lun;
+	su.lun = lun;
+	int e = ufs_scsi(cdb, cdb_len, len, write);
+	su.lun = save;
+	return e;
+}
