+/*
+ * One UFS Query Request UPIU (no data segment). Used for the device
+ * initialisation flag sequence, which the bootloader may not have run.
+ * Returns 0 on success and stores the query value in *out.
+ */
+/* Deassert the GCC UFS PHY block reset; the bootloader may leave it asserted
+ * after powering the block down, which makes every PHY register read zero. */
+static void
+ufs_gcc_phy_reset(void)
+{
+	if (!su.gcc) {
+		return;
+	}
+	volatile uint32_t *bcr = (volatile uint32_t *)(su.gcc + 0x87000);
+	printf("LIUQIN UFS: gcc bcr before %08x\n", *bcr);
+	*bcr = 0;
+	delay(2000);
+	printf("LIUQIN UFS: gcc bcr after %08x\n", *bcr);
+}
+
+/* Turn on the GCC clocks that gate the UFS PHY register interface.  The
+ * bootloader leaves the PHY core running (the link works) but gates the
+ * aux/apb clock, so the PCS registers read back as zero. */
+static void
+ufs_gcc_clocks_on(void)
+{
+	static const uint32_t cbcr[] = {
+		0x87018,        /* gcc_ufs_phy_axi_clk */
+		0x87020,        /* gcc_ufs_phy_ahb_clk */
+		0x87064,        /* gcc_ufs_phy_unipro_core_clk */
+		0x8706c,        /* gcc_ufs_phy_ice_core_clk */
+		0x870a4,        /* gcc_ufs_phy_phy_aux_clk */
+	};
+	if (!su.gcc) {
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(cbcr) / sizeof(cbcr[0]); i++) {
+		volatile uint32_t *r = (volatile uint32_t *)(su.gcc + cbcr[i]);
+		*r = *r | 1u;
+	}
+	/* root generator enable for the aux clock */
+	{
+		volatile uint32_t *r = (volatile uint32_t *)(su.gcc + 0x870a8);
+		*r = *r | 1u;
+	}
+	delay(1000);
+}
+
+/* Minimal QMP UFS PHY bring-up: the bootloader powers the PHY down, and
+ * without clearing that the UIC/UniPro commands all fail.  sm8450 uses the
+ * v5 PCS layout (pcs at +0xc00, start 0x000, power-down 0x004, ready 0x180). */
+static int
+ufs_phy_wake(void)
+{
+	if (!su.phy) {
+		return EIO;
+	}
+	volatile uint32_t *pcs = (volatile uint32_t *)(su.phy + 0xc00);
+	uint32_t pre_st = pcs[0x00 / 4], pre_pw = pcs[0x04 / 4], pre_rd = pcs[0x180 / 4];
+	printf("LIUQIN UFS: phy pre start 0x%x pwrdn 0x%x ready 0x%x\n",
+	    pre_st, pre_pw, pre_rd);
+	pcs[0x04 / 4] = 0;              /* clear SW_PWRDN (power up) */
+	pcs[0x00 / 4] = 0x3;            /* SERDES_START | PCS_START */
+	for (int i = 0; i < 1000 && !(pcs[0x180 / 4] & 1); i++) {
+		delay(100);
+	}
+	uint32_t rd = pcs[0x180 / 4];
+	printf("LIUQIN UFS: phy post pwrdn 0x%x ready 0x%x\n", pcs[0x04 / 4], rd);
+	return (rd & 1) ? 0 : EIO;
+}
+
+/* Stop and re-enable the host controller (u-boot/Linux do this when link
+ * startup fails), then the caller must re-program the request list. */
+static int
+ufs_hba_restart(void)
+{
+	ufs_wr(REG_HCE, 0);
+	for (int i = 0; i < 1000 && (ufs_rd(REG_HCE) & 1); i++) {
+		delay(1);
+	}
+	ufs_wr(REG_HCE, 1);
+	for (int i = 0; i < 1000 && !(ufs_rd(REG_HCE) & 1); i++) {
+		delay(1);
+	}
+	for (int i = 0; i < 1000 && ((ufs_rd(REG_HCS) & 0xf) != 0xf); i++) {
+		delay(1);
+	}
+	return (ufs_rd(REG_HCE) & 1) ? 0 : EIO;
+}
+
+/* One UIC command (link startup, DME get/set). Returns the result code. */
+static int
+ufs_uic(uint8_t opcode, uint32_t a1, uint32_t a2, uint32_t a3, uint32_t *out)
+{
+	uint64_t deadline;
+
+	if (!(ufs_rd(REG_HCS) & 0x8)) {          /* UIC_COMMAND_READY */
+		printf("LIUQIN UFS: UIC not ready (hcs 0x%x)\n", ufs_rd(REG_HCS));
+		return EBUSY;
+	}
+	ufs_wr(REG_UICARG1, a1);
+	ufs_wr(REG_UICARG2, a2);
+	ufs_wr(REG_UICARG3, a3);
+	ufs_wr(REG_UICCMD, opcode & 0xff);
+
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (!(ufs_rd(REG_IS) & 0x400)) {     /* UIC_COMMAND_COMPL */
+		if (mach_absolute_time() > deadline) {
+			printf("LIUQIN UFS: UIC 0x%02x timed out (is 0x%x)\n",
+			    opcode, ufs_rd(REG_IS));
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	if (out) {
+		*out = ufs_rd(REG_UICARG3);
+	}
+	return (int)(ufs_rd(REG_UICARG2) & 0xff);
+}
