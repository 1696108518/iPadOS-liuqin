+/* Register write in the bootloader: page command then [reg | 0x80, data...],
+ * each as its own chip-select transaction (nvt_set_bld_crc_bank and friends). */
+static void
+tch_fw_reg_write(uint32_t page_addr, uint32_t reg_addr, const uint8_t *data, size_t len)
+{
+	uint8_t page[3];
+	uint8_t buf[6];
 
+	page[0] = 0xff;
+	page[1] = (uint8_t)((page_addr >> 15) & 0xff);
+	page[2] = (uint8_t)((page_addr >> 7) & 0xff);
+	buf[0] = (uint8_t)((reg_addr & 0x7f) | 0x80);
+	memcpy(buf + 1, data, len);
+	if (tch_cs(true) != 0) {
+		return;
+	}
+	(void)tch_xfer(page, NULL, sizeof(page));
+	if (tch_cs(false) != 0) {
+		return;
+	}
+	if (tch_cs(true) != 0) {
+		return;
+	}
+	(void)tch_xfer(buf, NULL, len + 1);
+	(void)tch_cs(false);
+}
+
+/* ILM/DLM descriptors the cascade auto-copy engine needs before it will move
+ * the image: destination, length and golden checksum per section. */
+static void
+tch_fw_bld_bank(uint32_t des_addr, uint32_t sram, uint32_t len_addr,
+    uint32_t size, uint32_t cksum_addr, uint32_t crc)
+{
+	uint8_t v[4];
+
+	v[0] = (uint8_t)(sram & 0xff);
+	v[1] = (uint8_t)((sram >> 8) & 0xff);
+	v[2] = (uint8_t)((sram >> 16) & 0xff);
+	tch_fw_reg_write(des_addr, des_addr, v, 3);
+
+	v[0] = (uint8_t)(size & 0xff);
+	v[1] = (uint8_t)((size >> 8) & 0xff);
+	v[2] = (uint8_t)((size >> 16) & 0x01);
+	tch_fw_reg_write(des_addr, len_addr, v, 3);
+
+	v[0] = (uint8_t)(crc & 0xff);
+	v[1] = (uint8_t)((crc >> 8) & 0xff);
+	v[2] = (uint8_t)((crc >> 16) & 0xff);
+	v[3] = (uint8_t)((crc >> 24) & 0xff);
+	tch_fw_reg_write(des_addr, cksum_addr, v, 4);
+}
