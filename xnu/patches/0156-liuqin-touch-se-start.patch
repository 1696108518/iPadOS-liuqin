+/* What the bootloader left in the engine, and what it looks like after every
+ * step: the first touch4 boot could only tell us "irq 0x2", which is not
+ * enough to pick a fix. */
+static void
+tch_dump_state(const char *when)
+{
+	printf("LIUQIN TOUCH: %s SE4 status 0x%08x irq 0x%08x irqen 0x%08x ctrl 0x%08x cmd0 0x%08x gp_len 0x%08x\n",
+	    when, tch_rd(tch.se, SE_GENI_STATUS), tch_rd(tch.se, SE_GENI_M_IRQ_STATUS),
+	    tch_rd(tch.se, SE_GENI_M_IRQ_EN), tch_rd(tch.se, SE_GENI_M_CMD_CTRL_REG),
+	    tch_rd(tch.se, SE_GENI_M_CMD0), tch_rd(tch.se, SE_GENI_M_GP_LENGTH));
+	printf("LIUQIN TOUCH: %s SE4 clk 0x%08x sel 0x%08x out 0x%08x cgc 0x%08x gsi 0x%08x seirq 0x%08x ifdis 0x%08x\n",
+	    when, tch_rd(tch.se, GENI_SER_M_CLK_CFG), tch_rd(tch.se, SE_GENI_CLK_SEL),
+	    tch_rd(tch.se, GENI_OUTPUT_CTRL), tch_rd(tch.se, GENI_CGC_CTRL),
+	    tch_rd(tch.se, SE_GSI_EVENT_EN), tch_rd(tch.se, SE_IRQ_EN),
+	    tch_rd(tch.se, GENI_IF_DISABLE_RO));
+	printf("LIUQIN TOUCH: %s SE4 spi trans 0x%08x word 0x%08x cpha 0x%08x cpol 0x%08x demux 0x%08x slave 0x%08x\n",
+	    when, tch_rd(tch.se, SE_SPI_TRANS_CFG), tch_rd(tch.se, SE_SPI_WORD_LEN),
+	    tch_rd(tch.se, SE_SPI_CPHA), tch_rd(tch.se, SE_SPI_CPOL),
+	    tch_rd(tch.se, SE_SPI_DEMUX_SEL), tch_rd(tch.se, SE_SPI_SLAVE_EN));
+}
+
+/* One CS_ASSERT, reported in full: whether the SE latched the command
+ * (GENI_STATUS.M_GENI_CMD_ACTIVE), the first interrupt status it raised and
+ * the last one. */
+static int
+tch_cs_probe(const char *after)
+{
+	tch_fifo_mode();
+	const uint32_t irq = tch_run_cmd(SPI_CS_ASSERT << M_OPCODE_SHFT,
 	    NULL, 0, NULL, 0, NULL, 20);
+
+	printf("LIUQIN TOUCH: CS assert %s: after-cmd 0x%08x first-irq 0x%08x irq 0x%08x\n",
+	    after, tch.status_after_cmd, tch.first_irq, irq);
 	return (irq & M_CMD_DONE_EN) ? 0 : -1;
 }
 
+/* A one-byte TX_ONLY with CS deasserted: proves whether the SE runs commands
+ * at all without touching the chip. */
+static int
+tch_tx_probe(const char *after)
+{
+	uint8_t byte = 0xff;
+
+	tch_fifo_mode();
+	tch_wr(tch.se, SE_SPI_TX_TRANS_LEN, 1);
+	const uint32_t irq = tch_run_cmd((SPI_TX_ONLY << M_OPCODE_SHFT) | FRAGMENTATION,
+	    &byte, 1, NULL, 0, NULL, 20);
+
+	printf("LIUQIN TOUCH: TX probe %s: after-cmd 0x%08x first-irq 0x%08x irq 0x%08x\n",
+	    after, tch.status_after_cmd, tch.first_irq, irq);
+	return (irq & M_CMD_DONE_EN) ? 0 : -1;
+}
+
+/* Is the bus usable, and does it need help with chip select?  Tries the
+ * CS_ASSERT/CS_DEASSERT pair first and falls back to a bare transfer, which is
+ * all Qualcomm's own GENI SPI driver uses: if the engine accepts transfers but
+ * not the CS commands, it drives CS per transfer by itself. */
+static int
+tch_probe_bus(const char *how)
+{
+	if (tch_cs_probe(how) == 0) {
+		tch.cs_manual = true;
+		(void)tch_cs(false);
+		return 0;
+	}
+	if (tch_tx_probe(how) == 0) {
+		tch.cs_manual = false;
+		printf("LIUQIN TOUCH: transfers work, CS commands do not: CS per transfer\n");
+		return 0;
+	}
+	return -1;
+}
+
+/* The first touch4 boot answered "no" to every command with M_CMD_OVERRUN,
+ * which means the master sequencer is either still busy with something the
+ * bootloader left behind or disabled.  Walk the ways out of that state,
+ * logging each one, and stop at the first that works. */
+static int
+tch_se_start(void)
+{
+	static const struct {
+		uint32_t reg, val;
+		const char *what;
+	} fixes[] = {
+		{ SE_GENI_M_CMD_CTRL_REG, M_GENI_CMD_CANCEL, "cancel" },
+		{ SE_GENI_M_CMD_CTRL_REG, M_GENI_CMD_ABORT, "abort" },
+		{ SE_GENI_M_CMD_CTRL_REG, 0, "clear-disable" },
+		{ SE_GENI_CFG_SEQ_START, START_TRIGGER, "start-trigger" },
+	};
+
+	if (tch_probe_bus("as configured") == 0) {
+		return 0;
+	}
+	for (unsigned i = 0; i < sizeof(fixes) / sizeof(fixes[0]); i++) {
+		tch_wr(tch.se, fixes[i].reg, fixes[i].val);
+		delay(2000);
+		printf("LIUQIN TOUCH: %s: status 0x%08x irq 0x%08x ctrl 0x%08x\n",
+		    fixes[i].what, tch_rd(tch.se, SE_GENI_STATUS),
+		    tch_rd(tch.se, SE_GENI_M_IRQ_STATUS),
+		    tch_rd(tch.se, SE_GENI_M_CMD_CTRL_REG));
+		if (tch_probe_bus(fixes[i].what) == 0) {
+			printf("LIUQIN TOUCH: SE4 accepts commands after %s\n", fixes[i].what);
+			return 0;
+		}
+	}
+	tch_dump_state("dead");
+	printf("LIUQIN TOUCH: SE4 rejects every command, bus not started\n");
+	return -1;
+}
