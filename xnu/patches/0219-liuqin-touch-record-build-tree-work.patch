+/*
+ * Pacing.  delay() costs about 16 us on this port no matter what is asked for,
+ * and the bit-bang called it three times per bit - that, not the pads, is why
+ * the bus ran at ~20 kHz.  A calibrated spin loop is a few hundred nanoseconds
+ * and makes the pace argument mean something.
+ */
+static uint32_t bb_spin_per_us = 60;    /* calibrated at bring-up */
+
+static void
+bb_calibrate(void)
+{
+	uint64_t t0, t1, ns = 0;
+	const uint32_t n = 20000;
+	int spin = 0;
+	volatile uint32_t sink = 0;
+
+	if (PE_parse_boot_argn("liuqintouchspin", &spin, sizeof(spin)) && spin > 0) {
+		bb_spin_per_us = (uint32_t)spin;
+		printf("LIUQIN TOUCH: bit-bang spin %u iterations/us (boot arg)\n",
+		    bb_spin_per_us);
+		return;
+	}
+	t0 = mach_absolute_time();
+	for (uint32_t i = 0; i < n; i++) {
+		__asm__ volatile ("nop" ::: "memory");
+		sink++;
+	}
+	t1 = mach_absolute_time();
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	if (ns > 0 && sink == n) {
+		/* iterations per microsecond: n / (ns/1000) */
+		const uint64_t us = ns / 1000ull;
+		if (us > 0) {
+			bb_spin_per_us = (uint32_t)(n / us);
+		}
+		if (bb_spin_per_us < 4) {
+			bb_spin_per_us = 4;
+		}
+	}
+	printf("LIUQIN TOUCH: bit-bang spin %u iterations/us (%llu ns for %u nops)\n",
+	    bb_spin_per_us, ns, n);
+}
