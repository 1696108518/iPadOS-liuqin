+/*
+ * apps_smmu (vendor DTB: soc/apps-smmu@15000000, "qcom,qsmmu-v500", 1 MiB).
+ * QUPv3_0's GENI SE - the wrapper that owns SE4 - carries
+ * iommus = <&apps_smmu 0x5a3 0>, so every SE DMA transaction is translated by
+ * stream 0x5A3.  An S2CR that is not in bypass makes that transaction fault,
+ * and a stalled fault stalls the interconnect: the machine froze on the very
+ * first DMA opcode with nothing else printed.  qsmmu-v500 indexes S2CR by the
+ * stream id at 0x8000 + 4*n, so the register is 0x15000000 + 0x968c.
+ *
+ * liuqintouchsmmu: 0 off, 1 report only, 2 report and set the stream to bypass.
+ */
+#define APPS_SMMU_PA   0x15000000u
+#define SMMU_SCR0      0x0000u
+#define SMMU_IDR0      0x0020u
+#define SMMU_S2CR(n)   (0x8000u + (n) * 4u)
+#define SMMU_STREAM    0x5a3u
+#define S2CR_TYPE_BYPASS 0x1u
+
+static void
+tch_smmu_fix(void)
+{
+	int mode = 1;
+	vm_offset_t smmu;
+	uint32_t scr0, idr0, s2cr0, s2cr1, s2cr;
+
+	(void)PE_parse_boot_argn("liuqintouchsmmu", &mode, sizeof(mode));
+	if (mode <= 0) {
+		return;
+	}
+	smmu = ml_io_map(APPS_SMMU_PA, 0x10000);
+	if (smmu == 0) {
+		printf("LIUQIN TOUCH: SMMU: cannot map 0x%x\n", APPS_SMMU_PA);
+		return;
+	}
+	scr0 = tch_rd(smmu, SMMU_SCR0);
+	idr0 = tch_rd(smmu, SMMU_IDR0);
+	s2cr0 = tch_rd(smmu, SMMU_S2CR(0));
+	s2cr1 = tch_rd(smmu, SMMU_S2CR(1));
+	s2cr = tch_rd(smmu, SMMU_S2CR(SMMU_STREAM));
+	printf("LIUQIN TOUCH: SMMU scr0 0x%08x idr0 0x%08x S2CR[0] 0x%08x S2CR[1] 0x%08x\n",
+	    scr0, idr0, s2cr0, s2cr1);
+	printf("LIUQIN TOUCH: SMMU S2CR[0x%x] 0x%08x type %u (0 translate, 1 bypass, 2 fault)\n",
+	    SMMU_STREAM, s2cr, s2cr & 3u);
+	if (mode < 2) {
+		return;
+	}
+	if (idr0 == 0 || idr0 == 0xffffffffu) {
+		/* Not an SMMU register block: never write into whatever this is. */
+		printf("LIUQIN TOUCH: SMMU: no IDR0, refusing to write\n");
+		return;
+	}
+	if ((s2cr & 3u) == S2CR_TYPE_BYPASS) {
+		printf("LIUQIN TOUCH: SMMU stream already bypasses, nothing to write\n");
+		return;
+	}
+	printf("LIUQIN TOUCH: SMMU writing bypass to S2CR[0x%x] (0x%08x -> 0x%08x)\n",
+	    SMMU_STREAM, s2cr, (s2cr & ~3u) | S2CR_TYPE_BYPASS);
+	tch_wr(smmu, SMMU_S2CR(SMMU_STREAM), (s2cr & ~3u) | S2CR_TYPE_BYPASS);
+	printf("LIUQIN TOUCH: SMMU S2CR[0x%x] now 0x%08x\n", SMMU_STREAM,
+	    tch_rd(smmu, SMMU_S2CR(SMMU_STREAM)));
+}
