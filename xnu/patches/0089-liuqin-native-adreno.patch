index 0000000..6e11130
--- /dev/null
+++ b/iokit/NativeAdreno/kits/ArmSmmu4K/test_program.c
@@ -0,0 +1,184 @@
+/* SPDX-License-Identifier: MIT */
+/* Software I/O fixture only. No device, hardware mapping or GPU is opened. */
+#include "ArmSmmu4KMmio.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define CHECK(c) do {if(!(c)){fprintf(stderr,"line %d: %s\n",__LINE__,#c);exit(1);}}while(0)
+#define BYTES 0x40000
+#ifdef SOURCE_ORACLE
+extern uint32_t source_register(unsigned);
+static void source_definitions(void)
+{
+    const uint32_t expected[]={0x20,0x24,0x28,0,0x10,0x20,0x28,0x30,0x38,0x3c,
+        0x58,0x610,0x7f0,0x7f4,0xc00001fe,0x800,UINT32_MAX};
+    for(unsigned i=0;i<sizeof(expected)/sizeof(expected[0]);++i)CHECK(source_register(i)==expected[i]);
+}
+#endif
+typedef struct {unsigned kind;size_t at;uint64_t value;} Event;
+typedef struct {
+    uint64_t memory[BYTES/8];Event events[512];size_t event_count,calls,fail_call;
+    size_t cb,gr1;unsigned bank,enabled_seen,timeout,corrupt_tcr,corrupt_enable;
+    unsigned fault_on_enable,fail_disable,fail_after_write,sheng_bits;
+} Fixture;
+static Fixture f;
+static ArmSmmu4KConfig lower={48,48,0x10000000,16},upper={48,48,0x11000000,16};
+static ArmSmmu4KResult lr,ur;static uint64_t lower_tables[8*512],upper_tables[8*512];
+static ArmSmmu4KContextConfig config;
+static uint32_t get32(size_t at){uint32_t v;memcpy(&v,(unsigned char *)f.memory+at,4);return v;}
+static uint64_t get64(size_t at){uint64_t v;memcpy(&v,(unsigned char *)f.memory+at,8);return v;}
+static void put32(size_t at,uint32_t v){memcpy((unsigned char *)f.memory+at,&v,4);}
+static void put64(size_t at,uint64_t v){memcpy((unsigned char *)f.memory+at,&v,8);}
+static int event(unsigned kind,size_t at,uint64_t value)
+{
+    CHECK(f.event_count<512 && at<BYTES);f.events[f.event_count++]=(Event){kind,at,value};
+    return ++f.calls==f.fail_call;
+}
+static int read32(void *cookie,size_t at,uint32_t *out)
+{
+    CHECK(cookie==&f && !(at&3) && at<=BYTES-4);
+    if(event(0,at,0))return 1;
+    *out=(at==f.cb+0x7f4 && f.timeout)?1:get32(at);return 0;
+}
+static int read64(void *cookie,size_t at,uint64_t *out)
+{
+    CHECK(cookie==&f && !(at&7) && at<=BYTES-8);
+    if(event(1,at,0))return 1;*out=get64(at);return 0;
+}
+static int write32(void *cookie,size_t at,uint32_t value)
+{
+    CHECK(cookie==&f && !(at&3) && at<=BYTES-4);int fail=event(2,at,value);
+    if((fail && !f.fail_after_write) || (at==f.cb && value==0 && f.enabled_seen && f.fail_disable))return 1;
+    if(at==f.cb+0x58)put32(at,get32(at)&~value); /* actual W1C semantics */
+    else if(at==f.cb+0x30 && f.corrupt_tcr)put32(at,value^(1u<<14));
+    else if(at==f.cb+0x10 && f.sheng_bits)put32(at,value|0x60);   /* int-008: TCR2 TBI0/TBI1 read 1 */
+    else if(at==f.cb && value&1) {
+        if(f.sheng_bits)value&=~0x1000u;   /* int-009: SCTLR.ASIDPNE reads 0 */
+        f.enabled_seen=1;put32(at,f.corrupt_enable?value^1:value);
+        if(f.fault_on_enable)put32(f.cb+0x58,2);
+    } else put32(at,value);
+    return fail;
+}
+static int write64(void *cookie,size_t at,uint64_t value)
+{
+    CHECK(cookie==&f && !(at&7) && at<=BYTES-8);int fail=event(3,at,value);
+    if(fail && !f.fail_after_write)return 1;put64(at,value);return fail;
+}
+static int barrier(void *cookie){CHECK(cookie==&f);return event(4,0,0);}
+static ArmSmmu4KIo reset(unsigned register_64k)
+{
+    memset(&f,0,sizeof(f));f.bank=register_64k?1:2;f.gr1=register_64k?65536:4096;
+    size_t pages=register_64k?2:32;f.cb=(pages+f.bank)*f.gr1;
+    put32(0x20,1u<<30);put32(0x24,register_64k?0x80000002:0x40020010);put32(0x28,0x1555);
+    /* Deliberately wrong supplied IDs: only the real I/O reads may authorize. */
+    config=(ArmSmmu4KContextConfig){&lower,&upper,&lr,&ur,0,0,0xabcd,1,1,1};
+    ArmSmmu4KIo io={&f,BYTES,read32,read64,write32,write64,barrier};return io;
+}
+static size_t first(unsigned kind,size_t at)
+{for(size_t i=0;i<f.event_count;++i)if(f.events[i].kind==kind && f.events[i].at==at)return i;exit(1);}
+static void no_writes(void)
+{for(size_t i=0;i<f.event_count;++i)CHECK(f.events[i].kind!=2 && f.events[i].kind!=3);}
+static void never_enabled(void)
+{for(size_t i=0;i<f.event_count;++i)CHECK(!(f.events[i].kind==2 && f.events[i].at==f.cb && (f.events[i].value&1)));}
+static void direct_adapter(void)
+{
+    /* Explicit host-memory unit buffer, never described as an MMIO device. */
+    uint64_t storage[8]={0};ArmSmmu4KMmio mapping={(volatile unsigned char *)storage,sizeof(storage)};ArmSmmu4KIo io;
+    CHECK(ArmSmmu4KBindMmio(&mapping,&io)==ArmSmmu4KSuccess);
+    uint32_t a=0;uint64_t b=0;
+    CHECK(!io.write32(io.cookie,0,0xaabbccdd) && !io.read32(io.cookie,0,&a) && a==0xaabbccdd);
+    CHECK(!io.write64(io.cookie,8,UINT64_C(0x123456789abcdef0)) && !io.read64(io.cookie,8,&b) && b==UINT64_C(0x123456789abcdef0));
+    CHECK(!io.barrier(io.cookie));
+    CHECK(io.read32(io.cookie,1,&a) && io.read64(io.cookie,4,&b));
+    CHECK(io.write32(io.cookie,sizeof(storage),1) && io.write64(io.cookie,sizeof(storage)-4,1));
+    CHECK(io.read32(io.cookie,SIZE_MAX,&a) && io.read64(io.cookie,SIZE_MAX-7,&b));
+    CHECK(io.read32(io.cookie,0,NULL) && io.read64(io.cookie,8,NULL));
+    mapping.mapping++;CHECK(ArmSmmu4KBindMmio(&mapping,&io)==ArmSmmu4KArgument);
+    CHECK(!io.read32 && !io.write64);
+    mapping.mapping=(volatile unsigned char *)(UINTPTR_MAX-7);mapping.bytes=64;
+    CHECK(ArmSmmu4KBindMmio(&mapping,&io)==ArmSmmu4KArgument);
+}
+int main(void)
+{
+#ifdef SOURCE_ORACLE
+    source_definitions();
+#endif
+    ArmSmmu4KRange a={0x1000,0x20000000,4096,3,1,3},b=a;b.iova=UINT64_MAX-4095;
+    CHECK(ArmSmmu4KBuild(&lower,&a,1,lower_tables,8,&lr)==ArmSmmu4KSuccess);
+    CHECK(ArmSmmu4KBuildUpper(&upper,&b,1,upper_tables,8,&ur)==ArmSmmu4KSuccess);
+    ArmSmmu4KProgramResult r;size_t successful_calls=0;
+    for(unsigned spacing=0;spacing<2;++spacing) {
+        ArmSmmu4KIo io=reset(spacing);
+        CHECK(ArmSmmu4KProgramDisabledContext(&io,f.bank,&config,4,&r)==ArmSmmu4KSuccess);
+        CHECK(r.phase==5 && r.enabled && r.readback_valid && r.tlb_synchronized && r.must_retain_tables && !r.disabled_verified);
+        CHECK(r.id0==(1u<<30) && r.id2==0x1555 && r.context_offset==f.cb);
+        CHECK((r.readback.tcr>>14&3)==0 && (r.readback.tcr>>30&3)==2);
+        CHECK(first(2,f.gr1+0x800+f.bank*4)<first(2,f.gr1+f.bank*4));
+        CHECK(first(2,f.cb+0x10)<first(2,f.cb+0x30) && first(2,f.cb+0x30)<first(3,f.cb+0x20));
+        CHECK(first(3,f.cb+0x20)<first(3,f.cb+0x28) && first(2,f.cb+0x610)<first(2,f.cb+0x7f0));
+        for(size_t i=0;i<f.event_count;++i)if(f.events[i].kind==2 || f.events[i].kind==3) {
+            size_t at=f.events[i].at;
+            CHECK((at>=f.cb && at<f.cb+0x800) || at==f.gr1+f.bank*4 || at==f.gr1+0x800+f.bank*4);
+            if(at==f.cb && f.events[i].value&1)CHECK(i>first(2,f.cb+0x7f0));
+        }
+        successful_calls=f.calls;
+        /* Synchronize uses TLBIASID with the ASID; InvalidateAll uses TLBIALL; both sync and change nothing else. */
+        f.event_count=f.calls=0;
+        CHECK(ArmSmmu4KSynchronizeOwnedContext(&io,f.bank,&config,4,&r)==ArmSmmu4KSuccess && r.tlb_synchronized);
+        CHECK(f.events[first(2,f.cb+0x610)].value==0xabcd && first(2,f.cb+0x610)<first(2,f.cb+0x7f0));
+        for(size_t i=0;i<f.event_count;++i)if(f.events[i].kind==2)CHECK(f.events[i].at==f.cb+0x610 || f.events[i].at==f.cb+0x7f0);
+        f.event_count=f.calls=0;
+        CHECK(ArmSmmu4KInvalidateAllOwnedContext(&io,f.bank,&config,4,&r)==ArmSmmu4KSuccess && r.tlb_synchronized && get32(f.cb)&1);
+        CHECK(first(2,f.cb+0x618)<first(2,f.cb+0x7f0));
+        for(size_t i=0;i<f.event_count;++i)if(f.events[i].kind==2)CHECK(f.events[i].at==f.cb+0x618 || f.events[i].at==f.cb+0x7f0);
+        ArmSmmu4KContextConfig other=config;other.asid++;f.event_count=f.calls=0;
+        CHECK(ArmSmmu4KInvalidateAllOwnedContext(&io,f.bank,&other,4,&r)!=ArmSmmu4KSuccess);no_writes();
+        /* A different ASID/root must never disable an unrelated context. */
+        ArmSmmu4KContextConfig wrong=config;wrong.asid++;
+        f.event_count=f.calls=0;
+        CHECK(ArmSmmu4KDisableOwnedContext(&io,f.bank,&wrong,4,&r)==ArmSmmu4KStateMismatch);no_writes();CHECK(r.must_retain_tables);
+        CHECK(ArmSmmu4KDisableOwnedContext(&io,f.bank,&config,4,&r)==ArmSmmu4KSuccess);
+        CHECK(r.phase==7 && !r.enabled && r.disabled_verified && r.tlb_synchronized && !r.must_retain_tables && !get32(f.cb));
+        CHECK(ArmSmmu4KDisableOwnedContext(&io,f.bank,&config,4,&r)==ArmSmmu4KSuccess);
+    }
+    /* The sheng Adreno SMMU's read-only bits: program, observe and disable all succeed. */
+    {
+        ArmSmmu4KIo io=reset(0);f.sheng_bits=1;
+        CHECK(ArmSmmu4KProgramDisabledContext(&io,f.bank,&config,4,&r)==ArmSmmu4KSuccess && r.enabled);
+        CHECK(get32(f.cb+0x10)&0x60 && !(get32(f.cb)&0x1000));
+        CHECK(ArmSmmu4KObserveOwnedContext(&io,f.bank,&config,&r)==ArmSmmu4KSuccess);
+        CHECK(ArmSmmu4KDisableOwnedContext(&io,f.bank,&config,4,&r)==ArmSmmu4KSuccess && !get32(f.cb));
+        f.sheng_bits=0;
+    }
+    size_t faults=0;
+    for(unsigned after=0;after<2;++after)for(size_t call=1;call<=successful_calls;++call) {
+        ArmSmmu4KIo io=reset(0);f.fail_call=call;f.fail_after_write=after;
+        CHECK(ArmSmmu4KProgramDisabledContext(&io,f.bank,&config,4,&r)==ArmSmmu4KIoError);
+        if(r.writes)CHECK(!get32(f.cb) && r.disabled_verified && r.tlb_synchronized && !r.must_retain_tables);
+        else {no_writes();CHECK(r.must_retain_tables);}++faults;
+    }
+    ArmSmmu4KIo io=reset(0);put32(f.cb,1);
+    CHECK(ArmSmmu4KProgramDisabledContext(&io,f.bank,&config,4,&r)==ArmSmmu4KBusy);no_writes();CHECK(r.enabled && r.must_retain_tables);
+    io=reset(0);put32(0x28,0x555);config.id0=1u<<30;config.id2=0x1555;
+    CHECK(ArmSmmu4KProgramDisabledContext(&io,f.bank,&config,4,&r)==ArmSmmu4KUnsupported);no_writes();
+    io=reset(0);CHECK(ArmSmmu4KProgramDisabledContext(&io,1,&config,4,&r)==ArmSmmu4KUnsupported);no_writes();
+    io=reset(0);io.register_bytes=BYTES-1;
+    CHECK(ArmSmmu4KProgramDisabledContext(&io,f.bank,&config,4,&r)==ArmSmmu4KUnsupported);no_writes();
+    io=reset(0);CHECK(ArmSmmu4KProgramDisabledContext(&io,f.bank,&config,0,&r)==ArmSmmu4KArgument);CHECK(!f.calls);
+    io=reset(0);f.corrupt_tcr=1;
+    CHECK(ArmSmmu4KProgramDisabledContext(&io,f.bank,&config,4,&r)==ArmSmmu4KStateMismatch);never_enabled();CHECK(r.disabled_verified && !r.must_retain_tables);
+    io=reset(0);f.corrupt_enable=1;
+    CHECK(ArmSmmu4KProgramDisabledContext(&io,f.bank,&config,4,&r)==ArmSmmu4KStateMismatch);CHECK(r.disabled_verified && !r.must_retain_tables);
+    io=reset(0);f.timeout=1;
+    CHECK(ArmSmmu4KProgramDisabledContext(&io,f.bank,&config,4,&r)==ArmSmmu4KTimeout);never_enabled();
+    CHECK(r.poll_reads==8 && r.disabled_verified && !r.tlb_synchronized && r.must_retain_tables);
+    io=reset(0);f.fault_on_enable=1;
+    CHECK(ArmSmmu4KProgramDisabledContext(&io,f.bank,&config,4,&r)==ArmSmmu4KFault);
+    CHECK(r.fault_status==2 && r.disabled_verified && !r.must_retain_tables && !r.enabled);
+    io=reset(0);f.fault_on_enable=1;f.fail_disable=1;
+    CHECK(ArmSmmu4KProgramDisabledContext(&io,f.bank,&config,4,&r)==ArmSmmu4KFault);
+    CHECK(r.enabled && !r.disabled_verified && r.must_retain_tables && get32(f.cb)&1);
+    direct_adapter();
+    printf("PASS: real programming/disable code on software I/O fixture, TCR-before-TTBR/enable ordering, %zu I/O failure controls, bounded timeout/quarantine, fault/refusal, sheng read-only TBI/ASIDPNE bits and direct AArch64 adapter memory checks\n",faults);
+    puts("No hardware MMIO, active GPU translation or GPU execution observed");
+}
diff --git a/iokit/NativeAdreno/kits/ArmSmmu4K/test_streams.c b/iokit/NativeAdreno/kits/ArmSmmu4K/test_streams.c
new file mode 100644
index 0000000..47cce21
--- /dev/null
+++ b/iokit/NativeAdreno/kits/ArmSmmu4K/test_streams.c
@@ -0,0 +1,155 @@
+/* SPDX-License-Identifier: MIT */
+/* Software SMMUv2 register peer only: no device or active hardware proof. */
+#include "ArmSmmu4KStreams.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define CHECK(x) do {if(!(x)){fprintf(stderr,"line %d: %s\n",__LINE__,#x);exit(1);}}while(0)
+#define BYTES 0x40000
+#define CB 0x22000
+static uint32_t memory[BYTES/4];
+static struct {unsigned calls,fail_call,after,writes,events,corrupt,cleanup_fail;size_t at[1024];uint32_t value[1024];} f;
+static ArmSmmu4KIo io;
+static ArmSmmu4KStreamState state;
+static ArmSmmu4KStream routes[2]={{2,0},{4,1}};
+static ArmSmmu4KStreamResult result;
+static uint64_t tables[2048];
+static ArmSmmu4KConfig lower={32,40,0x10000000,1};
+static ArmSmmu4KResult built;
+static ArmSmmu4KContextConfig config;
+#ifdef SOURCE_ORACLE
+extern void source_stream(unsigned,unsigned,unsigned,unsigned,unsigned,uint32_t *,uint32_t *);
+extern uint32_t source_stream_register(unsigned);
+#endif
+static int event(void){return ++f.calls==f.fail_call;}
+static int read32(void *cookie,size_t at,uint32_t *v)
+{CHECK(cookie==&f && at%4==0 && at<=BYTES-4);if(event())return 1;*v=memory[at/4];return 0;}
+static int read64(void *cookie,size_t at,uint64_t *v)
+{CHECK(cookie==&f && at%8==0 && at<=BYTES-8);if(event())return 1;memcpy(v,memory+at/4,8);return 0;}
+static int write32(void *cookie,size_t at,uint32_t v)
+{
+    CHECK(cookie==&f && at%4==0 && at<=BYTES-4 && f.events<1024);
+    ++f.writes;f.at[f.events]=at;f.value[f.events++]=v;
+    int fail=event();if(fail && !f.after)return 1;
+    if(f.cleanup_fail && v==0x20000)return 1;
+    memory[at/4]=v;
+    if(f.corrupt && at==0x808)memory[at/4]^=2;
+    return fail;
+}
+static int write64(void *cookie,size_t at,uint64_t v)
+{(void)cookie;(void)at;(void)v;CHECK(0);return 1;}
+static int barrier(void *cookie){CHECK(cookie==&f);return event();}
+static void reset(unsigned exid)
+{
+    memset(memory,0,sizeof(memory));memset(&f,0,sizeof(f));state=(ArmSmmu4KStreamState){0};
+    io=(ArmSmmu4KIo){&f,BYTES,read32,read64,write32,write64,barrier};
+    memory[0x20/4]=(1u<<30)|(1u<<27)|(4u<<9)|8|(exid<<8);
+    memory[0x24/4]=0x40000010;memory[0x28/4]=0x1433;memory[0]=0x436|(exid<<3);
+    config=(ArmSmmu4KContextConfig){.lower=&lower,.lower_tables=&built,.asid=1,.coherent_walk=1,.continue_after_fault=1};
+    ArmSmmu4KContextConfig actual=config;actual.id0=memory[0x20/4];actual.id2=memory[0x28/4];
+    ArmSmmu4KContextImage image;CHECK(!ArmSmmu4KEncodeContext(&actual,&image));
+    memory[0x1008/4]=image.cbar;memory[0x1808/4]=image.cba2r;
+    memory[CB/4]=image.sctlr;memory[(CB+0x10)/4]=image.tcr2;memory[(CB+0x30)/4]=image.tcr;
+    memcpy(memory+(CB+0x20)/4,&image.ttbr0,8);memcpy(memory+(CB+0x28)/4,&image.ttbr1,8);
+    memory[(CB+0x38)/4]=image.mair0;
+    for(unsigned i=0;i<8;++i)memory[(0xc00+4*i)/4]=0x20000;
+    /* An unrelated live route, never to be altered by attachment/recovery. */
+    memory[0x800/4]=(exid?0:1u<<31)|9;memory[0xc00/4]=(exid?1u<<10:0)|3;
+}
+static ArmSmmu4KStatus attach(void)
+{return ArmSmmu4KAttachStreams(&io,&state,routes,2,2,&config,&result);}
+static void isolated(unsigned exid)
+{
+    CHECK(memory[0x800/4]==((exid?0:1u<<31)|9) && memory[0xc00/4]==((exid?1u<<10:0)|3));
+    for(unsigned i=0;i<f.events;++i) {
+        CHECK(f.at[i]==0x808 || f.at[i]==0x810 || f.at[i]==0xc08 || f.at[i]==0xc10);
+        if(f.at[i]>=0xc00)CHECK(((f.value[i]>>16)&3)!=1); /* Never BYPASS. */
+    }
+}
+int main(void)
+{
+    ArmSmmu4KRange range={0,0x20000000,4096,3,0,2};
+    CHECK(!ArmSmmu4KBuild(&lower,&range,1,tables,4,&built));
+#ifdef SOURCE_ORACLE
+    const uint32_t offsets[]={0,0x20,0x48,0x808,0xc08,0x80000000,0x400,0x400};
+    for(unsigned i=0;i<sizeof(offsets)/sizeof(offsets[0]);++i)CHECK(source_stream_register(i)==offsets[i]);
+#endif
+    unsigned fault_cases=0;
+    for(unsigned exid=0;exid<2;++exid) {
+        reset(exid);CHECK(!attach() && state.attached && result.streams_verified==2 && result.context.enabled && result.must_retain_resources);
+        unsigned normal_calls=f.calls;
+        CHECK(f.at[0]==0xc08 && f.at[1]==0x808);
+        for(unsigned i=0;i<2;++i) {
+            uint32_t smr=(exid?0:1u<<31)|routes[i].sid,s2cr=2|(exid?1u<<10:0);
+#ifdef SOURCE_ORACLE
+            source_stream(exid,routes[i].sid,0,1,2,&smr,&s2cr);
+#endif
+            CHECK(memory[(0x800+4*routes[i].slot)/4]==smr && memory[(0xc00+4*routes[i].slot)/4]==s2cr);
+        }
+        unsigned writes=f.writes;CHECK(!ArmSmmu4KObserveStreams(&io,&state,&config,&result) && f.writes==writes);
+        const unsigned full_reads=result.reads;
+        CHECK(!ArmSmmu4KObserveOwnedStreams(&io,&state,&config,&result) && f.writes==writes && result.streams_verified==2);
+        CHECK(result.reads==3+2*2 && result.reads<full_reads && result.context.enabled);
+        /* Every read or barrier failing is an I/O error, never a pass. */
+        for(unsigned at=1;;++at) {
+            f.calls=0;f.fail_call=at;
+            const ArmSmmu4KStatus st=ArmSmmu4KObserveOwnedStreams(&io,&state,&config,&result);
+            if(!st){CHECK(at>1);break;}
+            CHECK(st==ArmSmmu4KIoError && f.writes==writes);++fault_cases;
+        }
+        f.fail_call=0;f.calls=0;
+        CHECK(attach()==ArmSmmu4KBusy && f.writes==writes);
+        CHECK(!ArmSmmu4KFaultStreams(&io,&state,&result) && !state.attached && !state.poisoned && result.streams_faulted==2 && result.must_retain_resources);
+        isolated(exid);
+        for(unsigned i=0;i<2;++i)CHECK(memory[(0xc00+4*routes[i].slot)/4]==(0x20000|(exid?1u<<10:0)));
+        for(unsigned at=1;at<=normal_calls;++at)for(unsigned after=0;after<2;++after) {
+            reset(exid);f.fail_call=at;f.after=after;
+            CHECK(attach()==ArmSmmu4KIoError && result.must_retain_resources && !state.attached);
+            if(state.attempted){CHECK(state.poisoned && result.streams_faulted);CHECK(attach()==ArmSmmu4KBusy);}
+            else CHECK(!f.writes);
+            isolated(exid);++fault_cases;
+        }
+        reset(exid);f.corrupt=1;
+        CHECK(attach()==ArmSmmu4KStateMismatch && state.poisoned && !state.attached && result.must_retain_resources);
+        isolated(exid);
+        reset(exid);f.fail_call=45;f.cleanup_fail=1;
+        CHECK(attach()!=ArmSmmu4KSuccess && result.must_retain_resources);isolated(exid);
+        /* Every global/context/route refusal must precede any register write. */
+        for(unsigned control=0;control<16;++control) {
+            reset(exid);
+            switch(control) {
+            case 0:memory[0]|=1;break;case 1:memory[0]&=~0x400;break;case 2:memory[0]^=8;break;
+            case 3:memory[0x48/4]=2;break;case 4:memory[(CB+0x30)/4]^=1u<<14;break;
+            case 5:memory[CB/4]&=~1;break;case 6:memory[(CB+0x58)/4]=2;break;
+            case 7:memory[0xc08/4]=0x10000;break;
+            case 8:memory[0x800/4]=(exid?0:1u<<31)|0;break; /* exact collision */
+            case 9:memory[0x800/4]=(exid?0:1u<<31)|(15u<<16)|8;break; /* masked collision */
+            case 10:memory[0x20/4]&=~(1u<<27);break;
+            case 11:memory[0x808/4]=(exid?0:1u<<31)|7;memory[0xc08/4]|=exid?1u<<10:0;break;
+            case 12:memory[0x20/4]&=~255u;break;
+            case 13:memory[0xc00/4]=(exid?1u<<10:0)|2;break;
+            case 14:memory[0]&=~2u;break;   /* no global fault reporting */
+            case 15:memory[0]&=~4u;break;   /* no global fault interrupt */
+            }
+            CHECK(attach()!=ArmSmmu4KSuccess && !f.writes && !state.attempted && result.must_retain_resources);
+        }
+        /* Configuration-access fault reporting clear, as the sheng Adreno SMMU firmware leaves it (0x002f0406). */
+        reset(exid);memory[0]&=~0x30u;
+        CHECK(!attach() && state.attached);
+        reset(exid);
+        CHECK(!ArmSmmu4KCheckFaultedStreams(&io,routes,2,2,&result) && !f.writes);
+        CHECK(!attach());writes=f.writes;memory[0xc08/4]^=1;
+        CHECK(ArmSmmu4KObserveStreams(&io,&state,&config,&result)==ArmSmmu4KStateMismatch && f.writes==writes);
+        CHECK(ArmSmmu4KObserveOwnedStreams(&io,&state,&config,&result)==ArmSmmu4KStateMismatch && f.writes==writes);
+        memory[0xc08/4]^=1;memory[0x810/4]^=1;
+        CHECK(ArmSmmu4KObserveOwnedStreams(&io,&state,&config,&result)==ArmSmmu4KStateMismatch && f.writes==writes);
+        memory[0x810/4]^=1;memory[0]|=1;
+        CHECK(ArmSmmu4KObserveOwnedStreams(&io,&state,&config,&result)==ArmSmmu4KStateMismatch && f.writes==writes);
+        memory[0]&=~1u;memory[CB/4]&=~1u;
+        CHECK(ArmSmmu4KObserveOwnedStreams(&io,&state,&config,&result)!=ArmSmmu4KSuccess && f.writes==writes);
+        memory[CB/4]|=1u;CHECK(!ArmSmmu4KObserveOwnedStreams(&io,&state,&config,&result));
+        memory[0xc08/4]^=1;
+        CHECK(ArmSmmu4KFaultStreams(&io,&state,&result)==ArmSmmu4KStateMismatch && f.writes==writes);
+    }
+    printf("PASS: legacy/EXIDS stream attachment and quarantine, %u per-call I/O failure cases, 32 pre-write refusals, 2 attachments without GCFGFRE/GCFGFIE, actual context readback and unrelated-route isolation (software registers only)\n",fault_cases);
+}
diff --git a/iokit/NativeAdreno/kits/ArmSmmu4K/test_tables.c b/iokit/NativeAdreno/kits/ArmSmmu4K/test_tables.c
new file mode 100644
index 0000000..16dc91a
--- /dev/null
+++ b/iokit/NativeAdreno/kits/ArmSmmu4K/test_tables.c
@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4K.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define CHECK(c) do { if (!(c)) { fprintf(stderr,"line %d: %s\n",__LINE__,#c);exit(1); } } while (0)
+#define CAPACITY 1024
+static uint64_t tables[CAPACITY * 512], before[CAPACITY * 512];
+static unsigned visited[CAPACITY];
+static uint64_t walk_at(const uint64_t *base, const ArmSmmu4KResult *result, uint64_t va)
+{
+    size_t page = 0;
+    for (unsigned level = result->start_level; level <= 3; ++level) {
+        uint64_t entry = base[page * 512 + ((va >> (39 - 9 * level)) & 511)];
+        if (!entry) return 0;
+        CHECK((entry & 3) == 3); /* No block leaves anywhere. */
+        if (level == 3) return entry;
+        uint64_t address = entry & UINT64_C(0xfffffffff000);
+        CHECK(address >= result->root_physical);
+        page = (address - result->root_physical) >> 12;
+        CHECK(page < result->table_pages);
+    }
+    exit(1);
+}
+static size_t graph(size_t page, unsigned level, const ArmSmmu4KResult *result, size_t *leaves)
+{
+    CHECK(page < result->table_pages && !visited[page]);
+    visited[page] = 1;
+    size_t count = 1;
+    for (size_t slot = 0; slot < 512; ++slot) {
+        uint64_t entry = tables[page * 512 + slot];
+        if (!entry) continue;
+        CHECK((entry & 3) == 3);
+        if (level == 3) { ++*leaves; continue; }
+        CHECK(!(entry & ~UINT64_C(0xfffffffff003)));
+        CHECK((entry & UINT64_C(0xfffffffff000)) >= result->root_physical);
+        size_t child = ((entry & UINT64_C(0xfffffffff000)) - result->root_physical) >> 12;
+        count += graph(child, level + 1, result, leaves);
+    }
+    return count;
+}
+static void verify(const ArmSmmu4KConfig *config, const ArmSmmu4KRange *ranges, size_t n, const ArmSmmu4KResult *result)
+{
+    CHECK(result->root_physical == config->table_physical && result->mair == 0xff44 && !result->upper_region);
+    size_t leaves = 0;
+    memset(visited, 0, sizeof(visited));
+    CHECK(graph(0, result->start_level, result, &leaves) == result->table_pages);
+    CHECK(leaves == result->leaf_pages);
+    size_t checked = 0;
+    for (size_t i = 0; i < n; ++i) {
+        for (uint64_t off = 0; off < ranges[i].bytes; off += 4096) {
+            uint64_t entry = walk_at(tables,result, ranges[i].iova + off);
+            CHECK((entry & UINT64_C(0xfffffffff000)) == ranges[i].physical + off);
+            CHECK(((entry >> 53) & 3) == (ranges[i].permissions & ArmSmmu4KExecute ? 0 : 3));
+            CHECK(((entry >> 10) & 1) && ((entry >> 11) & 1));
+            CHECK(((entry >> 6) & 1) == !(ranges[i].permissions & ArmSmmu4KPrivileged));
+            CHECK(((entry >> 7) & 1) == !(ranges[i].permissions & ArmSmmu4KWrite));
+            CHECK(((entry >> 2) & 7) == ranges[i].writeback);
+            CHECK(((entry >> 8) & 3) == ranges[i].shareability);
+            ++checked;
+        }
+        if (i + 1 < n && ranges[i].iova + ranges[i].bytes < ranges[i + 1].iova)
+            CHECK(!walk_at(tables,result, ranges[i].iova + ranges[i].bytes));
+    }
+    CHECK(checked == result->leaf_pages);
+    /* Successful building touches only the actually used table pages. */
+    CHECK(!memcmp(tables + result->table_pages * 512, before + result->table_pages * 512,
+                  (CAPACITY - result->table_pages) * 4096));
+}
+static void refusal(ArmSmmu4KConfig c, const ArmSmmu4KRange *r, size_t n, size_t capacity, ArmSmmu4KStatus status)
+{
+    ArmSmmu4KResult result;
+    memset(tables, 0xa5, sizeof(tables));memcpy(before,tables,sizeof(tables));
+    memset(&result,0xa5,sizeof(result));
+    CHECK(ArmSmmu4KBuild(&c,r,n,tables,capacity,&result) == status);
+    CHECK(!result.root_physical && !result.mair && !result.table_pages && !result.leaf_pages && !result.start_level && !result.upper_region);
+    CHECK(!memcmp(tables,before,sizeof(tables)));
+}
+static void success(ArmSmmu4KConfig c, const ArmSmmu4KRange *r, size_t n)
+{
+    ArmSmmu4KResult result;
+    memset(tables,0xa5,sizeof(tables));memcpy(before,tables,sizeof(tables));
+    CHECK(ArmSmmu4KBuild(&c,r,n,tables,CAPACITY,&result) == ArmSmmu4KSuccess);
+    verify(&c,r,n,&result);
+}
+int main(void)
+{
+    ArmSmmu4KConfig c = {48,48,0x10000000,4096};
+    ArmSmmu4KRange r[] = {
+        {0,0x20000000,0x3000,1,0,2}, {0x1ff000,0x21000000,0x3000,3,1,3},
+        {0x3ffff000,0x22000000,0x3000,1,1,3}, {UINT64_C(0x7ffffff000),0x23000000,0x3000,3,0,2},
+        {UINT64_C(0xfffffffff000),UINT64_C(0xfffffffff000),0x1000,1,0,2}
+    };
+    success(c,r,5);
+    refusal(c,r,5,1,ArmSmmu4KCapacity);
+    c.leaf_budget = 12;refusal(c,r,5,CAPACITY,ArmSmmu4KBudget);c.leaf_budget=4096;
+    ArmSmmu4KRange bad[5];memcpy(bad,r,sizeof(r));
+    bad[4].bytes=8192;refusal(c,bad,5,CAPACITY,ArmSmmu4KBadRange);
+    memcpy(bad,r,sizeof(r));bad[4].physical += 4096;refusal(c,bad,5,CAPACITY,ArmSmmu4KBadRange);
+    memcpy(bad,r,sizeof(r));bad[3].iova=0;refusal(c,bad,5,CAPACITY,ArmSmmu4KOverlap);
+    memcpy(bad,r,sizeof(r));bad[3].physical=c.table_physical;refusal(c,bad,5,CAPACITY,ArmSmmu4KOverlap);
+    memcpy(bad,r,sizeof(r));bad[3].physical=r[1].physical;refusal(c,bad,5,CAPACITY,ArmSmmu4KOverlap);
+    bad[3].writeback=1;bad[3].shareability=3;success(c,bad,5); /* Consistent physical aliases allowed. */
+    memcpy(bad,r,sizeof(r));bad[3].permissions=2;refusal(c,bad,5,CAPACITY,ArmSmmu4KBadRange);
+    memcpy(bad,r,sizeof(r));bad[3].iova++;refusal(c,bad,5,CAPACITY,ArmSmmu4KBadRange);
+    memcpy(bad,r,sizeof(r));bad[3].writeback=2;refusal(c,bad,5,CAPACITY,ArmSmmu4KBadRange);
+    memcpy(bad,r,sizeof(r));bad[3].shareability=1;refusal(c,bad,5,CAPACITY,ArmSmmu4KBadRange);
+    memcpy(bad,r,sizeof(r));bad[3].physical=r[1].physical;bad[3].writeback=1;
+    refusal(c,bad,5,CAPACITY,ArmSmmu4KOverlap); /* Same MAIR, different SH. */
+    c.table_physical++;refusal(c,r,5,CAPACITY,ArmSmmu4KBadRange);c.table_physical--;
+    c.input_bits=49;refusal(c,r,5,CAPACITY,ArmSmmu4KArgument);c.input_bits=48;
+    c.output_bits=52;refusal(c,r,5,CAPACITY,ArmSmmu4KArgument);c.output_bits=48;
+    ArmSmmu4KRange many[256];
+    for (unsigned bits=32;bits<=48;++bits) {
+        c.input_bits=bits;
+        uint64_t limit=UINT64_C(1)<<bits;
+        for (size_t i=0;i<256;++i) many[i]=(ArmSmmu4KRange){(limit/256*i)&~UINT64_C(4095),0x30000000+i*4096,4096,i&1?1:3,(unsigned)(i&1),2u+(unsigned)(i&1)};
+        many[255].iova=limit-4096;
+        success(c,many,256);
+    }
+    c.input_bits=32;
+    unsigned output_bits[]={32,36,40,42,44,48};
+    for (size_t i=0;i<6;++i) {
+        c.output_bits=output_bits[i];
+        ArmSmmu4KRange edge={0x1000,(UINT64_C(1)<<c.output_bits)-4096,4096,1,0,2};
+        success(c,&edge,1);
+        edge.bytes=8192;refusal(c,&edge,1,CAPACITY,ArmSmmu4KBadRange);
+    }
+    refusal(c,r,0,CAPACITY,ArmSmmu4KArgument);
+    CHECK(ArmSmmu4KBuild(&c,r,1,tables,CAPACITY,NULL)==ArmSmmu4KArgument);
+    refusal(c,r,SIZE_MAX,CAPACITY,ArmSmmu4KArgument);
+    refusal(c,r,1,SIZE_MAX,ArmSmmu4KArgument);
+    refusal(c,r,1,0,ArmSmmu4KArgument);
+    c.table_physical=(UINT64_C(1)<<c.output_bits)-4096;
+    refusal(c,r,1,CAPACITY,ArmSmmu4KBadRange);
+    c.table_physical=0x10000000;c.input_bits=48;
+    ArmSmmu4KRange one={0x1000,0x40000000,4096,1,0,2};
+    for (unsigned cache=0;cache<=1;++cache) {
+        for (unsigned sh=2;sh<=3;++sh) {
+            one.writeback=cache;one.shareability=sh;
+            success(c,&one,1);
+        }
+    }
+    for(unsigned permissions=0;permissions<32;++permissions) {
+        one.permissions=permissions;
+        if((permissions&1) && !(permissions&~15u))success(c,&one,1);
+        else refusal(c,&one,1,CAPACITY,ArmSmmu4KBadRange);
+    }
+    ArmSmmu4KRange aliases[2]={{0x1000,0x40000000,4096,3,0,2},{0x2000,0x40000000,4096,11,0,2}};
+    refusal(c,aliases,2,CAPACITY,ArmSmmu4KOverlap);
+    one.permissions=1;one.writeback=0;one.shareability=2;
+    ArmSmmu4KResult first,second_result;
+    CHECK(ArmSmmu4KBuild(&c,&one,1,tables,CAPACITY,&first)==ArmSmmu4KSuccess);
+    memcpy(before,tables,sizeof(tables));
+    static uint64_t second[CAPACITY*512];
+    c.table_physical=0x11000000;one.physical=0x50000000;
+    CHECK(ArmSmmu4KBuild(&c,&one,1,second,CAPACITY,&second_result)==ArmSmmu4KSuccess);
+    CHECK(!memcmp(tables,before,sizeof(tables)));
+    CHECK((walk_at(tables,&first,one.iova)&UINT64_C(0xfffffffff000))==0x40000000);
+    CHECK((walk_at(second,&second_result,one.iova)&UINT64_C(0xfffffffff000))==0x50000000);
+    puts("PASS: native 4K leaves, independent table graph/walk, 2M/1G/512G boundaries, IAS32..48, six OAS widths, transactional refusals");
+}
