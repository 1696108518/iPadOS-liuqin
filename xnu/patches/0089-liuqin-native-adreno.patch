+    reg64(&out, pvt_base, 0);
+    reg32(&out, pvt_size, 0);
+    reg32(&out, stack, 0);
+    reg32(&out, vgs, 0);
+    return (struct AdrenoShaderResult){AdrenoShaderOK, ADRENO_SHADER_BIND_WORDS, 13};
+}
