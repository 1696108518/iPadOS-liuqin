+       s->point_size_q4>65472 || s->line_width_q1>255 ||
+       !finite32(s->offset_scale_bits) || !finite32(s->offset_units_bits) ||
+       !finite32(s->offset_clamp_bits)) return fail(AdrenoRasterProfile);
