+    return (struct AdrenoRasterResult){s,0,0};
+}
+static int wraps(uintptr_t p,size_t n) { return n>UINTPTR_MAX-p; }
+static int overlap(uintptr_t a,size_t n,uintptr_t b,size_t m) {
+    return n && m && a<b+m && b<a+n;
