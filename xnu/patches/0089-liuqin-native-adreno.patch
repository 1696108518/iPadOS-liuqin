@@ -0,0 +1,7 @@
+# ArmSmmu4K
+
+ARM SMMUv2 native 4 KiB table kit. Builds stage-1 tables, context and streams, updates live mappings and performs TLB maintenance.
+
+Current state: used by the GPU and storage SMMU paths on sheng.
+
+Built into the kernel with the sheng storage and GPU stacks.
diff --git a/iokit/NativeAdreno/kits/ArmSmmu4K/test_alias.c b/iokit/NativeAdreno/kits/ArmSmmu4K/test_alias.c
new file mode 100644
index 0000000..63cbd62
--- /dev/null
+++ b/iokit/NativeAdreno/kits/ArmSmmu4K/test_alias.c
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: MIT */
+/* The sorted physical-alias check against the pairwise definition (conflicting_alias over every pair) on random sets: scattered
+ * single pages and long runs, up to eight attribute classes, self and cross comparisons, with scratch, without it and with too
+ * little of it; then one int-144-sized case (24k coherent import pages beside 82k non-cacheable pages) for its cost. */
+#ifndef ARM_SMMU4K_ALIAS_SOURCE
+#define ARM_SMMU4K_ALIAS_SOURCE "ArmSmmu4KLive.c"
+#endif
+#include ARM_SMMU4K_ALIAS_SOURCE
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#ifdef ARM_SMMU4K_TEST_COVERAGE
+/* Compiler basic-block coverage counts, test-only. Production needs no hook or
+ * counter. Volatile keeps the caller's reads intact before coverage insertion. */
+static volatile uint64_t alias_steps;
+__attribute__((no_sanitize("coverage"))) void __sanitizer_cov_trace_pc_guard(uint32_t *guard)
+{(void)guard;++alias_steps;}
+__attribute__((no_sanitize("coverage"))) void __sanitizer_cov_trace_pc_guard_init(uint32_t *start,uint32_t *end)
+{if(start==end || *start)return;for(uint32_t *p=start;p<end;++p)*p=1;}
+#endif
+#define CHECK(x) do{if(!(x)){fprintf(stderr,"%s:%d: %s\n",__FILE__,__LINE__,#x);exit(1);}}while(0)
+static uint64_t seed=0x9e3779b97f4a7c15ull;
+static uint64_t rnd(void){seed^=seed<<13;seed^=seed>>7;seed^=seed<<17;return seed;}
+static int pairwise(const ArmSmmu4KRange *a,size_t na,const ArmSmmu4KRange *b,size_t nb)
+{
+    for(size_t i=0;i<na;++i)for(size_t j=0;j<nb;++j) {
+        const int different=a[i].writeback!=b[j].writeback || a[i].shareability!=b[j].shareability ||
+            ((a[i].permissions^b[j].permissions)&ArmSmmu4KPrivileged);
+        if(different && a[i].physical<b[j].physical+b[j].bytes && b[j].physical<a[i].physical+a[i].bytes)return 1;
+    }
+    return 0;
+}
+static void fill(ArmSmmu4KRange *r,size_t n,unsigned classes,uint64_t span)
+{
+    for(size_t i=0;i<n;++i) {
+        const unsigned c=(unsigned)(rnd()%classes);
+        const uint64_t pages=(rnd()%8)?1:1+rnd()%64;
+        r[i]=(ArmSmmu4KRange){0x100000+i*0x100000,0x80000000+(rnd()%span)*4096,pages*4096,
+            (c&2)?3u|ArmSmmu4KPrivileged:3u,c&1u,(c&4u)?3u:2u};
+    }
+}
+static uint32_t scratch[1u<<18];
+int main(void)
+{
+    static ArmSmmu4KRange a[4096],b[4096];
+    ArmSmmu4KLiveArena with={0},without={0},small={0};
+    with.alias_scratch=scratch;with.alias_scratch_entries=sizeof scratch/sizeof *scratch;
+    small.alias_scratch=scratch;small.alias_scratch_entries=3;
+    unsigned cases=0,conflicts=0;
+    for(unsigned round=0;round<3000;++round) {
+        const size_t na=1+rnd()%(round<2000?40:600),nb=1+rnd()%(round<2000?40:600);
+        const unsigned classes=1+(unsigned)(rnd()%8);
+        const uint64_t span=1+rnd()%(round&1?200000:4000);
+        fill(a,na,classes,span);fill(b,nb,classes,span);
+        const int cross=pairwise(a,na,b,nb),self=pairwise(a,na,a,na);
+        CHECK(any_conflicting_alias(&with,a,na,b,nb)==cross && any_conflicting_alias(&with,b,nb,a,na)==cross);
+        CHECK(any_conflicting_alias(&without,a,na,b,nb)==cross && any_conflicting_alias(&small,a,na,b,nb)==cross);
+        CHECK(any_conflicting_alias(&with,a,na,a,na)==self && any_conflicting_alias(&small,a,na,a,na)==self);
+        cases+=5;conflicts+=(unsigned)(cross+self);
+    }
+    /* int-144's shape: 23855 coherent import pages and 82000 non-cacheable pages, disjoint, then one aliased page. */
+    enum {Imports=23855,Owned=82000};
+    ArmSmmu4KRange *all=calloc(Imports+Owned,sizeof *all);CHECK(all);
+    for(size_t i=0;i<Imports+Owned;++i) {
+        const int coherent=i<Imports;
+        all[i]=(ArmSmmu4KRange){0x100000+i*4096,(coherent?UINT64_C(0x800000000):UINT64_C(0x900000000))+(rnd()%0x100000)*4096*2+
+            (coherent?0:4096),4096,3,coherent?1u:0u,coherent?3u:2u};
+    }
+    const clock_t began=clock();
+    CHECK(!any_conflicting_alias(&with,all,Imports+Owned,all,Imports+Owned));
+    CHECK(!any_conflicting_alias(&with,all,Imports,all+Imports,Owned));
+    all[Imports+Owned-1].physical=all[17].physical;
+    CHECK(any_conflicting_alias(&with,all,Imports+Owned,all,Imports+Owned));
+    CHECK(any_conflicting_alias(&with,all+Imports+Owned-1,1,all,Imports));
+    const double ms=1000.0*(double)(clock()-began)/CLOCKS_PER_SEC;
+    CHECK(ms<2000);
+    free(all);
+    printf("PASS: %u sorted alias checks equal the pairwise definition (%u conflicting) with, without and with too little scratch; "
+           "a 23855+82000-page mixed-class set checked 4 times in %.0f ms\n",cases,conflicts,ms);
+    /* One long interval lies beyond every probe. Its length must not make each
+     * gap probe scan all preceding small intervals. Equal interval lengths in
+     * the earlier large case do not expose that degeneration. */
+    enum {Mixed=8192};
+    ArmSmmu4KRange *left=calloc(Mixed+1,sizeof *left),*right=calloc(Mixed+2,sizeof *right);CHECK(left && right);
+    for(size_t i=0;i<Mixed+2;++i) {
+        if(i<Mixed)left[i]=(ArmSmmu4KRange){0,0x40000000+i*8192,4096,3,0,2};
+        right[i]=(ArmSmmu4KRange){0,0x40001000+i*8192,4096,3,1,3};
+    }
+    left[Mixed]=(ArmSmmu4KRange){0,UINT64_C(0x200000000),UINT64_C(0x10000000),3,0,2};
+#ifdef ARM_SMMU4K_TEST_COVERAGE
+    alias_steps=0;
+#endif
+    const clock_t mixed_began=clock();
+    CHECK(!any_conflicting_alias(&with,left,Mixed+1,right,Mixed+2));
+#ifdef ARM_SMMU4K_TEST_COVERAGE
+    const uint64_t work=alias_steps;
+    printf("mixed alias diagnostic: %u intervals, %llu coverage steps, %.1f host ms (not hardware timing)\n",2*Mixed+3,
+        (unsigned long long)work,1000.0*(double)(clock()-mixed_began)/CLOCKS_PER_SEC);fflush(stdout);
+    CHECK(work>0 && work<UINT64_C(512)*(2*Mixed+3));
+#else
+    (void)mixed_began;
+#endif
+    CHECK(!any_conflicting_alias(&with,right,Mixed+2,left,Mixed+1));
+    right[Mixed+1].physical=left[Mixed].physical+4096;
+    CHECK(any_conflicting_alias(&with,left,Mixed+1,right,Mixed+2));
+    free(left);free(right);
+#ifdef ARM_SMMU4K_TEST_COVERAGE
+    puts("PASS: mixed-size alias gap/long-range controls and bounded compiler-coverage work");
+#else
+    puts("PASS: mixed-size alias gap/long-range controls; work counter not enabled");
+#endif
+    return 0;
+}
diff --git a/iokit/NativeAdreno/kits/ArmSmmu4K/test_audit.c b/iokit/NativeAdreno/kits/ArmSmmu4K/test_audit.c
new file mode 100644
index 0000000..5f2d85f
--- /dev/null
+++ b/iokit/NativeAdreno/kits/ArmSmmu4K/test_audit.c
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: MIT */
+/* Synthetic owned physical memory only; no hardware observation. */
+#include "ArmSmmu4KTableMemory.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define CHECK(x) do {if(!(x)){fprintf(stderr,"line %d: %s\n",__LINE__,#x);exit(1);}}while(0)
+#define CAP 16
+_Alignas(4096) static uint64_t tables[CAP*512];
+static unsigned char visited[CAP];
+static ArmSmmu4KConfig c;
+static ArmSmmu4KResult built;
+static ArmSmmu4KRange ranges[3];
+static ArmSmmu4KAuditRegion a;
+static ArmSmmu4KTableAuditResult result;
+static size_t calls,fail_at;
+static int read_descriptor(void *cookie,uint64_t pa,uint64_t *out)
+{
+    CHECK(cookie==tables && !(pa&7) && pa>=c.table_physical && pa-c.table_physical<sizeof(tables));
+    if(++calls==fail_at)return 1;
+    *out=tables[(pa-c.table_physical)/8];return 0;
+}
+static ArmSmmu4KTableIo io={tables,read_descriptor};
+static ArmSmmu4KStatus audit(void)
+{calls=0;return ArmSmmu4KAuditTables(&io,&c,&built,&a,c.table_physical,&result);}
+static void setup(unsigned bits,unsigned oas,unsigned upper,unsigned permissions)
+{
+    c=(ArmSmmu4KConfig){bits,oas,0x1000000,8};
+    uint64_t span=UINT64_C(1)<<bits,base=upper?UINT64_MAX-span+1:0;
+    ranges[0]=(ArmSmmu4KRange){base,0x2000000,8192,permissions,0,2};
+    ranges[1]=(ArmSmmu4KRange){base+0x1ff000,0x3000000,8192,permissions,1,3};
+    ranges[2]=(ArmSmmu4KRange){base+(span-4096),0x4000000,4096,permissions,0,3};
+    CHECK(!(upper?ArmSmmu4KBuildUpper(&c,ranges,3,tables,CAP,&built):ArmSmmu4KBuild(&c,ranges,3,tables,CAP,&built)));
+    a=(ArmSmmu4KAuditRegion){ranges,3,CAP,CAP*512,visited,sizeof(visited)};fail_at=0;
+}
+int main(void)
+{
+    unsigned widths[]={32,36,40,42,44,48},profiles=0,mutations=0,failures=0;
+    for(unsigned bits=32;bits<=48;++bits)for(unsigned o=0;o<6;++o)
+    for(unsigned upper=0;upper<2;++upper)for(unsigned p=1;p<16;p+=2) {
+        setup(bits,widths[o],upper,p);CHECK(!audit() && result.complete && result.leaf_pages==5);
+        CHECK(result.table_pages==built.table_pages && calls==built.table_pages*512);++profiles;
+    }
+    for(unsigned upper=0;upper<2;++upper) {
+        setup(40,40,upper,15);size_t reads=built.table_pages*512;
+        for(size_t n=1;n<=reads;++n){fail_at=n;CHECK(audit()==ArmSmmu4KIoError && !result.complete && calls==n);++failures;}
+        fail_at=0;
+        /* Every reachable nonzero descriptor bit, plus EVERY unused slot.
+         * Includes reserved high bits, AP/XN, AF/nG, SH, type and PA bits. */
+        for(size_t n=0;n<reads;++n) {
+            uint64_t old=tables[n];
+            for(unsigned bit=0;bit<(old?64u:1u);++bit) {
+                tables[n]=old^(UINT64_C(1)<<bit);CHECK(audit()!=ArmSmmu4KSuccess && !result.complete);++mutations;
+            }
+            tables[n]=old;
+        }
+        CHECK(!audit());
+        a.read_budget=reads-1;CHECK(audit()==ArmSmmu4KBudget && !calls);a.read_budget=CAP*512;
+        a.visited_bytes=CAP-1;CHECK(audit()==ArmSmmu4KArgument && !calls);a.visited_bytes=CAP;
+        built.root_physical+=4096;CHECK(audit()==ArmSmmu4KStateMismatch && !calls);built.root_physical-=4096;
+        uint64_t root=tables[0];tables[0]=c.table_physical|3;CHECK(audit()==ArmSmmu4KOverlap);tables[0]=root;
+        tables[0]=(c.table_physical+CAP*4096)|3;CHECK(audit()==ArmSmmu4KBadRange);tables[0]=root;
+        /* A legitimate graph need not have builder allocation order: swap
+         * root's first child into a spare page and redirect its actual pointer. */
+        size_t child=(size_t)((root&UINT64_C(0x0000fffffffff000))-c.table_physical)/4096;
+        memcpy(tables+(CAP-1)*512,tables+child*512,4096);
+        memset(tables+child*512,0xcc,4096);tables[0]=(c.table_physical+(CAP-1)*4096)|3;
+        CHECK(!audit());
+    }
+    /* Cross-region reservations must be checked before any physical read. */
+    setup(40,40,0,3);
+    ArmSmmu4KConfig uc=c;uc.table_physical+=4096;
+    ArmSmmu4KResult ub=built;ub.root_physical=uc.table_physical;ub.upper_region=1;
+    ArmSmmu4KRange ur[3];for(unsigned i=0;i<3;++i){ur[i]=ranges[i];ur[i].iova|=UINT64_MAX-((UINT64_C(1)<<40)-1);}
+    unsigned char uv[CAP];ArmSmmu4KAuditRegion ua=a;ua.ranges=ur;ua.visited=uv;
+    ArmSmmu4KContextConfig cc={.lower=&c,.upper=&uc,.lower_tables=&built,.upper_tables=&ub};
+    ArmSmmu4KAuditConfig ac={io,&a,&ua};ArmSmmu4KAuditResult ar;
+    calls=0;CHECK(ArmSmmu4KAuditDeclaredContext(&cc,&ac,&ar)==ArmSmmu4KOverlap && !calls);
+    uc.table_physical=0x1800000;ub.root_physical=uc.table_physical;
+    ur[0].physical=c.table_physical+(CAP-1)*4096;
+    CHECK(ArmSmmu4KAuditDeclaredContext(&cc,&ac,&ar)==ArmSmmu4KOverlap && !calls);
+    ur[0].physical=ranges[0].physical;ur[0].permissions|=ArmSmmu4KPrivileged;
+    CHECK(ArmSmmu4KAuditDeclaredContext(&cc,&ac,&ar)==ArmSmmu4KOverlap && !calls);
+    /* Exercise the concrete production volatile-load adapter on real host
+     * buffers with SYNTHETIC physical labels. It does not prove VA->PA. */
+    setup(40,40,1,15);
+    ArmSmmu4KTableMemory memory={1,{{tables,c.table_physical,CAP},{0}}};ArmSmmu4KTableIo direct;
+    CHECK(!ArmSmmu4KBindTableMemory(&memory,&direct));
+    CHECK(!ArmSmmu4KAuditTables(&direct,&c,&built,&a,c.table_physical,&result));
+    uint64_t value;
+    CHECK(direct.read_descriptor(direct.cookie,c.table_physical-8,&value));
+    CHECK(direct.read_descriptor(direct.cookie,c.table_physical+CAP*4096,&value));
+    CHECK(direct.read_descriptor(direct.cookie,c.table_physical+1,&value));
+    CHECK(direct.read_descriptor(direct.cookie,c.table_physical,NULL));
+    memory.count=2;memory.pools[1]=memory.pools[0];
+    CHECK(ArmSmmu4KBindTableMemory(&memory,&direct)==ArmSmmu4KOverlap && !direct.read_descriptor);
+    memory.count=1;memory.pools[0].mapping=tables+1;
+    CHECK(ArmSmmu4KBindTableMemory(&memory,&direct)==ArmSmmu4KBadRange && !direct.read_descriptor);
+    memory.pools[0].mapping=(const volatile uint64_t *)(UINTPTR_MAX-4095);
+    CHECK(ArmSmmu4KBindTableMemory(&memory,&direct)==ArmSmmu4KBadRange);
+    memory.pools[0].mapping=tables;memory.pools[0].physical=(UINT64_C(1)<<48)-4096;
+    CHECK(ArmSmmu4KBindTableMemory(&memory,&direct)==ArmSmmu4KBadRange);
+    printf("PASS: %u physical-graph profiles, %u descriptor mutations, %u read failures; upper final page, relocated tables, cycles, full-pool and cross-region isolation; synthetic physical memory only\n",profiles,mutations,failures);
+}
diff --git a/iokit/NativeAdreno/kits/ArmSmmu4K/test_context.c b/iokit/NativeAdreno/kits/ArmSmmu4K/test_context.c
new file mode 100644
index 0000000..2fa8f37
--- /dev/null
+++ b/iokit/NativeAdreno/kits/ArmSmmu4K/test_context.c
@@ -0,0 +1,146 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KContext.h"
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define CHECK(c) do {if(!(c)){fprintf(stderr,"line %d: %s\n",__LINE__,#c);exit(1);}}while(0)
+#define PAGES 32
+static uint64_t low[PAGES*512],high[PAGES*512],before[PAGES*512];
+/* Built separately from the pinned original arm-smmu.h inline helpers. */
+extern uint32_t source_tcr(unsigned,unsigned,unsigned);
+extern uint32_t source_tcr2(unsigned);
+static uint64_t walk(const uint64_t *tables,const ArmSmmu4KConfig *c,
+    const ArmSmmu4KResult *r,uint64_t va)
+{
+    unsigned level=4-(c->input_bits-12+8)/9;size_t page=0;
+    for(;level<=3;++level) {
+        unsigned shift=39-9*level;
+        unsigned bits=level==r->start_level?c->input_bits-shift:9;
+        uint64_t entry=tables[page*512+((va>>shift)&((1u<<bits)-1))];
+        if(!entry)return 0;
+        CHECK((entry&3)==3); /* Never block descriptors. */
+        if(level==3)return entry;
+        uint64_t physical=entry&UINT64_C(0xfffffffff000);
+        CHECK(physical>=r->root_physical && physical-r->root_physical<r->table_pages*4096);
+        page=(physical-r->root_physical)/4096;
+    }
+    exit(1);
+}
+static void upper_tables(void)
+{
+    for(unsigned bits=32;bits<=48;++bits) {
+        ArmSmmu4KConfig c={bits,48,0x11000000,64};
+        uint64_t base=UINT64_MAX-(UINT64_C(1)<<bits)+1;
+        ArmSmmu4KRange ranges[]={
+            {base,0x20000000,4096,1,0,2},
+            {base+0x1ff000,0x21000000,12288,3,1,3},
+            {base+0x3ffff000,0x22000000,12288,1,1,3},
+            {base+UINT64_C(0x7ffffff000),0x23000000,12288,3,0,2},
+            {UINT64_MAX-4095,0x24000000,4096,1,0,2}};
+        if(bits<40)ranges[3]=ranges[4];
+        size_t count=bits<40?4:5;ArmSmmu4KResult r;
+        memset(high,0xa5,sizeof(high));memcpy(before,high,sizeof(high));
+        CHECK(ArmSmmu4KBuildUpper(&c,ranges,count,high,PAGES,&r)==ArmSmmu4KSuccess);
+        CHECK(r.upper_region==1);
+        unsigned shift=39-9*r.start_level,root_entries=1u<<(bits-shift);
+        for(unsigned i=root_entries;i<512;++i)CHECK(!high[i]);
+        size_t leaves=0;
+        for(size_t i=0;i<count;++i)for(uint64_t off=0;off<ranges[i].bytes;off+=4096) {
+            uint64_t entry=walk(high,&c,&r,ranges[i].iova+off);
+            CHECK((entry&UINT64_C(0xfffffffff000))==ranges[i].physical+off);
+            CHECK(((entry>>53)&3)==3 && ((entry>>2)&7)==ranges[i].writeback);
+            CHECK(((entry>>8)&3)==ranges[i].shareability && ((entry>>10)&3)==3);
+            CHECK(((entry>>6)&3)==(ranges[i].permissions==1?3:1));++leaves;
+        }
+        CHECK(leaves==r.leaf_pages && !walk(high,&c,&r,base+4096));
+        CHECK(!memcmp(high+r.table_pages*512,before+r.table_pages*512,(PAGES-r.table_pages)*4096));
+        memcpy(before,high,sizeof(high));
+        ArmSmmu4KRange bad=ranges[count-1];bad.bytes=8192;
+        CHECK(ArmSmmu4KBuildUpper(&c,&bad,1,high,PAGES,&r)==ArmSmmu4KBadRange);
+        CHECK(!memcmp(high,before,sizeof(high)) && !r.table_pages);
+        bad=ranges[0];bad.iova=0;
+        CHECK(ArmSmmu4KBuildUpper(&c,&bad,1,high,PAGES,&r)==ArmSmmu4KBadRange);
+        bad.iova=base-4096;
+        CHECK(ArmSmmu4KBuildUpper(&c,&bad,1,high,PAGES,&r)==ArmSmmu4KBadRange);
+        bad=ranges[0];
+        CHECK(ArmSmmu4KBuild(&c,&bad,1,high,PAGES,&r)==ArmSmmu4KBadRange);
+        CHECK(!memcmp(high,before,sizeof(high)));
+    }
+}
+static void refusal(ArmSmmu4KContextConfig c,ArmSmmu4KStatus status)
+{
+    ArmSmmu4KContextImage image;memset(&image,0xa5,sizeof(image));
+    CHECK(ArmSmmu4KEncodeContext(&c,&image)==status);
+    unsigned char zero[sizeof(image)]={0};CHECK(!memcmp(&image,zero,sizeof(image)));
+}
+int main(void)
+{
+    upper_tables();unsigned widths[]={32,36,40,42,44,48};size_t images=0,mismatches=0,tbi_accepted=0;
+    for(unsigned input=32;input<=48;++input)for(unsigned output=0;output<6;++output) {
+        ArmSmmu4KConfig a={input,widths[output],0x10000000,16},b=a;b.table_physical=0x11000000;
+        ArmSmmu4KRange ra={0x1000,0x20000000,4096,3,1,3},rb=ra;rb.iova=UINT64_MAX-4095;
+        ArmSmmu4KResult ar,br;
+        CHECK(ArmSmmu4KBuild(&a,&ra,1,low,PAGES,&ar)==ArmSmmu4KSuccess);
+        CHECK(ArmSmmu4KBuildUpper(&b,&rb,1,high,PAGES,&br)==ArmSmmu4KSuccess);
+        for(unsigned mode=1;mode<=3;++mode)for(unsigned coherent=0;coherent<2;++coherent)
+        for(unsigned fault=0;fault<4;++fault)for(unsigned ai=0;ai<3;++ai) {
+            unsigned asids[]={0,1,65535};
+            ArmSmmu4KContextConfig c={mode&1?&a:NULL,mode&2?&b:NULL,
+                mode&1?&ar:NULL,mode&2?&br:NULL,1u<<30,0x1555,asids[ai],coherent,fault&1,fault>>1};
+            ArmSmmu4KContextImage v;
+            CHECK(ArmSmmu4KEncodeContext(&c,&v)==ArmSmmu4KSuccess);
+            uint32_t expected=UINT32_C(2)<<30;
+            if(mode&1)expected|=source_tcr(input,0,coherent);
+            if(mode&2)expected|=source_tcr(input,1,coherent);
+            if(mode==3)expected&=~((1u<<7)|(1u<<23));
+            CHECK(v.tcr==expected && v.tcr2==(source_tcr2(output)|(1u<<4)));
+            CHECK(v.cbar==0x1f300 && v.cba2r==1 && v.mair0==0xff44 && !v.mair1 && !v.reserved_zero);
+            CHECK(v.sctlr==(0x1067|((fault&1)<<7)|((fault>>1)<<8)));
+            CHECK(v.ttbr0==((uint64_t)c.asid<<48|(mode&1?a.table_physical:0)));
+            CHECK(v.ttbr1==((uint64_t)c.asid<<48|(mode&2?b.table_physical:0)));
+            CHECK(ArmSmmu4KValidateContextReadback(&c,&v)==ArmSmmu4KSuccess);++images;
+            /* Every stored bit, including each granule, ASID, root address,
+             * enable/stage/format/cache/attribute field, must match. */
+            /* Except TCR2.TBI0/TBI1 reading 1 where 0 was written (int-008 hardware), accepted alone or together,
+             * and SCTLR.ASIDPNE reading 0 where 1 was written (int-009 hardware). */
+            for(size_t byte=0;byte<sizeof(v);++byte)for(unsigned bit=0;bit<8;++bit) {
+                ArmSmmu4KContextImage changed=v;((unsigned char *)&changed)[byte]^=1u<<bit;
+                const int tbi=(byte==offsetof(ArmSmmu4KContextImage,tcr2) && (bit==5 || bit==6)) ||
+                    (byte==offsetof(ArmSmmu4KContextImage,sctlr)+1 && bit==4);
+                CHECK(ArmSmmu4KValidateContextReadback(&c,&changed)==(tbi?ArmSmmu4KSuccess:ArmSmmu4KStateMismatch));
+                if(tbi)++tbi_accepted;else ++mismatches;
+            }
+            {
+                ArmSmmu4KContextImage changed=v;changed.tcr2|=0x60;
+                CHECK(ArmSmmu4KValidateContextReadback(&c,&changed)==ArmSmmu4KSuccess);++tbi_accepted;
+                changed.sctlr&=~0x1000u;   /* the int-009 image: both tolerances together */
+                CHECK(ArmSmmu4KValidateContextReadback(&c,&changed)==ArmSmmu4KSuccess);++tbi_accepted;
+                changed.tcr2|=0x80;   /* any other extra bit still refuses */
+                CHECK(ArmSmmu4KValidateContextReadback(&c,&changed)==ArmSmmu4KStateMismatch);++mismatches;
+            }
+            ArmSmmu4KContextConfig bad=c;bad.id0=0;refusal(bad,ArmSmmu4KUnsupported);
+            bad=c;bad.id2&=~(1u<<12);refusal(bad,ArmSmmu4KUnsupported);
+            bad=c;bad.id2=(bad.id2&~0xf00)|0x600;refusal(bad,ArmSmmu4KUnsupported);
+            bad=c;bad.id2=(bad.id2&~0xf0)|0x60;refusal(bad,ArmSmmu4KUnsupported);
+            bad=c;bad.asid=65536;refusal(bad,ArmSmmu4KArgument);
+            bad=c;bad.coherent_walk=2;refusal(bad,ArmSmmu4KArgument);
+            bad=c;bad.stall_on_fault=2;refusal(bad,ArmSmmu4KArgument);
+        }
+        ArmSmmu4KContextConfig c={&a,&b,&ar,&br,1u<<30,0x1555,7,1,1,1};
+        ArmSmmu4KContextConfig bad=c;bad.upper=NULL;refusal(bad,ArmSmmu4KArgument);
+        bad=c;bad.lower_tables=NULL;refusal(bad,ArmSmmu4KArgument);
+        bad=c;bad.continue_after_fault=2;refusal(bad,ArmSmmu4KArgument);
+        bad=c;bad.id2=0x1000;if(input>32 || widths[output]>32)refusal(bad,ArmSmmu4KUnsupported);
+        uint64_t saved=br.root_physical;br.root_physical++;refusal(c,ArmSmmu4KArgument);br.root_physical=saved;
+        saved=br.mair;br.mair=0;refusal(c,ArmSmmu4KArgument);br.mair=saved;
+        unsigned level=br.start_level;br.start_level=3;refusal(c,ArmSmmu4KArgument);br.start_level=level;
+        br.upper_region=0;refusal(c,ArmSmmu4KArgument);br.upper_region=1;
+        saved=b.table_physical;b.table_physical=a.table_physical;br.root_physical=b.table_physical;
+        refusal(c,ArmSmmu4KOverlap);b.table_physical=saved;br.root_physical=saved;
+    }
+    ArmSmmu4KContextConfig none={0};refusal(none,ArmSmmu4KArgument);
+    CHECK(ArmSmmu4KEncodeContext(NULL,NULL)==ArmSmmu4KArgument);
+    CHECK(ArmSmmu4KValidateContextReadback(NULL,NULL)==ArmSmmu4KArgument);
+    printf("PASS: native4K TTBR1 high/partial-root/upper-bound tables; %zu context images versus pinned original helpers; %zu one-bit readback refusals; %zu TCR2.TBI/SCTLR.ASIDPNE readback tolerances\n",images,mismatches,tbi_accepted);
+}
