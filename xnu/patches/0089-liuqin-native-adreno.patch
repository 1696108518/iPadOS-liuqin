+IOReturn NativeAdrenoUserClient::dispatch(uint32_t method,const void *input,
+    size_t input_size,void *output,size_t output_size,const NativeAdrenoRingClock *clock)
+{
+    struct Tally {
+        uint32_t method;uint64_t began;IOReturn *result;const NativeAdrenoRingClock *clock;
+        Tally(uint32_t m,IOReturn *r,const NativeAdrenoRingClock *c):method(m),began(c && c->now_us?c->now_us(c->cookie):0),result(r),clock(c) {}
+        ~Tally() {
+            if(method>=20)return;
+            const uint64_t now=clock && clock->now_us?clock->now_us(clock->cookie):0;
+            native_adreno_method_stats[method][0]=native_adreno_method_stats[method][0]+1;
+            if(*result)native_adreno_method_stats[method][1]=native_adreno_method_stats[method][1]+1;
+            native_adreno_method_stats[method][2]=(uint32_t)*result;
+            native_adreno_method_stats[method][3]=native_adreno_method_stats[method][3]+(uint32_t)(now-began);
+        }
+    };
+    /* The same clock times the VM's table transactions (the board service's probe never ran on this path, so nothing else installed it). */
+    static const NativeAdrenoRingClock *vm_clock=nullptr;
+    vm_clock=clock;
+    native_adreno_vm_now_us=[]()->uint64_t{return vm_clock && vm_clock->now_us?vm_clock->now_us(vm_clock->cookie):0;};
+    IOReturn tally_result=kIOReturnSuccess;
+    Tally tally(method,&tally_result,clock);
+    const size_t expected_in=inputSize(method),expected_out=outputSize(method);
+    if(expected_in==SIZE_MAX || expected_out==SIZE_MAX)return kIOReturnUnsupported;
+    if(input_size!=expected_in || output_size!=expected_out)return kIOReturnBadArgument;
+    if((expected_in && !input) || (expected_out && !output))return kIOReturnBadArgument;
+    IOReturn status=kIOReturnSuccess;
+    switch(method) {
+    case NativeAdrenoMethodQuery: {
+        NativeAdrenoAbiParams reply{};
+        status=query(&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodBoAlloc: {
+        NativeAdrenoAbiBoAlloc request{};
+        memcpy(&request,input,sizeof(request));
+        NativeAdrenoAbiBoAllocReply reply{};
+        status=allocBo(&request,&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodBoImport:
+        status=kIOReturnUnsupported;
+        break;
+    case NativeAdrenoMethodBoMap: {
+        NativeAdrenoAbiBoMap request{};
+        memcpy(&request,input,sizeof(request));
+        NativeAdrenoAbiBoMapReply reply{};
+        status=mapBo(&request,&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        else {
+            /* Why maps fail (int-135: 55 of 191, and the translator answers each as a device out-of-memory): status, count, and what the table
+             * held and the failed request asked for the last time. */
+            unsigned at=0;while(at<5 && native_adreno_map_fail[at][0] && native_adreno_map_fail[at][0]!=(uint32_t)status)++at;
+            native_adreno_map_fail[at][0]=(uint32_t)status;native_adreno_map_fail[at][1]=native_adreno_map_fail[at][1]+1;
+            native_adreno_map_fail[5][0]=(uint32_t)vm_->spanCount();native_adreno_map_fail[5][1]=(uint32_t)vm_->objectCount();
+            native_adreno_map_fail[6][0]=(uint32_t)(request.iova>>12);native_adreno_map_fail[6][1]=(uint32_t)(request.handle);
+        }
+        break;
+    }
+    case NativeAdrenoMethodBoFree: {
+        NativeAdrenoAbiBoFree request{};
+        memcpy(&request,input,sizeof(request));
+        status=freeBo(&request);
+        break;
+    }
+    case NativeAdrenoMethodSubmit: {
+        NativeAdrenoAbiSubmit request{};
+        memcpy(&request,input,sizeof(request));
+        NativeAdrenoAbiSubmitReply reply{};
+        status=submit(&request,&reply,clock);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodWaitFence: {
+        NativeAdrenoAbiWaitFence request{};
+        memcpy(&request,input,sizeof(request));
+        status=waitFence(&request,clock);
+        break;
+    }
+    case NativeAdrenoMethodGetDeviceInfo: {
+        NativeAdrenoAbiDeviceInfo reply{};
+        status=deviceInfo(&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodGetTimestamp: {
+        NativeAdrenoAbiTimestamp reply{};
+        status=timestamp(&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodBoCpuMap: {
+        NativeAdrenoAbiBoCpuMap request{};
+        memcpy(&request,input,sizeof(request));
+        NativeAdrenoAbiBoCpuMapReply reply{};
+        status=cpuMap(&request,&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodBoCpuUnmap: {
+        NativeAdrenoAbiBoCpuUnmap request{};
+        memcpy(&request,input,sizeof(request));
+        status=cpuUnmap(&request);
+        break;
+    }
+    case NativeAdrenoMethodCreateQueue: {
+        NativeAdrenoAbiQueueReply reply{};
+        status=createQueue(&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodCloseQueue: {
+        NativeAdrenoAbiQueue request{};
+        memcpy(&request,input,sizeof(request));
+        status=closeQueue(&request);
+        break;
+    }
+    case NativeAdrenoMethodSetMetadata: {
+        NativeAdrenoAbiMetadata request{};
+        memcpy(&request,input,sizeof(request));
+        status=setMetadata(&request);
+        break;
+    }
+    case NativeAdrenoMethodGetMetadata: {
+        NativeAdrenoAbiMetadata request{};
+        memcpy(&request,input,sizeof(request));
+        NativeAdrenoAbiMetadata reply{};
+        status=getMetadata(&request,&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    case NativeAdrenoMethodGetStatus: {
+        NativeAdrenoAbiStatus reply{};
+        status=this->status(&reply);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        break;
+    }
+    default:return kIOReturnUnsupported;
+    }
+    tally_result=status;
+    return status;
+}
+IOReturn NativeAdrenoUserClient::cpuMap(const NativeAdrenoAbiBoCpuMap *request,
+    NativeAdrenoAbiBoCpuMapReply *reply)
+{
+    if(!request || !reply)return kIOReturnBadArgument;*reply={};
+    if(!open_)return kIOReturnNotReady;
+    Entry *entry=find(request->handle);
+    if(!entry || entry->unreleasable)return kIOReturnBadArgument;
+    /* An imported BO is the caller's own memory, already mapped where it came from. */
+    if(entry->memory.imported())return kIOReturnUnsupported;
+    if(entry->mapping_leases==UINT32_MAX)return kIOReturnNoResources;
+    ++entry->mapping_leases;
+    reply->token=entry->token;reply->bytes=entry->memory.bytes();
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::cpuUnmap(const NativeAdrenoAbiBoCpuUnmap *request)
+{
+    if(!request)return kIOReturnBadArgument;
+    if(!open_)return kIOReturnNotReady;
+    if(request->reserved)return kIOReturnBadArgument;
+    Entry *entry=find(request->handle);
+    if(!entry || entry->unreleasable || !entry->token)return kIOReturnBadArgument;
+    if(request->token!=entry->token)return kIOReturnBadArgument;
+    if(!entry->mapping_leases)return kIOReturnBusy;
+    --entry->mapping_leases;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::createQueue(NativeAdrenoAbiQueueReply *reply)
+{
+    if(!reply)return kIOReturnBadArgument;
+    if(!open_)return kIOReturnNotReady;
+    for(size_t i=1;i<NativeAdrenoAbiMaxQueues;++i)if(!queues_[i].active) {
+        queues_[i]={static_cast<uint32_t>(i),true};
+        reply->queue=i;
+        return kIOReturnSuccess;
+    }
+    return kIOReturnNoResources;
+}
+IOReturn NativeAdrenoUserClient::closeQueue(const NativeAdrenoAbiQueue *request)
+{
+    if(!request)return kIOReturnBadArgument;
+    if(!open_)return kIOReturnNotReady;
+    if(!request->queue || request->queue>=NativeAdrenoAbiMaxQueues)return kIOReturnBadArgument;
+    Queue &queue=queues_[request->queue];
+    if(!queue.active)return kIOReturnBadArgument;
+    /* A queue must be drained by the caller before it disappears. */
+    if(submit_->queueOutstanding(queue_base_+static_cast<uint32_t>(request->queue)))
+        return kIOReturnBusy;
+    queue={};
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::setMetadata(const NativeAdrenoAbiMetadata *request)
+{
+    if(!request)return kIOReturnBadArgument;
+    if(!open_)return kIOReturnNotReady;
+    if(request->reserved || request->bytes>NativeAdrenoAbiMetadataBytes)return kIOReturnBadArgument;
+    Entry *entry=find(request->handle);
+    if(!entry || entry->unreleasable)return kIOReturnBadArgument;
+    if(request->bytes)memcpy(entry->metadata,request->text,request->bytes);
+    entry->metadata_bytes=request->bytes;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::getMetadata(const NativeAdrenoAbiMetadata *request,
+    NativeAdrenoAbiMetadata *reply)
+{
+    if(!request || !reply)return kIOReturnBadArgument;
+    /* Snapshot the request so an in/out alias is still well defined. */
+    const uint64_t handle=request->handle;
+    const uint32_t asked=request->bytes;
+    const uint32_t reserved=request->reserved;
+    *reply={};
+    if(!open_)return kIOReturnNotReady;
+    if(reserved || asked>NativeAdrenoAbiMetadataBytes)return kIOReturnBadArgument;
+    Entry *entry=find(handle);
+    if(!entry || entry->unreleasable)return kIOReturnBadArgument;
+    if(asked<entry->metadata_bytes)return kIOReturnBadArgument;
+    reply->handle=entry->handle;reply->bytes=entry->metadata_bytes;
+    if(entry->metadata_bytes)memcpy(reply->text,entry->metadata,entry->metadata_bytes);
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::waitFence(const NativeAdrenoAbiWaitFence *request,
+    const NativeAdrenoRingClock *clock)
+{
+    if(!request || !clock)return kIOReturnBadArgument;
+    if(!open_)return kIOReturnNotReady;
+    if(!request->fence)return kIOReturnBadArgument;
+    const uint32_t timeout_us=request->timeout_ns==0?0:
+        (request->timeout_ns>UINT64_C(0xffffffff)*1000u?0xffffffffu:
+        (uint32_t)(request->timeout_ns/1000));
+    return submit_->wait((uint32_t)request->fence,clock,timeout_us);
+}
diff --git a/iokit/NativeAdreno/NativeAdrenoUserClient.h b/iokit/NativeAdreno/NativeAdrenoUserClient.h
new file mode 100644
index 0000000..46c4aea
--- /dev/null
+++ b/iokit/NativeAdreno/NativeAdrenoUserClient.h
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_USERCLIENT_H
+#define NATIVE_ADRENO_USERCLIENT_H
+#include "NativeAdrenoABI.h"
+#include "NativeAdrenoSubmit.h"
+#include "NativeAdrenoTimer.h"
+#include "NativeAdrenoStatus.h"
+
+/* Kernel-side body of the Adreno user client, deliberately free of IOKit so it
+ * can be exercised on a host. The future IOService/IOUserClient wrapper only
+ * copies one fixed ABI record in and out and calls these methods; it must not
+ * add policy. Handles are this object's own identities, never VM, IOVA or
+ * pointer values. A mapping is retirable only through freeBo, which unmaps
+ * first and then releases the backing object; both steps must succeed.
+ * Up to NativeAdrenoClientMaxObjects live objects and the execbuf's own eight-job limit apply. */
+enum : size_t {NativeAdrenoClientMaxObjects=4096,NativeAdrenoClientContiguousFirstBytes=65536};
+class NativeAdrenoUserClient final {
+    struct Queue {uint32_t id=0;bool active=false;};
+    struct Entry {
+        NativeAdrenoMemory memory;
+        uint64_t handle=0;
+        uint64_t mapped=0;
+        uint64_t iova=0;
+        bool used=false;
+        bool mapped_state=false;
+        bool unreleasable=false;
+        bool imported=false;
+        uint32_t metadata_bytes=0;
+        uint32_t token=0;
+        uint32_t mapping_leases=0;
+        char metadata[NativeAdrenoAbiMetadataBytes]{};
+    };
+    /* Allocated at open(), all-zero is the free state. */
+    Entry *entries_=nullptr;
+    size_t entry_count_=0;
+    Queue queues_[NativeAdrenoAbiMaxQueues]{};
+    NativeAdrenoVm *vm_=nullptr;
+    NativeAdrenoSubmit *submit_=nullptr;
+    NativeAdrenoRing *ring_=nullptr;
+    const NativeAdrenoTimer *timer_=nullptr;
+    const NativeAdrenoStatus *status_=nullptr;
+    const NativeAdrenoAbiDeviceInfo *info_=nullptr;
+    uint32_t input_bits_=0,output_bits_=0;
+    /* Scope on the shared ring and GPU space: this client's queues are the submit object's queues [queue_base_, +MaxQueues), and with a
+     * window (window_bytes_ nonzero) every mapping must lie inside [window_start_, +window_bytes_), which GetDeviceInfo reports as the VA. */
+    uint32_t queue_base_=0;
+    /* A client owns a queue range once setScope() gave it one or it has submitted into the default one (a single client that never scopes owns
+     * range 0). Before either, queue_base_ is only the default 0, which a scoped client may own, so a check of "this client's own range" would
+     * test someone else's jobs. */
+    bool scoped_=false,used_=false;
+    uint64_t window_start_=0,window_bytes_=0,window_peak_=0;
+    uint64_t next_handle_=1;
+    bool open_=false;
+    Entry *find(uint64_t);
+    Entry *free();
+    static void clear(Entry &);
+public:
+    NativeAdrenoUserClient()=default;
+    ~NativeAdrenoUserClient()=default;
+    NativeAdrenoUserClient(const NativeAdrenoUserClient &)=delete;
+    NativeAdrenoUserClient &operator=(const NativeAdrenoUserClient &)=delete;
+    /* Mounts one already-qualified context. input/output bits describe the
+     * active native4K arena and are reported, never guessed. */
+    IOReturn open(uint32_t abi_version,NativeAdrenoVm *,NativeAdrenoSubmit *,
+        NativeAdrenoRing *,uint32_t input_bits,uint32_t output_bits);
+    /* One client of several on the same VM, submit object and ring: its queue range (queue_base a multiple of NativeAdrenoAbiMaxQueues) and
+     * GPU address window (4 KiB aligned, inside the input range; bytes 0 = unrestricted). Only while open with no live object or job. */
+    IOReturn setScope(uint32_t queue_base,uint64_t window_start,uint64_t window_bytes);
+    /* Highest end address (exclusive) any mapping of this client has reached, 0 before the first. */
+    uint64_t windowPeak() const {return window_peak_;}
+    /* Whether any job is unobserved in the range this client owns (never, while it owns none). */
+    bool ownRangeOutstanding() const;
+    /* Refuses while any object is live or any of this client's jobs is unobserved. */
+    IOReturn close();
+    /* Connection teardown: waits for every outstanding job, then unmaps and frees every object, closes every queue and
+     * closes the client. The first failure stops it and leaves what remains live; nothing is forced. */
+    IOReturn releaseAll(const NativeAdrenoRingClock *,uint32_t timeout_us);
+    /* Backing object of a token returned by cpuMap while its lease is held (clientMemoryForType); null otherwise. */
+    NativeAdrenoMemory *memoryForToken(uint32_t token);
+    /* CPU mappings of the BO of this token that BoCpuMap handed out and BoCpuUnmap has not given back; 0 for no such BO. */
+    uint32_t mappingLeases(uint32_t token) const;
+    IOReturn query(NativeAdrenoAbiParams *);
+    IOReturn allocBo(const NativeAdrenoAbiBoAlloc *,NativeAdrenoAbiBoAllocReply *);
+    IOReturn allocBoInner(const NativeAdrenoAbiBoAlloc *,NativeAdrenoAbiBoAllocReply *);
+    IOReturn mapBo(const NativeAdrenoAbiBoMap *,NativeAdrenoAbiBoMapReply *);
+    /* BoImport: pins the caller's pages. Only the IOKit wrapper can call it, with the calling task; dispatch() refuses the method
+     * because it has no task (the kernel mailbox path cannot import). */
+    IOReturn importBo(const NativeAdrenoAbiBoImport *,void *task,NativeAdrenoAbiBoAllocReply *);
+    /* Unmaps if still mapped, then releases the backing object. A failure at
+     * either step keeps the entry live and unmapped where possible. */
+    IOReturn freeBo(const NativeAdrenoAbiBoFree *);
+    IOReturn submit(const NativeAdrenoAbiSubmit *,NativeAdrenoAbiSubmitReply *,
+        const NativeAdrenoRingClock *);
+    IOReturn cpuMap(const NativeAdrenoAbiBoCpuMap *,NativeAdrenoAbiBoCpuMapReply *);
+    IOReturn cpuUnmap(const NativeAdrenoAbiBoCpuUnmap *);
+    IOReturn createQueue(NativeAdrenoAbiQueueReply *);
+    IOReturn closeQueue(const NativeAdrenoAbiQueue *);
+    IOReturn setMetadata(const NativeAdrenoAbiMetadata *);
+    IOReturn getMetadata(const NativeAdrenoAbiMetadata *,NativeAdrenoAbiMetadata *);
+    IOReturn waitFence(const NativeAdrenoAbiWaitFence *,const NativeAdrenoRingClock *);
+    /* One external-method entry: exact record sizes are required, unknown
+     * methods are unsupported and no output byte is modified on failure. The
+     * IOKit wrapper should only copy these buffers and call this function. */
+    IOReturn dispatch(uint32_t method,const void *input,size_t input_size,
+        void *output,size_t output_size,const NativeAdrenoRingClock *);
+    static size_t inputSize(uint32_t method);
+    static size_t outputSize(uint32_t method);
+    size_t liveObjects() const;
+    /* Optional GPU timestamp source; absent means the method stays unsupported. */
+    IOReturn attachTimer(const NativeAdrenoTimer *);
+    IOReturn timestamp(NativeAdrenoAbiTimestamp *);
+    /* Optional counters; absent means the status method stays unsupported. */
+    IOReturn attachStatus(const NativeAdrenoStatus *);
+    IOReturn status(NativeAdrenoAbiStatus *);
+    /* Optional constant device facts; absent means the method stays unsupported. */
+    IOReturn attachDeviceInfo(const NativeAdrenoAbiDeviceInfo *);
+    IOReturn deviceInfo(NativeAdrenoAbiDeviceInfo *);
+    bool mapped(uint64_t handle);
+    /* Backing object of a live handle, for the IOKit wrapper's clientMemoryForType and for kernel self-tests;
+     * null for an unknown or unreleasable handle. The client keeps ownership. */
+    NativeAdrenoMemory *memoryOf(uint64_t handle);
+};
+#endif
diff --git a/iokit/NativeAdreno/NativeAdrenoVm.cpp b/iokit/NativeAdreno/NativeAdrenoVm.cpp
new file mode 100644
index 0000000..5a72a93
--- /dev/null
+++ b/iokit/NativeAdreno/NativeAdrenoVm.cpp
@@ -0,0 +1,448 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoVm.h"
+#include "NativeAdrenoVmAlias.h"
+extern "C" volatile uint32_t native_adreno_trace_stage;
+extern "C" {int (*native_adreno_dram_read32)(uint64_t,uint32_t *);int (*native_adreno_cached_read32)(uint64_t,uint32_t *);
+    int (*native_adreno_line_audit)(uint64_t,size_t,uint32_t *,uint32_t *);}
+#include <string.h>
+#include <IOKit/IOLib.h>
+/* 1 once the board proved the GPU's cacheable inner-shareable accesses coherent with the CPU's caches in both directions (the A740's
+ * ADRENO_QUIRK_HAS_CACHED_COHERENT behind the dma-coherent GPU SMMU, which Linux maps with IOMMU_CACHE): a mapping with write-back
+ * attributes then needs no CPU cache maintenance. 0 keeps every mapping maintained as before. Counters: maintenance passes skipped for
+ * coherent mappings at map, unmap, submission and completion. */
+extern "C" {volatile uint32_t native_adreno_io_coherent;volatile uint32_t native_adreno_coherent_skips[4];}
+static bool coherentMapping(unsigned writeback) {return writeback && native_adreno_io_coherent;}
+/* GPU-written imports (render targets) are mapped non-coherent (the GPU stopped inside its end-of-pass clean writing them through
+ * write-back mappings), and the CPU never touches their pixels while the GPU owns them: they were cleaned when mapped and need no
+ * maintenance per submission, which cost about 60 ms per frame. */
+static bool importedUntouched(const NativeAdrenoMemory *memory) {return memory->imported() && native_adreno_io_coherent;}
+static bool overlap(uint64_t a,uint64_t ab,uint64_t b,uint64_t bb)
+{return a<b+bb && b<a+ab;}
+/* Mappings of one cache/shareability/privilege class may share pages; only pages shared across classes refuse. */
+static unsigned aliasClass(unsigned permissions,unsigned writeback,unsigned shareability)
+{return writeback|(shareability<<1)|((permissions&ArmSmmu4KPrivileged)?8u:0u);}
+static void reverse(ArmSmmu4KRange *first,ArmSmmu4KRange *last)
+{while(first<last && first<--last) {const ArmSmmu4KRange t=*first;*first++=*last;*last=t;}}
+static bool validBinding(const NativeAdrenoVmRegion &r,unsigned upper)
+{
+    return r.tables && r.arena && r.state && !r.tables->quarantined() &&
+        r.tables->deviceReferences() && r.tables->spanCount()==1 &&
+        r.tables->spans()[0].bytes==r.tables->bytes() && !r.tables->spans()[0].offset &&
+        r.arena->mapping==r.tables->mapping() && r.arena->upper_region==upper &&
+        r.arena->config.table_physical==r.tables->spans()[0].physical &&
+        r.arena->capacity_pages==r.tables->bytes()/4096 && r.state->prepared &&
+        !r.state->poisoned && !r.state->tables.leaf_pages;
+}
+ArmSmmu4KLiveRegion NativeAdrenoVm::region(unsigned upper) const
+{
+    return {regions_[upper].arena,regions_[upper].state,
+        ranges_+(upper?lower_count_:0),upper?upper_count_:lower_count_};
+}
+/* Board hook and per-phase time of the two table transactions, for the log: [0] map, [1] unmap; each row is count, the phases in order, the slowest call
+ * and the bytes mapped (int-134: BoMap averaged 135 ms and the desktop crawled). */
+extern "C" {uint64_t (*native_adreno_vm_now_us)(void)=nullptr;volatile uint64_t native_adreno_vm_phase_us[2][8];}
+namespace {
+struct PhaseClock {
+    uint64_t last=native_adreno_vm_now_us?native_adreno_vm_now_us():0,began=last;
+    void lap(unsigned row,unsigned slot) {
+        if(!native_adreno_vm_now_us)return;
+        const uint64_t now=native_adreno_vm_now_us();native_adreno_vm_phase_us[row][slot]+=now-last;last=now;
+    }
+    void done(unsigned row,uint64_t bytes) {
+        if(!native_adreno_vm_now_us)return;
+        const uint64_t total=native_adreno_vm_now_us()-began;
+        native_adreno_vm_phase_us[row][0]+=1;native_adreno_vm_phase_us[row][7]+=bytes;
+        if(total>native_adreno_vm_phase_us[row][6])native_adreno_vm_phase_us[row][6]=total;
+    }
+};
+}
+ArmSmmu4KStatus NativeAdrenoVm::observe() const
+{
+    ArmSmmu4KStreamResult routes;
+    ArmSmmu4KStatus status=ArmSmmu4KObserveStreams(&io_,streams_,context_,&routes);if(status)return status;
+    ArmSmmu4KLiveRegion lower=region(0),upper=region(1);ArmSmmu4KLiveResult audit;
+    status=ArmSmmu4KLiveAuditContext(context_,lower.arena?&lower:nullptr,upper.arena?&upper:nullptr,&audit);
+    if(status)return status;
+    return ArmSmmu4KObserveStreams(&io_,streams_,context_,&routes);
+}
+/* Global policy, the context image and the owned routes only. The scan of every other slot for a conflicting route read each
+ * SMR/S2CR of the SMMU twice per map and unmap (int-152: 0.75 ms a pass, 1.3 s of the 3.2 s of 807 maps); observe(), which
+ * observeCheap runs every 64 operations, keeps that scan. */
+ArmSmmu4KStatus NativeAdrenoVm::observeStreamsOnly() const
+{
+    ArmSmmu4KStreamResult routes;
+    return ArmSmmu4KObserveOwnedStreams(&io_,streams_,context_,&routes);
+}
+/* The owned routes and context are observed in full every 64th table operation; the ones between read no SMMU register before the
+ * table transaction (int-159: a map read the owned routes before and after its transaction, 0.4 ms of its 1.7 ms). */
+ArmSmmu4KStatus NativeAdrenoVm::observeCheap()
+{
+    if(++since_audit_>=64) {since_audit_=0;return observe();}
+    return ArmSmmu4KSuccess;
+}
+IOReturn NativeAdrenoVm::fail(ArmSmmu4KStatus status)
+{
+    poisoned_=true;result_.operation=status;result_.complete=false;
+    for(size_t i=0;mappings_ && i<NativeAdrenoVmMaxObjects;++i)if(mappings_[i].memory)mappings_[i].memory->quarantine();
+    for(auto &r:regions_)if(r.arena) {r.tables->quarantine();r.state->poisoned=1;}
+    ArmSmmu4KStreamResult routes;
+    result_.quarantine=ArmSmmu4KFaultStreams(&io_,streams_,&routes);
+    return kIOReturnIOError;
+}
+IOReturn NativeAdrenoVm::attach(const ArmSmmu4KIo *io,ArmSmmu4KContextConfig *context,
+    ArmSmmu4KStreamState *streams,const NativeAdrenoVmRegion *lower,const NativeAdrenoVmRegion *upper,
+    size_t capacity,unsigned budget)
+{
+    if(attached_ || ranges_ || poisoned_)return kIOReturnBusy;
+    if(!io || !context || !streams || (!lower && !upper) || !capacity || capacity>262144 ||
+        !budget || budget>1048576 || (lower && !validBinding(*lower,0)) || (upper && !validBinding(*upper,1)))
+        return kIOReturnBadArgument;
+    ranges_=IONewData(ArmSmmu4KRange,capacity);if(!ranges_)return kIOReturnNoMemory;
+    mappings_=IONewData(Mapping,NativeAdrenoVmMaxObjects);
+    if(!mappings_) {IODeleteData(ranges_,ArmSmmu4KRange,capacity);return kIOReturnNoMemory;}
+    memset(mappings_,0,sizeof(Mapping)*NativeAdrenoVmMaxObjects);
+    capacity_=capacity;io_=*io;context_=context;streams_=streams;budget_=budget;
+    if(lower)regions_[0]=*lower;if(upper)regions_[1]=*upper;
+    for(unsigned i=0;i<2;++i)if(regions_[i].arena) {
+        if(NativeAdrenoBindSmmuVisibility(regions_[i].tables,&visibility_[i])!=kIOReturnSuccess) {
+            IODeleteData(ranges_,ArmSmmu4KRange,capacity_);IODeleteData(mappings_,Mapping,NativeAdrenoVmMaxObjects);
+            regions_[0]={};regions_[1]={};return kIOReturnBadArgument;
+        }
+    }
+    attached_=true;
+    ArmSmmu4KStatus status=observe();if(status)return fail(status);
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::detach()
+{
+    if(poisoned_ || objects_ || spanCount())return kIOReturnBusy;
+    if(!attached_)return kIOReturnNotReady;
+    IODeleteData(ranges_,ArmSmmu4KRange,capacity_);IODeleteData(mappings_,Mapping,NativeAdrenoVmMaxObjects);
+    attached_=false;regions_[0]={};regions_[1]={};context_=nullptr;streams_=nullptr;capacity_=0;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::findAddress(unsigned upper,size_t bytes,uint64_t alignment,uint64_t *out) const
+{
+    if(!out)return kIOReturnBadArgument;*out=0;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(upper>1 || !regions_[upper].arena || !bytes || (bytes&4095) || alignment<4096 ||
+        (alignment&(alignment-1)))return kIOReturnBadArgument;
+    const ArmSmmu4KLiveArena *a=regions_[upper].arena;
+    uint64_t offset=0;
+    for(size_t i=upper?lower_count_:0;;++i) {
+        uint64_t rem=(a->iova+offset)&(alignment-1),padding=rem?alignment-rem:0;
+        if(padding>a->bytes-offset)return kIOReturnNoResources;offset+=padding;
+        if(bytes>a->bytes-offset)return kIOReturnNoResources;
+        if(i==(upper?spanCount():lower_count_) ||
+            (ranges_[i].iova-a->iova>=offset && bytes<=ranges_[i].iova-a->iova-offset))
+            {*out=a->iova+offset;return kIOReturnSuccess;}
+        uint64_t end=ranges_[i].iova-a->iova+ranges_[i].bytes;
+        if(end>offset)offset=end;
+    }
+}
+IOReturn NativeAdrenoVm::preflight(const NativeAdrenoMemory *memory,unsigned upper,uint64_t iova,
+    unsigned permissions,unsigned writeback,unsigned shareability) const
+{
+    if(!memory || upper>1 || !regions_[upper].arena || !memory->backed() || memory->quarantined() ||
+        !memory->bytes() || !memory->spanCount() || !(permissions&ArmSmmu4KRead) || (permissions&~15u) ||
+        writeback>1 || (shareability!=2 && shareability!=3))return kIOReturnBadArgument;
+    const ArmSmmu4KLiveArena *a=regions_[upper].arena;
+    if((iova&4095) || iova<a->iova || iova-a->iova>=a->bytes || memory->bytes()>a->bytes-(iova-a->iova))
+        return kIOReturnBadArgument;
+    if(objects_>=NativeAdrenoVmMaxObjects || memory->spanCount()>capacity_-spanCount())return kIOReturnNoResources;
+    for(size_t i=0;i<spanCount();++i) {
+        /* Native addresses may end at 2^64; compare offsets in the region. */
+        if((i<lower_count_)==!upper && iova<=ranges_[i].iova+(ranges_[i].bytes-1) &&
+            ranges_[i].iova<=iova+(memory->bytes()-1))return kIOReturnBusy;
+    }
+    if(a->config.output_bits<32 || a->config.output_bits>48)return kIOReturnBadArgument;
+    uint64_t offset=0,limit=UINT64_C(1)<<a->config.output_bits;
+    for(size_t j=0;j<memory->spanCount();++j) {
+        const auto &span=memory->spans()[j];
+        if(span.offset!=offset || !span.physical || !span.bytes || ((span.physical|span.bytes)&4095) ||
+            span.bytes>memory->bytes()-offset || span.physical>=limit || span.bytes>limit-span.physical)
+            return kIOReturnBadArgument;
+        for(const auto &r:regions_)if(r.arena && overlap(span.physical,span.bytes,
+            r.arena->config.table_physical,r.arena->capacity_pages*UINT64_C(4096)))return kIOReturnBadArgument;
+        offset+=span.bytes;
+    }
+    if(offset!=memory->bytes())return kIOReturnBadArgument;
+    /* Only another cache/shareability/privilege class can conflict. Reuse the
+     * arena's caller-owned temporary alias scratch before the table transaction
+     * uses it. Index the smaller side and query the other in O(log n); neither
+     * the resource spans nor the actual page tables are modified here. */
+    const unsigned mine=aliasClass(permissions,writeback,shareability);
+    size_t other=0;
+    for(size_t i=0;i<spanCount();++i)
+        if(aliasClass(ranges_[i].permissions,ranges_[i].writeback,ranges_[i].shareability)!=mine)++other;
+    if(!other)return kIOReturnSuccess;
+    const bool indexNew=memory->spanCount()<=other;
+    const size_t smaller=indexNew?memory->spanCount():other;
+    uint32_t *order=a->alias_scratch;
+    if(order && smaller<=a->alias_scratch_entries) {
+        if(indexNew) {
+            for(size_t i=0;i<smaller;++i)order[i]=(uint32_t)i;
+            NativeAdrenoPhysicalIndex index(memory->spans(),order,smaller);
+            for(size_t i=0;i<spanCount();++i) {
+                const auto &r=ranges_[i];
+                if(aliasClass(r.permissions,r.writeback,r.shareability)!=mine && index.overlaps(r.physical,r.bytes))return kIOReturnBadArgument;
+            }
+        } else {
+            size_t n=0;
+            for(size_t i=0;i<spanCount();++i)
+                if(aliasClass(ranges_[i].permissions,ranges_[i].writeback,ranges_[i].shareability)!=mine)order[n++]=(uint32_t)i;
+            NativeAdrenoPhysicalIndex index(ranges_,order,n);
+            for(size_t j=0;j<memory->spanCount();++j)
+                if(index.overlaps(memory->spans()[j].physical,memory->spans()[j].bytes))return kIOReturnBadArgument;
+        }
+        return kIOReturnSuccess;
+    }
+    /* Small/unconfigured callers retain the conservative allocation-free path. */
+    for(size_t i=0;i<spanCount();++i) {
+        const ArmSmmu4KRange &r=ranges_[i];
+        if(aliasClass(r.permissions,r.writeback,r.shareability)==mine)continue;
+        for(size_t j=0;j<memory->spanCount();++j)
+            if(overlap(memory->spans()[j].physical,memory->spans()[j].bytes,r.physical,r.bytes))return kIOReturnBadArgument;
+    }
+    return kIOReturnSuccess;
+}
+NativeAdrenoVm::Mapping *NativeAdrenoVm::find(uint64_t handle)
+{if(handle && mappings_)for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i)if(mappings_[i].handle==handle && mappings_[i].memory)return &mappings_[i];return nullptr;}
+/* The n ranges just past the table's end (one mapping's spans, consecutive in IOVA and all in one gap) take their sorted place. */
+void NativeAdrenoVm::insert(size_t n,unsigned upper)
+{
+    const size_t count=spanCount();
+    size_t at=0;while(at<count && ranges_[at].iova<ranges_[count].iova)++at;
+    reverse(ranges_+at,ranges_+count);reverse(ranges_+count,ranges_+count+n);reverse(ranges_+at,ranges_+count+n);
+    if(upper)upper_count_+=n;else lower_count_+=n;
+}
+void NativeAdrenoVm::erase(size_t at,size_t n,unsigned upper)
+{
+    const size_t count=spanCount();
+    memmove(ranges_+at,ranges_+at+n,(count-at-n)*sizeof(*ranges_));
+    if(upper)upper_count_-=n;else lower_count_-=n;
+}
+IOReturn NativeAdrenoVm::map(NativeAdrenoMemory *memory,unsigned upper,uint64_t iova,
+    unsigned permissions,unsigned writeback,unsigned shareability,uint64_t *handle)
+{
+    if(!handle)return kIOReturnBadArgument;*handle=0;result_={};
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    PhaseClock clock;
+    IOReturn checked=preflight(memory,upper,iova,permissions,writeback,shareability);if(checked)return checked;
+    if(next_handle_==UINT64_MAX)return kIOReturnNoResources;
+    clock.lap(0,5); /* Previously omitted preflight; map slot 5 was unused. */
+    ArmSmmu4KStatus status=observeCheap();if(status)return fail(status);
+    clock.lap(0,1);
+    checked=memory->holdForDevice();if(checked)return checked;
+    Mapping *record=nullptr;for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i)if(!mappings_[i].memory){record=&mappings_[i];break;}
+    if(!record) {memory->quarantine();return fail(ArmSmmu4KStateMismatch);}
+    *record={memory,0,iova,memory->spanCount(),0,permissions,writeback,shareability,0};++objects_;
+    if(coherentMapping(writeback))native_adreno_coherent_skips[0]=native_adreno_coherent_skips[0]+1;
+    else {
+        checked=memory->publishForDevice(0,memory->bytes(),permissions&ArmSmmu4KWrite,distrust_write_combined_);
+        if(checked)return fail(ArmSmmu4KIoError);
+    }
+    clock.lap(0,2);
+    /* Every span in one table transaction, staged in the table's free tail (preflight checked the room). */
+    const size_t spans=record->spans;
+    ArmSmmu4KRange *changes=ranges_+spanCount();
+    for(size_t i=0;i<spans;++i) {
+        const auto &span=memory->spans()[i];
+        changes[i]={iova+span.offset,span.physical,span.bytes,permissions,writeback,shareability};
+    }
+    ArmSmmu4KLiveRegion lower=region(0),high=region(1);ArmSmmu4KLiveResult update;
+    status=ArmSmmu4KLiveUpdateContextBatch(&io_,streams_->bank,context_,lower.arena?&lower:nullptr,
+        high.arena?&high:nullptr,upper,&visibility_[upper],changes,spans,1,budget_,&update);
+    if(status)return fail(status);
+    clock.lap(0,3);
+    insert(spans,upper);record->mapped_spans=spans;result_.completed_spans=spans;
+    clock.lap(0,4);clock.done(0,memory->bytes());
+    record->handle=next_handle_++;*handle=record->handle;result_.complete=true;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::unmap(uint64_t handle)
+{
+    native_adreno_trace_stage=10;
+    result_={};if(!attached_ || poisoned_)return kIOReturnNotReady;
+    Mapping *record=find(handle);if(!record)return kIOReturnBadArgument;
+    if(record->jobs)return kIOReturnBusy;
+    PhaseClock clock;
+    ArmSmmu4KStatus status=observeCheap();
+    native_adreno_trace_stage=11;
+    if(status)return fail(status);
+    clock.lap(1,1);
+    unsigned upper=regions_[1].arena && record->iova>=regions_[1].arena->iova;
+    if(coherentMapping(record->writeback))native_adreno_coherent_skips[1]=native_adreno_coherent_skips[1]+1;
+    else if(record->permissions&ArmSmmu4KWrite) {
+        if(record->memory->acquireDeviceWrites(0,record->memory->bytes())!=kIOReturnSuccess)
+            return fail(ArmSmmu4KIoError);
+    }
+    clock.lap(1,2);
+    /* The mapping's spans are consecutive in the table; unmap them in one transaction. */
+    const size_t spans=record->spans;
+    size_t at=0;while(at<spanCount() && ranges_[at].iova!=record->iova)++at;
+    if(spans>spanCount()-at)return fail(ArmSmmu4KStateMismatch);
+    for(size_t i=0;i<spans;++i) {
+        const auto &span=record->memory->spans()[i];
+        const ArmSmmu4KRange &r=ranges_[at+i];
+        if(r.iova!=record->iova+span.offset || r.physical!=span.physical || r.bytes!=span.bytes ||
+            r.permissions!=record->permissions || r.writeback!=record->writeback || r.shareability!=record->shareability)
+            return fail(ArmSmmu4KStateMismatch);
+    }
+    ArmSmmu4KLiveRegion lower=region(0),high=region(1);ArmSmmu4KLiveResult update;
+    native_adreno_trace_stage=12;
+    status=ArmSmmu4KLiveUpdateContextBatch(&io_,streams_->bank,context_,lower.arena?&lower:nullptr,
+        high.arena?&high:nullptr,upper,&visibility_[upper],ranges_+at,spans,0,budget_,&update);
+    native_adreno_trace_stage=13;
+    if(status)return fail(status);
+    clock.lap(1,3);
+    erase(at,spans,upper);record->mapped_spans=0;result_.completed_spans=spans;
+    native_adreno_trace_stage=14;
+    clock.lap(1,4);
+    if(record->memory->retireAfterQuiescence()!=kIOReturnSuccess)return fail(ArmSmmu4KStateMismatch);
+    clock.lap(1,5);clock.done(1,record->memory->bytes());
+    *record={};--objects_;result_.complete=true;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::describe(uint64_t handle,uint64_t *iova,size_t *bytes,
+    unsigned *permissions) const
+{
+    if(!iova || !bytes || !permissions)return kIOReturnBadArgument;
+    *iova=0;*bytes=0;*permissions=0;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    for(size_t m=0;mappings_ && m<NativeAdrenoVmMaxObjects;++m)if(mappings_[m].handle==handle && mappings_[m].memory) {
+        const Mapping &mapping=mappings_[m];
+        *iova=mapping.iova;*bytes=mapping.memory->bytes();*permissions=mapping.permissions;
+        return mapping.mapped_spans==mapping.spans?kIOReturnSuccess:kIOReturnNotReady;
+    }
+    return kIOReturnBadArgument;
+}
+/* TLBIALL of the bank before a submission. Where a table update has observed the bank's image (each region's whole-verification
+ * update remembers its register offset), the invalidation alone: the image and faults were observed there and every 64th table
+ * operation since (int-159: a submission spent 1.3 ms in the kernel, most of it reading SMMU registers). */
+IOReturn NativeAdrenoVm::invalidateTlb()
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    ArmSmmu4KProgramResult r;
+    uint64_t offset=0;
+    for(const auto &region:regions_)if(region.state && region.state->context_offset)offset=region.state->context_offset;
+    const ArmSmmu4KStatus status=offset?ArmSmmu4KSyncContextTlb(&io_,offset,context_->asid,1,budget_,&r):
+        ArmSmmu4KInvalidateAllOwnedContext(&io_,streams_->bank,context_,budget_,&r);
+    return status?fail(status):kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::publishMapped()
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory)continue;
+        if(coherentMapping(m.writeback) || importedUntouched(m.memory)) {native_adreno_coherent_skips[2]=native_adreno_coherent_skips[2]+1;continue;}
+        if(m.memory->publishForDevice(0,m.memory->bytes(),true,distrust_write_combined_))return fail(ArmSmmu4KIoError);
+    }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::acquireImported()
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory || !m.memory->imported() || !(m.permissions&ArmSmmu4KWrite))continue;
+        if(coherentMapping(m.writeback) || importedUntouched(m.memory)) {native_adreno_coherent_skips[3]=native_adreno_coherent_skips[3]+1;continue;}
+        if(m.memory->acquireDeviceWrites(0,m.memory->bytes()))return fail(ArmSmmu4KIoError);
+    }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::sampleWord(uint64_t iova,uint32_t *cached,uint32_t *dram) const
+{
+    if(!cached || !dram)return kIOReturnBadArgument;
+    *cached=*dram=~0u;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(iova&3)return kIOReturnBadArgument;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory || iova<m.iova || iova-m.iova>=m.memory->bytes())continue;
+        const size_t offset=(size_t)(iova-m.iova);
+        if(m.memory->mapping())*cached=static_cast<const volatile uint32_t *>(m.memory->mapping())[offset/4];
+        for(size_t j=0;j<m.memory->spanCount();++j) {
+            const auto &span=m.memory->spans()[j];
+            if(offset<span.offset || offset-span.offset>=span.bytes)continue;
+            uint32_t value=0;
+            /* DRAM first: the cached reader writes its line back, so read after it DRAM would always agree (int-099). */
+            if(native_adreno_dram_read32 && !native_adreno_dram_read32(span.physical+(offset-span.offset),&value))*dram=value;
+            /* A write-combined BO's own mapping is non-cacheable: read the cacheable alias instead, so a dirty line is still seen. */
+            if(native_adreno_cached_read32 && !native_adreno_cached_read32(span.physical+(offset-span.offset),&value))*cached=value;
+            break;
+        }
+        return kIOReturnSuccess;
+    }
+    return kIOReturnBadArgument;
+}
+IOReturn NativeAdrenoVm::reassertWriteCombined(uint32_t *reset) const
+{
+    if(!reset)return kIOReturnBadArgument;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory)continue;
+        const IOReturn status=m.memory->reassertWriteCombined(reset);
+        if(status)return status;
+    }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::auditRange(uint64_t iova,size_t bytes,uint32_t *lines,uint32_t *dirty,uint32_t *stale) const
+{
+    if(!lines || !dirty || !stale)return kIOReturnBadArgument;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(!native_adreno_line_audit)return kIOReturnUnsupported;
+    if(!bytes || iova>UINT64_MAX-bytes)return kIOReturnBadArgument;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory || iova<m.iova || iova-m.iova>=m.memory->bytes())continue;
+        if(!m.memory->writeCombined())return kIOReturnSuccess;   /* maintained before every submission anyway */
+        /* Whole lines; the range is clipped to its BO. */
+        size_t at=(size_t)(iova-m.iova)&~(size_t)63;
+        const size_t end=(size_t)(iova-m.iova)+bytes>m.memory->bytes()?m.memory->bytes():(size_t)(iova-m.iova)+bytes;
+        while(at<end) {
+            const NativeAdrenoPhysicalSpan *span=nullptr;
+            for(size_t j=0;j<m.memory->spanCount();++j) {
+                const auto &s=m.memory->spans()[j];
+                if(at>=s.offset && at-s.offset<s.bytes) {span=&s;break;}
+            }
+            if(!span)return kIOReturnBadArgument;
+            const uint64_t physical=span->physical+(at-span->offset);
+            size_t chunk=4096-(size_t)(physical&4095);
+            if(chunk>span->offset+span->bytes-at)chunk=span->offset+span->bytes-at;
+            if(chunk>end-at)chunk=(end-at+63)&~(size_t)63;
+            if(native_adreno_line_audit(physical,chunk,dirty,stale))return kIOReturnIOError;
+            *lines+=(uint32_t)(chunk/64);at+=chunk;
+        }
+        return kIOReturnSuccess;
+    }
+    return kIOReturnBadArgument;
+}
+IOReturn NativeAdrenoVm::peekWords(uint64_t iova,uint32_t *out,size_t count) const
+{
+    if(!out || !attached_ || poisoned_)return kIOReturnBadArgument;
+    for(size_t k=0;k<count;++k)out[k]=0;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory || !m.memory->mapping() || iova<m.iova || iova-m.iova>=m.memory->bytes())continue;
+        const size_t offset=(size_t)(iova-m.iova);
+        for(size_t k=0;k<count && offset+4*k+4<=m.memory->bytes();++k)out[k]=static_cast<const volatile uint32_t *>(m.memory->mapping())[offset/4+k];
+        return kIOReturnSuccess;
+    }
+    return kIOReturnBadArgument;
+}
+IOReturn NativeAdrenoVm::holdJob(uint64_t handle)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    Mapping *record=find(handle);if(!record)return kIOReturnBadArgument;
+    if(record->jobs==UINT32_MAX)return kIOReturnNoResources;
+    IOReturn status=record->memory->holdForDevice();if(status)return status;
+    ++record->jobs;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::retireJobAfterCompletion(uint64_t handle)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    Mapping *record=find(handle);if(!record || !record->jobs)return kIOReturnBadArgument;
+    IOReturn status=record->memory->retireAfterQuiescence();if(status)return status;
+    --record->jobs;return kIOReturnSuccess;
+}
diff --git a/iokit/NativeAdreno/NativeAdrenoVm.h b/iokit/NativeAdreno/NativeAdrenoVm.h
new file mode 100644
index 0000000..be6820b
--- /dev/null
+++ b/iokit/NativeAdreno/NativeAdrenoVm.h
@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_VM_H
+#define NATIVE_ADRENO_VM_H
+#include "NativeAdrenoSmmuMemory.h"
+#include "ArmSmmu4KStreams.h"
+struct NativeAdrenoVmRegion {
+    NativeAdrenoMemory *tables;
+    ArmSmmu4KLiveArena *arena;
+    ArmSmmu4KLiveState *state;
+};
+struct NativeAdrenoVmResult {
+    ArmSmmu4KStatus operation,quarantine;
+    size_t completed_spans;
+    bool complete;
+};
+/* Kernel-owned BO mapping transactions, not a userspace ABI or GPU scheduler.
+ * Attach only under the actual bank/ASID/stream and powered-MMIO lease, with
+ * fault IRQ handling installed and empty native4K arenas already active.
+ * The real table allocations, context/streams and BO objects remain retained
+ * by the owning driver. No implicit destructor cleanup; detach must succeed.
+ * Serialize all methods, table updates and submission under the DRIVER gate.
+ * ALL masters must stay genuinely quiesced through each map/unmap transaction.
+ * Job counts are lifetime accounting; neither they nor these APIs are fences.
+ * Each active region is audited, including the unmodified peer. Partial failure
+ * keeps every old/new BO reference, poisons both arenas and attempts to FAULT
+ * only the owned streams. Uncertain resources require independent real reset.
+ * No VM may be advertised to apps until per-client isolation, submission
+ * validation/protection, genuine IRQ fences and reset are implemented. */
+/* One table for every client's mappings: 1024 filled up once the render server primed its shaders (int-237: BoMap refused with
+ * kIOReturnNoResources at objects=1024, Turnip wrote through a NULL command stream and backboardd crashed). */
+enum : size_t {NativeAdrenoVmMaxObjects=4096};
+/* Board hook for sampleWord(): reads one aligned word of physical memory through a fresh uncached mapping; 0 on success. */
+extern "C" int (*native_adreno_dram_read32)(uint64_t physical,uint32_t *value);
+/* The board's reader through the kernel's cacheable physical aperture (null on the host: the BO's own mapping is read). */
+extern "C" int (*native_adreno_cached_read32)(uint64_t physical,uint32_t *value);
+/* Board hook for auditRange(): [physical, physical+bytes), whole 64-byte lines inside one page, as the cacheable physical aperture and
+ * DRAM (a fresh uncached mapping) read it. A line that differs is cleaned and invalidated and DRAM read again: when DRAM then holds the
+ * cached copy the line was dirty (*dirty), when DRAM is unchanged it was a stale clean copy (*stale). 0 on success. */
+extern "C" int (*native_adreno_line_audit)(uint64_t physical,size_t bytes,uint32_t *dirty,uint32_t *stale);
+class NativeAdrenoVm final {
+    struct Mapping {
+        NativeAdrenoMemory *memory=nullptr;
+        uint64_t handle=0,iova=0;
+        size_t spans=0,mapped_spans=0;
+        unsigned permissions=0,writeback=0,shareability=0,jobs=0;
+    };
+    Mapping *mappings_=nullptr;
+    NativeAdrenoVmRegion regions_[2]{};
+    ArmSmmu4KLiveVisibility visibility_[2]{};
+    ArmSmmu4KIo io_{};
+    ArmSmmu4KContextConfig *context_=nullptr;
+    ArmSmmu4KStreamState *streams_=nullptr;
+    ArmSmmu4KRange *ranges_=nullptr;
+    size_t capacity_=0,lower_count_=0,upper_count_=0,objects_=0;
+    unsigned budget_=0;
+    uint64_t next_handle_=1;
+    bool attached_=false,poisoned_=false,distrust_write_combined_=false;
+    NativeAdrenoVmResult result_{};
+    ArmSmmu4KLiveRegion region(unsigned) const;
+    ArmSmmu4KStatus observe() const;
+    /* The route check alone: the table walk is the update's own (it verifies every region before the first store and after the last), so
+     * map/unmap pay a full extra audit only every 64th operation (int-139: 4 full walks of the 2 GiB aperture made every map 70 ms). */
+    ArmSmmu4KStatus observeStreamsOnly() const;
+    ArmSmmu4KStatus observeCheap();
+    unsigned since_audit_=0;
+    IOReturn fail(ArmSmmu4KStatus);
+    Mapping *find(uint64_t);
+    void insert(size_t,unsigned);
+    void erase(size_t,size_t,unsigned);
+    IOReturn preflight(const NativeAdrenoMemory *,unsigned,uint64_t,unsigned,unsigned,unsigned) const;
+public:
+    NativeAdrenoVm()=default;
+    ~NativeAdrenoVm()=default;
+    NativeAdrenoVm(const NativeAdrenoVm &)=delete;
+    NativeAdrenoVm &operator=(const NativeAdrenoVm &)=delete;
+    IOReturn attach(const ArmSmmu4KIo *,ArmSmmu4KContextConfig *,ArmSmmu4KStreamState *,
+        const NativeAdrenoVmRegion *lower,const NativeAdrenoVmRegion *upper,
+        size_t max_spans,unsigned poll_budget);
+    /* Frees CPU metadata only, with no BOs remaining. Never releases roots,
+     * disables a bank or returns the platform lease; board lifecycle owns it. */
+    IOReturn detach();
+    IOReturn findAddress(unsigned upper,size_t bytes,uint64_t alignment,uint64_t *iova) const;
+    IOReturn map(NativeAdrenoMemory *,unsigned upper,uint64_t iova,
+        unsigned permissions,unsigned writeback,unsigned shareability,uint64_t *handle);
+    IOReturn unmap(uint64_t handle);
+    IOReturn holdJob(uint64_t handle);
+    /* TLBIALL for the context bank plus TLBSYNC: drops every cached translation of the bank whatever its ASID. Unmap already
+     * synchronizes by ASID; this is the stronger form the submit path uses before each submission (int-070: on sheng the CP read
+     * zeros from an IB whose table entry and DRAM were both correct, after the address had been mapped to other pages before). */
+    IOReturn invalidateTlb();
+    /* Cleans and invalidates the CPU caches over every mapped BO (whole objects; imported ones through their physical pages), so
+     * no CPU cache line can hold data the GPU should see or hide what it wrote. Lines are physically tagged, so this also reaches
+     * lines a user mapping of the same pages left behind. int-070 runs it before every submission. */
+    IOReturn publishMapped();
+    /* The submit path saw a CPU-cached word that DRAM did not hold yet in a client's BO: from now on write-combined BOs are maintained
+     * like any other (sticky; the safe behaviour of int-070..097). */
+    void distrustWriteCombined() {distrust_write_combined_=true;}
+    bool writeCombinedTrusted() const {return !distrust_write_combined_;}
+    /* After a submission completed: cleans and invalidates the CPU caches over every GPU-writable imported BO, so the owner's mapping
+     * (an IOSurface) reads what the GPU wrote, not a line prefetched while the GPU ran. Jobs name only their IBs, so every such BO
+     * is covered. int-071: an imported render target read back 672 of 4096 texels stale. */
+    IOReturn acquireImported();
+    /* Diagnostic, never a proof of coherence: the 32-bit word at a mapped GPU address as the kernel's cacheable alias reads it
+     * and, when the board installed native_adreno_dram_read32, as DRAM reads it through an uncached mapping (else ~0). */
+    IOReturn sampleWord(uint64_t iova,uint32_t *cached,uint32_t *dram) const;
+    /* Every line of [iova, iova+bytes) that lies in a write-combined BO, through native_adreno_line_audit: *dirty counts lines a CPU
+     * cache held newer than DRAM (a client view that caches after all; each such line is written back by the audit), *stale clean
+     * copies, *lines the lines compared. kIOReturnUnsupported without a board hook. int-099 sampled one word and wrote its line back
+     * before reading DRAM, so it could never see a dirty line. */
+    /* Before a submission while write-combined BOs are trusted: every page of every mapped write-combined BO that XNU set back to the
+     * default attribute is write-combined again (and its lines written back); *reset counts the pages. */
+    IOReturn reassertWriteCombined(uint32_t *reset) const;
+    IOReturn auditRange(uint64_t iova,size_t bytes,uint32_t *lines,uint32_t *dirty,uint32_t *stale) const;
+    /* Read-only description of a live mapping; never pins or extends it. */
+    IOReturn describe(uint64_t handle,uint64_t *iova,size_t *bytes,unsigned *permissions) const;
+    /* Up to `count` dwords of a mapped kernel-owned BO at a GPU address (through the kernel's own mapping), for the board log. */
+    IOReturn peekWords(uint64_t iova,uint32_t *out,size_t count) const;
+    /* Only a scheduler's actual successful GPU completion may call this.
+     * A timeout, interrupt bit alone or CPU-written timestamp is insufficient. */
+    IOReturn retireJobAfterCompletion(uint64_t handle);
+    bool poisoned() const {return poisoned_;}
+    size_t objectCount() const {return objects_;}
+    size_t spanCount() const {return lower_count_+upper_count_;}
+    NativeAdrenoVmResult lastResult() const {return result_;}
+};
+#endif
diff --git a/iokit/NativeAdreno/NativeAdrenoVmAlias.h b/iokit/NativeAdreno/NativeAdrenoVmAlias.h
new file mode 100644
index 0000000..bdd6b9e
--- /dev/null
+++ b/iokit/NativeAdreno/NativeAdrenoVmAlias.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_VM_ALIAS_H
+#define NATIVE_ADRENO_VM_ALIAS_H
+#include <stddef.h>
+#include <stdint.h>
+
+/* Temporary CPU validation index, never a GPU mapping or translation table.
+ * Range has physical/bytes fields. The caller has validated nonempty ranges
+ * with nonoverflowing ends and supplies count valid indices in owned scratch.
+ * Original ranges are immutable. One serialized owner uses scratch at a time. */
+template<class Range> class NativeAdrenoPhysicalIndex final {
+    const Range *ranges_;
+    uint32_t *order_;
+    size_t count_;
+    uint64_t end(uint32_t i) const {return ranges_[i].physical+ranges_[i].bytes;}
+    bool less(uint32_t a,uint32_t b) const {
+        return ranges_[a].physical<ranges_[b].physical ||
+            (ranges_[a].physical==ranges_[b].physical && ranges_[a].bytes<ranges_[b].bytes);
+    }
+    void sift(size_t root,size_t count) {
+        while(root<count/2) {
+            size_t child=root*2+1;
+            if(child+1<count && less(order_[child],order_[child+1]))++child;
+            if(!less(order_[root],order_[child]))break;
+            uint32_t t=order_[root];order_[root]=order_[child];order_[child]=t;root=child;
+        }
+    }
+public:
+    NativeAdrenoPhysicalIndex(const Range *ranges,uint32_t *order,size_t count):ranges_(ranges),order_(order),count_(count) {
+        for(size_t i=count/2;i-->0;)sift(i,count);
+        for(size_t n=count;n>1;) {--n;uint32_t t=order_[0];order_[0]=order_[n];order_[n]=t;sift(0,n);}
+        /* Discard an interval contained by an earlier interval. The remaining
+         * starts AND ends are monotonic, even for nested/duplicate/overlapping
+         * inputs. Each query then needs a binary search, with no backward scan. */
+        size_t kept=0;
+        for(size_t i=0;i<count;++i) {
+            uint32_t index=order_[i];
+            if(!kept || end(index)>end(order_[kept-1]))order_[kept++]=index;
+        }
+        count_=kept;
+    }
+    bool overlaps(uint64_t physical,uint64_t bytes) const {
+        size_t lo=0,hi=count_;
+        while(lo<hi) {size_t mid=lo+(hi-lo)/2;if(end(order_[mid])<=physical)lo=mid+1;else hi=mid;}
+        return lo<count_ && ranges_[order_[lo]].physical<physical+bytes;
+    }
+};
+#endif
diff --git a/iokit/NativeAdreno/NativeMetal/CacheExport.h b/iokit/NativeAdreno/NativeMetal/CacheExport.h
new file mode 100644
index 0000000..9fb72ff
--- /dev/null
+++ b/iokit/NativeAdreno/NativeMetal/CacheExport.h
@@ -0,0 +1,313 @@
+// SPDX-License-Identifier: MIT
+// Pipeline-cache export (int-147). The render server's runtime keeps its translated shaders and the Vulkan driver's pipeline records in its
+// cache directory, but that directory lives on the RAM Data disk: every boot compiled the whole UI again (int-146: 98 pipelines, 63 s,
+// up to 1.6 s each, also while the user opened App Library). This thread sends the directory to the kernel's UFS log (method 0x7100 on a
+// hand-off connection, kits/sheng/BootLog.c export region) whenever it changed and then stayed unchanged for one period; the host reads it
+// back with the log and builds the next image's Data with it, so those pipelines start as cache hits.
+// A boot whose image carried a pack exports only the files the pack did not have (see baked()).
+// Stream: "M2VCACH1", u32 directory length, directory, u32 file count, then per file u32 path length, u32 mode, u32 uid, u32 gid, u64 size,
+// path (relative to the directory), contents. Export blob: "SHEXR001", u32 stream bytes, u32 0, the stream as it is: it goes out in pieces
+// while the files are read, so the render server never holds more than a piece (int-149: one boot's new variants were about 100 MB).
+// Image pack: "SHEXP001", u32 stream bytes, u32 compressed bytes, the stream zlib-compressed (scripts/add-gpu-plugin-data.py merges exports
+// into one). The export only reads.
+#pragma once
+#include <dirent.h>
+#include <dlfcn.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <zlib.h>
+#include <set>
+#include <string>
+#include <vector>
+#ifndef CACHEEXPORT_FORMAT_ONLY   // the format alone (host check, bridge/cache_export_host.cpp); the plugin also gets the sender
+#include "NativeAdrenoUserTest.h"
+#endif
+
+namespace cacheexport {
+
+// kLimit: the largest export blob, one half of the kernel's 256 MiB export region.
+constexpr uint32_t kMethod = 0x7100, kPiece = 3968, kLimit = 128u << 20;
+struct File {std::string path; struct stat st;};
+
+// A pack in the image is the union of several boots' exports (scripts/add-gpu-plugin-data.py); it is read as a stream, so only its own
+// file and the stream bounds limit it.
+constexpr uint64_t kPackLimit = 1ull << 30;
+
+// Files the image's pack carried (path and size). The export leaves them out: the host has them already and merges each boot's export
+// with the earlier ones, so a boot sends only what it compiled itself (int-148: the whole directory outgrew the export area once the UI's
+// own variants were added, and the export refused the build, marker 0x69f2).
+static std::set<std::string> &baked() {static std::set<std::string> files; return files;}
+static std::string bakedKey(const std::string &path, uint64_t size) {return path + '\n' + std::to_string(size);}
+static void dropBaked(std::vector<File> &files) {
+    if (baked().empty()) return;
+    std::vector<File> fresh;
+    for (File &f : files) if (!baked().count(bakedKey(f.path, (uint64_t)f.st.st_size))) fresh.push_back(std::move(f));
+    files.swap(fresh);
+}
+
+static void scan(const std::string &root, const std::string &relative, std::vector<File> &out, unsigned depth) {
+    if (depth > 8) return;
+    DIR *dir = opendir((root + "/" + relative).c_str());
+    if (!dir) return;
+    while (dirent *entry = readdir(dir)) {
+        if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, "..")) continue;
+        const std::string path = relative.empty() ? std::string(entry->d_name) : relative + "/" + entry->d_name;
+        struct stat st = {};
+        if (lstat((root + "/" + path).c_str(), &st) != 0) continue;
+        if (S_ISDIR(st.st_mode)) scan(root, path, out, depth + 1);
+        else if (S_ISREG(st.st_mode)) out.push_back({path, st});
+    }
+    closedir(dir);
+}
+
+// Count, bytes and newest modification of the directory: equal on two scans = nothing is being written.
+static uint64_t signature(const std::vector<File> &files) {
+    uint64_t s = files.size() * 0x9e3779b97f4a7c15ull;
+    for (const File &f : files) s = s * 31 + (uint64_t)f.st.st_size * 1000003 + (uint64_t)f.st.st_mtimespec.tv_sec * 7 + (uint64_t)f.st.st_mtimespec.tv_nsec;
+    return s;
+}
+
+template <typename T> static void put(std::vector<uint8_t> &b, T v) {const uint8_t *p = (const uint8_t *)&v; b.insert(b.end(), p, p + sizeof v);}
+
+// The stream's length for these files, from their sizes as scanned.
+static uint64_t streamBytes(const std::string &root, const std::vector<File> &files) {
+    uint64_t n = 8 + 4 + root.size() + 4;
+    for (const File &f : files) n += 24 + f.path.size() + (uint64_t)f.st.st_size;
+    return n;
+}
+
+// The stream, handed to emit(bytes, count) in order (emit returns false to stop); false when a file vanished or no longer has the size
+// it was scanned with, or emit stopped.
+template <typename Emit> static bool stream(const std::string &root, const std::vector<File> &files, Emit &&emit) {
+    std::vector<uint8_t> head;
+    {static const char magic[] = "M2VCACH1"; head.insert(head.end(), magic, magic + 8);}
+    put<uint32_t>(head, (uint32_t)root.size());
+    head.insert(head.end(), root.begin(), root.end());
+    put<uint32_t>(head, (uint32_t)files.size());
+    if (!emit(head.data(), head.size())) return false;
+    std::vector<uint8_t> chunk(65536);
+    for (const File &f : files) {
+        FILE *in = fopen((root + "/" + f.path).c_str(), "rb");
+        if (!in) return false;
+        head.clear();
+        put<uint32_t>(head, (uint32_t)f.path.size());
+        put<uint32_t>(head, (uint32_t)f.st.st_mode);
+        put<uint32_t>(head, (uint32_t)f.st.st_uid);
+        put<uint32_t>(head, (uint32_t)f.st.st_gid);
+        put<uint64_t>(head, (uint64_t)f.st.st_size);
+        head.insert(head.end(), f.path.begin(), f.path.end());
+        bool ok = emit(head.data(), head.size());
+        uint64_t left = (uint64_t)f.st.st_size;
+        while (ok && left) {
+            const size_t want = left < chunk.size() ? (size_t)left : chunk.size();
+            ok = fread(chunk.data(), 1, want, in) == want && emit(chunk.data(), want);
+            left -= want;
+        }
+        ok = ok && fgetc(in) == EOF;   // grown since the scan: refuse rather than send a short copy
+        fclose(in);
+        if (!ok) return false;
+    }
+    return true;
+}
+
+#ifdef CACHEEXPORT_FORMAT_ONLY
+// The image pack format (SHEXP001, compressed), for the host check; scripts/add-gpu-plugin-data.py builds the same. False when a file
+// vanished or zlib is missing.
+static bool build(const std::string &root, const std::vector<File> &files, std::vector<uint8_t> &out) {
+    using BoundFn = unsigned long (*)(unsigned long);
+    using CompressFn = int (*)(uint8_t *, unsigned long *, const uint8_t *, unsigned long, int);
+    static void *z = dlopen("/usr/lib/libz.1.dylib", RTLD_NOW | RTLD_LOCAL);
+    if (!z) return false;
+    auto bound = (BoundFn)dlsym(z, "compressBound");
+    auto compress = (CompressFn)dlsym(z, "compress2");
+    if (!bound || !compress) return false;
+    std::vector<uint8_t> raw;
+    if (!stream(root, files, [&](const uint8_t *p, size_t n) {raw.insert(raw.end(), p, p + n); return true;})) return false;
+    unsigned long zbytes = bound(raw.size());
+    std::vector<uint8_t> zdata(zbytes);
+    if (compress(zdata.data(), &zbytes, raw.data(), raw.size(), 6) != 0) return false;
+    out.clear();
+    {static const char magic[] = "SHEXP001"; out.insert(out.end(), magic, magic + 8);}
+    put<uint32_t>(out, (uint32_t)raw.size());
+    put<uint32_t>(out, (uint32_t)zbytes);
+    out.insert(out.end(), zdata.begin(), zdata.begin() + (long)zbytes);
+    return true;
+}
+#endif
+
+// Reads a pack's stream: inflated as it is consumed, so neither the pack nor the stream is held in memory.
+struct PackReader {
+    using InitFn = int (*)(z_streamp, const char *, int);
+    using InflateFn = int (*)(z_streamp, int);
+    using EndFn = int (*)(z_streamp);
+    FILE *in = nullptr;
+    z_stream z = {};
+    InflateFn inflateFn = nullptr;
+    EndFn endFn = nullptr;
+    bool open = false, ended = false;
+    uint64_t left = 0, produced = 0, expect = 0;   // compressed bytes not yet read from the file, stream bytes produced, stream bytes announced
+    uint8_t input[65536];
+    ~PackReader() {if (open) endFn(&z); if (in) fclose(in);}
+    bool start(const char *path) {
+        static void *lib = dlopen("/usr/lib/libz.1.dylib", RTLD_NOW | RTLD_LOCAL);
+        auto init = lib ? (InitFn)dlsym(lib, "inflateInit_") : nullptr;
+        inflateFn = lib ? (InflateFn)dlsym(lib, "inflate") : nullptr;
+        endFn = lib ? (EndFn)dlsym(lib, "inflateEnd") : nullptr;
+        if (!init || !inflateFn || !endFn || !(in = fopen(path, "rb"))) return false;
+        struct stat st = {};
+        uint8_t head[16];
+        uint32_t raw = 0, zbytes = 0;
+        if (fstat(fileno(in), &st) != 0 || (uint64_t)st.st_size > kPackLimit || fread(head, 1, 16, in) != 16 || memcmp(head, "SHEXP001", 8)) return false;
+        memcpy(&raw, head + 8, 4);
+        memcpy(&zbytes, head + 12, 4);
+        if ((uint64_t)zbytes != (uint64_t)st.st_size - 16) return false;
+        left = zbytes; expect = raw;
+        open = init(&z, ZLIB_VERSION, (int)sizeof z) == Z_OK;
+        return open;
+    }
+    bool read(void *out, size_t n) {
+        z.next_out = static_cast<Bytef *>(out);
+        z.avail_out = (uInt)n;
+        while (z.avail_out) {
+            if (ended) return false;
+            if (!z.avail_in && left) {
+                const size_t want = left < sizeof input ? (size_t)left : sizeof input;
+                if (fread(input, 1, want, in) != want) return false;
+                left -= want;
+                z.next_in = input;
+                z.avail_in = (uInt)want;
+            }
+            const uInt before = z.avail_out;
+            const int r = inflateFn(&z, Z_NO_FLUSH);
+            produced += before - z.avail_out;
+            if (r == Z_STREAM_END) ended = true;
+            else if (r != Z_OK) return false;
+            if (produced > expect) return false;
+        }
+        return true;
+    }
+    bool skip(uint64_t n) {
+        uint8_t scratch[16384];
+        while (n) {const size_t k = n < sizeof scratch ? (size_t)n : sizeof scratch; if (!read(scratch, k)) return false; n -= k;}
+        return true;
+    }
+    // The whole stream was consumed: zlib's check passed at its end and nothing follows it.
+    bool finished() {
+        if (!ended) {uint8_t b; if (read(&b, 1)) return false;}
+        return ended && produced == expect && !left && !z.avail_in;
+    }
+};
+
+// Import, before the device opens: the image may carry a pack beside the bundle (NativeAdrenoMetal.m2vpack, put there by
+// scripts/add-gpu-plugin-data.py --pipeline-pack). Its files go into this process's own cache directory, so they carry this process's owner
+// and mode; a file that is already there with the same size is kept. Files are written beside their place and renamed only once the
+// whole pack has been read and checked: a damaged pack imports nothing. Returns the number of files written, or -1.
+static int importPack(const char *pack, const std::string &directory) {
+    if (access(pack, R_OK) != 0) return 0;
+    PackReader r;
+    if (!r.start(pack)) return -1;
+    std::vector<std::string> written;
+    auto fail = [&]() {for (const std::string &f : written) unlink((f + ".import").c_str()); return -1;};
+    char magic[8];
+    uint32_t rootLength = 0, count = 0;
+    if (!r.read(magic, 8) || memcmp(magic, "M2VCACH1", 8) || !r.read(&rootLength, 4) || rootLength > 4096 || !r.skip(rootLength) ||
+        !r.read(&count, 4) || count > 1u << 20) return fail();
+    std::set<std::string> seen;
+    std::vector<uint8_t> chunk(65536);
+    for (uint32_t i = 0; i < count; ++i) {
+        uint32_t pathLength = 0, mode = 0, uid = 0, gid = 0;
+        uint64_t size = 0;
+        if (!r.read(&pathLength, 4) || !r.read(&mode, 4) || !r.read(&uid, 4) || !r.read(&gid, 4) || !r.read(&size, 8)) return fail();
+        if (pathLength == 0 || pathLength > 1024 || size > r.expect) return fail();
+        std::string path(pathLength, '\0');
+        if (!r.read(&path[0], pathLength)) return fail();
+        if (path[0] == '/' || path.find("..") != std::string::npos || path.find('\0') != std::string::npos) return fail();
+        seen.insert(bakedKey(path, size));
+        const std::string full = directory + "/" + path;
+        struct stat st = {};
+        if (stat(full.c_str(), &st) == 0 && (uint64_t)st.st_size == size) {if (!r.skip(size)) return fail(); continue;}
+        for (size_t slash = full.find('/', directory.size() + 1); slash != std::string::npos; slash = full.find('/', slash + 1))
+            mkdir(full.substr(0, slash).c_str(), 0700);
+        written.push_back(full);
+        FILE *out = fopen((full + ".import").c_str(), "wb");
+        if (!out) return fail();
+        bool ok = true;
+        for (uint64_t left = size; ok && left;) {
+            const size_t k = left < chunk.size() ? (size_t)left : chunk.size();
+            ok = r.read(chunk.data(), k) && fwrite(chunk.data(), 1, k, out) == k;
+            left -= k;
+        }
+        ok = fclose(out) == 0 && ok;
+        if (!ok) return fail();
+    }
+    if (!r.finished()) return fail();
+    int renamed = 0;
+    for (const std::string &f : written) if (rename((f + ".import").c_str(), f.c_str()) == 0) ++renamed; else unlink((f + ".import").c_str());
+    baked().insert(seen.begin(), seen.end());   // only a pack read to its end counts
+    return renamed;
+}
+
+#ifndef CACHEEXPORT_FORMAT_ONLY
+// Markers 0x69xx: 00 started, 01 connection, 02 an export went out (then 0x6Bnn: its size in MiB, saturated), f0 no connection,
+// f1 no selector, f2 a file changed or vanished while it was read, f3 a piece refused, f4 the new files exceed one export.
+static void run(Gpu &marker, std::string root) {
+    while (root.size() > 1 && root.back() == '/') root.pop_back();
+    marker.mark(0x6900);
+    Gpu link;
+    link.call = marker.call; link.openFn = marker.openFn; link.closeFn = marker.closeFn; link.port = marker.port;
+    if (!link.openFn || link.openFn(link.port, mach_task_self(), 0x4148, &link.conn) != 0 || !link.conn) {marker.mark(0x69f0); return;}
+    if (!link.probe()) {marker.mark(0x69f1); return;}
+    marker.mark(0x6901);
+    uint64_t previous = 0, exported = 0;
+    uint32_t generation = 0;
+    std::vector<uint8_t> buffer(24 + kPiece);
+    for (;;) {
+        sleep(15);
+        std::vector<File> files;
+        scan(root, "", files, 0);
+        dropBaked(files);
+        const uint64_t now = signature(files);
+        const bool stable = now == previous;
+        previous = now;
+        if (!stable || now == exported || files.empty()) continue;
+        const uint64_t total = 16 + streamBytes(root, files);
+        if (total > kLimit) {marker.mark(0x69f4); exported = now; continue;}
+        ++generation;
+        uint32_t offset = 0, filled = 0;
+        bool sent = true;
+        auto flush = [&]() {
+            const uint32_t header[6] = {kTunnelMagic, kMethod, generation, (uint32_t)total, offset, filled};
+            memcpy(buffer.data(), header, sizeof header);
+            sent = link.call(link.conn, link.selector, buffer.data(), sizeof header + filled, nullptr, nullptr) == 0;
+            offset += filled;
+            filled = 0;
+            return sent;
+        };
+        auto emit = [&](const uint8_t *p, size_t n) {
+            while (n) {
+                const size_t k = n < kPiece - filled ? n : kPiece - filled;
+                memcpy(buffer.data() + 24 + filled, p, k);
+                filled += (uint32_t)k; p += k; n -= k;
+                if (filled == kPiece && !flush()) return false;
+            }
+            return true;
+        };
+        uint8_t head[16] = {'S', 'H', 'E', 'X', 'R', '0', '0', '1'};
+        const uint32_t streamed = (uint32_t)(total - 16);
+        memcpy(head + 8, &streamed, 4);
+        const bool read = emit(head, sizeof head) && stream(root, files, emit);
+        if (read && filled) flush();
+        if (!sent) {marker.mark(0x69f3); continue;}       // retried after the next change or period
+        if (!read || offset != total) {marker.mark(0x69f2); continue;}
+        exported = now;
+        marker.mark(0x6902);
+        marker.mark(0x6B00 | (uint32_t)(total >> 20 > 0xff ? 0xff : total >> 20));
+    }
+}
+
+#endif
+
+}  // namespace cacheexport
diff --git a/iokit/NativeAdreno/NativeMetal/ExceptionDiag.h b/iokit/NativeAdreno/NativeMetal/ExceptionDiag.h
new file mode 100644
index 0000000..3f35f6e
--- /dev/null
+++ b/iokit/NativeAdreno/NativeMetal/ExceptionDiag.h
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: MIT
+// The throw site of an uncaught Objective-C exception (int-201). MobileSafari aborts with "-[_NSPlaceholderData initWithContentsOfURL:...]: nil URL
+// argument" on a dispatch worker, and the crash record's backtrace has only the dispatch frames: the unwinder gave up inside the throw, so which
+// caller passed the nil URL is lost. Foundation records the return addresses when it throws (callStackReturnAddresses); this handler copies them,
+// with the exception's name and reason, into a malloc'd C string that the kernel's abort-reason scan finds in the dying process's heap
+// (kits/sheng/BootFaultProbe.c, "SHENGTHROW ") and the log prints as the THROW row. The original handler (the app's own, or Foundation's) runs
+// after it, unchanged; a process that never throws is untouched.
+#pragma once
+#import <Foundation/Foundation.h>
+#include <stdlib.h>
+#include <string.h>
+
+namespace exceptiondiag {
+
+static NSUncaughtExceptionHandler *gPrevious;
+static char *gText;   // kept referenced: the text must stay in the heap until the process is gone
+
+static void handler(NSException *exception) {
+    @autoreleasepool {
+        NSMutableString *text = [NSMutableString stringWithFormat:@"SHENGTHROW %@ | ", exception.name];
+        NSString *reason = exception.reason ?: @"";
+        [text appendString:reason.length > 96 ? [reason substringToIndex:96] : reason];
+        [text appendString:@" |"];
+        NSArray<NSNumber *> *frames = exception.callStackReturnAddresses;
+        for (NSUInteger i = 0; i < frames.count && i < 20; ++i) [text appendFormat:@" %llx", (unsigned long long)frames[i].unsignedLongLongValue];
+        for (NSUInteger i = 0; i < text.length; ++i) if ([text characterAtIndex:i] < 32 || [text characterAtIndex:i] > 126) [text replaceCharactersInRange:NSMakeRange(i, 1) withString:@"?"];
+        if (const char *utf8 = text.UTF8String) gText = strdup(utf8);
+    }
+    if (gPrevious) gPrevious(exception);
+}
+// Every process that loads the plugin, once: the handler is installed in front of whatever the process already had.
+static void start() {
+    static bool started;
+    if (started) return;
+    started = true;
+    gPrevious = NSGetUncaughtExceptionHandler();
+    NSSetUncaughtExceptionHandler(handler);
+}
+
+}  // namespace exceptiondiag
diff --git a/iokit/NativeAdreno/NativeMetal/GpuScanoutClient.h b/iokit/NativeAdreno/NativeMetal/GpuScanoutClient.h
new file mode 100644
index 0000000..6ffcb6d
--- /dev/null
+++ b/iokit/NativeAdreno/NativeMetal/GpuScanoutClient.h
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: MIT
+// Userspace side of the GPU hand-off (boot-arg sheng-fb-gpu=1): serves the display driver's frames with the GPU. For every offered frame the
+// GPU copies the compositor's surface pages into the scanout mapping (GpuScanoutPresenter.h), and the swap is completed with the GPU's
+// verdict. A failed copy is reported as failed; the display driver then falls back to its own path and counts it.
+// The calls reach the kernel through a Transport. In the plugin that is the Adreno accelerator's connection (the original sandbox profiles
+// admit that class, not the presenter's own service): methods 0x7000 + NGP_METHOD_* through the tunnel selector, scanout as memory type 0x5343.
+#pragma once
+#import <Metal/Metal.h>
+#include <mach/mach_time.h>
+#include <stdint.h>
+#include <unistd.h>
+#include "GpuScanoutPresenter.h"
+#include "../NativeMobileDisplay/NativeGOPWire.h"
+
+namespace gpuscanout {
+
+struct Transport {
+    void *context;
+    // NGP_METHOD_MODE / WAIT_SWAP / COMPLETE_SWAP with the wire records; returns the IOReturn (0 = success).
+    int (*call)(void *context, uint32_t method, const void *in, size_t inSize, void *out, size_t outSize);
+    // The scanout, writable, mapped into this task.
+    int (*mapScanout)(void *context, uint64_t *address, uint64_t *length);
+    // Progress marker (the plugin shows the latest ones on the boot page, which survives a panic that parks the calling core).
+    void (*mark)(void *context, uint32_t value);
+};
+
+struct Stats {
+    uint64_t frames, failures, timeouts;
+    int lastResult;     // gpupresent::Result of the last frame
+    int step;           // 0 idle, 2 mode refused, 3 scanout not mappable/importable, 4 serving
+    int error;          // the failing call's return, when there is one
+    uint64_t verified;  // frames whose scanout was read back and compared with the surface
+    uint64_t mismatchRows;   // rows of those frames that differ (CPU reads only: nothing is rendered or copied by the CPU)
+    uint32_t lastMs;    // the GPU copy's time for the last frame
+    uint64_t totalMs;   // and for all frames (the mean is totalMs / (frames + failures))
+};
+
+class Client {
+public:
+    // Reads the mode and maps the scanout; false with stats.step telling where it stopped.
+    bool open(id<MTLDevice> device, const Transport &transport, Stats *stats) {
+        transport_ = transport;
+        stats_ = stats;
+        NGPMode mode = {};
+        note(0x6710);
+        int status = transport_.call(transport_.context, NGP_METHOD_MODE, nullptr, 0, &mode, sizeof mode);
+        note(0x6711);
+        if (status || mode.version != NGP_VERSION || mode.format != NGP_BGRX8888 || !mode.width || !mode.height ||
+            mode.stride < mode.width * 4 || mode.bytes < mode.stride * mode.height) return fail(2, status);
+        const size_t page = (size_t)getpagesize();
+        uint64_t address = 0, length = 0;
+        note(0x6712);
+        status = transport_.mapScanout(transport_.context, &address, &length);
+        note(0x6713);
+        if (status || !address || length < mode.bytes) return fail(3, status);
+        // The mapping covers whole pages; the framebuffer allocation ends on a page boundary, the copy never writes past the last row.
+        gpupresent::Scanout scanout = {(void *)(uintptr_t)address, (size_t)((mode.bytes + page - 1) & ~(page - 1)), (size_t)mode.stride,
+                                       (uint32_t)mode.width, (uint32_t)mode.height};
+        note(0x6714);
+        scanout_ = scanout;
+        presenter_ = new gpupresent::Presenter(device, scanout);
+        note(0x6715);
+        if (!presenter_->ready()) return fail(3, 0);
+        stats_->step = 4;
+        return true;
+    }
+    // One wait (at most timeoutMs) and, when the display driver offered a frame, one GPU copy and its completion. Returns false on a
+    // protocol error that makes further serving pointless.
+    bool serveOne(uint64_t timeoutMs) {
+        NGPWait wait = {timeoutMs};
+        NGPSwap swap = {};
+        if (!stats_->timeouts && !stats_->frames) note(0x6720);   // first wait
+        const int status = transport_.call(transport_.context, NGP_METHOD_WAIT_SWAP, &wait, sizeof wait, &swap, sizeof swap);
+        if (status) {
+            if ((unsigned)status == 0xe00002d6u /* kIOReturnTimeout */) {++stats_->timeouts; return true;}
+            ++stats_->failures;
+            stats_->error = status;
+            return false;
+        }
+        const size_t page = (size_t)getpagesize();
+        note(0x6730);   // a frame was offered
+        const uint64_t began = mach_absolute_time();
+        const gpupresent::Result r = presenter_->present({(const void *)(uintptr_t)swap.address, (size_t)((swap.bytes + page - 1) & ~(page - 1)),
+                                                          (size_t)swap.stride, swap.width, swap.height});
+        {
+            static mach_timebase_info_data_t base;
+            if (!base.denom) mach_timebase_info(&base);
+            stats_->lastMs = (uint32_t)(((mach_absolute_time() - began) * base.numer / base.denom) / 1000000);
+            stats_->totalMs += stats_->lastMs;
+        }
+        stats_->lastResult = (int)r;
+        if (r == gpupresent::kOk && stats_->verified < 4) verify(swap);
+        note(0x6731);   // the GPU copy returned
+        NGPComplete done = {swap.sequence, r == gpupresent::kOk ? 0u : 0xe00002bcu /* kIOReturnError */, 0};
+        const int completed = transport_.call(transport_.context, NGP_METHOD_COMPLETE_SWAP, &done, sizeof done, nullptr, 0);
+        if (completed) {++stats_->failures; stats_->error = completed; return false;}
+        if (r == gpupresent::kOk) ++stats_->frames; else ++stats_->failures;
+        return true;
+    }
+private:
+    // Reads the scanout back with aligned 32-bit loads (the framebuffer is device memory; wider loads can fault) and compares the top rows with the
+    // surface the GPU copied. The lower part of the panel is skipped: the diagnostic renderer paints there. Evidence only; nothing is written.
+    void verify(const NGPSwap &swap) {
+        const uint32_t rows = swap.height < 400 ? swap.height : 400, words = swap.width;
+        const volatile uint32_t *shown = (const volatile uint32_t *)scanout_.base;
+        const volatile uint32_t *surface = (const volatile uint32_t *)(uintptr_t)swap.address;
+        for (uint32_t y = 0; y < rows; ++y) {
+            const volatile uint32_t *a = shown + (size_t)y * (scanout_.stride / 4), *b = surface + (size_t)y * (swap.stride / 4);
+            for (uint32_t x = 0; x < words; ++x)
+                if (a[x] != b[x]) {++stats_->mismatchRows; break;}
+        }
+        ++stats_->verified;
+    }
+    void note(uint32_t value) {if (transport_.mark) transport_.mark(transport_.context, value);}
+    bool fail(int step, int error) {stats_->step = step; stats_->error = error; return false;}
+    Transport transport_ = {};
+    gpupresent::Presenter *presenter_ = nullptr;
+    gpupresent::Scanout scanout_ = {};
+    Stats *stats_ = nullptr;
+};
+
+}  // namespace gpuscanout
diff --git a/iokit/NativeAdreno/NativeMetal/GpuScanoutPresenter.h b/iokit/NativeAdreno/NativeMetal/GpuScanoutPresenter.h
new file mode 100644
index 0000000..9a9e938
--- /dev/null
+++ b/iokit/NativeAdreno/NativeMetal/GpuScanoutPresenter.h
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: MIT
+// GPU presentation: the GPU copies a finished BGRA frame (the compositor's IOSurface pages) into the firmware scanout memory. Both are
+// imported without a copy (newBufferWithBytesNoCopy: pinned by the kernel and mapped into the GPU's 4 KiB context), the copy is a blit on
+// the GPU's queue, and the call returns after the GPU retired it. No CPU touches a pixel; there is no staging copy and no software fallback
+// here. Used through the public Metal API, on any device (the native frontend on the tablet, the Mac's device for the host check).
+#pragma once
+#import <Metal/Metal.h>
+#include <unistd.h>
+#include <stdint.h>
+#include <string.h>
+
+namespace gpupresent {
+
+struct Scanout {
+    void *base;       // writable mapping of the firmware framebuffer (page aligned)
+    size_t bytes;     // whole extent, a multiple of the page size
+    size_t stride;    // bytes per row
+    uint32_t width, height;
+};
+
+struct Frame {
+    const void *base; // page-aligned mapping of the surface pages
+    size_t bytes;     // allocation size, a multiple of the page size
+    size_t stride;
+    uint32_t width, height;
+};
+
+enum Result { kOk = 0, kBadFrame, kBadScanout, kNoResource, kGpuFailed };
+
+class Presenter {
+public:
+    Presenter(id<MTLDevice> device, const Scanout &scanout) : device_(device), scanout_(scanout) {
+        queue_ = [device newCommandQueue];
+        if (!validScanout() || !queue_) return;
+        target_ = [device newBufferWithBytesNoCopy:scanout.base length:scanout.bytes options:MTLResourceStorageModeShared deallocator:nil];
+    }
+    bool ready() const { return target_ != nil; }
+    // One frame: encodes the GPU copy, commits, waits for the GPU. Rows are copied as whole rows of width*4 bytes.
+    Result present(const Frame &frame) {
+        if (!ready()) return kBadScanout;
+        const size_t page = (size_t)getpagesize(), row = (size_t)frame.width * 4;
+        if (!frame.base || ((uintptr_t)frame.base & (page - 1)) || !frame.bytes || (frame.bytes & (page - 1)) ||
+            frame.width != scanout_.width || frame.height != scanout_.height || frame.stride < row ||
+            (size_t)frame.height > frame.bytes / frame.stride || frame.stride * (frame.height - 1) + row > frame.bytes) return kBadFrame;
+        id<MTLBuffer> source = [device_ newBufferWithBytesNoCopy:(void *)frame.base length:frame.bytes options:MTLResourceStorageModeShared deallocator:nil];
+        if (!source) return kNoResource;
+        id<MTLCommandBuffer> commands = [queue_ commandBuffer];
+        id<MTLBlitCommandEncoder> blit = commands ? [commands blitCommandEncoder] : nil;
+        if (!blit) return kNoResource;
+        if (frame.stride == scanout_.stride) {
+            // Equal pitch: the rows are one contiguous run.
+            [blit copyFromBuffer:source sourceOffset:0 toBuffer:target_ destinationOffset:0 size:frame.stride * (frame.height - 1) + row];
+        } else {
+            // A linear texture over the surface pages reads them with the surface's pitch and writes the scanout's pitch.
+            MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:frame.width
+                                                                                       height:frame.height mipmapped:NO];
+            d.storageMode = MTLStorageModeShared;
+            d.usage = MTLTextureUsageShaderRead;
+            if (frame.stride % [device_ minimumLinearTextureAlignmentForPixelFormat:MTLPixelFormatBGRA8Unorm]) {
+                for (uint32_t y = 0; y < frame.height; ++y)
+                    [blit copyFromBuffer:source sourceOffset:y * frame.stride toBuffer:target_ destinationOffset:y * scanout_.stride size:row];
+            } else {
+                id<MTLTexture> texture = [source newTextureWithDescriptor:d offset:0 bytesPerRow:frame.stride];
+                if (!texture) {[blit endEncoding]; return kNoResource;}
+                [blit copyFromTexture:texture sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+                           sourceSize:MTLSizeMake(frame.width, frame.height, 1) toBuffer:target_ destinationOffset:0
+                    destinationBytesPerRow:scanout_.stride destinationBytesPerImage:scanout_.stride * frame.height];
+            }
+        }
+        [blit endEncoding];
+        [commands commit];
+        [commands waitUntilCompleted];
+        return commands.status == MTLCommandBufferStatusCompleted ? kOk : kGpuFailed;
+    }
+private:
+    bool validScanout() const {
+        const size_t page = (size_t)getpagesize();
+        return scanout_.base && !((uintptr_t)scanout_.base & (page - 1)) && scanout_.bytes && !(scanout_.bytes & (page - 1)) &&
+               scanout_.width && scanout_.height && scanout_.stride >= (size_t)scanout_.width * 4 &&
+               scanout_.stride * scanout_.height <= scanout_.bytes;
+    }
+    id<MTLDevice> device_;
+    Scanout scanout_;
+    id<MTLCommandQueue> queue_;
+    id<MTLBuffer> target_;
+};
+
+}  // namespace gpupresent
