+extern "C" {
+#endif
+#define ADRENO_VPC_MAX_OUTPUTS 16u
+#define ADRENO_VPC_MAX_INPUTS 15u
+#define ADRENO_VPC_MAX_WORDS 52u
+struct AdrenoVPCOutput {
+    const uint8_t *identity;
