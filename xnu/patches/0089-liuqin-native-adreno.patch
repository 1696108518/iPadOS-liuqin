+void nativeAdrenoMailboxPoller(void *,wait_result_t)
+{
+    thread_set_thread_name(current_thread(),"sheng-gpu-mailbox");
+    uint32_t last=0;
+    for(;;) {
+        IOSleep(1);
+        if(!gMailboxOwner || !gMailboxWords)continue;
+        const uint32_t request=gMailboxWords[1];
+        if(request==last || request==gMailboxWords[2])continue;
+        last=request;
+        const uint32_t method=gMailboxWords[3],in_size=gMailboxWords[5],out_size=gMailboxWords[6];
+        IOReturn status=kIOReturnBadArgument;
+        if(in_size<=0x700 && out_size<=0x700) {
+            uint8_t input[0x700],output[0x700];
+            memcpy(input,const_cast<uint32_t *>(gMailboxWords)+0x10,in_size);
+            IOLockLock(g.lock);
+            AGXDeviceUserClient *owner=gMailboxOwner;
+            if(owner)owner->retain();
+            IOLockUnlock(g.lock);
+            status=owner?runCore(owner,method,input,in_size,output,out_size):kIOReturnNotReady;
+            if(owner)owner->release();
+            if(!status)memcpy(const_cast<uint32_t *>(gMailboxWords)+0x200,output,out_size);
+        }
+        native_adreno_metal_diag.mb_calls=native_adreno_metal_diag.mb_calls+1;
+        gMailboxWords[4]=uint32_t(status);
+        __asm__ volatile("dmb sy" ::: "memory");
+        gMailboxWords[2]=request;
+        __asm__ volatile("dmb sy" ::: "memory");
+    }
+}
+
+/* The client log row of name (created for the first eight names); null when the table is full. Under g.lock. */
+static NativeAdrenoClientRecord *clientRecord(const char *name)
+{
+    for(auto &record:native_adreno_client_log) {
+        if(!record.name[0]) {strlcpy(record.name,name,sizeof record.name);record.slot=0xff;return &record;}
+        if(!strncmp(record.name,name,sizeof record.name))return &record;
+    }
+    return nullptr;
+}
+bool AGXDeviceUserClient::mount(bool kernel)
+{
+    proc_selfname(name_,sizeof name_);
+    NativeAdrenoUserClient *core=new NativeAdrenoUserClient;
+    if(!core)return false;
+    IOLockLock(g.lock);
+    bool ok=false;
+    /* The render server takes slot 0 (the large window) when free; every other process, or a second render-server connection, the next free one. */
+    unsigned slot=NativeAdrenoMaxClients;
+    if(kernel)slot=g.kernel_client?NativeAdrenoMaxClients:0;
+    else {
+        if(!strncmp(name_,"backboardd",sizeof name_) && !g.slots[0])slot=0;
+        for(unsigned i=1;slot==NativeAdrenoMaxClients && i<NativeAdrenoMaxClients;++i)if(!g.slots[i])slot=i;
+    }
+    const IOReturn opened=slot<NativeAdrenoMaxClients?core->open(NativeAdrenoAbiVersion,g.vm,g.submit,g.ring,g.input_bits,g.output_bits):kIOReturnNoSpace;
+    if(opened!=kIOReturnSuccess) {native_adreno_mount_fail[0]=slot<NativeAdrenoMaxClients?2:1;native_adreno_mount_fail[1]=uint32_t(opened);native_adreno_mount_fail[2]=slot;native_adreno_mount_fail[3]=native_adreno_mount_fail[3]+1;}
+    if(opened==kIOReturnSuccess) {
+        if(g.timer)core->attachTimer(g.timer);
+        if(g.info)core->attachDeviceInfo(g.info);
+        /* Queue ranges: the kernel client keeps range 0 alone (no user slot is live while the board's self-test runs); users get their slot's. */
+        const IOReturn scoped=kernel?core->setScope(0,0,0):core->setScope(slot*NativeAdrenoAbiMaxQueues,kClientWindows[slot].start,kClientWindows[slot].bytes);
+        if(scoped==kIOReturnSuccess) {
+            core_=core;core=nullptr;slot_=slot;kernel_=kernel;live_=true;ok=true;
+            if(kernel)g.kernel_client=true;else g.slots[slot]=true;
+            ++g.opened;
+            if(NativeAdrenoClientRecord *record=clientRecord(name_))record->slot=slot;
+        } else {
+            native_adreno_mount_fail[0]=3;native_adreno_mount_fail[1]=uint32_t(scoped);native_adreno_mount_fail[2]=slot;native_adreno_mount_fail[3]=native_adreno_mount_fail[3]+1;
+            core->releaseAll(&g.clock,0);
+        }
+    }
+    /* The mailbox page and its poller serve the render server's connection only. */
+    if(ok && !kernel && slot==0 && !strncmp(name_,"backboardd",sizeof name_)) {
+        if(!gMailbox) {
+            gMailbox=IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,kIODirectionInOut,4096,4096);
+            if(gMailbox) {gMailboxWords=static_cast<volatile uint32_t *>(gMailbox->getBytesNoCopy());memset(const_cast<uint32_t *>(gMailboxWords),0,4096);}
+        }
+        if(gMailboxWords) {
+            memset(const_cast<uint32_t *>(gMailboxWords),0,4096);
+            gMailboxWords[0]=NativeAdrenoMailboxMagic;
+            if(!gPollerStarted) {
+                thread_t thread=nullptr;
+                if(kernel_thread_start(nativeAdrenoMailboxPoller,nullptr,&thread)==KERN_SUCCESS) {thread_deallocate(thread);gPollerStarted=true;}
+            }
+        }
+        if(gMailboxOwner)gMailboxOwner->release();
+        retain();gMailboxOwner=this;
+    }
+    IOLockUnlock(g.lock);
+    if(core)delete core;
+    return ok;
+}
+/* Removes the cached view(s) of token (0 = all) and tears down every user mapping of them, so the BO's pages are never freed while a user
+ * PTE still points at them, whether or not the client unmapped. */
+void AGXDeviceUserClient::dropViews(uint32_t token)
+{
+    for(;;) {
+        IOMemoryDescriptor *view=nullptr;
+        IOLockLock(g.lock);
+        if(views_)for(size_t i=0;i<MaxViews;++i) {View &v=views_[i];if(v.descriptor && (!token || v.token==token)) {view=v.descriptor;v.descriptor=nullptr;v.token=0;break;}}
+        IOLockUnlock(g.lock);
+        if(!view)return;
+        /* The returned reference is the last one outside the descriptor's own list: dropping it frees the map, which unmaps the user range. */
+        while(removeMappingForDescriptor(view))native_adreno_metal_diag.forced_unmaps=native_adreno_metal_diag.forced_unmaps+1;
+        view->release();
+    }
+}
+IOReturn AGXDeviceUserClient::clientClose()
+{
+    dropViews(0);
+    IOLockLock(g.lock);
+    IOReturn status=kIOReturnSuccess;
+    AGXDeviceUserClient *mailbox=nullptr;
+    if(gMailboxOwner==this) {mailbox=gMailboxOwner;gMailboxOwner=nullptr;}
+    if(live_) {
+        const uint64_t peak=core_->windowPeak();
+        status=core_->releaseAll(&g.clock,2000000);
+        /* A failed teardown leaves the objects live and the slot taken: nothing is forced or reused. */
+        if(!status) {
+            live_=false;
+            if(kernel_)g.kernel_client=false;else if(slot_<NativeAdrenoMaxClients)g.slots[slot_]=false;
+            ++g.closed;native_adreno_metal_diag.closes=native_adreno_metal_diag.closes+1;
+            if(NativeAdrenoClientRecord *record=clientRecord(name_)) {
+                record->closes=record->closes+1;record->slot=0xff;
+                if(peak>>20>record->peak_mib)record->peak_mib=uint32_t(peak>>20);
+            }
+        }
+    }
+    IOLockUnlock(g.lock);
+    if(mailbox)mailbox->release();
+    if(!status)terminate();
+    return status;
+}
+void AGXDeviceUserClient::free()
+{
+    dropViews(0);
+    if(views_) {IODelete(views_,View,MaxViews);views_=nullptr;}
+    /* Still live only when a teardown failed: its objects stay referenced by the VM and the ring, so the core is kept, not freed. */
+    if(core_ && !live_) {delete core_;core_=nullptr;}
+    IOUserClient::free();
+}
+IOReturn AGXDeviceUserClient::clientMemoryForType(UInt32 type,IOOptionBits *options,IOMemoryDescriptor **memory)
+{
+    if(memory)*memory=nullptr;
+    if(!memory || !options)return kIOReturnBadArgument;
+    IOReturn status=kIOReturnNotFound;
+    if(type==NativeAdrenoScanoutType) {
+        if(!live_ && !handoffOnly_)return kIOReturnNotReady;
+        IOMemoryDescriptor *scanout=native_gop_handoff_memory();
+        if(!scanout)return kIOReturnNotReady;
+        *memory=scanout;                        /* already retained for the caller */
+        *options=kIOMapAnywhere|kIOMapInhibitCache;   /* firmware framebuffer: device memory, never cached by the CPU */
+        return kIOReturnSuccess;
+    }
+    if(type==NativeAdrenoMailboxType) {
+        if(live_ && gMailbox && gMailboxOwner==this) {
+            gMailbox->retain();
+            *memory=gMailbox;
+            *options=kIOMapAnywhere;   /* ordinary cached memory: both sides are CPUs, so it is coherent */
+            native_adreno_metal_diag.mb_maps=native_adreno_metal_diag.mb_maps+1;
+            return kIOReturnSuccess;
+        }
+        return kIOReturnNotReady;
+    }
+    native_adreno_view_diag[0]=native_adreno_view_diag[0]+1;
+    /* [5]: threads inside this function right now (a thread stuck here, on the gate or in a mapping, shows as a non-zero count that stays). */
+    struct Inside {Inside() {__atomic_fetch_add(&native_adreno_view_diag[5],1,__ATOMIC_RELAXED);} ~Inside() {__atomic_fetch_sub(&native_adreno_view_diag[5],1,__ATOMIC_RELAXED);}} inside;
+    IOLockLock(g.lock);
+    if(!views_)views_=IONewZero(View,MaxViews);
+    if(!views_) {IOLockUnlock(g.lock);return kIOReturnNoMemory;}
+    for(size_t i=0;i<MaxViews;++i)if(views_[i].descriptor && views_[i].token==type) {
+        views_[i].descriptor->retain();*memory=views_[i].descriptor;*options=kIOMapAnywhere|kIOMapInhibitCache;
+        native_adreno_view_diag[2]=native_adreno_view_diag[2]+1;
+        IOLockUnlock(g.lock);
+        return kIOReturnSuccess;
+    }
+    NativeAdrenoMemory *backing=live_?core_->memoryForToken(type):nullptr;
+    if(backing) {
+        /* The BO's pages are cached in the kernel and the GPU's PTEs are non-cacheable, so the client needs an uncached
+         * view. A mapping of the buffer descriptor with a different cache mode is not reliable, so describe the same raw
+         * physical spans (the ones the SMMU maps) and ask for kIOMapInhibitCache, exactly how the board code maps the
+         * ring and the GMU windows. The descriptor does not retain the pages: the client must unmap before BoCpuUnmap/BoFree. */
+        /* A BO's pages can come scattered, one span per page (a 64 MiB BO is 16384 of them): the descriptor takes them all, as many as the GPU's
+         * own table accepts. A fixed 64-entry array made every scattered BO above 256 KiB fail to map (VK_ERROR_MEMORY_MAP_FAILED, int-084),
+         * only when memory happened to be fragmented. The descriptor copies the ranges. */
+        enum {MaxSpans=65536};
+        const size_t count=backing->spanCount();
+        if(!count || count>MaxSpans)status=kIOReturnNoResources;
+        else {
+            IOAddressRange *ranges=IONewData(IOAddressRange,count);
+            if(!ranges)status=kIOReturnNoMemory;
+            else {
+                for(size_t i=0;i<count;++i)ranges[i]={backing->spans()[i].physical,backing->spans()[i].bytes};
+                IOMemoryDescriptor *descriptor=IOMemoryDescriptor::withAddressRanges(ranges,(UInt32)count,
+                    static_cast<IOOptionBits>(kIODirectionInOut)|static_cast<IOOptionBits>(kIOMemoryTypePhysical64),nullptr);
+                IODeleteData(ranges,IOAddressRange,count);
+                if(!descriptor)status=kIOReturnNoMemory;
+                else {
+                    bool cached=false;
+                    for(size_t i=0;i<MaxViews;++i)if(!views_[i].descriptor) {views_[i].token=type;views_[i].descriptor=descriptor;descriptor->retain();cached=true;break;}
+                    if(!cached) {
+                        /* Never hand out a view that cannot be torn down again. */
+                        descriptor->release();
+                        status=kIOReturnNoResources;
+                    } else {
+                        *memory=descriptor;
+                        *options=kIOMapAnywhere|kIOMapInhibitCache;
+                        native_adreno_view_diag[1]=native_adreno_view_diag[1]+1;
+                        status=kIOReturnSuccess;
+                    }
+                }
+            }
+        }
+    }
+    IOLockUnlock(g.lock);
+    if(status){native_adreno_view_diag[3]=native_adreno_view_diag[3]+1;native_adreno_view_diag[4]=(uint32_t)status;}
+    return status;
+}
+/* Fence waits as the callers see them (int-147; method 6's own statistics count every poll): [0] waits, [1] us waited in total, [2] pauses
+ * taken outside the connection lock, [3] the longest wait in us. */
+extern "C" {volatile uint64_t native_adreno_wait_outer[4];}
+static IOReturn runCore(AGXDeviceUserClient *connection,uint32_t method,const void *input,size_t input_size,void *output,size_t output_size)
+{
+    if(method==NativeAdrenoMethodSetMetadata && input && input_size==sizeof(NativeAdrenoAbiMetadata)) {
+        const NativeAdrenoAbiMetadata *meta=static_cast<const NativeAdrenoAbiMetadata *>(input);
+        /* The raw test's line and the Turnip phase's line ("T ..." result or "W ..." watchdog sample) are kept apart, so neither hides the other. */
+        const bool turnip=meta->bytes>=2 && (meta->text[0]=='T' || meta->text[0]=='W') && meta->text[1]==' ';
+        char *line=turnip?native_adreno_metal_diag.report2:native_adreno_metal_diag.report;
+        uint32_t n=meta->bytes<sizeof(native_adreno_metal_diag.report)-1?meta->bytes:uint32_t(sizeof(native_adreno_metal_diag.report)-1);
+        memset(line,0,sizeof(native_adreno_metal_diag.report));
+        memcpy(line,meta->text,n);
+        native_adreno_metal_diag.reports=native_adreno_metal_diag.reports+1;
+    }
+    /* A call that is still running when the boot page is photographed shows as inflight = its method number + 1 (0 = none), so a hang in the
+     * kernel is attributable to one ABI method. */
+    native_adreno_metal_diag.inflight=method+1;
+    native_adreno_metal_diag.inflight_since_calls=native_adreno_metal_diag.calls;
+    IOReturn status;
+    if(method==NativeAdrenoMethodWaitFence && connection->live_ && input && input_size==sizeof(NativeAdrenoAbiWaitFence) && g.clock.now_us) {
+        /* int-147: a fence wait polls under the lock but pauses outside it. int-146 slept inside the lock (up to the caller's 1 ms slice per
+         * call), so every other thread's submit, map or allocation waited for the GPU to finish unrelated work: a frame could not be queued
+         * while the previous one ran. Each poll is the core's own zero-timeout wait (same checks, retirement and statistics); the pause is the
+         * board's (until the next GPU interrupt, at most 100 us). */
+        NativeAdrenoAbiWaitFence poll{};
+        memcpy(&poll,input,sizeof(poll));
+        const uint64_t timeout_us=poll.timeout_ns/1000,began=g.clock.now_us(g.clock.cookie);
+        poll.timeout_ns=0;
+        uint64_t waited=0;
+        for(;;) {
+            /* The connection's own core while it is live; a close that ran between two polls ends the wait. */
+            IOLockLock(g.lock);
+            status=connection->live_?connection->core_->dispatch(method,&poll,sizeof(poll),output,output_size,&g.clock):kIOReturnNotReady;
+            IOLockUnlock(g.lock);
+            waited=g.clock.now_us(g.clock.cookie)-began;
+            if(status!=kIOReturnTimeout || waited>=timeout_us)break;
+            native_adreno_wait_outer[2]=native_adreno_wait_outer[2]+1;
+            if(!g.clock.idle || g.clock.idle(g.clock.cookie))break;
+        }
+        native_adreno_wait_outer[0]=native_adreno_wait_outer[0]+1;native_adreno_wait_outer[1]=native_adreno_wait_outer[1]+waited;
+        if(waited>native_adreno_wait_outer[3])native_adreno_wait_outer[3]=waited;
+    } else {
+        IOLockLock(g.lock);
+        status=connection->live_?connection->core_->dispatch(method,input,input_size,output,output_size,&g.clock):kIOReturnNotReady;
+        if(method==NativeAdrenoMethodBoMap && !status && connection->live_ && !connection->kernel_)
+            if(NativeAdrenoClientRecord *record=clientRecord(connection->name_))
+                if(connection->core_->windowPeak()>>20>record->peak_mib)record->peak_mib=uint32_t(connection->core_->windowPeak()>>20);
+        IOLockUnlock(g.lock);
+    }
+    native_adreno_metal_diag.inflight=0;
+    native_adreno_metal_diag.calls=native_adreno_metal_diag.calls+1;
+    native_adreno_metal_diag.last_selector=method;
+    native_adreno_metal_diag.last_status=uint32_t(status);
+    return status;
+}
+IOReturn AGXDeviceUserClient::run(uint32_t method,const void *input,size_t input_size,void *output,size_t output_size)
+{
+    if(method>=NativeAdrenoHandoffBase && method<=NativeAdrenoHandoffLast)
+        return native_gop_handoff_call(method-NativeAdrenoHandoffBase,current_task(),input,input_size,output,output_size);
+    if(method==NativeAdrenoExportMethod) {
+        struct Piece {uint32_t generation,total,offset,bytes;};
+        char caller[20]={};proc_selfname(caller,sizeof caller);
+        Piece piece{};
+        if(input && input_size>=sizeof(piece))memcpy(&piece,input,sizeof(piece));
+        const bool valid=!output_size && input && input_size>=sizeof(piece) && piece.bytes && piece.bytes<=NativeAdrenoExportMaxPiece &&
+            input_size==sizeof(piece)+piece.bytes && !strncmp(caller,"backboardd",sizeof caller);
+        const int stored=valid && boot_log_export_put?boot_log_export_put(piece.generation,piece.total,piece.offset,
+            static_cast<const uint8_t *>(input)+sizeof(piece),piece.bytes):-1;
+        if(stored) {native_adreno_export_stats[1]=native_adreno_export_stats[1]+1;return kIOReturnBadArgument;}
+        native_adreno_export_stats[0]=native_adreno_export_stats[0]+1;
+        native_adreno_export_stats[2]=piece.generation;native_adreno_export_stats[3]=piece.total;
+        return kIOReturnSuccess;
+    }
+    if(method==NativeAdrenoMethodBoCpuUnmap && input && input_size==sizeof(NativeAdrenoAbiBoCpuUnmap)) {
+        /* The view is shared by every CPU mapping of the BO, and dropViews removes all of them. A BO mapped twice (the view cache served 207
+         * second requests in int-177) lost both mappings at the first unmap, and the other holder's next store hit an unmapped page: the
+         * render server's crash in the command stream writes of vkCmdCopyBuffer. Only the last lease takes the view down; the earlier
+         * ones leave their mapping until it, or the client unmaps it itself (IOConnectUnmapMemory64 works on the cached view). */
+        const uint32_t token=static_cast<const NativeAdrenoAbiBoCpuUnmap *>(input)->token;
+        IOLockLock(g.lock);
+        const uint32_t leases=live_?core_->mappingLeases(token):0;
+        IOLockUnlock(g.lock);
+        if(leases>1)native_adreno_view_kept=native_adreno_view_kept+1;
+        else dropViews(token);
+    }
+    if(method==NativeAdrenoMethodBoImport) {
+        /* The pages belong to the task making this call (an external method runs in the caller's context). */
+        if(!input || input_size!=sizeof(NativeAdrenoAbiBoImport) || !output || output_size!=sizeof(NativeAdrenoAbiBoAllocReply))
+            return kIOReturnBadArgument;
+        NativeAdrenoAbiBoImport request{};
+        memcpy(&request,input,sizeof(request));
+        NativeAdrenoAbiBoAllocReply reply{};
+        native_adreno_metal_diag.inflight=method+1;
+        IOLockLock(g.lock);
+        const IOReturn status=live_?core_->importBo(&request,current_task(),&reply):kIOReturnNotReady;
+        IOLockUnlock(g.lock);
+        native_adreno_metal_diag.inflight=0;
+        native_adreno_metal_diag.calls=native_adreno_metal_diag.calls+1;
+        native_adreno_metal_diag.last_selector=method;
+        native_adreno_metal_diag.last_status=uint32_t(status);
+        if(!status)memcpy(output,&reply,sizeof(reply));
+        return status;
+    }
+    return runCore(this,method,input,input_size,output,output_size);
+}
+IOReturn AGXDeviceUserClient::action(OSObject *target,void *,IOExternalMethodArguments *arguments)
+{
+    AGXDeviceUserClient *connection=OSDynamicCast(AGXDeviceUserClient,target);
+    if(!connection || !arguments)return kIOReturnBadArgument;
+    return connection->run(arguments->selector,arguments->structureInput,arguments->structureInputSize,
+        arguments->structureOutput,arguments->structureOutputSize);
+}
+IOReturn AGXDeviceUserClient::externalMethod(uint32_t selector,IOExternalMethodArguments *arguments,
+    IOExternalMethodDispatch *,OSObject *target,void *reference)
+{
+    /* One entry per ABI method; sizes are the exact wire records. */
+    static const IOExternalMethodDispatch table[]={
+        {&action,0,0,0,sizeof(NativeAdrenoAbiParams)},
+        {&action,0,sizeof(NativeAdrenoAbiBoAlloc),0,sizeof(NativeAdrenoAbiBoAllocReply)},
+        {&action,0,sizeof(NativeAdrenoAbiBoMap),0,sizeof(NativeAdrenoAbiBoMapReply)},
+        {&action,0,sizeof(NativeAdrenoAbiBoFree),0,0},
+        {&action,0,sizeof(NativeAdrenoAbiSubmit),0,sizeof(NativeAdrenoAbiSubmitReply)},
+        {&action,0,sizeof(NativeAdrenoAbiWaitFence),0,0},
+        {&action,0,0,0,sizeof(NativeAdrenoAbiTimestamp)},
+        {&action,0,0,0,sizeof(NativeAdrenoAbiStatus)},
+        {&action,0,sizeof(NativeAdrenoAbiMetadata),0,0},
+        {&action,0,sizeof(NativeAdrenoAbiMetadata),0,sizeof(NativeAdrenoAbiMetadata)},
+        {&action,0,sizeof(NativeAdrenoAbiQueue),0,sizeof(NativeAdrenoAbiQueueReply)},
+        {&action,0,sizeof(NativeAdrenoAbiQueue),0,0},
+        {&action,0,sizeof(NativeAdrenoAbiBoCpuMap),0,sizeof(NativeAdrenoAbiBoCpuMapReply)},
+        {&action,0,sizeof(NativeAdrenoAbiBoCpuUnmap),0,0},
+        {&action,0,0,0,sizeof(NativeAdrenoAbiDeviceInfo)},
+        {&action,0,sizeof(NativeAdrenoAbiBoImport),0,sizeof(NativeAdrenoAbiBoAllocReply)}};
+    native_adreno_metal_diag.ext_entries=native_adreno_metal_diag.ext_entries+1;
+    if(selector<256)native_adreno_metal_diag.sel_bits[selector>>5]|=1u<<(selector&31);
+    /* Tunnel. The sandbox resolves a filter policy for this class at open time and then admits only the selectors its profile lists,
+     * so which selector numbers reach this object is decided outside the driver. A tunnel call carries the real ABI method in its
+     * first eight bytes and may use ANY admitted selector: {magic, method, payload...} in, the method's exact output out. Method
+     * 0xffffffff is a probe that only proves the selector was admitted. */
+    if(arguments && arguments->structureInput && arguments->structureInputSize>=8 &&
+        static_cast<const uint32_t *>(arguments->structureInput)[0]==NativeAdrenoTunnelMagic) {
+        const uint32_t *header=static_cast<const uint32_t *>(arguments->structureInput);
+        if(header[1]==0xffffffffu) {
+            native_adreno_metal_diag.probes=native_adreno_metal_diag.probes+1;
+            return kIOReturnSuccess;
+        }
+        native_adreno_metal_diag.tunnel_calls=native_adreno_metal_diag.tunnel_calls+1;
+        const IOReturn tunneled=run(header[1],reinterpret_cast<const uint8_t *>(arguments->structureInput)+8,
+            arguments->structureInputSize-8,arguments->structureOutput,arguments->structureOutputSize);
+        native_adreno_metal_diag.ext_status=uint32_t(tunneled);
+        return tunneled;
+    }
+    native_adreno_metal_diag.ext_selector=selector;
+    native_adreno_metal_diag.ext_in=arguments?arguments->structureInputSize:0xffff;
+    native_adreno_metal_diag.ext_out=arguments?arguments->structureOutputSize:0xffff;
+    if(selector<1 || selector>sizeof(table)/sizeof(table[0])) {
+        native_adreno_metal_diag.ext_status=uint32_t(kIOReturnUnsupported);
+        return kIOReturnUnsupported;
+    }
+    const IOReturn result=IOUserClient::externalMethod(selector,arguments,const_cast<IOExternalMethodDispatch *>(&table[selector-1]),
+        target?target:this,reference);
+    native_adreno_metal_diag.ext_status=uint32_t(result);
+    return result;
+}
+/* limit > 0 caps the connections ever granted: a plugin that crashes its host process on every launch (the process respawns and
+ * loads it again) must not be able to keep a system process in a crash loop, so after the cap further opens are refused. */
+extern "C" IOReturn native_adreno_new_user_client(IOService *provider,task_t owningTask,void *securityID,UInt32 type,
+    OSDictionary *properties,IOUserClient **handler,unsigned limit)
+{
+    if(handler)*handler=nullptr;
+    if(!handler || !g.published)return kIOReturnNotReady;
+    /* Progress markers: open types 0x4147xxxx (xxxx nonzero) are not connections. The plugin sends one before and after each step so
+     * that a sandbox that admits neither selectors nor mapping, or a crash, still leaves a trace of how far it got. */
+    if((type>>16)==NativeAdrenoPluginOpenType && (type&0xffff)) {
+        const uint32_t value=type&0xffff,slot=native_adreno_metal_diag.marks_total&15;
+        /* Text stream into report2, one character per marker: 0x7fff starts a line, 0x70cc appends character cc. It needs no connection,
+         * so the plugin's Turnip watchdog can report while Turnip itself holds its connection slot. Not counted as markers. */
+        if(value>=0x8000) {
+            static unsigned row=48,length;
+            if(value>=0xC000) {
+                row=value&0x3f;length=0;
+                if(row<48)memset(native_adreno_metal_rows[row],0,sizeof(native_adreno_metal_rows[row]));
+                native_adreno_metal_rows_seq=native_adreno_metal_rows_seq+1;
+            } else if(row<48) {
+                const char pair[2]={char((value>>7)&0x7f),char(value&0x7f)};
+                for(unsigned i=0;i<2;++i)if(pair[i] && length<sizeof(native_adreno_metal_rows[row])-1)native_adreno_metal_rows[row][length++]=pair[i];
+            }
+            return kIOReturnUnsupported;
+        }
+        if(value>=0x7000 && value<0x8000) {
+            /* 0x7ffe starts a line in report (GPU7) instead: the Metal bridge's result, after the raw test's line has been read. */
+            static uint32_t length;
+            static char *line=native_adreno_metal_diag.report2;
+            static_assert(sizeof(native_adreno_metal_diag.report)==sizeof(native_adreno_metal_diag.report2),"stream lines");
+            if(value==0x7fff || value==0x7ffe) {
+                line=value==0x7fff?native_adreno_metal_diag.report2:native_adreno_metal_diag.report;
+                /* A line from a process other than the render server goes to that process's own row (native_adreno_client_text): the render server
+                 * rewrites report2 every ten seconds, so the reason another process's device failed would be gone from it. */
+                char who[20]={};
+                proc_selfname(who,sizeof who);
+                if(value==0x7fff && strncmp(who,"backboardd",sizeof who)) {
+                    for(auto &entry:native_adreno_client_text) {
+                        if(!entry.name[0]) strlcpy(entry.name,who,sizeof entry.name);
+                        if(!strncmp(entry.name,who,sizeof entry.name)) {line=entry.text;break;}
+                    }
+                }
+                memset(line,0,sizeof(native_adreno_metal_diag.report2));length=0;
+            }
+            else if(value<0x7100 && length<sizeof(native_adreno_metal_diag.report2)-1) {line[length++]=char(value&0xff);line[length]=0;}
+            return kIOReturnUnsupported;
+        }
+        native_adreno_metal_diag.marks[slot]=value;
+        native_adreno_metal_diag.marks_total=native_adreno_metal_diag.marks_total+1;
+        if(value==1) {
+            memcpy(native_adreno_metal_diag.starter[2],native_adreno_metal_diag.starter[1],17);
+            memcpy(native_adreno_metal_diag.starter[1],native_adreno_metal_diag.starter[0],17);
+            proc_selfname(native_adreno_metal_diag.starter[0],17);
+        }
+        return kIOReturnUnsupported;
+    }
+    shiftName(native_adreno_metal_diag.opener);
+    AGXDeviceUserClient *connection=new AGXDeviceUserClient;
+    if(!connection)return kIOReturnNoMemory;
+    if(!connection->initWithTask(owningTask,securityID,type,properties)) {
+        connection->release();
+        native_adreno_metal_diag.bad=native_adreno_metal_diag.bad+1;
+        return kIOReturnNoResources;
+    }
+    /* IOService::newUserClient attaches and starts what it creates (a client without a provider chain is also a reason for the sandbox to
+     * refuse). Then the two sandbox gates IOServiceOpen would apply afterwards are run here for every opener and logged with the
+     * process name and open type, so the boot page shows which processes the sandbox lets reach this class and with which type. */
+    unsigned attach_state=0;
+    if(provider) {
+        const bool attached=connection->attach(provider);
+        attach_state=attached?1:2;
+        if(attached && !connection->start(provider)) {
+            connection->detach(provider);
+            attach_state=3;
+        }
+    }
+    native_adreno_metal_diag.attach_status=attach_state;
+    const uint32_t macf=uint32_t(mac_iokit_check_open(kauth_cred_get(),connection,type));
+    uint32_t resolver=0xfeedfeed;
+    if(gIOUCFilterCallbacks && gIOUCFilterCallbacks->io_filter_resolver) {
+        io_filter_policy_t policy=0;
+        const IOReturn resolved=gIOUCFilterCallbacks->io_filter_resolver(owningTask,connection,type,&policy);
+        resolver=uint32_t(resolved);
+        if(resolved==kIOReturnSuccess && policy && gIOUCFilterCallbacks->io_filter_release)gIOUCFilterCallbacks->io_filter_release(policy);
+    }
+    native_adreno_metal_diag.chk_type=type;
+    native_adreno_metal_diag.chk_macf=macf;
+    native_adreno_metal_diag.chk_res=resolver;
+    {
+        NativeAdrenoOpenRecord &record=native_adreno_open_log[native_adreno_open_log_count&7];
+        proc_selfname(record.name,sizeof(record.name));
+        record.type=type;record.macf=macf;record.res=resolver;record.attach=attach_state;record.foreign=type!=NativeAdrenoPluginOpenType;
+        native_adreno_open_log_count=native_adreno_open_log_count+1;
+    }
+    if(type==NativeAdrenoHandoffOpenType) {
+        connection->setHandoffOnly();
+        *handler=connection;
+        return kIOReturnSuccess;
+    }
+    /* Only the Adreno plugin's open (type NativeAdrenoPluginOpenType) is served. The original IOGPU library opens the accelerator with type 1
+     * (and an API value in the upper bits) for an IOGPUDeviceUserClient, which this driver is not; refuse it cleanly. */
+    if(type!=NativeAdrenoPluginOpenType) {
+        connection->release();
+        native_adreno_metal_diag.foreign_opens=native_adreno_metal_diag.foreign_opens+1;
+        native_adreno_metal_diag.foreign_type=type;
+        return kIOReturnUnsupported;
+    }
+    /* Every process that runs the Adreno plugin opens with its type: on Apple hardware every Metal process opens the AGX user client, and the
+     * original profiles here name no class of this driver for the render server (MACF 1 for the plugin's types at every boot since int-038).
+     * The plugin's two open types are granted here, by this driver: the grant is a property of the client object that the kernel's open path
+     * (patches/xnu/native-adreno-sandbox-grant.patch) honours in place of the sandbox verdict. The verdict is still taken above and logged.
+     * Which processes run the plugin at all is the plugin's allow-list (NativeAdrenoMetal.clients). */
+    const bool kernel=owningTask==kernel_task;
+    char opener[20]={};
+    proc_selfname(opener,sizeof opener);
+    if(!kernel && (macf || resolver!=uint32_t(kIOReturnSuccess))) {
+        connection->setProperty("NativeSandboxGrant",kOSBooleanTrue);
+        native_adreno_metal_diag.grants=native_adreno_metal_diag.grants+1;
+    }
+    /* limit caps the connections granted to each process name, so one process that crashes on every launch cannot loop forever, and cannot use
+     * up the others' opens; a process other than the render server gets at most eight per boot. */
+    const unsigned cap=strncmp(opener,"backboardd",sizeof opener)?(limit && limit<8?limit:8):limit;
+    IOLockLock(g.lock);
+    NativeAdrenoClientRecord *record=kernel?nullptr:clientRecord(opener);
+    const bool capped=cap && record && record->opens>=cap;
+    IOLockUnlock(g.lock);
+    IOReturn refusal=kIOReturnSuccess;
+    if(capped)refusal=kIOReturnBusy;
+    else if(!connection->mount(kernel))refusal=kIOReturnBusy;   /* every slot taken */
+    if(refusal) {
+        connection->release();
+        native_adreno_metal_diag.busy=native_adreno_metal_diag.busy+1;
+        IOLockLock(g.lock);
+        if(record) {record->refused=record->refused+1;record->last_refusal=uint32_t(refusal);}
+        IOLockUnlock(g.lock);
+        return refusal;
+    }
+    IOLockLock(g.lock);
+    if(record)record->opens=record->opens+1;
+    IOLockUnlock(g.lock);
+    native_adreno_metal_diag.opens=native_adreno_metal_diag.opens+1;
+    *handler=connection;
+    return kIOReturnSuccess;
+}
+extern "C" void native_adreno_note_property_read(const char *key)
+{
+    if(key && !strcmp(key,"MetalPluginName")) {
+        proc_selfname(native_adreno_metal_diag.name_reader,17);
+        native_adreno_metal_diag.name_reads=native_adreno_metal_diag.name_reads+1;
+        char name[20]={};
+        proc_selfname(name,sizeof name);
+        /* Unlocked: the discovery runs at process start, a lost count is harmless and a row is claimed by its first byte. */
+        for(auto &asker:native_adreno_metal_askers) {
+            if(!asker.name[0]) {strlcpy(asker.name,name,sizeof asker.name);asker.reads=1;break;}
+            if(!strncmp(asker.name,name,sizeof asker.name)) {asker.reads=asker.reads+1;break;}
+        }
+    }
+    shiftName(native_adreno_metal_diag.reader);
+    native_adreno_metal_diag.property_reads=native_adreno_metal_diag.property_reads+1;
+}
+IOReturn NativeAdrenoGpuPublished::newUserClient(task_t owningTask,void *securityID,UInt32 type,
+    OSDictionary *properties,IOUserClient **handler)
+{
+    return native_adreno_new_user_client(this,owningTask,securityID,type,properties,handler,0);
+}
+
+/* Publishes the service once. Everything passed in must outlive the system (the board probe keeps them in statics) and
+ * the VM, submit object and ring must already be attached to the live GPU context. The core must not be open. */
+extern "C" IOReturn native_adreno_publish(NativeAdrenoVm *vm,NativeAdrenoSubmit *submit,NativeAdrenoRing *ring,
+    const NativeAdrenoRingClock *clock,const NativeAdrenoTimer *timer,const NativeAdrenoAbiDeviceInfo *info,
+    uint32_t input_bits,uint32_t output_bits)
+{
+    if(g.published || !vm || !submit || !ring || !clock || !clock->now_us)return kIOReturnBadArgument;
+    g.lock=IOLockAlloc();
+    NativeAdrenoGpuPublished *service=new NativeAdrenoGpuPublished;
+    if(!g.lock || !service || !service->init() || !service->attach(IOService::getPlatform())) {
+        if(service)service->release();
+        return kIOReturnNoMemory;
+    }
+    g.vm=vm;g.submit=submit;g.ring=ring;g.clock=*clock;g.timer=timer;g.info=info;g.input_bits=input_bits;g.output_bits=output_bits;
+    g.service=service;g.published=true;
+    service->setName("NativeAdrenoGpu");
+    service->registerService();
+    return kIOReturnSuccess;
+}
+extern "C" uint32_t native_adreno_publish_stats(uint32_t *closed)
+{
+    if(closed)*closed=g.closed;
+    return g.opened;
+}
+extern "C" IOService *native_adreno_published_service()
+{
+    return g.service;
+}
diff --git a/iokit/NativeAdreno/NativeAdrenoPwrup.cpp b/iokit/NativeAdreno/NativeAdrenoPwrup.cpp
new file mode 100644
index 0000000..d604c14
--- /dev/null
+++ b/iokit/NativeAdreno/NativeAdrenoPwrup.cpp
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoPwrup.h"
+#include <IOKit/IOLib.h>
+#include <string.h>
+#include "NativeAdrenoPwrupRegs.h"
+enum : size_t { HeaderBytes=16, PairBytes=8, TripletBytes=12 };
+size_t NativeAdrenoPwrupList::requiredBytes(const NativeAdrenoPwrupCounts &counts)
+{
+    return HeaderBytes+size_t(counts.ifpc+counts.preemption)*PairBytes+
+        size_t(counts.dynamic)*TripletBytes;
+}
+IOReturn NativeAdrenoPwrupList::buildA740(int (*read)(void *,uint32_t,uint32_t *),
+    void *cookie,uint8_t *out,size_t capacity,size_t *written)
+{
+    if(!read || !out || !written)return kIOReturnBadArgument;
+    uint32_t values[NATIVE_ADRENO_A740_PWRUP_COUNT]={};
+    for(size_t index=0;index<NATIVE_ADRENO_A740_PWRUP_COUNT;++index)
+        if(read(cookie,NativeAdrenoA740PwrupRegs[index],&values[index]))
+            return kIOReturnIOError;
+    const NativeAdrenoPwrupCounts counts={0,NATIVE_ADRENO_A740_PWRUP_COUNT,0};
+    return pack(counts,nullptr,nullptr,NativeAdrenoA740PwrupRegs,values,nullptr,
+        out,capacity,written);
+}
+IOReturn NativeAdrenoPwrupList::pack(const NativeAdrenoPwrupCounts &counts,
+    const uint32_t *ifpc_regs,const uint32_t *ifpc_values,
+    const uint32_t *preemption_regs,const uint32_t *preemption_values,
+    const uint32_t *dynamic_triplets,uint8_t *out,size_t capacity,size_t *written)
+{
+    if(!out || !written)return kIOReturnBadArgument;
+    *written=0;
+    if(counts.ifpc>0xff || counts.preemption>0xff || counts.dynamic>0xffff)
+        return kIOReturnBadArgument;
+    const size_t needed=requiredBytes(counts);
+    if(capacity<needed)return kIOReturnNoResources;
+    if((counts.ifpc && (!ifpc_regs || !ifpc_values)) ||
+        (counts.preemption && (!preemption_regs || !preemption_values)) ||
+        (counts.dynamic && !dynamic_triplets))return kIOReturnBadArgument;
+    memset(out,0,needed);
+    /* gpu_req/cpu_req/turn stay zero; unions carry the list lengths. */
+    out[12]=static_cast<uint8_t>(counts.ifpc);
+    out[13]=static_cast<uint8_t>(counts.preemption);
+    out[14]=static_cast<uint8_t>(counts.dynamic&0xff);
+    out[15]=static_cast<uint8_t>((counts.dynamic>>8)&0xff);
+    uint32_t *cursor=reinterpret_cast<uint32_t *>(out+HeaderBytes);
+    for(uint32_t i=0;i<counts.ifpc;++i) {
+        *cursor++=ifpc_regs[i];*cursor++=ifpc_values[i];
+    }
+    for(uint32_t i=0;i<counts.preemption;++i) {
+        *cursor++=preemption_regs[i];*cursor++=preemption_values[i];
+    }
+    for(uint32_t i=0;i<counts.dynamic;++i) {
+        *cursor++=dynamic_triplets[i*3];
+        *cursor++=dynamic_triplets[i*3+1];
+        *cursor++=dynamic_triplets[i*3+2];
+    }
+    *written=needed;
+    return kIOReturnSuccess;
+}
diff --git a/iokit/NativeAdreno/NativeAdrenoPwrup.h b/iokit/NativeAdreno/NativeAdrenoPwrup.h
new file mode 100644
index 0000000..fa95865
--- /dev/null
+++ b/iokit/NativeAdreno/NativeAdrenoPwrup.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_PWRUP_H
+#define NATIVE_ADRENO_PWRUP_H
+#include <IOKit/IOTypes.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* Pack the A7xx power-up register list consumed by CP_ME_INIT. The layout is
+ * the pinned `struct cpu_gpu_lock`: three u32 lock words, a union of either
+ * {u8 ifpc_len, u8 preemption_len, u16 dynamic_len} (A7xx) or two u16 fields
+ * (A6xx), then 64-bit register slots holding {reg, current value} pairs and
+ * 12-byte dynamic triplets {aperture, offset, value}. Only the A7xx form is
+ * packed here. Values must come from actual register reads at bring-up; this
+ * function never invents one, never reads MMIO and never clears the lock words
+ * silently. Capacity and count limits are checked before any write. */
+struct NativeAdrenoPwrupCounts {
+    uint32_t ifpc;
+    uint32_t preemption;
+    uint32_t dynamic;
+};
+class NativeAdrenoPwrupList final {
+    NativeAdrenoPwrupList()=delete;
+public:
+    static size_t requiredBytes(const NativeAdrenoPwrupCounts &);
+    /* regs/values are parallel arrays; dynamic triplets are {aperture,offset,
+     * value} in that order. Output is the exact byte image; *written receives
+     * the length on success. */
+    /* Read the sixteen A740 preemption registers through the callback (raw
+     * 32-bit GPU register reads) and pack them with zero IFPC and dynamic
+     * counts. A read failure refuses and writes nothing. */
+    static IOReturn buildA740(int (*read)(void *,uint32_t,uint32_t *),void *cookie,
+        uint8_t *out,size_t capacity,size_t *written);
+    static IOReturn pack(const NativeAdrenoPwrupCounts &,
+        const uint32_t *ifpc_regs,const uint32_t *ifpc_values,
+        const uint32_t *preemption_regs,const uint32_t *preemption_values,
+        const uint32_t *dynamic_triplets,uint8_t *out,size_t capacity,size_t *written);
+};
+#endif
diff --git a/iokit/NativeAdreno/NativeAdrenoPwrupRegs.h b/iokit/NativeAdreno/NativeAdrenoPwrupRegs.h
new file mode 100644
index 0000000..570f464
--- /dev/null
+++ b/iokit/NativeAdreno/NativeAdrenoPwrupRegs.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_PWRUP_REGS_H
+#define NATIVE_ADRENO_PWRUP_REGS_H
+#include <stdint.h>
+/* Generated by scripts/derive-a740-pwrup.py from the pinned
+ * a6xx_catalog.c list and the pinned XMLs, selecting only entries whose
+ * variants include A7XX. Do not edit by hand. */
+static const uint32_t NativeAdrenoA740PwrupRegs[]={
+    0x00000e09,
+    0x00000e0a,
+    0x00000e07,
+    0x00000e08,
+    0x00000e0b,
+    0x00000e0c,
+    0x00000e0d,
+    0x00000e0e,
+    0x00000e17,
+    0x00000e01,
+    0x00008e08,
+    0x00008e28,
+    0x00008e50,
+    0x00000e3a,
+    0x00000e19,
+    0x0000b602,
+};
+#define NATIVE_ADRENO_A740_PWRUP_COUNT \
+    (sizeof(NativeAdrenoA740PwrupRegs)/sizeof(NativeAdrenoA740PwrupRegs[0]))
+#endif
diff --git a/iokit/NativeAdreno/NativeAdrenoRing.cpp b/iokit/NativeAdreno/NativeAdrenoRing.cpp
new file mode 100644
index 0000000..1711ea1
--- /dev/null
+++ b/iokit/NativeAdreno/NativeAdrenoRing.cpp
@@ -0,0 +1,285 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoRing.h"
+#include "AdrenoPM4.h"
+#include <IOKit/IOLib.h>
+
+/* Values are taken from the pinned Linux source, not guessed:
+ * drivers/gpu/drm/msm/registers/adreno/a6xx.xml (register offsets), and
+ * registers/adreno/adreno_pm4.xml (opcode 0x46 CP_EVENT_WRITE7, event 0x31
+ * CACHE_CLEAN, WRITE_SRC bits 20..22, WRITE_DST bit 24, WRITE_ENABLED bit 27,
+ * IRQ bit 31). CP_RB_CNTL BUFSZ bits 0..5 and BLKSZ bits 8..13 are the same
+ * fields MSM_GPU_RB_CNTL_DEFAULT programs. All are dword register indices. */
+enum : uint32_t {
+    RingBase = 0x0800,        /* 64-bit CP_RB_BASE */
+    RingControl = 0x0802,     /* CP_RB_CNTL */
+    RingRptrAddress = 0x0804, /* 64-bit CP_RB_RPTR_ADDR */
+    RingRptr = 0x0806,
+    RingWptr = 0x0807,
+    RingScratch = 0x0885,     /* CP_SCRATCH(2) for A6XX..A7XX */
+    RingFenceOpcode = 0x46,   /* CP_EVENT_WRITE7 on A7XX */
+    RingFenceEvent = 0x31,    /* CACHE_CLEAN */
+    RingFenceEnable = 1u << 27,
+    RingFenceIrq = 1u << 31,
+    RingBlockBytes = 32,
+    /* A7XX framing, as a7xx_submit() in the pinned a6xx_gpu.c emits it: CP_THREAD_CONTROL (0x17; THREAD bits 0..1,
+     * BR 1, BV 2, BOTH 3; SYNC_THREADS bit 31), CP_SET_MARKER (0x65; 0x101 IFPC disable, 0x100 enable), CCU_INVALIDATE_DEPTH
+     * 0x18 / CCU_INVALIDATE_COLOR 0x19 and CP_WAIT_TIMESTAMP (0x14) from adreno_pm4.xml. User command streams synchronize
+     * the BR and BV threads themselves (Turnip waits on BV timestamps), so the IBs must run with both threads enabled. */
+    RingThreadControl = 0x17,
+    RingThreadBr = 1,
+    RingThreadBv = 2,
+    RingThreadBoth = 3,
+    RingSyncThreads = 1u << 31,
+    RingSetMarker = 0x65,
+    RingWaitTimestamp = 0x14,
+    RingCcuInvalidateDepth = 0x18,
+    RingCcuInvalidateColor = 0x19,
+    /* What the SQE's CP_SMMU_TABLE_UPDATE handler does before it switches tables (a740_sqe.fw, qrisc-disasm): CACHE_FLUSH7 (0x32)
+     * and CACHE_INVALIDATE7 (0x33) with a wait for idle (CP_WAIT_FOR_IDLE 0x26). Linux gets these from that packet on every context
+     * switch; this ring never sends it, and event 0x31 is only CACHE_CLEAN on A7XX, so nothing else ever invalidated UCHE. */
+    RingCacheFlush7 = 0x32,
+    RingCacheInvalidate7 = 0x33,
+    RingWaitForIdle = 0x26,
+    RingPrologueWords = 11,
+    /* a6xx_set_pagetable()'s A7XX context entry: CP_RESET_CONTEXT_STATE (0x1f; CLEAR_ON_CHIP_TS, CLEAR_RESOURCE_TABLE,
+     * CLEAR_BV_BR_COUNTER, RESET_GLOBAL_LOCAL_TS = bits 0..3) between thread syncs, LRZ_FLUSH_INVALIDATE (0x26), the
+     * RBBM_PERFCTR_SRAM_INIT_CMD (0x050e) write and CACHE_INVALIDATE (0x31), after a CP_WAIT_TIMESTAMP on the last fence, then the
+     * CP_WAIT_REG_MEM (0x3c, WRITE_EQ) on RBBM_PERFCTR_SRAM_INIT_STATUS (0x050f) bit 0 that Linux always emits after the SRAM init
+     * write. Without that wait the client's first IB started while the SRAM was still clearing; on sheng (int-064..067) the CP then
+     * stopped on the IB's first CP_THREAD_CONTROL, while the same IB retired under the Linux driver. */
+    RingResetContextState = 0x1f,
+    RingResetAll = 0xf,
+    RingLrzFlushInvalidate = 0x26,
+    RingCacheInvalidate = 0x31,
+    RingPerfctrSramInit = 0x050e,
+    RingPerfctrSramInitStatus = 0x050f,
+    RingWaitRegMem = 0x3c,
+    RingWaitWriteEq = 3,
+    RingResetWords = 26,
+    RingFenceWords = 7,       /* kernel bring-up submissions: TYPE4 scratch + TYPE7 event */
+    RingFramedFenceWords = 31,/* user submissions: scratch, BV timestamp, BR wait, ring timestamp */
+    RingBvFenceOffset = 12    /* msm_rbmemptrs.bv_fence; +8 is bv_rptr, the BV RPTR shadow hw init programs */
+};
+static uint32_t ilog2(size_t value)
+{
+    uint32_t result=0;while(value>1) {value>>=1;++result;}return result;
+}
+/* The last submissions as the CP will read them: [slot] fence, start index, end index, word count, then up to 112 ring words from the start. The board log
+ * prints them, so a fence the GPU never wrote can be compared with the packets that should have written it. */
+extern "C" {volatile uint32_t native_adreno_ring_log[4][4+112];volatile uint32_t native_adreno_ring_log_count;}
+IOReturn NativeAdrenoRing::poison()
+{
+    poisoned_=true;return kIOReturnIOError;
+}
+IOReturn NativeAdrenoRing::readRptr(uint32_t *value)
+{
+    uint32_t rptr=0;
+    if(io_.read32(io_.cookie,RingRptr,&rptr))return poison();
+    if(rptr>=ring_bytes_/4)return poison(); /* unusable read pointer */
+    *value=rptr;rptr_shadow_=rptr;return kIOReturnSuccess;
+}
+/* Packs one TYPE7 packet into words; returns the next free index or 0 when the header cannot be built. */
+static size_t packet(uint32_t *words,size_t at,uint32_t opcode,const uint32_t *payload,uint32_t count)
+{
+    if(AdrenoPM4Type7(opcode,count,&words[at])!=AdrenoPM4Success)return 0;
+    for(uint32_t i=0;i<count;++i)words[at+1+i]=payload[i];
+    return at+1+count;
+}
+/* Thread selection and IFPC disable before the user buffers, as a7xx_submit() does; the first submission after
+ * requestContextReset() also carries the context entry a6xx_set_pagetable() emits when a new context first submits.
+ * Every prologue ends its BR-only part with the GPU cache flush and invalidate described at RingCacheFlush7. */
+IOReturn NativeAdrenoRing::emitPrologue(uint32_t at,bool reset,uint32_t *end)
+{
+    const uint32_t mask=(uint32_t)(ring_bytes_/4-1);
+    uint32_t words[RingPrologueWords+RingResetWords]={0};
+    const uint32_t br=RingSyncThreads|RingThreadBr,syncBoth=RingSyncThreads|RingThreadBoth,both=RingThreadBoth,marker=0x101;
+    const uint32_t count=RingPrologueWords+(reset?RingResetWords:0);
+    size_t n=packet(words,0,RingThreadControl,&br,1);
+    if(reset) {
+        const uint64_t at4=fence_iova_+4;
+        const uint32_t wait[4]={0,(uint32_t)at4,(uint32_t)(at4>>32),seqno_},all=RingResetAll,lrz=RingLrzFlushInvalidate,
+            invalidate=RingCacheInvalidate;
+        if(n)n=packet(words,n,RingWaitTimestamp,wait,4);
+        if(n)n=packet(words,n,RingThreadControl,&syncBoth,1);
+        if(n)n=packet(words,n,RingResetContextState,&all,1);
+        if(n)n=packet(words,n,RingThreadControl,&syncBoth,1);
+        if(n)n=packet(words,n,RingFenceOpcode,&lrz,1);
+        if(n)n=packet(words,n,RingThreadControl,&br,1);
+        if(n && AdrenoPM4Type4(RingPerfctrSramInit,1,&words[n])==AdrenoPM4Success) {words[n+1]=1;n+=2;} else n=0;
+        if(n)n=packet(words,n,RingFenceOpcode,&invalidate,1);
+        const uint32_t sram[6]={RingWaitWriteEq,RingPerfctrSramInitStatus,0,1,1,0};
+        if(n)n=packet(words,n,RingWaitRegMem,sram,6);
+    }
+    const uint32_t flush=RingCacheFlush7,invalidate7=RingCacheInvalidate7;
+    if(n)n=packet(words,n,RingFenceOpcode,&flush,1);
+    if(n)n=packet(words,n,RingFenceOpcode,&invalidate7,1);
+    if(n)n=packet(words,n,RingWaitForIdle,nullptr,0);
+    if(n)n=packet(words,n,RingThreadControl,&both,1);
+    if(n)n=packet(words,n,RingSetMarker,&marker,1);
+    if(n!=count)return poison();
+    for(uint32_t i=0;i<count;++i)ring_[(at+i)&mask]=words[i];
+    *end=(at+count)&mask;return kIOReturnSuccess;
+}
+/* Writes the timestamp fence that makes a submission observable. */
+IOReturn NativeAdrenoRing::emitFence(uint32_t at,uint32_t seqno,uint32_t *end)
+{
+    const uint32_t mask=(uint32_t)(ring_bytes_/4-1);
+    uint32_t words[RingFenceWords]={0};
+    if(AdrenoPM4Type4(RingScratch,1,&words[0])!=AdrenoPM4Success ||
+        AdrenoPM4Type7(RingFenceOpcode,4,&words[2])!=AdrenoPM4Success)return poison();
+    words[1]=seqno;
+    words[3]=RingFenceEvent|RingFenceEnable|RingFenceIrq;
+    /* The timestamp goes to +4 (msm_rbmemptrs.fence), where wait() reads it; +0 is the CP's RPTR shadow. */
+    const uint64_t at4=fence_iova_+4;
+    words[4]=(uint32_t)at4;words[5]=(uint32_t)(at4>>32);words[6]=seqno;
+    for(uint32_t i=0;i<RingFenceWords;++i)ring_[(at+i)&mask]=words[i];
+    *end=(at+RingFenceWords)&mask;return kIOReturnSuccess;
+}
+/* The fence of a framed submission: CP_SCRATCH(2), the BV thread's timestamp, a BR wait for it (so BR cannot report the
+ * submission while BV still works on it), then the ring timestamp with an interrupt, both threads and IFPC back on. */
+IOReturn NativeAdrenoRing::emitFramedFence(uint32_t at,uint32_t seqno,uint32_t *end)
+{
+    const uint32_t mask=(uint32_t)(ring_bytes_/4-1);
+    uint32_t words[RingFramedFenceWords]={0};
+    if(AdrenoPM4Type4(RingScratch,1,&words[0])!=AdrenoPM4Success)return poison();
+    words[1]=seqno;
+    /* The timestamp goes to +4 (msm_rbmemptrs.fence), where wait() reads it; +0 is the CP's RPTR shadow. */
+    const uint64_t at4=fence_iova_+4,bv=fence_iova_+RingBvFenceOffset;
+    const uint32_t br=RingThreadBr,bvThread=RingThreadBv,both=RingThreadBoth,depth=RingCcuInvalidateDepth,
+        color=RingCcuInvalidateColor,marker=0x100;
+    const uint32_t bvWrite[4]={RingFenceEvent|RingFenceEnable,(uint32_t)bv,(uint32_t)(bv>>32),seqno};
+    const uint32_t bvWait[4]={0,(uint32_t)bv,(uint32_t)(bv>>32),seqno};
+    const uint32_t fence[4]={RingFenceEvent|RingFenceEnable|RingFenceIrq,(uint32_t)at4,(uint32_t)(at4>>32),seqno};
+    size_t n=packet(words,2,RingThreadControl,&br,1);
+    if(n)n=packet(words,n,RingFenceOpcode,&depth,1);
+    if(n)n=packet(words,n,RingFenceOpcode,&color,1);
+    if(n)n=packet(words,n,RingThreadControl,&bvThread,1);
+    if(n)n=packet(words,n,RingFenceOpcode,bvWrite,4);
+    if(n)n=packet(words,n,RingThreadControl,&br,1);
+    if(n)n=packet(words,n,RingWaitTimestamp,bvWait,4);
+    if(n)n=packet(words,n,RingFenceOpcode,fence,4);
+    if(n)n=packet(words,n,RingThreadControl,&both,1);
+    if(n)n=packet(words,n,RingSetMarker,&marker,1);
+    if(n!=RingFramedFenceWords)return poison();
+    for(uint32_t i=0;i<RingFramedFenceWords;++i)ring_[(at+i)&mask]=words[i];
+    *end=(at+RingFramedFenceWords)&mask;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoRing::attach(const NativeAdrenoRingIo *io,const NativeAdrenoRingCache *cache,
+    void *ring,size_t ring_bytes,uint64_t ring_iova,void *fence,size_t fence_bytes,uint64_t fence_iova)
+{
+    if(attached_ || poisoned_ || ring_ || fence_)return kIOReturnBusy;
+    if(!io || !io->write32 || !io->read32 || !io->barrier || !cache ||
+        !cache->publish || !cache->acquire || !ring || !fence ||
+        ring_bytes<8192 || ring_bytes>(1u<<20) || (ring_bytes&(ring_bytes-1)) ||
+        ((ring_iova|ring_bytes)&(ring_bytes-1)) || (ring_iova&4095) ||
+        fence_bytes<64 || (fence_iova&7) || fence_bytes>=(1u<<24))return kIOReturnBadArgument;
+    /* No register may be touched before every argument is acceptable. */
+    io_=*io;cache_=*cache;ring_=static_cast<volatile uint32_t *>(ring);
+    ring_bytes_=ring_bytes;ring_iova_=ring_iova;
+    fence_=static_cast<volatile uint32_t *>(fence);fence_bytes_=fence_bytes;fence_iova_=fence_iova;
+    for(size_t i=0;i<fence_bytes_/4;++i)fence_[i]=0;
+    const uint32_t control=(uint32_t)(ilog2(ring_bytes/8)&0x3f)|(ilog2(RingBlockBytes/8)<<8);
+    const uint32_t base_lo=(uint32_t)ring_iova_,base_hi=(uint32_t)(ring_iova_>>32);
+    const uint32_t rptr_lo=(uint32_t)fence_iova_,rptr_hi=(uint32_t)(fence_iova_>>32);
+    const uint32_t writes[]={RingBase,base_lo,RingBase+1,base_hi,RingControl,control,
+        RingRptrAddress,rptr_lo,RingRptrAddress+1,rptr_hi,RingWptr,0,RingScratch,0};
+    for(size_t i=0;i<sizeof(writes)/sizeof(writes[0]);i+=2)
+        if(io_.write32(io_.cookie,writes[i],writes[i+1]))return poison();
+    uint32_t rptr=0;IOReturn status=readRptr(&rptr);
+    if(status)return status;
+    next_=rptr;seqno_=0;completed_=0;submissions_=0;
+    attached_=true;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoRing::detach()
+{
+    if(poisoned_)return kIOReturnBusy;
+    if(!attached_)return kIOReturnNotReady;
+    if(outstanding())return kIOReturnBusy;
+    attached_=false;ring_=nullptr;fence_=nullptr;ring_bytes_=fence_bytes_=0;
+    ring_iova_=fence_iova_=0;next_=rptr_shadow_=seqno_=completed_=submissions_=0;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoRing::submit(const uint32_t *words,size_t word_count,uint32_t *fence)
+{
+    return submitWords(words,word_count,fence,false);
+}
+IOReturn NativeAdrenoRing::submitFramed(const uint32_t *words,size_t word_count,uint32_t *fence)
+{
+    return submitWords(words,word_count,fence,true);
+}
+IOReturn NativeAdrenoRing::submitWords(const uint32_t *words,size_t word_count,uint32_t *fence,bool framed)
+{
+    if(!fence)return kIOReturnBadArgument;*fence=0;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(!words || !word_count || word_count>SIZE_MAX/sizeof(uint32_t))return kIOReturnBadArgument;
+    const uint32_t size_words=(uint32_t)(ring_bytes_/4),mask=size_words-1;
+    const bool reset=framed && reset_pending_;
+    const uint32_t extra=framed?RingPrologueWords+(reset?RingResetWords:0)+RingFramedFenceWords:RingFenceWords;
+    if(word_count>size_words-extra-8)return kIOReturnNoResources;
+    uint32_t rptr=0;IOReturn status=readRptr(&rptr);
+    if(status)return status;
+    const uint32_t used=(next_-rptr)&mask;
+    if(word_count+extra+8>size_words-used)return kIOReturnNoResources;
+    uint32_t at=next_;
+    if(framed) {
+        status=emitPrologue(at,reset,&at);
+        if(status)return status;
+    }
+    for(size_t i=0;i<word_count;++i)ring_[(at+i)&mask]=words[i];
+    at=(at+(uint32_t)word_count)&mask;
+    uint32_t end=0;
+    status=framed?emitFramedFence(at,seqno_+1,&end):emitFence(at,seqno_+1,&end);
+    if(status)return status;
+    /* Whole-ring publication is deliberate: a submission may wrap, and one
+     * clean of the owned pool is cheaper than a split range proof. */
+    {
+        const uint32_t slot=native_adreno_ring_log_count&3;
+        const uint32_t total=(end-next_)&mask;
+        volatile uint32_t *record=native_adreno_ring_log[slot];
+        record[0]=seqno_+1;record[1]=next_;record[2]=end;record[3]=total;
+        for(uint32_t i=0;i<112;++i)record[4+i]=i<total?ring_[(next_+i)&mask]:0;
+        native_adreno_ring_log_count=native_adreno_ring_log_count+1;
+    }
+    if(cache_.publish(cache_.cookie,ring_,ring_bytes_))return poison();
+    if(io_.barrier(io_.cookie))return poison();
+    if(io_.write32(io_.cookie,RingWptr,end))return poison();
+    next_=end;*fence=++seqno_;++submissions_;
+    if(reset)reset_pending_=false;
+    return kIOReturnSuccess;
+}
+NativeAdrenoRingFence NativeAdrenoRing::observeFence(uint32_t fence,
+    const NativeAdrenoRingClock *clock,uint32_t timeout_us,uint32_t *observed)
+{
+    if(observed)*observed=0;
+    if(!attached_ || poisoned_)return NativeAdrenoRingFencePoisoned;
+    if(!fence || fence>seqno_)return NativeAdrenoRingFenceArgument;
+    uint64_t start=clock && clock->now_us?clock->now_us(clock->cookie):0;
+    for(;;) {
+        if(cache_.acquire(cache_.cookie,fence_,fence_bytes_)) {poison();return NativeAdrenoRingFencePoisoned;}
+        const uint32_t value=fence_[1];
+        if(observed)*observed=value;
+        if(value>seqno_) {poison();return NativeAdrenoRingFencePoisoned;}
+        if(value>=fence)return NativeAdrenoRingFenceComplete;
+        if(!clock || !clock->now_us)return NativeAdrenoRingFenceTimeout;
+        if(clock->now_us(clock->cookie)-start>=timeout_us)return NativeAdrenoRingFenceTimeout;
+        if(clock->idle && clock->idle(clock->cookie))return NativeAdrenoRingFenceTimeout;
+    }
+}
+NativeAdrenoRingFence NativeAdrenoRing::wait(uint32_t fence,const NativeAdrenoRingClock *clock,
+    uint32_t timeout_us,uint32_t *observed)
+{
+    if(observed)*observed=0;
+    if(!attached_ || poisoned_)return NativeAdrenoRingFencePoisoned;
+    if(!fence || fence>seqno_)return NativeAdrenoRingFenceArgument;
+    uint64_t start=clock && clock->now_us?clock->now_us(clock->cookie):0;
+    for(;;) {
+        if(cache_.acquire(cache_.cookie,fence_,fence_bytes_)) {poison();return NativeAdrenoRingFencePoisoned;}
+        const uint32_t value=fence_[1];
+        if(observed)*observed=value;
+        if(value>=fence) {if(value>seqno_) {poison();return NativeAdrenoRingFencePoisoned;}completed_=value;
+            return NativeAdrenoRingFenceComplete;}
+        if(!clock || !clock->now_us)return NativeAdrenoRingFenceTimeout;
+        if(clock->now_us(clock->cookie)-start>=timeout_us)return NativeAdrenoRingFenceTimeout;
+        if(clock->idle && clock->idle(clock->cookie))return NativeAdrenoRingFenceTimeout;
+    }
+}
diff --git a/iokit/NativeAdreno/NativeAdrenoRing.h b/iokit/NativeAdreno/NativeAdrenoRing.h
new file mode 100644
index 0000000..55c6a93
--- /dev/null
+++ b/iokit/NativeAdreno/NativeAdrenoRing.h
@@ -0,0 +1,101 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_RING_H
+#define NATIVE_ADRENO_RING_H
+#include <IOKit/IOTypes.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* A7XX command processor ring and timestamp fence, not a scheduler.
+ * Register indices are dword offsets; the platform adds the MMIO base and
+ * multiplies by four. Caller must already own an exclusive, powered GPU with
+ * SQE microcode loaded (CP_SQE_INSTR_BASE), global reset released and all
+ * masters quiesced while attach programs the ring. Ring and fence CPU
+ * addresses must be actual writable mappings of the same IOVAs that were
+ * mapped into the active native-4K GPU context. No MMIO base, IRQ, power,
+ * GMU, context switching or per-client validation is implemented here.
+ * Every submit publishes ring memory before advancing WPTR and completes
+ * only when the CP timestamp value is observed at the fence address.
+ * A failed WPTR write or cache publication is uncertain: the ring is poisoned
+ * and every resource must be retained until an independently verified reset. */
+struct NativeAdrenoRingIo {
+    void *cookie;
+    /* Return zero only on a completed access. */
+    int (*write32)(void *,uint32_t reg,uint32_t value);
+    int (*read32)(void *,uint32_t reg,uint32_t *value);
+    int (*barrier)(void *);
+};
+struct NativeAdrenoRingCache {
+    void *cookie;
+    /* Clean owned ring bytes to PoC before the device reads them. */
+    int (*publish)(void *,const volatile uint32_t *words,size_t bytes);
+    /* Invalidate the fence page before the CPU reads CP-written values. */
+    int (*acquire)(void *,volatile uint32_t *words,size_t bytes);
+};
+struct NativeAdrenoRingClock {
+    void *cookie;
+    uint64_t (*now_us)(void *);
+    /* Optional; may sleep. Never used before a successful submit. */
+    int (*idle)(void *);
+};
+enum NativeAdrenoRingFence {
+    NativeAdrenoRingFenceComplete = 0,
+    NativeAdrenoRingFenceTimeout,
+    NativeAdrenoRingFencePoisoned,
+    NativeAdrenoRingFenceArgument
+};
+class NativeAdrenoRing final {
+    NativeAdrenoRingIo io_{};
+    NativeAdrenoRingCache cache_{};
+    volatile uint32_t *ring_=nullptr,*fence_=nullptr;
+    size_t ring_bytes_=0,fence_bytes_=0;
+    uint64_t ring_iova_=0,fence_iova_=0;
+    uint32_t next_=0,rptr_shadow_=0,seqno_=0,completed_=0,submissions_=0;
+    bool attached_=false,poisoned_=false,reset_pending_=false;
+    IOReturn poison();
+    IOReturn readRptr(uint32_t *);
+    IOReturn emitPrologue(uint32_t at,bool reset,uint32_t *end);
+    IOReturn emitFence(uint32_t at,uint32_t seqno,uint32_t *end);
+    IOReturn emitFramedFence(uint32_t at,uint32_t seqno,uint32_t *end);
+    IOReturn submitWords(const uint32_t *words,size_t word_count,uint32_t *fence,bool framed);
+public:
+    NativeAdrenoRing()=default;
+    ~NativeAdrenoRing()=default;
+    NativeAdrenoRing(const NativeAdrenoRing &)=delete;
+    NativeAdrenoRing &operator=(const NativeAdrenoRing &)=delete;
+    /* ring_bytes is a power of two in [8KiB,1MiB]; ring_iova must be aligned
+     * to ring_bytes. fence_bytes >=64 and fence_iova 8-aligned. The fence page
+     * layout is: +0 CP read-pointer shadow, +4 completed timestamp, +8 spare.
+     * All outputs are prevalidated before any register write. */
+    IOReturn attach(const NativeAdrenoRingIo *,const NativeAdrenoRingCache *,
+        void *ring,size_t ring_bytes,uint64_t ring_iova,
+        void *fence,size_t fence_bytes,uint64_t fence_iova);
+    /* Programs nothing. Refuses while submissions are unobserved or poisoned,
+     * because only the caller can establish real GPU quiescence and unmap. */
+    IOReturn detach();
+    /* Emit an entire command stream followed by the timestamp fence and commit
+     * it with one WPTR update. Returns a nonzero fence value on success. The
+     * words are copied; the caller's buffer is never retained. */
+    IOReturn submit(const uint32_t *words,size_t word_count,uint32_t *fence);
+    /* User command buffers: the A7XX BR/BV thread framing of a7xx_submit() around the words (CP init and the kernel's own
+     * bring-up packets keep the plain submit() above, as Linux sends them outside a7xx_submit()). */
+    IOReturn submitFramed(const uint32_t *words,size_t word_count,uint32_t *fence);
+    /* The next framed submission starts with the A7XX context entry of a6xx_set_pagetable() (BR/BV counters, on-chip
+     * timestamps and resource table cleared between thread syncs); a new user client requests it, as Linux does per context. */
+    void requestContextReset() {reset_pending_=true;}
+    /* Polls the CP-written timestamp after invalidating the fence page. Never
+     * writes registers and never advances the ring. Timeout is not poison. */
+    NativeAdrenoRingFence wait(uint32_t fence,const NativeAdrenoRingClock *,
+        uint32_t timeout_us,uint32_t *observed);
+    /* Observe a previously issued fence without retiring or accounting for it.
+     * Used before a new submission waits on an earlier batch; only fence values
+     * this ring issued are accepted. Never writes a register. */
+    NativeAdrenoRingFence observeFence(uint32_t fence,const NativeAdrenoRingClock *,
+        uint32_t timeout_us,uint32_t *observed);
+    bool poisoned() const {return poisoned_;}
+    uint32_t outstanding() const {return seqno_-completed_;}
+    uint32_t lastSubmitted() const {return seqno_;}      /* the newest fence number handed out */
+    uint32_t completedFence() const {return completed_;}
+    uint32_t submissions() const {return submissions_;}
+    uint32_t readPointer() const {return rptr_shadow_;}
+};
+#endif
