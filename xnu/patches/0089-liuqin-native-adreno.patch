diff --git a/iokit/NativeAdreno/LiuqinAdrenoGlue.cpp b/iokit/NativeAdreno/LiuqinAdrenoGlue.cpp
new file mode 100644
index 0000000..28c8b0f
--- /dev/null
+++ b/iokit/NativeAdreno/LiuqinAdrenoGlue.cpp
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: MIT */
+/* Board wiring for the native Adreno IOKit services (liuqin, Adreno 730).
+ *
+ * The services in this directory are plain IOService subclasses: they carry no
+ * kernel-side matching personality, so on this port nothing would ever
+ * instantiate them. This file is the missing board code. It runs after the
+ * platform expert has published /arm-io's children as IOPlatformDevice nubs
+ * (the ADT nodes "gpu", "gmu" and "gpu-smmu" built by tools/mkadt.py) and:
+ *
+ *   1. finds those three nubs by their compatible property;
+ *   2. creates NativeAdrenoSmmuService, NativeAdrenoGmuService and
+ *      NativeAdrenoGpuService, attaches each one to its own nub and starts it,
+ *      in that order: the GPU service looks the other two up by class name;
+ *   3. leaves the GPU service published but not ready. Its start() maps the
+ *      windows and reports what it found, then refuses user clients until a
+ *      started CP exists.
+ *
+ * Boot argument liuqinsvc=1 enables all of it; default 0 keeps the registry as
+ * it was. Nothing here powers the GPU, loads firmware or writes a register:
+ * that is still the bring-up ladder in bsd/dev/liuqin_adreno.c.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <pexpert/pexpert.h>
+#include <string.h>
+#include "NativeAdrenoGmuService.h"
+#include "NativeAdrenoSmmuService.h"
+
+/* NativeAdrenoService.cpp: the class has no public header yet. */
+extern "C" IOService *liuqin_adreno_gpu_service_create(void);
+extern "C" void liuqin_adreno_services_start(void);
+
+static bool compatibleHas(IOService *service, const char *needle, size_t needleLength)
+{
+	OSData *data = OSDynamicCast(OSData,
+	    service ? service->getProperty("compatible") : NULL);
+	if (!data || !data->getBytesNoCopy() || !data->getLength()) {
+		return false;
+	}
+	const char *text = static_cast<const char *>(data->getBytesNoCopy());
+	const size_t length = data->getLength();
+	for (size_t at = 0; at + needleLength <= length; ++at) {
+		if (!memcmp(text + at, needle, needleLength)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* One /arm-io child whose compatible contains needle, retained; NULL if none. */
+static IOService *copyNub(const char *needle)
+{
+	const size_t needleLength = strlen(needle);
+	IOService *found = NULL;
+	OSDictionary *matching = IOService::serviceMatching("IOPlatformDevice");
+	if (!matching) {
+		return NULL;
+	}
+	OSIterator *services = IOService::getMatchingServices(matching);
+	matching->release();
+	if (!services) {
+		return NULL;
+	}
+	while (IOService *candidate = OSDynamicCast(IOService, services->getNextObject())) {
+		if (compatibleHas(candidate, needle, needleLength)) {
+			found = candidate;
+			found->retain();
+			break;
+		}
+	}
+	services->release();
+	return found;
+}
+
+static bool startService(IOService *service, IOService *provider, const char *name)
+{
+	/* Nothing calls getResources() for a nub nobody matched: it is what turns
+	 * the node's reg property into the IODeviceMemory array the service maps. */
+	const IOReturn resources = provider->getResources();
+	if (resources != kIOReturnSuccess) {
+		IOLog("NativeAdreno: %s resources 0x%x\n", name, resources);
+		return false;
+	}
+	if (!provider->getDeviceMemoryCount()) {
+		IOLog("NativeAdreno: %s has no device memory\n", name);
+		return false;
+	}
+	if (!service->attach(provider)) {
+		IOLog("NativeAdreno: %s did not attach\n", name);
+		return false;
+	}
+	if (!service->start(provider)) {
+		IOLog("NativeAdreno: %s did not start\n", name);
+		return false;
+	}
+	IOLog("NativeAdreno: %s started on %s\n", name,
+	    provider->getName() ? provider->getName() : "?");
+	return true;
+}
+
+void liuqin_adreno_services_start(void)
+{
+	uint32_t enabled = 0;
+	if (!PE_parse_boot_argn("liuqinsvc", &enabled, sizeof(enabled)) || !enabled) {
+		return;
+	}
+	IOService *smmuNub = copyNub("qcom,adreno-smmu");
+	IOService *gmuNub = copyNub("qcom,adreno-gmu");
+	IOService *gpuNub = copyNub("adreno-gpu");
+	IOLog("NativeAdreno: nubs smmu=%u gmu=%u gpu=%u\n",
+	    smmuNub ? 1u : 0u, gmuNub ? 1u : 0u, gpuNub ? 1u : 0u);
+
+	if (smmuNub) {
+		NativeAdrenoSmmuService *smmu = new NativeAdrenoSmmuService;
+		if (!smmu || !smmu->init() || !startService(smmu, smmuNub, "SMMU")) {
+			if (smmu) {
+				smmu->release();
+			}
+			IOLog("NativeAdreno: SMMU service unavailable\n");
+		}
+		smmuNub->release();
+	}
+	if (gmuNub) {
+		NativeAdrenoGmuService *gmu = new NativeAdrenoGmuService;
+		if (!gmu || !gmu->init() || !startService(gmu, gmuNub, "GMU")) {
+			if (gmu) {
+				gmu->release();
+			}
+			IOLog("NativeAdreno: GMU service unavailable\n");
+		}
+		gmuNub->release();
+	}
+	if (gpuNub) {
+		IOService *gpu = liuqin_adreno_gpu_service_create();
+		if (!gpu || !startService(gpu, gpuNub, "GPU")) {
+			if (gpu) {
+				gpu->release();
+			}
+			IOLog("NativeAdreno: GPU service unavailable\n");
+		}
+		gpuNub->release();
+	} else {
+		IOLog("NativeAdreno: no /arm-io gpu node; nothing to attach\n");
+	}
+}
