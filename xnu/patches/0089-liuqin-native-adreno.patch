@@ -0,0 +1,7 @@
+# AdrenoPM4
+
+Adreno PM4 packet encoding kit. Encodes A740 state, constants, shader bindings, VPC and rasterizer packets.
+
+Current state: used by the native GPU submission path.
+
+Built into the kernel with the sheng GPU stack.
diff --git a/iokit/NativeAdreno/kits/AdrenoPM4/test_constants.c b/iokit/NativeAdreno/kits/AdrenoPM4/test_constants.c
new file mode 100644
index 0000000..78ddd1b
--- /dev/null
+++ b/iokit/NativeAdreno/kits/AdrenoPM4/test_constants.c
@@ -0,0 +1,143 @@
+/* SPDX-License-Identifier: MIT */
+#include "AdrenoConstants.h"
+#include "AdrenoPM4.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#ifdef MESA_REFERENCE
+#include "freedreno_pm4.h"
+#endif
+#define WORDS 2304
+static uint32_t output[WORDS], before[WORDS];
+static unsigned checks, refusals;
+static struct AdrenoConstantConfig config = {ADRENO_A740_CHIP_ID, AdrenoConstantVertex, 8192};
+static uint32_t reference_state(unsigned stage, unsigned destination, unsigned units)
+{
+#ifdef MESA_REFERENCE
+    const enum a6xx_state_block blocks[] = {SB6_VS_SHADER, SB6_HS_SHADER, SB6_DS_SHADER,
+        SB6_GS_SHADER, SB6_FS_SHADER, SB6_CS_SHADER};
+    return CP_LOAD_STATE6_0_DST_OFF(destination) | CP_LOAD_STATE6_0_STATE_TYPE(ST6_CONSTANTS) |
+        CP_LOAD_STATE6_0_STATE_SRC(SS6_DIRECT) | CP_LOAD_STATE6_0_STATE_BLOCK(blocks[stage]) |
+        CP_LOAD_STATE6_0_NUM_UNIT(units);
+#else
+    const uint32_t blocks[] = {0x200000, 0x240000, 0x280000, 0x2c0000, 0x300000, 0x340000};
+    return destination | 0x4000 | blocks[stage] | units * 0x400000;
+#endif
+}
+static void reset(void)
+{
+    memset(output, 0x6b, sizeof(output));
+    memcpy(before, output, sizeof(output));
+}
+static void rejected(const struct AdrenoConstantConfig *cfg, const struct AdrenoConstantSpan *spans,
+                     size_t count, const uint8_t *data, size_t bytes, uint32_t *dst, size_t capacity, unsigned expected)
+{
+    memcpy(before, output, sizeof(output));
+    struct AdrenoConstantResult r = AdrenoA740Constants(cfg, spans, count, data, bytes, dst, capacity);
+    assert(r.status == expected && !r.words && !r.packets);
+    assert(!memcmp(output, before, sizeof(output)));
+    ++refusals;
+}
+static void positive(const struct AdrenoConstantSpan *spans, size_t count, const uint8_t *data, size_t bytes)
+{
+    reset();
+    struct AdrenoConstantResult r = AdrenoA740Constants(&config, spans, count, data, bytes, output, WORDS);
+    assert(r.status == AdrenoConstantOK && r.packets == count);
+    AdrenoPM4Packet packets[64];
+    size_t packet_count = 0;
+    assert(AdrenoPM4Plan(output, r.words, packets, 64, &packet_count) == AdrenoPM4Success && packet_count == count);
+    size_t at = 0;
+    for (size_t i = 0; i < count; ++i) {
+        const struct AdrenoConstantSpan *s = &spans[i];
+        unsigned opcode = config.stage < 4 ? 0x32 : 0x34;
+#ifdef MESA_REFERENCE
+        assert(output[at] == pm4_pkt7_hdr(opcode, 3 + s->bytes / 4));
+#endif
+        assert(packets[i].header_word == at && packets[i].identifier == opcode && packets[i].type == 7 &&
+               packets[i].payload_words == 3 + s->bytes / 4);
+        assert(output[at+1] == reference_state(config.stage, s->destination_byte / 16, s->bytes / 16));
+        assert(!output[at+2] && !output[at+3]);
+        assert(!memcmp(output + at + 4, data + s->source_byte, s->bytes));
+        at += 4 + s->bytes / 4;
+    }
+    assert(r.words == at && !memcmp(output + at, before + at, sizeof(output) - at * 4));
+    ++checks;
+}
+int main(void)
+{
+    long page = sysconf(_SC_PAGESIZE);
+    assert(page >= 4096);
+    uint8_t *mapping = mmap(NULL, (size_t)page*3, PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0);
+    assert(mapping != MAP_FAILED && !mprotect(mapping+2*page, (size_t)page, PROT_NONE));
+    uint8_t *data = mapping + 2*page - 8192;
+    for (unsigned i = 0; i < 8192; ++i) data[i] = (uint8_t)(i * 7 + 3);
+    struct AdrenoConstantSpan one = {0, 0, 16};
+    for (unsigned stage = 0; stage < 6; ++stage) {
+        config.stage = stage;
+        for (unsigned off = 0; off < 512; ++off) {
+            one.destination_byte = off*16;
+            const unsigned units[] = {1, 512-off, 4};
+            for (unsigned i = 0; i < 3; ++i) if (units[i] <= 512-off) {
+                one.bytes = units[i]*16;
+                one.source_byte = 8192-one.bytes;
+                positive(&one, 1, data, 8192);
+            }
+        }
+    }
+    config.stage = 0;
+    config.chip_id = ADRENO_A740_FALLBACK_CHIP_ID;
+    one = (struct AdrenoConstantSpan){0, 0, 16};
+    positive(&one, 1, data, 8192);
+    config.chip_id = ADRENO_A740_CHIP_ID;
+    struct AdrenoConstantSpan spans[64];
+    for (unsigned i = 0; i < 64; ++i) spans[i] = (struct AdrenoConstantSpan){i*16, i*32, 16};
+    positive(spans, 64, data, 8192);
+    /* An unaligned byte source is legal and reads exactly through its logical end. */
+    one = (struct AdrenoConstantSpan){0, 0, 16};
+    positive(&one, 1, data+1, 16);
+    positive(NULL, 0, NULL, 0);
+    reset();
+    rejected(NULL, &one, 1, data, 8192, output, WORDS, AdrenoConstantArgument);
+    rejected(&config, NULL, 1, data, 8192, output, WORDS, AdrenoConstantArgument);
+    rejected(&config, &one, 65, data, 8192, output, WORDS, AdrenoConstantArgument);
+    rejected(&config, &one, 1, NULL, 8192, output, WORDS, AdrenoConstantArgument);
+    rejected(&config, &one, 1, data, 8192, NULL, WORDS, AdrenoConstantArgument);
+    rejected(&config, &one, 1, data, 16385, output, WORDS, AdrenoConstantArgument);
+    rejected(&config, &one, 1, data, 8192, output, SIZE_MAX, AdrenoConstantArgument);
+    rejected(&config, &one, 1, data, 8192, (uint32_t *)((uint8_t *)output+1), WORDS-1, AdrenoConstantArgument);
+    rejected(&config, &one, 1, (void *)(UINTPTR_MAX-3), 16, output, WORDS, AdrenoConstantArgument);
+    rejected(&config, &one, 1, data, 8192, (void *)(UINTPTR_MAX-3), 8, AdrenoConstantArgument);
+    rejected((void *)(UINTPTR_MAX-3), &one, 1, data, 8192, output, WORDS, AdrenoConstantArgument);
+    rejected(&config, (void *)(UINTPTR_MAX-3), 1, data, 8192, output, WORDS, AdrenoConstantArgument);
+    struct AdrenoConstantConfig bad = config;
+    bad.chip_id ^= 1;
+    rejected(&bad, &one, 1, data, 8192, output, WORDS, AdrenoConstantProfile);
+    bad=config;bad.chip_id=UINT64_C(0xffff000043050a01);
+    rejected(&bad, &one, 1, data, 8192, output, WORDS, AdrenoConstantProfile);
+    bad=config;bad.stage=6;
+    rejected(&bad, &one, 1, data, 8192, output, WORDS, AdrenoConstantProfile);
+    bad=config;bad.constant_bytes=8208;
+    rejected(&bad, &one, 1, data, 8192, output, WORDS, AdrenoConstantProfile);
+    bad=config;bad.constant_bytes=17;
+    rejected(&bad, &one, 1, data, 8192, output, WORDS, AdrenoConstantProfile);
+    rejected(&config, &one, 1, data, 8192, output, 7, AdrenoConstantCapacity);
+    rejected(&config, &one, 1, (const uint8_t *)output, 16, output, WORDS, AdrenoConstantAlias);
+    memcpy(output, &config, sizeof(config));
+    rejected((const void *)output, &one, 1, data, 8192, output, WORDS, AdrenoConstantAlias);
+    memcpy(output, &one, sizeof(one));
+    rejected(&config, (const void *)output, 1, data, 8192, output, WORDS, AdrenoConstantAlias);
+    const struct AdrenoConstantSpan invalid[] = {{0,0,0},{0,0,15},{0,1,16},{8192,0,16},
+        {0,8192,16},{UINT32_MAX,0,16},{0,UINT32_MAX-15,16},{0,0,UINT32_MAX-15}};
+    reset();
+    for (unsigned i = 0; i < sizeof(invalid)/sizeof(invalid[0]); ++i)
+        rejected(&config, &invalid[i], 1, data, 8192, output, WORDS, AdrenoConstantRange);
+    struct AdrenoConstantSpan late[] = {{0,0,16},{16,0,16}};
+    rejected(&config, late, 2, data, 8192, output, WORDS, AdrenoConstantRange);
+    late[1].destination_byte=8192;
+    rejected(&config, late, 2, data, 8192, output, WORDS, AdrenoConstantRange);
+    assert(!munmap(mapping, (size_t)page*3));
+    printf("PASS: %u direct upload cases, six stages/all 512 offsets, maximum extents, guard and %u transactional refusals\n", checks, refusals);
+    return 0;
+}
diff --git a/iokit/NativeAdreno/kits/AdrenoPM4/test_pm4.c b/iokit/NativeAdreno/kits/AdrenoPM4/test_pm4.c
new file mode 100644
index 0000000..f7005b7
--- /dev/null
+++ b/iokit/NativeAdreno/kits/AdrenoPM4/test_pm4.c
@@ -0,0 +1,101 @@
+/* SPDX-License-Identifier: MIT */
+#include "AdrenoPM4.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "line %d: %s\n", __LINE__, #c); exit(1); } } while (0)
+
+static unsigned population(uint32_t word)
+{
+    unsigned sum = 0;
+    for (unsigned bit = 0; bit < 32; ++bit)
+        sum += (word >> bit) & 1;
+    return sum;
+}
+static void refusal(const uint32_t *words, size_t length, size_t capacity, AdrenoPM4Status expected)
+{
+    AdrenoPM4Packet output[8], before[8];
+    size_t count = 99;
+    memset(output, 0xa5, sizeof(output));
+    memcpy(before, output, sizeof(output));
+    CHECK(AdrenoPM4Plan(words, length, output, capacity, &count) == expected);
+    CHECK(!count && !memcmp(output, before, sizeof(output)));
+}
+int main(void)
+{
+    uint32_t header, words[0x4000] = {0};
+    AdrenoPM4Packet packet[4];
+    size_t count;
+    unsigned flips = 0;
+    CHECK(AdrenoPM4Type7(0x26, 0, &header) == AdrenoPM4Success && header == 0x70268000);
+    CHECK(AdrenoPM4Type7(0x10, 1, &header) == AdrenoPM4Success && header == 0x70100001);
+    CHECK(AdrenoPM4Type7(0x3d, 3, &header) == AdrenoPM4Success && header == 0x703d8003);
+    CHECK(AdrenoPM4Type4(0, 1, &header) == AdrenoPM4Success && header == 0x48000001);
+    /* Entire type-7 field domain: check independent population invariants,
+     * exact field preservation, reserved bits and real plan boundaries. */
+    for (uint32_t opcode = 0; opcode <= 127; ++opcode) {
+        for (uint32_t n = 0; n <= 0x3fff; ++n) {
+            CHECK(AdrenoPM4Type7(opcode, n, &header) == AdrenoPM4Success);
+            CHECK((header & 0xff004000) == 0x70000000);
+            CHECK(((header >> 16) & 127) == opcode && (header & 0x3fff) == n);
+            CHECK(population(header & 0xffff) % 2 == 1);
+            CHECK(population((header >> 16) & 255) % 2 == 1);
+            words[0] = header;
+            CHECK(AdrenoPM4Plan(words, n + 1, packet, 1, &count) == AdrenoPM4Success);
+            CHECK(count == 1 && packet[0].type == 7 && packet[0].identifier == opcode && packet[0].payload_words == n);
+            if (n == 0 || n == 0x3fff) {
+                for (unsigned bit = 0; bit < 32; ++bit) {
+                    words[0] = header ^ (1u << bit);
+                    refusal(words, n + 1, 1, AdrenoPM4InvalidHeader);
+                    ++flips;
+                }
+            }
+        }
+    }
+    /* All supported register indices and all count values. */
+    for (uint32_t reg = 0; reg <= 0x3ffff; ++reg) {
+        CHECK(AdrenoPM4Type4(reg, 1, &header) == AdrenoPM4Success);
+        CHECK(((header >> 8) & 0x3ffff) == reg && (header & 127) == 1);
+        CHECK(population(header & 255) % 2 == 1 && population((header >> 8) & 0xfffff) % 2 == 1);
+        words[0] = header;
+        CHECK(AdrenoPM4Plan(words, 2, packet, 1, &count) == AdrenoPM4Success);
+        CHECK(count == 1 && packet[0].type == 4 && packet[0].identifier == reg);
+    }
+    for (uint32_t n = 1; n <= 127; ++n) {
+        CHECK(AdrenoPM4Type4(0, n, &header) == AdrenoPM4Success);
+        words[0] = header;
+        CHECK(AdrenoPM4Plan(words, n + 1, packet, 1, &count) == AdrenoPM4Success);
+        CHECK(packet[0].payload_words == n);
+        for (unsigned bit = 0; bit < 32; ++bit) {
+            words[0] = header ^ (1u << bit);
+            refusal(words, n + 1, 1, AdrenoPM4InvalidHeader);
+            ++flips;
+        }
+    }
+    /* Mixed packets, payload containing header-like data and transactional
+     * late failures: payload must never be interpreted as packet headers. */
+    uint32_t mixed[] = {0x70100001, 0xffffffff, 0x48000001, 0x70000000, 0x70268000};
+    CHECK(AdrenoPM4Plan(mixed, 5, packet, 3, &count) == AdrenoPM4Success && count == 3);
+    CHECK(packet[0].header_word == 0 && packet[1].header_word == 2 && packet[2].header_word == 4);
+    refusal(mixed, 5, 2, AdrenoPM4Capacity);
+    refusal(mixed, 3, 3, AdrenoPM4Truncated);
+    mixed[4] ^= 1u << 15;
+    refusal(mixed, 5, 3, AdrenoPM4InvalidHeader);
+    refusal(NULL, 1, 1, AdrenoPM4InvalidArgument);
+    refusal(words, SIZE_MAX, 1, AdrenoPM4InvalidArgument);
+    CHECK(AdrenoPM4Plan(NULL, 0, NULL, 0, &count) == AdrenoPM4Success && !count);
+    CHECK(AdrenoPM4Plan(words, 1, NULL, 1, &count) == AdrenoPM4InvalidArgument && !count);
+    CHECK(AdrenoPM4Plan(NULL, 0, NULL, 0, NULL) == AdrenoPM4InvalidArgument);
+    header = 0xa5a5a5a5;
+    CHECK(AdrenoPM4Type7(128, 1, &header) == AdrenoPM4InvalidArgument);
+    CHECK(AdrenoPM4Type7(0, 0x4000, &header) == AdrenoPM4InvalidArgument);
+    CHECK(AdrenoPM4Type4(0x40000, 1, &header) == AdrenoPM4InvalidArgument);
+    CHECK(AdrenoPM4Type4(0x3ffff, 2, &header) == AdrenoPM4InvalidArgument);
+    CHECK(AdrenoPM4Type4(0, 0, &header) == AdrenoPM4InvalidArgument);
+    CHECK(AdrenoPM4Type4(0, 128, &header) == AdrenoPM4InvalidArgument);
+    CHECK(header == 0xa5a5a5a5);
+    CHECK(AdrenoPM4Type7(0, 0, NULL) == AdrenoPM4InvalidArgument);
+    CHECK(AdrenoPM4Type4(0, 1, NULL) == AdrenoPM4InvalidArgument);
+    printf("PASS: 2097152 type-7 pairs, 262144 registers, 127 counts, %u single-bit corruptions; transactional stream refusals\n", flips);
+    return 0;
+}
diff --git a/iokit/NativeAdreno/kits/AdrenoPM4/test_raster.c b/iokit/NativeAdreno/kits/AdrenoPM4/test_raster.c
new file mode 100644
index 0000000..9d81d7e
--- /dev/null
+++ b/iokit/NativeAdreno/kits/AdrenoPM4/test_raster.c
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: MIT */
+#include "AdrenoRaster.h"
+#include "AdrenoPM4.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#ifdef MESA_REFERENCE
+size_t AdrenoRasterReference(const struct AdrenoRasterState *,uint32_t *,uint32_t *,size_t);
+#endif
+static unsigned positives,refusals;
+static uint32_t out[80],saved[80];
+static struct AdrenoRasterState state;
+static void fixture(void) {
+    state=(struct AdrenoRasterState){ADRENO_A740_CHIP_ID,
+        AdrenoRasterClipNear|AdrenoRasterClipFar|AdrenoRasterHalfZ|AdrenoRasterFrontCCW,
+        3,16,2,0,0,0,0};
+}
+static void reset(void) { memset(out,0x6b,sizeof out);memcpy(saved,out,sizeof out); }
+static void positive_capacity(size_t capacity) {
+    reset();struct AdrenoRasterResult r=AdrenoA740Raster(&state,out,capacity);
+    int clamp=(state.flags&3)!=3;
+    assert(!r.status && r.words==(clamp?24u:60u) && r.registers==(clamp?12u:46u));
+    assert(!memcmp(out+r.words,saved+r.words,sizeof out-r.words*4));
+    AdrenoPM4Packet packets[16];size_t count=0;
+    assert(!AdrenoPM4Plan(out,r.words,packets,16,&count) && count==(clamp?12u:14u));
+#ifdef MESA_REFERENCE
+    uint32_t regs[64],values[64];size_t nr=AdrenoRasterReference(&state,regs,values,64),at=0;
+    assert(nr==r.registers);
+    for(size_t i=0;i<count;i++) {
+        assert(packets[i].type==4);
+        for(unsigned j=0;j<packets[i].payload_words;j++,at++)
+            assert(at<nr && regs[at]==packets[i].identifier+j &&
+                values[at]==out[packets[i].header_word+1+j]);
+    }
+    assert(at==nr);
+#endif
+    positives++;
+}
+static void positive(void) { positive_capacity(80); }
+static void refusal(uint32_t status,size_t capacity) {
+    reset();struct AdrenoRasterResult r=AdrenoA740Raster(&state,out,capacity);
+    assert(r.status==status && !r.words && !r.registers && !memcmp(out,saved,sizeof out));refusals++;
+}
+int main(void) {
+    /* Every supported flag combination and polygon mode, for both full IDs. */
+    for(unsigned chip=0;chip<2;chip++)for(unsigned flags=0;flags<=ADRENO_RASTER_FLAGS;flags++)for(unsigned mode=1;mode<=3;mode++) {
+        fixture();state.chip_id=chip?ADRENO_A740_FALLBACK_CHIP_ID:ADRENO_A740_CHIP_ID;
+        state.flags=flags;state.polygon_mode=mode;positive();
+    }
+    /* Every fixed-point point/line field value, avoiding float conversions. */
+    for(unsigned i=0;i<=65472;i++) {fixture();state.point_size_q4=i;positive();}
+    for(unsigned i=0;i<=255;i++) {fixture();state.line_width_q1=i;positive();}
+    static const uint32_t finite[]={0,0x80000000,1,0x80000001,0x007fffff,0x00800000,
+        0x3f000000,0x3f800000,0xbf800000,0x7f7fffff,0xff7fffff};
+    for(unsigned i=0;i<sizeof finite/sizeof finite[0];i++)for(unsigned j=0;j<3;j++) {
+        fixture();uint32_t *v=j==0?&state.offset_scale_bits:j==1?&state.offset_units_bits:&state.offset_clamp_bits;*v=finite[i];positive();
+    }
+    fixture();positive_capacity(60);state.flags=0;positive_capacity(24);
+#define BAD(change,status) do {fixture();change;refusal(status,80);}while(0)
+    BAD(state.chip_id=0x43050a02,AdrenoRasterProfile);
+    BAD(state.chip_id=UINT64_C(0x123443050a01),AdrenoRasterProfile);
+    BAD(state.flags=8192,AdrenoRasterProfile);BAD(state.reserved=1,AdrenoRasterProfile);
+    BAD(state.polygon_mode=0,AdrenoRasterProfile);BAD(state.polygon_mode=4,AdrenoRasterProfile);
+    BAD(state.point_size_q4=65473,AdrenoRasterProfile);BAD(state.line_width_q1=256,AdrenoRasterProfile);
+    const uint32_t bad[]={0x7f800000,0xff800000,0x7fc00000,0xff800001};
+    for(unsigned i=0;i<4;i++)for(unsigned j=0;j<3;j++) {
+        fixture();uint32_t *v=j==0?&state.offset_scale_bits:j==1?&state.offset_units_bits:&state.offset_clamp_bits;*v=bad[i];refusal(AdrenoRasterProfile,80);
+    }
+#undef BAD
+    fixture();refusal(AdrenoRasterCapacity,0);refusal(AdrenoRasterCapacity,59);
+    state.flags=0;refusal(AdrenoRasterCapacity,23);
+    reset();assert(AdrenoA740Raster(0,out,80).status==AdrenoRasterArgument && !memcmp(out,saved,sizeof out));refusals++;
+    fixture();reset();assert(AdrenoA740Raster(&state,0,80).status==AdrenoRasterArgument);refusals++;
+    assert(AdrenoA740Raster(&state,out,SIZE_MAX).status==AdrenoRasterArgument && !memcmp(out,saved,sizeof out));refusals++;
+    assert(AdrenoA740Raster((const void *)(UINTPTR_MAX-7),out,80).status==AdrenoRasterArgument && !memcmp(out,saved,sizeof out));refusals++;
+    assert(AdrenoA740Raster((const void *)((uintptr_t)&state+1),out,80).status==AdrenoRasterArgument && !memcmp(out,saved,sizeof out));refusals++;
+    assert(AdrenoA740Raster(&state,(void *)((uintptr_t)out+1),80).status==AdrenoRasterArgument && !memcmp(out,saved,sizeof out));refusals++;
+    assert(AdrenoA740Raster(&state,(void *)(UINTPTR_MAX-3),2).status==AdrenoRasterArgument && !memcmp(out,saved,sizeof out));refusals++;
+    union { struct AdrenoRasterState s;uint32_t words[80]; } alias;
+    for(unsigned i=0;i<sizeof(state)/4;i++) {
+        memset(&alias,0x6b,sizeof alias);alias.s=state;unsigned char before[sizeof alias];memcpy(before,&alias,sizeof alias);
+        assert(AdrenoA740Raster(&alias.s,alias.words+i,60).status==AdrenoRasterAlias && !memcmp(before,&alias,sizeof alias));refusals++;
+    }
+    _Alignas(struct AdrenoRasterState) uint32_t preceding[96];
+    memset(preceding,0x6b,sizeof preceding);memcpy(preceding+8,&state,sizeof state);
+    unsigned char before[sizeof preceding];memcpy(before,preceding,sizeof preceding);
+    assert(AdrenoA740Raster((const void *)(preceding+8),preceding,60).status==AdrenoRasterAlias && !memcmp(before,preceding,sizeof preceding));refusals++;
+    printf("PASS: %u raster profiles, %u transactional refusals\n",positives,refusals);
+    return 0;
+}
diff --git a/iokit/NativeAdreno/kits/AdrenoPM4/test_shader.c b/iokit/NativeAdreno/kits/AdrenoPM4/test_shader.c
