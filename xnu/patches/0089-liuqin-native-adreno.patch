+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+NSDictionary *ServeOfflineMetalCommands(const char *,id<MTLDevice>,NSArray<id<MTLLibrary>> *,NSArray *,unsigned expectedSessions=0);
diff --git a/iokit/NativeAdreno/NativeMetal/NativeAdrenoUserTest.h b/iokit/NativeAdreno/NativeMetal/NativeAdrenoUserTest.h
new file mode 100644
index 0000000..2ed55dd
--- /dev/null
+++ b/iokit/NativeAdreno/NativeMetal/NativeAdrenoUserTest.h
@@ -0,0 +1,628 @@
+// SPDX-License-Identifier: MIT
+// The userspace GPU test shared by the Adreno Metal plugin (runs inside whichever system process the original Metal discovery loads it
+// into, under that process's sandbox) and the launchd probe daemon (no sandbox profile). It proves the whole userspace path to the GPU:
+// open the driver, move every ABI method through an admitted selector (or the mailbox page), map buffer objects write-combined or
+// uncached, write an indirect buffer from userspace, submit it, wait for the fence, read the result back, and report one line to the
+// kernel through SetMetadata. Progress markers are IOServiceOpen calls with type 0x4147<value>, which the driver counts and refuses.
+#pragma once
+#include <dlfcn.h>
+#include <mach/mach.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <initializer_list>
+#include "NativeAdrenoABI.h"
+#include "NativeTurnipSmoke.h"
+#if __has_include("TurnipReplay.h")
+#include "TurnipReplay.h"
+#define NATIVE_TURNIP_REPLAY 1
+#endif
+extern "C" {
+#include "AdrenoPM4.h"
+}
+
+namespace {
+using IOServiceOpenFn = int (*)(unsigned, unsigned, uint32_t, unsigned *);
+using IOServiceCloseFn = int (*)(unsigned);
+using CallFn = int (*)(unsigned, uint32_t, const void *, size_t, void *, size_t *);
+using MapFn = int (*)(unsigned, uint32_t, unsigned, uint64_t *, uint64_t *, uint32_t);
+using UnmapFn = int (*)(unsigned, uint32_t, unsigned, uint64_t);
+
+// The sandbox admits only some external-method selector numbers for this user-client class, and which ones is decided by the
+// profile, not by us. Every ABI method therefore travels through one admitted selector as {magic, method, payload}; the driver
+// recognises the magic before its own selector table. Probing 0..255 finds an admitted selector without knowing the profile.
+constexpr uint32_t kTunnelMagic = 0x4e544e4c, kProbe = 0xffffffffu;
+struct Gpu {
+    unsigned conn = 0;
+    CallFn call = nullptr;
+    MapFn map = nullptr;
+    UnmapFn unmap = nullptr;
+    uint32_t selector = 0;
+    unsigned admitted = 0;
+    uint64_t lastTicks = 0;
+    unsigned port = 0;
+    IOServiceOpenFn openFn = nullptr;
+    IOServiceCloseFn closeFn = nullptr;
+    // Progress marker: an IOServiceOpen with type 0x4147<value>. The driver counts it and refuses it, so it needs no selector, no
+    // mapping and no connection, and survives a sandbox that admits nothing else or a crash after it.
+    void mark(uint32_t value) {
+        unsigned c = 0;
+        if (openFn && port && openFn(port, mach_task_self(), 0x41470000u | (value & 0xffff), &c) == 0 && c && closeFn) closeFn(c);
+    }
+    volatile uint32_t *mailbox = nullptr;
+    uint32_t mailboxSeq = 0;
+    int mailboxMethod(uint32_t m, const void *in, size_t is, void *out, size_t os) {
+        if (!mailbox || is > 0x700 || os > 0x700) return -1;
+        if (is) memcpy(const_cast<uint32_t *>(mailbox) + 0x10, in, is);
+        mailbox[3] = m;
+        mailbox[5] = (uint32_t)is;
+        mailbox[6] = (uint32_t)os;
+        __sync_synchronize();
+        const uint32_t seq = ++mailboxSeq;
+        mailbox[1] = seq;
+        __sync_synchronize();
+        for (unsigned i = 0; i < 6000 && mailbox[2] != seq; ++i) usleep(500);   // the kernel poller runs at about 1 kHz
+        if (mailbox[2] != seq) return -2;
+        __sync_synchronize();
+        const int status = (int)mailbox[4];
+        if (!status && os) memcpy(out, const_cast<uint32_t *>(mailbox) + 0x200, os);
+        return status;
+    }
+    int method(uint32_t m, const void *in, size_t is, void *out, size_t os) {
+        if (mailbox) return mailboxMethod(m, in, is, out, os);
+        uint8_t buffer[8 + sizeof(NativeAdrenoAbiSubmit)];
+        if (is > sizeof(NativeAdrenoAbiSubmit)) return -1;
+        const uint32_t header[2] = {kTunnelMagic, m};
+        memcpy(buffer, header, 8);
+        if (is) memcpy(buffer + 8, in, is);
+        size_t o = os;
+        return call(conn, selector, buffer, 8 + is, os ? out : nullptr, os ? &o : nullptr);
+    }
+    // No selector is admitted: use the mailbox page (IOConnectMapMemory64 is not covered by the selector filter).
+    bool openMailbox() {
+        uint64_t address = 0, length = 0;
+        if (map(conn, 0xC0DE, mach_task_self(), &address, &length, 1) != 0 || length < 4096) return false;
+        mailbox = reinterpret_cast<volatile uint32_t *>(address);
+        return mailbox[0] == 0x4d41494c;
+    }
+    // Returns true when some selector was admitted; the first one becomes the tunnel selector.
+    bool probe() {
+        const uint32_t header[2] = {kTunnelMagic, kProbe};
+        bool found = false;
+        for (uint32_t s = 0; s < 256; ++s) {
+            if (call(conn, s, header, sizeof header, nullptr, nullptr) == 0) {
+                if (!found) selector = s;
+                found = true;
+                ++admitted;
+            }
+        }
+        return found;
+    }
+};
+
+void report(Gpu &gpu, const char *process, int step, int error, int verified, int verifiedWc, uint64_t ticks) {
+    // SetMetadata with a bogus handle: the driver records the text before it validates the handle.
+    NativeAdrenoAbiMetadata meta = {};
+    meta.handle = 1;
+    char text[NativeAdrenoAbiMetadataBytes] = {};
+    snprintf(text, sizeof text, "%.9s s%d e%x v%d/%d t%llx a%u/%u", process, step, error, verified, verifiedWc,
+             (unsigned long long)ticks, gpu.mailbox ? 0xffffu : gpu.admitted, gpu.selector);
+    meta.bytes = (uint32_t)strlen(text);
+    memcpy(meta.text, text, meta.bytes);
+    gpu.method(NativeAdrenoMethodSetMetadata, &meta, sizeof meta, nullptr, 0);
+}
+
+// Everything the Turnip backend does for a first submission, in the same order; returns the verified dword count or -1.
+int runTest(Gpu &gpu, uint32_t mapFlags, int &step, int &error) {
+    auto check = [&](int status) {
+        if (status && !error) error = status;
+        if (!status) ++step;
+        gpu.mark(status ? 0x4000 | (status & 0xfff) : 0x3000 | (mapFlags == 0x401 ? 0x100 : 0) | step);
+        return status == 0;
+    };
+    NativeAdrenoAbiParams params = {};
+    if (!check(gpu.method(NativeAdrenoMethodQuery, nullptr, 0, &params, sizeof params))) return -1;
+    NativeAdrenoAbiDeviceInfo info = {};
+    if (!check(gpu.method(NativeAdrenoMethodGetDeviceInfo, nullptr, 0, &info, sizeof info))) return -1;
+    NativeAdrenoAbiBoAlloc alloc = {4096, 12, 0};
+    NativeAdrenoAbiBoAllocReply ib = {}, target = {};
+    if (!check(gpu.method(NativeAdrenoMethodBoAlloc, &alloc, sizeof alloc, &ib, sizeof ib)) ||
+        !check(gpu.method(NativeAdrenoMethodBoAlloc, &alloc, sizeof alloc, &target, sizeof target))) return -1;
+    const uint64_t ibIova = info.va_start, tgtIova = info.va_start + 0x1000;
+    NativeAdrenoAbiBoMap mapIb = {ib.handle, ibIova, 1, 0, 2, 0}, mapTgt = {target.handle, tgtIova, 3, 0, 2, 0};
+    NativeAdrenoAbiBoMapReply mr = {};
+    if (!check(gpu.method(NativeAdrenoMethodBoMap, &mapIb, sizeof mapIb, &mr, sizeof mr)) ||
+        !check(gpu.method(NativeAdrenoMethodBoMap, &mapTgt, sizeof mapTgt, &mr, sizeof mr))) return -1;
+    NativeAdrenoAbiBoCpuMap cmIb = {ib.handle}, cmTgt = {target.handle};
+    NativeAdrenoAbiBoCpuMapReply crIb = {}, crTgt = {};
+    if (!check(gpu.method(NativeAdrenoMethodBoCpuMap, &cmIb, sizeof cmIb, &crIb, sizeof crIb)) ||
+        !check(gpu.method(NativeAdrenoMethodBoCpuMap, &cmTgt, sizeof cmTgt, &crTgt, sizeof crTgt))) return -1;
+    uint64_t ibAddr = 0, ibLen = 0, tgtAddr = 0, tgtLen = 0;
+    if (!check(gpu.map(gpu.conn, crIb.token, mach_task_self(), &ibAddr, &ibLen, mapFlags)) ||
+        !check(gpu.map(gpu.conn, crTgt.token, mach_task_self(), &tgtAddr, &tgtLen, mapFlags))) return -1;
+    if (ibLen < 4096 || tgtLen < 4096) {error = 0xbad1; return -1;}
+    volatile uint32_t *iw = reinterpret_cast<volatile uint32_t *>(ibAddr);
+    volatile uint32_t *tw = reinterpret_cast<volatile uint32_t *>(tgtAddr);
+    for (unsigned i = 0; i < 1024; ++i) tw[i] = 0xdeadbeef;
+    const uint32_t values[3] = {0x0adc0de1u, 0xfeed0002u, 0x600d0003u};
+    uint32_t words[12];
+    for (unsigned i = 0; i < 3; ++i) {
+        if (AdrenoPM4Type7(0x3d, 3, &words[i * 4]) != AdrenoPM4Success) {error = 0xbad2; return -1;}
+        words[i * 4 + 1] = uint32_t(tgtIova + i * 4);
+        words[i * 4 + 2] = uint32_t(tgtIova >> 32);
+        words[i * 4 + 3] = values[i];
+    }
+    for (unsigned i = 0; i < 12; ++i) iw[i] = words[i];
+    __asm__ volatile("dsb sy" ::: "memory");   // the mapping is non-cacheable and the GPU is an outer-shareable observer
+    NativeAdrenoAbiSubmit submit = {};
+    submit.buffer_count = 1;
+    submit.buffers[0] = {ib.handle, ibIova, sizeof words};
+    NativeAdrenoAbiSubmitReply sr = {};
+    if (!check(gpu.method(NativeAdrenoMethodSubmit, &submit, sizeof submit, &sr, sizeof sr))) return -1;
+    NativeAdrenoAbiWaitFence wait = {sr.fence, 200000000ull};
+    if (!check(gpu.method(NativeAdrenoMethodWaitFence, &wait, sizeof wait, nullptr, 0))) return -1;
+    __asm__ volatile("dsb sy" ::: "memory");
+    const int verified = (tw[0] == values[0]) + (tw[1] == values[1]) + (tw[2] == values[2]) + (tw[3] == 0xdeadbeef);
+    NativeAdrenoAbiTimestamp ts = {};
+    uint64_t ticks = 0;
+    if (check(gpu.method(NativeAdrenoMethodGetTimestamp, nullptr, 0, &ts, sizeof ts))) ticks = ts.ticks;
+    gpu.unmap(gpu.conn, crIb.token, mach_task_self(), ibAddr);
+    gpu.unmap(gpu.conn, crTgt.token, mach_task_self(), tgtAddr);
+    NativeAdrenoAbiBoCpuUnmap ui = {ib.handle, crIb.token, 0}, ut = {target.handle, crTgt.token, 0};
+    check(gpu.method(NativeAdrenoMethodBoCpuUnmap, &ui, sizeof ui, nullptr, 0));
+    check(gpu.method(NativeAdrenoMethodBoCpuUnmap, &ut, sizeof ut, nullptr, 0));
+    NativeAdrenoAbiBoFree fi = {ib.handle}, ft = {target.handle};
+    check(gpu.method(NativeAdrenoMethodBoFree, &fi, sizeof fi, nullptr, 0));
+    check(gpu.method(NativeAdrenoMethodBoFree, &ft, sizeof ft, nullptr, 0));
+    gpu.lastTicks = ticks;
+    return verified;
+}
+}
+
+// A report line as a marker stream (0x7fff, then 0x70cc per character): works while another connection holds the driver's single slot.
+// Two threads of one process may report (the published mode's status monitor and the scanout client): the driver keeps one text cursor, so a line
+// goes out whole.
+static pthread_mutex_t gStreamLock = PTHREAD_MUTEX_INITIALIZER;
+static void streamText(Gpu &gpu, const char *text) {
+    pthread_mutex_lock(&gStreamLock);
+    gpu.mark(0x7fff);
+    for (unsigned i = 0; i < 63 && text[i]; ++i) gpu.mark(0x7000 | (uint8_t)text[i]);
+    pthread_mutex_unlock(&gStreamLock);
+}
+
+// Line into report (GPU7) instead of report2 (GPU8).
+__attribute__((unused)) static void streamText7(Gpu &gpu, const char *text) {
+    pthread_mutex_lock(&gStreamLock);
+    gpu.mark(0x7ffe);
+    for (unsigned i = 0; i < 63 && text[i]; ++i) gpu.mark(0x7000 | (uint8_t)text[i]);
+    pthread_mutex_unlock(&gStreamLock);
+}
+
+// Remap probe (int-064): does the CP read the new pages after a GPU address is moved to other physical pages? int-063's W1 run (the
+// replay IB on fresh buffers at the same addresses) stopped both CP threads in the SQE's unknown-opcode trap, i.e. on wrong data. A
+// CP_MEM_TO_MEM from a remapped page into a result page reports what the CP sees instead of executing it, so no variant can stop the CP:
+//   v0 first mapping, v1 remap to a page allocated before the old one is freed (so the old page keeps its old pattern),
+//   v2 as v1 with a UCHE invalidate (CP_EVENT_WRITE7 0x31) and CP_WAIT_FOR_IDLE before the copy,
+//   v3 as v1 but remapped while the CP is busy spinning on a flag (CP_WAIT_REG_MEM), then released: GX stays up across the TLB invalidate.
+// Each result: '1' the new pattern, 'o' the previous mapping's pattern, 'z' zero, 'd' result not written, 'g' other, 'x' setup failed,
+// 't' fence timeout. Reported as "P<v0><v1><v2><v3>" in front of the replay line. The addresses (0x5f000000..) are never used elsewhere.
+struct ProbeBo {
+    uint64_t handle = 0, address = 0;
+    uint32_t token = 0;
+    volatile uint32_t *words = nullptr;
+};
+static int probeAlloc(Gpu &gpu, ProbeBo &b, uint32_t fill) {
+    NativeAdrenoAbiBoAlloc alloc = {4096, 12, 0};
+    NativeAdrenoAbiBoAllocReply reply = {};
+    if (int e = gpu.method(NativeAdrenoMethodBoAlloc, &alloc, sizeof alloc, &reply, sizeof reply)) return e;
+    b.handle = reply.handle;
+    NativeAdrenoAbiBoCpuMap cm = {b.handle};
+    NativeAdrenoAbiBoCpuMapReply cr = {};
+    if (int e = gpu.method(NativeAdrenoMethodBoCpuMap, &cm, sizeof cm, &cr, sizeof cr)) return e;
+    b.token = cr.token;
+    uint64_t length = 0;
+    if (int e = gpu.map(gpu.conn, cr.token, mach_task_self(), &b.address, &length, 0x101)) return e;
+    if (length < 4096) return 0xbad5;
+    b.words = reinterpret_cast<volatile uint32_t *>(b.address);
+    for (unsigned i = 0; i < 1024; ++i) b.words[i] = fill;
+    __asm__ volatile("dsb sy" ::: "memory");
+    return 0;
+}
+static int probeMap(Gpu &gpu, const ProbeBo &b, uint64_t iova) {
+    NativeAdrenoAbiBoMap map = {b.handle, iova, 3, 0, 2, 0};
+    NativeAdrenoAbiBoMapReply mr = {};
+    return gpu.method(NativeAdrenoMethodBoMap, &map, sizeof map, &mr, sizeof mr);
+}
+static void probeFree(Gpu &gpu, ProbeBo &b) {
+    if (!b.handle) return;
+    if (b.address) {
+        gpu.unmap(gpu.conn, b.token, mach_task_self(), b.address);
+        NativeAdrenoAbiBoCpuUnmap cu = {b.handle, b.token, 0};
+        gpu.method(NativeAdrenoMethodBoCpuUnmap, &cu, sizeof cu, nullptr, 0);
+    }
+    NativeAdrenoAbiBoFree f = {b.handle};
+    gpu.method(NativeAdrenoMethodBoFree, &f, sizeof f, nullptr, 0);
+    b = ProbeBo();
+}
+static char gProbe[6] = "P----";
+__attribute__((unused)) static void remapProbe(Gpu &gpu) {
+    constexpr uint64_t kSource = 0x5f000000ull, kResult = 0x5f010000ull, kIb = 0x5f020000ull, kFlag = 0x5f030000ull;
+    const uint32_t patterns[4] = {0x0a1a1a10u, 0x0b2b2b20u, 0x0c3c3c30u, 0x0d4d4d40u};
+    ProbeBo ib, result, flag, source;
+    bool stuck = false;
+    if (probeAlloc(gpu, ib, 0) || probeAlloc(gpu, result, 0xdeadbeef) || probeAlloc(gpu, flag, 0) ||
+        probeAlloc(gpu, source, patterns[0]) || probeMap(gpu, ib, kIb) || probeMap(gpu, result, kResult) ||
+        probeMap(gpu, flag, kFlag) || probeMap(gpu, source, kSource)) {
+        for (unsigned v = 1; v < 5; ++v) gProbe[v] = 'x';
+        probeFree(gpu, source); probeFree(gpu, flag); probeFree(gpu, result); probeFree(gpu, ib);
+        return;
+    }
+    for (unsigned v = 0; v < 4 && !stuck; ++v) {
+        gpu.mark(0x6d00 | v);
+        ProbeBo next;
+        if (v) {
+            // The new page exists before the old one is freed, so the two differ and the old one still holds the old pattern.
+            if (probeAlloc(gpu, next, patterns[v])) {gProbe[1 + v] = 'x'; probeFree(gpu, next); continue;}
+        }
+        uint32_t words[32], n = 0;
+        auto packet = [&](uint32_t opcode, std::initializer_list<uint32_t> payload) {
+            if (AdrenoPM4Type7(opcode, uint32_t(payload.size()), &words[n]) != AdrenoPM4Success) return false;
+            ++n;
+            for (uint32_t w : payload) words[n++] = w;
+            return true;
+        };
+        bool ok = true;
+        if (v == 3) ok = packet(0x3c, {3u | (1u << 4), uint32_t(kFlag), uint32_t(kFlag >> 32), 1u, 0xffffffffu, 16u});   // wait flag == 1
+        if (v == 2) ok = packet(0x46, {0x31u}) && packet(0x26, {});
+        ok = ok && packet(0x73, {0u, uint32_t(kResult), uint32_t(kResult >> 32), uint32_t(kSource), uint32_t(kSource >> 32)});
+        if (!ok) {gProbe[1 + v] = 'x'; probeFree(gpu, next); continue;}
+        for (uint32_t i = 0; i < n; ++i) ib.words[i] = words[i];
+        result.words[0] = 0xdeadbeef;
+        flag.words[0] = 0;
+        __asm__ volatile("dsb sy" ::: "memory");
+        if (v && v != 3) {
+            probeFree(gpu, source);
+            if (probeMap(gpu, next, kSource)) {gProbe[1 + v] = 'x'; probeFree(gpu, next); break;}
+            source = next;
+        }
+        NativeAdrenoAbiSubmit submit = {};
+        submit.buffer_count = 1;
+        submit.buffers[0] = {ib.handle, kIb, uint64_t(n) * 4};
+        NativeAdrenoAbiSubmitReply sr = {};
+        if (gpu.method(NativeAdrenoMethodSubmit, &submit, sizeof submit, &sr, sizeof sr)) {gProbe[1 + v] = 'x'; probeFree(gpu, next); continue;}
+        if (v == 3) {
+            usleep(20000);   // the CP is spinning on the flag
+            probeFree(gpu, source);
+            if (probeMap(gpu, next, kSource)) {gProbe[1 + v] = 'x'; probeFree(gpu, next); stuck = true; break;}
+            source = next;
+            flag.words[0] = 1;
+            __asm__ volatile("dsb sy" ::: "memory");
+        }
+        int waited = -1;
+        for (unsigned t = 0; t < 10 && waited; ++t) {
+            NativeAdrenoAbiWaitFence wait = {sr.fence, 200000000ull};
+            waited = gpu.method(NativeAdrenoMethodWaitFence, &wait, sizeof wait, nullptr, 0);
+        }
+        if (waited) {gProbe[1 + v] = 't'; stuck = true; break;}
+        const uint32_t got = result.words[0], want = patterns[v];
+        gProbe[1 + v] = got == want ? '1' : (v && got == patterns[v - 1]) ? 'o' : got == 0 ? 'z' : got == 0xdeadbeef ? 'd' : 'g';
+    }
+    // A stuck CP may still reference the buffers.
+    if (!stuck) {probeFree(gpu, source); probeFree(gpu, flag); probeFree(gpu, result); probeFree(gpu, ib);}
+}
+
+#ifdef NATIVE_TURNIP_REPLAY
+// Prefix replay of Turnip's first submission (recorded on the host by scripts/gen-turnip-replay.py with the tablet's 4 KiB page size, so
+// the GPU addresses are the ones Turnip itself uses on the tablet): its buffers are mapped at the recorded GPU addresses and growing
+// prefixes of its IB, cut after each TYPE7 packet, are submitted one by one, each waited for up to 2 s. Reported on GPU7 as
+// "B <retired>/<prefixes> t<thread variants retired> o<last opcode of the first stuck prefix> c<its dwords> e<error>", markers
+// 0x6b00 | thread variant, then 0x6a00 | prefix.
+struct Replay {
+    static constexpr unsigned kCount = sizeof turnipreplay::kBuffers / sizeof turnipreplay::kBuffers[0];
+    uint64_t handles[kCount] = {};
+    unsigned ibIndex = kCount;
+    bool hung = false;
+};
+// Allocates and maps every recorded buffer and fills it through a CPU mapping with the given flags: 0x101 (Device, aligned volatile
+// stores, as the prefix replay always did) or 0x401 (write combine filled with memcpy/memset, as Turnip fills its BOs).
+static int replayLoad(Gpu &gpu, Replay &r, uint32_t mapFlags) {
+    using namespace turnipreplay;
+    for (unsigned i = 0; i < Replay::kCount; ++i) {
+        const Buffer &b = kBuffers[i];
+        NativeAdrenoAbiBoAlloc alloc = {b.bytes, 12, 0};
+        NativeAdrenoAbiBoAllocReply reply = {};
+        if (int e = gpu.method(NativeAdrenoMethodBoAlloc, &alloc, sizeof alloc, &reply, sizeof reply)) return e;
+        r.handles[i] = reply.handle;
+        NativeAdrenoAbiBoMap map = {reply.handle, b.iova, 3, 0, 2, 0};
+        NativeAdrenoAbiBoMapReply mr = {};
+        if (int e = gpu.method(NativeAdrenoMethodBoMap, &map, sizeof map, &mr, sizeof mr)) return e;
+        NativeAdrenoAbiBoCpuMap cm = {reply.handle};
+        NativeAdrenoAbiBoCpuMapReply cr = {};
+        if (int e = gpu.method(NativeAdrenoMethodBoCpuMap, &cm, sizeof cm, &cr, sizeof cr)) return e;
+        uint64_t address = 0, length = 0;
+        if (int e = gpu.map(gpu.conn, cr.token, mach_task_self(), &address, &length, mapFlags)) return e;
+        if (length < b.bytes) return 0xbad3;
+        if (mapFlags == 0x401) {
+            memcpy(reinterpret_cast<void *>(address), b.data, b.words * 4);
+            memset(reinterpret_cast<uint8_t *>(address) + b.words * 4, 0, b.bytes - b.words * 4);
+        } else {
+            volatile uint32_t *w = reinterpret_cast<volatile uint32_t *>(address);
+            for (uint64_t k = 0; k < b.bytes / 4; ++k) w[k] = k < b.words ? b.data[k] : 0;
+        }
+        __asm__ volatile("dsb sy" ::: "memory");
+        gpu.unmap(gpu.conn, cr.token, mach_task_self(), address);
+        NativeAdrenoAbiBoCpuUnmap cu = {reply.handle, cr.token, 0};
+        gpu.method(NativeAdrenoMethodBoCpuUnmap, &cu, sizeof cu, nullptr, 0);
+        if (b.iova <= kIbIova && kIbIova < b.iova + b.bytes) r.ibIndex = i;
+    }
+    return r.ibIndex == Replay::kCount ? 0xbad4 : 0;
+}
+// Submits the first dwords of the IB and waits up to 2 s; a timeout leaves the buffers referenced by the stuck CP.
+static int replayRun(Gpu &gpu, Replay &r, uint32_t dwords) {
+    NativeAdrenoAbiSubmit submit = {};
+    submit.buffer_count = 1;
+    submit.buffers[0] = {r.handles[r.ibIndex], turnipreplay::kIbIova, uint64_t(dwords) * 4};
+    NativeAdrenoAbiSubmitReply sr = {};
+    if (int e = gpu.method(NativeAdrenoMethodSubmit, &submit, sizeof submit, &sr, sizeof sr)) return e;
+    int waited = -1;
+    for (unsigned t = 0; t < 10 && waited; ++t) {
+        NativeAdrenoAbiWaitFence wait = {sr.fence, 200000000ull};
+        waited = gpu.method(NativeAdrenoMethodWaitFence, &wait, sizeof wait, nullptr, 0);
+    }
+    if (waited) r.hung = true;
+    return waited;
+}
+// A stuck CP still references the buffers; they are only released when everything retired.
+static void replayFree(Gpu &gpu, Replay &r) {
+    if (r.hung) return;
+    for (uint64_t &h : r.handles)
+        if (h) {NativeAdrenoAbiBoFree f = {h}; gpu.method(NativeAdrenoMethodBoFree, &f, sizeof f, nullptr, 0); h = 0;}
+}
+// One whole-IB control run on fresh buffers at the same GPU addresses: '1' retired, '0' stuck, 'x' setup failed. Marker 0x6c00 | tag.
+static char replayControl(Gpu &gpu, uint32_t mapFlags, uint32_t tag, bool &hung) {
+    Replay r;
+    gpu.mark(0x6c00 | tag);
+    char result = 'x';
+    if (!replayLoad(gpu, r, mapFlags)) result = replayRun(gpu, r, turnipreplay::kCuts[sizeof turnipreplay::kCuts / sizeof turnipreplay::kCuts[0] - 1]) ? (r.hung ? '0' : 'x') : '1';
+    hung = r.hung;
+    replayFree(gpu, r);
+    return result;
+}
+static char gReplayControls[4] = "---";   // W1 W2 N, appended to the B line
+static char gReplayLine[64];
+// Whole-IB runs before any prefix (int-065). int-064's remap probe read the new pages in every variant (P1111), yet the whole IB on fresh
+// buffers after the prefix series stopped the CP again (W1). These runs separate "a fresh first run stops" (prefix runs had left GPU-written
+// memory behind) from "a second whole run stops": E<r1><r2><r3>, r1 the whole IB on fresh buffers before anything else, r2 the same
+// buffers again, r3 fresh buffers at the same addresses (W1's case); '1' retired, '0' stuck, 'x' setup failed, '-' not run. After r1
+// retires, "d" lists how many words of each buffer differ from the recording and "f" the first changed word outside the fill target, as
+// <buffer>@<word offset>=<value>, so the memory the GPU wrote is known.
+static char gEarly[48] = "E---";
+__attribute__((unused)) static bool earlyRuns(Gpu &gpu) {
+    using namespace turnipreplay;
+    const uint32_t whole = kCuts[sizeof kCuts / sizeof kCuts[0] - 1];
+    char diff[40] = "";
+    Replay r;
+    gpu.mark(0x6e01);
+    if (replayLoad(gpu, r, 0x101)) {gEarly[1] = 'x'; replayFree(gpu, r); return true;}
+    gEarly[1] = replayRun(gpu, r, whole) ? (r.hung ? '0' : 'x') : '1';
+    if (gEarly[1] == '1') {
+        unsigned counts[Replay::kCount] = {}, firstBuffer = 0, firstWord = 0;
+        uint32_t firstValue = 0;
+        bool found = false;
+        for (unsigned i = 0; i < Replay::kCount; ++i) {
+            const Buffer &b = kBuffers[i];
+            NativeAdrenoAbiBoCpuMap cm = {r.handles[i]};
+            NativeAdrenoAbiBoCpuMapReply cr = {};
+            if (gpu.method(NativeAdrenoMethodBoCpuMap, &cm, sizeof cm, &cr, sizeof cr)) continue;
+            uint64_t address = 0, length = 0;
+            if (!gpu.map(gpu.conn, cr.token, mach_task_self(), &address, &length, 0x101)) {
+                const volatile uint32_t *w = reinterpret_cast<const volatile uint32_t *>(address);
+                for (uint64_t k = 0; k < b.bytes / 4 && k < length / 4; ++k) {
+                    const uint32_t want = k < b.words ? b.data[k] : 0;
+                    if (w[k] == want) continue;
+                    ++counts[i];
+                    // The fill target is the recording's empty buffer; its change is expected.
+                    if (!found && b.words) {found = true; firstBuffer = i; firstWord = unsigned(k); firstValue = w[k];}
+                }
+                gpu.unmap(gpu.conn, cr.token, mach_task_self(), address);
+            }
+            NativeAdrenoAbiBoCpuUnmap cu = {r.handles[i], cr.token, 0};
+            gpu.method(NativeAdrenoMethodBoCpuUnmap, &cu, sizeof cu, nullptr, 0);
+        }
+        int at = snprintf(diff, sizeof diff, " d");
+        for (unsigned i = 0; i < Replay::kCount && at < int(sizeof diff); ++i)
+            at += snprintf(diff + at, sizeof diff - at, "%s%x", i ? "," : "", counts[i]);
+        if (found && at < int(sizeof diff)) snprintf(diff + at, sizeof diff - at, " f%u@%x=%x", firstBuffer, firstWord, firstValue);
+    }
+    if (gEarly[1] == '1') {gpu.mark(0x6e02); gEarly[2] = replayRun(gpu, r, whole) ? (r.hung ? '0' : 'x') : '1';}
+    const bool stuck = r.hung;
+    replayFree(gpu, r);
+    if (!stuck && gEarly[2] == '1') {
+        Replay fresh;
+        gpu.mark(0x6e03);
+        gEarly[3] = replayLoad(gpu, fresh, 0x101) ? 'x' : replayRun(gpu, fresh, whole) ? (fresh.hung ? '0' : 'x') : '1';
+        replayFree(gpu, fresh);
+        if (fresh.hung) gEarly[3] = '0';
+    }
+    snprintf(gEarly + 4, sizeof gEarly - 4, "%s", diff);
+    streamText7(gpu, gEarly);
+    return gEarly[1] == '1' && gEarly[2] == '1' && gEarly[3] == '1';
+}
+// Fresh-buffer prefix scan (int-066). int-065: the whole IB on fresh buffers, before any other replay, stopped the CP (E0--), while the
+// prefix series on one set of buffers retires every prefix. Here every prefix runs on freshly loaded buffers, so memory written by
+// earlier runs cannot help it; the first prefix that stops names the packet that needs that memory. When every prefix retires, CP state
+// left by the earlier runs is what helped, and the whole IB then runs once more on fresh buffers (e<result>). Reported on GPU7 as
+// "F <retired>/<prefixes> o<opcode ending the stuck prefix> c<its dwords> e<whole run: 1, 0 stuck, - not run>".
+static bool freshScan(Gpu &gpu) {
+    using namespace turnipreplay;
+    constexpr unsigned kPrefixes = sizeof kCuts / sizeof kCuts[0];
+    unsigned retired = 0;
+    bool stuck = false;
+    char whole = '-';
+    for (unsigned p = 0; p < kPrefixes && !stuck; ++p) {
+        Replay r;
+        gpu.mark(0x6f80 | p);
+        int e = replayLoad(gpu, r, 0x101);
+        if (!e) e = replayRun(gpu, r, kCuts[p]);
+        stuck = r.hung;
+        replayFree(gpu, r);
+        if (e) break;
+        ++retired;
+    }
+    if (retired == kPrefixes) {
+        Replay r;
+        gpu.mark(0x6fa0);
+        whole = replayLoad(gpu, r, 0x101) ? 'x' : replayRun(gpu, r, kCuts[kPrefixes - 1]) ? (r.hung ? '0' : 'x') : '1';
+        stuck = r.hung;
+        replayFree(gpu, r);
+    }
+    char text[64];
+    snprintf(text, sizeof text, "F %u/%u o%x c%u e%c", retired, kPrefixes, retired < kPrefixes ? kCutOps[retired] : 0,
+             retired < kPrefixes ? kCuts[retired] : 0, whole);
+    streamText7(gpu, text);
+    return !stuck && whole == '1';
+}
+static bool replayPhase(Gpu &gpu) {
+    using namespace turnipreplay;
+    constexpr unsigned kPrefixes = sizeof kCuts / sizeof kCuts[0];
+    Replay r;
+    unsigned retired = 0, variants = 0;
+    int error = replayLoad(gpu, r, 0x101);
+    // The first packet is CP_THREAD_CONTROL(BOTH) and int-060 stopped on it alone. Before the prefixes, the same two dwords run with
+    // BR only (1) and BV only (2), so a hang names the thread: t<variants retired>.
+    auto patch = [&](uint32_t value) {
+        const Buffer &b = kBuffers[r.ibIndex];
+        NativeAdrenoAbiBoCpuMap cm = {r.handles[r.ibIndex]};
+        NativeAdrenoAbiBoCpuMapReply cr = {};
+        if (int e = gpu.method(NativeAdrenoMethodBoCpuMap, &cm, sizeof cm, &cr, sizeof cr)) return e;
+        uint64_t address = 0, length = 0;
+        if (int e = gpu.map(gpu.conn, cr.token, mach_task_self(), &address, &length, 0x101)) return e;
+        reinterpret_cast<volatile uint32_t *>(address)[(kIbIova - b.iova) / 4 + 1] = value;
+        __asm__ volatile("dsb sy" ::: "memory");
+        gpu.unmap(gpu.conn, cr.token, mach_task_self(), address);
+        NativeAdrenoAbiBoCpuUnmap cu = {r.handles[r.ibIndex], cr.token, 0};
+        gpu.method(NativeAdrenoMethodBoCpuUnmap, &cu, sizeof cu, nullptr, 0);
+        return 0;
+    };
+    const uint32_t original = r.ibIndex < Replay::kCount ? kBuffers[r.ibIndex].data[(kIbIova - kBuffers[r.ibIndex].iova) / 4 + 1] : 0;
+    for (uint32_t thread = 1; thread <= 2 && !error; ++thread) {
+        gpu.mark(0x6b00 | thread);
+        if (!(error = patch(thread)) && !(error = replayRun(gpu, r, 2))) ++variants;
+    }
+    if (!error) error = patch(original);
+    for (unsigned p = 0; p < kPrefixes && !error; ++p) {
+        gpu.mark(0x6a00 | p);
+        if ((error = replayRun(gpu, r, kCuts[p]))) break;
+        ++retired;
+    }
+    replayFree(gpu, r);
+    // Turnip's own fill of this IB stopped in int-062 while this replay retired. The control runs separate the remaining differences, each
+    // on fresh buffers at the same addresses: W1 Device-mapped stores (address reuse after a free), W2 write-combine memcpy (how Turnip
+    // fills its BOs); the caller adds N, a second connection (a second context entry on a CP that already ran work).
+    bool stuck = r.hung;
+    if (retired == kPrefixes && !stuck) gReplayControls[0] = replayControl(gpu, 0x101, 1, stuck);
+    if (retired == kPrefixes && !stuck) gReplayControls[1] = replayControl(gpu, 0x401, 2, stuck);
+    snprintf(gReplayLine, sizeof gReplayLine, "%.4s B %u/%u t%u o%x c%u e%x ", gEarly, retired, kPrefixes, variants,
+             retired < kPrefixes ? kCutOps[retired] : 0, retired < kPrefixes ? kCuts[retired] : 0, unsigned(error));
+    char text[64];
+    snprintf(text, sizeof text, "%s%s", gReplayLine, gReplayControls);
+    streamText7(gpu, text);
+    return retired == kPrefixes && !stuck;
+}
+// N: the whole IB on a second connection, whose first submission carries the A7XX context entry again (Turnip's connection does that
+// after the replay). Returns false when the CP stopped.
+static bool replaySecondClient(Gpu &gpu) {
+    unsigned conn = 0;
+    if (gpu.openFn(gpu.port, mach_task_self(), 0x4147, &conn) != 0 || !conn) {gReplayControls[2] = 'o'; return true;}
+    const unsigned first = gpu.conn;
+    volatile uint32_t *mailbox = gpu.mailbox;
+    gpu.conn = conn;
+    gpu.mailbox = nullptr;
+    bool ok = !mailbox || gpu.openMailbox();
+    bool stuck = false;
+    gReplayControls[2] = ok ? replayControl(gpu, 0x101, 3, stuck) : 'm';
+    gpu.closeFn(conn);
+    gpu.conn = first;
+    gpu.mailbox = mailbox;
+    char text[64];
+    snprintf(text, sizeof text, "%s%s", gReplayLine, gReplayControls);
+    streamText7(gpu, text);
+    return !stuck;
+}
+#endif
+
+// Run after a passing Turnip phase by the plugin (the Metal bridge self-test); null in the probe daemon.
+static void (*gAfterTurnip)(Gpu &gpu, const char *turnipPath);
+
+// Turnip phase: only where libvulkan_freedreno.dylib sits next to this code (the plugin bundle), never in the probe daemon.
+static void turnipPhase(Gpu &gpu) {
+    char path[1024];
+    if (!turnip::libraryPath(path, sizeof path) || access(path, R_OK) != 0) return;
+    gpu.mark(0x6000);
+    auto marker = [&](uint32_t value) { gpu.mark(value); };
+    const turnip::Result result = turnip::runWatched(marker, [&](const char *text) { streamText(gpu, text); }, path);
+    char text[NativeAdrenoAbiMetadataBytes] = {};
+    snprintf(text, sizeof text, "T s%d r%d v%d c%d%s g%d/%d%s %.30s", result.stage, result.vkResult, result.verified, result.computeWords,
+             result.computeStage ? "!" : "", result.renderTriangle, result.renderOther, result.renderStage ? "!" : "", turnip::gFirstError);
+    streamText(gpu, text);
+    gpu.mark(result.ok ? 0x6fff : 0x6ffe);
+    // Also when results are wrong but every Vulkan step ran: one boot then shows both layers.
+    if (result.stage == 0 && result.vkResult == 0 && gAfterTurnip) gAfterTurnip(gpu, path);
+}
+
+// Returns the GPU-verified dword count of the uncached run, or a negative number; every outcome is also reported to the kernel.
+static int adrenoUserTest(unsigned port, const char *process) {
+    void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_NOW | RTLD_LOCAL);
+    if (!iokit) return -1;
+    auto open = (IOServiceOpenFn)dlsym(iokit, "IOServiceOpen");
+    auto close = (IOServiceCloseFn)dlsym(iokit, "IOServiceClose");
+    Gpu gpu;
+    gpu.call = (CallFn)dlsym(iokit, "IOConnectCallStructMethod");
+    gpu.map = (MapFn)dlsym(iokit, "IOConnectMapMemory64");
+    gpu.unmap = (UnmapFn)dlsym(iokit, "IOConnectUnmapMemory64");
+    gpu.port = port;
+    gpu.openFn = open;
+    gpu.closeFn = close;
+    gpu.mark(1);
+    if (!open || !close || !gpu.call || !gpu.map || !gpu.unmap) return -1;
+    gpu.mark(2);
+    // 0x4147 ('AG') is the open type the driver serves; the original IOGPU library's type-1 opens are refused.
+    const int openResult = open(port, mach_task_self(), 0x4147, &gpu.conn);
+    if (openResult != 0 || !gpu.conn) {
+        // The exact kern_return_t, as two markers (high and low half), after the failure marker.
+        gpu.mark(0x4f01);
+        gpu.mark(((uint32_t)openResult >> 16) & 0xffff ? ((uint32_t)openResult >> 16) & 0xffff : 0xffff);
+        gpu.mark((uint32_t)openResult & 0xffff ? (uint32_t)openResult & 0xffff : 0xffff);
+        return -1;
+    }
+    gpu.mark(3);
+    const bool probed = gpu.probe();
+    gpu.mark(0x1000 | (gpu.admitted & 0xfff));
+    bool mailboxOk = false;
+    if (!probed) {mailboxOk = gpu.openMailbox(); gpu.mark(mailboxOk ? 0x2001 : 0x2000);}
+    if (!probed && !mailboxOk) {close(gpu.conn); return -2;}   // neither channel works: the driver's E row shows what reached it
+    // mapFlags are what the CLIENT asks for: IOUserClient::mapClientMemory64 lets them override the cache mode the driver returns, so
+    // the cache bits must be set here. 0x101 = anywhere + inhibit cache (aligned dword accesses only), 0x401 = anywhere + write
+    // combine (Normal non-cacheable; what a Vulkan driver needs, since it uses memcpy and unaligned stores).
+    int step = 0, error = 0;
+    const int verified = runTest(gpu, 0x101, step, error);
+    int stepWc = 0, errorWc = 0;
+    const int verifiedWc = error ? -2 : runTest(gpu, 0x401, stepWc, errorWc);
+    report(gpu, process, step + stepWc, error ? error : errorWc, verified, verifiedWc, gpu.lastTicks);
+    gpu.mark(0x5000 | (verified & 0xff));
+    bool replayed = true;
+#ifdef NATIVE_TURNIP_REPLAY
+    // Plugin only (the Turnip library sits next to it): a stuck replay leaves the CP stopped, so Turnip is not started after it.
+    char turnipPath[1024];
+    if (verified == 4 && verifiedWc == 4 && turnip::libraryPath(turnipPath, sizeof turnipPath) && access(turnipPath, R_OK) == 0) {
+        replayed = freshScan(gpu) && replayPhase(gpu);
+    }
+#endif
+    close(gpu.conn);
+#ifdef NATIVE_TURNIP_REPLAY
+    if (replayed && verified == 4 && verifiedWc == 4) replayed = replaySecondClient(gpu);
+#endif
+    if (verified == 4 && verifiedWc == 4 && replayed) turnipPhase(gpu);
+    return verified;
+}
diff --git a/iokit/NativeAdreno/NativeMetal/NativeBridgeMetalFrontend.h b/iokit/NativeAdreno/NativeMetal/NativeBridgeMetalFrontend.h
new file mode 100644
index 0000000..5c0c7ca
--- /dev/null
+++ b/iokit/NativeAdreno/NativeMetal/NativeBridgeMetalFrontend.h
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: MIT
+// Entry points of the native Metal frontend over the bridge (NativeBridgeMetalFrontend.mm).
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __OBJC__
+#import <Foundation/Foundation.h>
+extern "C" {
+// Opens the process's one device: loader exports vkGetInstanceProcAddr (Turnip), cache is a writable shader-cache directory, registryID is the
+// accelerator service's registry entry. missing (may be null) is told the class and selector of every unimplemented call.
+id native_bridge_metal_open(const char *loader, const char *cache, uint64_t registryID, void (*missing)(const char *, const char *));
+// Bare AIR bitcode as a library (the bridge's fixtures; Metal itself accepts only metallibs).
+id native_bridge_metal_library_with_air(const void *bytes, size_t length);
+// One line for the plugin's status report: command buffers committed/failed locally, pipelines made, refusals, the last refusal's text.
+size_t native_bridge_metal_status(char *out, size_t size);
+// The pixel formats of the textures asked for (first eight distinct) and how many texture requests the runtime refused.
+size_t native_bridge_metal_formats(char *out, size_t size);
+size_t native_bridge_metal_telemetry(char *out, size_t size);
+// Structured cumulative artifact/driver-cache counters for offline qualification.
+struct NmbShaderCacheStats;
+bool native_bridge_metal_shader_cache_stats(struct NmbShaderCacheStats *out);
+bool native_bridge_metal_work_stats(uint64_t out[10]);
+// The same fixed CPU, memory and pipeline workload on the tablet and the host, so their times compare directly (int-145): compute, first-touch
+// page faults, memset bandwidth, CommonCrypto SHA-256, then the first `pairs` vertex/fragment pairs of the given QuartzCore metallib made into
+// BGRA8 render states and drawn once each (pipeline_timing_host's draw=1 order). The results become the telemetry's Y rows; also returned.
+size_t native_bridge_metal_benchmark(id device, const char *metallib, unsigned pairs, char *out, size_t size);
+}
+#endif
diff --git a/iokit/NativeAdreno/NativeMetal/NativeMetalBridgePhase.h b/iokit/NativeAdreno/NativeMetal/NativeMetalBridgePhase.h
new file mode 100644
index 0000000..1f7ce14
--- /dev/null
+++ b/iokit/NativeAdreno/NativeMetal/NativeMetalBridgePhase.h
@@ -0,0 +1,199 @@
+// SPDX-License-Identifier: MIT
+// Plugin-only phase after Turnip: the Metal bridge self-test (bridge/NativeMetalBridge.rs) on the same Turnip, on an 8 MiB worker under a
+// watchdog. Markers 0x6501..0x650f come from the bridge itself; the result line goes to GPU7 ("M ..."), a stuck worker is reported there
+// as "MW <last marker> <seconds>".
+// After a passing self-test the worker runs the frontend checks (bridge/FrontendChecks.h) through the public Metal API on the native frontend
+// (NativeBridgeMetalFrontend.mm) over the same Turnip: markers 0x6600 (device), 0x6601..0x660f, then 0x66f0 pass / 0x66f1 fail. Its verdict
+// ends the same GPU7 line: "F0" (with the first unimplemented selector, if any), "F<failed> <marker> <first failure>", "Fo"/"Fx" + reason
+// when the device or the fixtures were refused.
+#pragma once
+#include "bridge/NativeMetalBridge.h"
+#include "bridge/NativeMetalObjects.h"
+#include "bridge/FrontendChecks.h"
+#include "NativeBridgeMetalFrontend.h"
+#include "GpuScanoutClient.h"
+#include <fcntl.h>
+#include <pthread.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace bridgephase {
+struct Job {
+    const char *turnip;
+    char cache[512];
+    NmbSelftest result;
+    uint32_t code;
+    frontendchecks::Report frontend;
+    bool frontendRan, frontendOpened;
+    char missing[64], error[48];
+    volatile uint32_t last;
+    volatile bool done;
+};
+static Gpu *gGpu;
+static Job *gJob;
+static id gDevice;   // the frontend device of the checks, kept for the scanout stage
+static void mark(uint32_t value) {
+    if (gJob) gJob->last = value;
+    if (gGpu) gGpu->mark(value);
+}
+static void missingSelector(const char *cls, const char *selector) {
+    if (gJob && !gJob->missing[0]) snprintf(gJob->missing, sizeof gJob->missing, "FM %.20s %.36s", cls, selector);
+}
+// The frontend checks on the native frontend over Turnip (QuartzCore is already translated by the self-test, so it is not repeated).
+static void frontend(Job *job) {
+    mark(0x6600);
+    id device = native_bridge_metal_open(job->turnip, job->cache, 0, missingSelector);
+    // The runtime's reasons are per thread: keep this worker's for the report.
+    if (!device) {strlcpy(job->error, nmb_last_error(), sizeof job->error); return;}
+    job->frontendOpened = true;
+    gDevice = device;
+    size_t bytes = 0;
+    const void *air = nmb_fixture_air(&bytes);
+    id library = native_bridge_metal_library_with_air(air, bytes);
+    air = nmb_function_constant_air(&bytes);
+    id fcLibrary = native_bridge_metal_library_with_air(air, bytes);
+    if (!library || !fcLibrary) {strlcpy(job->error, nmb_last_error(), sizeof job->error); return;}
+    job->frontend.mark = mark;
+    job->frontendRan = true;
+    // An exception escaping a worker thread aborts the whole host process (SpringBoard died that way, int-075/083): report it as a failed check.
+    @try {
+        frontendchecks::run(device, library, fcLibrary, nil, &job->frontend);
+    } @catch (NSException *exception) {
+        ++job->frontend.failed;
+        snprintf(job->frontend.first, sizeof job->frontend.first, "exception %.40s", exception.name.UTF8String ?: "?");
+    }
+}
+static void *worker(void *arg) {
+    Job *job = static_cast<Job *>(arg);
+    // The target's own compositor library, read in place (never copied anywhere).
+    const uint8_t *qc = nullptr;
+    size_t qcBytes = 0;
+    const int fd = open("/System/Library/Frameworks/QuartzCore.framework/default.metallib", O_RDONLY);
+    struct stat st = {};
+    if (fd >= 0 && fstat(fd, &st) == 0 && st.st_size > 0) {
+        void *m = mmap(nullptr, (size_t)st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);
+        if (m != MAP_FAILED) {qc = static_cast<const uint8_t *>(m); qcBytes = (size_t)st.st_size;}
+    }
+    if (fd >= 0) close(fd);
+    job->code = nmb_selftest(job->turnip, job->cache, qc, qcBytes, mark, &job->result);
+    if (qc) munmap(const_cast<uint8_t *>(qc), qcBytes);
+    if (!job->code) frontend(job);
+    __atomic_store_n(&job->done, true, __ATOMIC_RELEASE);
+    return nullptr;
+}
+// Serves the display driver's frames with the GPU on `device` (the kernel offers them only with sheng-fb-gpu=1). The calls go through a hand-off-only
+// connection to the accelerator (open type 0x4148: no GPU slot is taken): the original sandbox profiles admit that class and not the presenter's own
+// service. Reports on GPU7 only when the state changes: "P<step> e<hex>" (0 no connection, 1 no selector, 2 mode refused, 3 scanout not
+// mappable/importable, 4 serving), then "PF <frames>/<failures> r<last result> v<verified>/<differing rows> t<ms>" at the first frame, every fifth after
+// and the first failure, "PX ..." when serving stops. Returns when serving stops.
+struct ScanoutContext {
+    Gpu link;
+    Gpu *marker;
+};
+static void serveScanout(Gpu &gpu, id device) {
+    // This thread carries every frame to the screen; at the default priority it waited behind the launching apps' threads.
+    pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+    ScanoutContext context;
+    context.marker = &gpu;
+    Gpu &link = context.link;
+    link.call = gpu.call; link.map = gpu.map; link.unmap = gpu.unmap; link.openFn = gpu.openFn; link.closeFn = gpu.closeFn; link.port = gpu.port;
+    gpuscanout::Stats st = {};
+    char line[64];
+    gpu.mark(0x6700);
+    const int openResult = link.openFn ? link.openFn(link.port, mach_task_self(), 0x4148, &link.conn) : -1;
+    if (openResult != 0 || !link.conn) {
+        snprintf(line, sizeof line, "P0 e%x", (unsigned)openResult);
+    } else if (gpu.mark(0x6701), !link.probe()) {
+        snprintf(line, sizeof line, "P1");
+    } else {
+        gpu.mark(0x6702);
+        gpuscanout::Transport transport = {&context,
+            [](void *c, uint32_t method, const void *in, size_t is, void *out, size_t os) -> int {
+                return static_cast<ScanoutContext *>(c)->link.method(0x7000 + method, in, is, out, os);
+            },
+            [](void *c, uint64_t *address, uint64_t *length) -> int {
+                Gpu &g = static_cast<ScanoutContext *>(c)->link;
+                return g.map(g.conn, 0x5343, mach_task_self(), address, length, 0x101);   // anywhere + inhibit cache
+            },
+            [](void *c, uint32_t value) {static_cast<ScanoutContext *>(c)->marker->mark(value);}};
+        gpuscanout::Client client;
+        const bool opened = client.open((id<MTLDevice>)device, transport, &st);
+        snprintf(line, sizeof line, "P%d e%x", st.step, (unsigned)st.error);
+        streamText7(gpu, line);
+        if (opened) {
+            uint64_t reportedFrames = 0, reportedFailures = 0;
+            while (client.serveOne(500)) {
+                const bool frame = st.frames && (st.frames == 1 || st.frames - reportedFrames >= 5);
+                if (frame || (st.failures && !reportedFailures)) {
+                    reportedFrames = st.frames ? st.frames : reportedFrames;
+                    reportedFailures = st.failures ? st.failures : reportedFailures;
+                    const uint64_t served = st.frames + st.failures;
+                    snprintf(line, sizeof line, "PF %llu/%llu r%d v%llu/%llu t%u a%llu", (unsigned long long)st.frames, (unsigned long long)st.failures,
+                             st.lastResult, (unsigned long long)st.verified, (unsigned long long)st.mismatchRows, st.lastMs,
+                             (unsigned long long)(served ? st.totalMs / served : 0));
+                    streamText7(gpu, line);
+                }
+            }
+            snprintf(line, sizeof line, "PX %llu/%llu r%d e%x", (unsigned long long)st.frames, (unsigned long long)st.failures, st.lastResult,
+                     (unsigned)st.error);
+        }
+    }
+    streamText7(gpu, line);
+}
+static void run(Gpu &gpu, const char *turnipPath) {
+    gpu.mark(0x6500);
+    Job *job = new Job{};
+    job->turnip = turnipPath;
+    // A per-user cache directory of the host process (its sandbox allows it); the translated-shader cache goes in a subdirectory.
+    if (!confstr(_CS_DARWIN_USER_CACHE_DIR, job->cache, sizeof job->cache - 16)) strlcpy(job->cache, "/tmp/", sizeof job->cache);
+    strlcat(job->cache, "m2v", sizeof job->cache);
+    mkdir(job->cache, 0700);
+    gGpu = &gpu;
+    gJob = job;
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, 8u << 20);
+    pthread_t thread;
+    const bool started = pthread_create(&thread, &attr, worker, job) == 0;
+    pthread_attr_destroy(&attr);
+    if (!started) {gpu.mark(0x65fd); return;}
+    static const unsigned checkpoints[] = {30, 90, 180};
+    unsigned next = 0;
+    for (unsigned tenths = 0; !__atomic_load_n(&job->done, __ATOMIC_ACQUIRE); ++tenths) {
+        usleep(100000);
+        if (next < 3 && tenths == checkpoints[next] * 10) {
+            char text[64];
+            snprintf(text, sizeof text, "MW %x %us", job->last, checkpoints[next]);
+            streamText7(gpu, text);
+            ++next;
+        }
+    }
+    pthread_join(thread, nullptr);
+    const NmbSelftest &r = job->result;
+    // One GPU7 line (the page keeps only the latest): the self-test's counts, then after a passing self-test the frontend's verdict.
+    char text[64];
+    const int at = snprintf(text, sizeof text, "M s%x c%u r%u i%u q%u k%u/%u p%u/%u", r.stage, r.compute_bad, r.render_bad, r.import_bad,
+                            r.qc_functions, r.qc_kernels_ok, r.qc_kernels_failed, r.qc_pairs_ok, r.qc_pairs_failed);
+    char *rest = text + (at > 0 && at < (int)sizeof text ? at : 0);
+    const size_t room = sizeof text - (size_t)(rest - text);
+    if (job->code) snprintf(rest, room, " %s", r.message);
+    else if (!job->frontendOpened) snprintf(rest, room, " Fo %s", job->error);
+    else if (!job->frontendRan) snprintf(rest, room, " Fx %s", job->error);
+    else if (job->frontend.failed) snprintf(rest, room, " F%u %s", job->frontend.failed, job->frontend.first);
+    else snprintf(rest, room, " F0%s%s", job->missing[0] ? " " : "", job->missing[0] ? job->missing + 3 : "");
+    streamText7(gpu, text);
+    const bool ok = !job->code && !r.compute_bad && !r.render_bad && !r.import_bad;
+    gpu.mark(ok ? 0x65f0 : 0x65f1);
+    if (!job->code) gpu.mark(job->frontendRan && !job->frontend.failed ? 0x66f0 : 0x66f1);
+    const bool scanout = ok && job->frontendRan && !job->frontend.failed && gDevice;
+    gJob = nullptr;
+    delete job;
+    // After the checks' verdict has been on the page for a while: serve the display driver's frames with the GPU.
+    if (scanout) {
+        sleep(8);
+        serveScanout(gpu, gDevice);
+    }
+    gGpu = nullptr;
+}
+}  // namespace bridgephase
diff --git a/iokit/NativeAdreno/NativeMetal/NativeTurnipSmoke.h b/iokit/NativeAdreno/NativeMetal/NativeTurnipSmoke.h
new file mode 100644
index 0000000..8450ee7
--- /dev/null
+++ b/iokit/NativeAdreno/NativeMetal/NativeTurnipSmoke.h
@@ -0,0 +1,653 @@
+// SPDX-License-Identifier: MIT
+// Turnip smoke test, run by the Adreno Metal plugin from inside the system process that loaded it (under that process's sandbox) once the raw
+// userspace test (NativeAdrenoUserTest.h) has passed. It loads the real Mesa Turnip driver (libvulkan_freedreno.dylib, built with the native
+// Darwin kernel backend and shipped next to the plugin binary) and drives it through the Vulkan ICD entry points without a loader:
+// instance, physical device, device, queue, a host-visible buffer, one vkCmdFillBuffer, a fence, and a read-back of the fill pattern.
+// Every stage leaves a progress marker (IOServiceOpen type 0x4147<value>, see NativeAdrenoUserTest.h): 6001 library loaded, 6002 entry points,
+// 6003 instance, 6004 physical device, 6005 device, 6007 buffer memory mapped, 6006 command buffer recorded, 6008 submitted, 6009 fence
+// signalled, 600a fill pattern verified; then the shader tests: 6100 compute begins, 6101 pipeline, 6102 recorded, 6103 fence, 6104 all words
+// right (61fS = compute step S failed); 6200 render begins, 6201 pipeline, 6202 recorded, 6203 fence, 6204 image right (62fS = render step S
+// failed); 600b everything destroyed. A setup failure leaves 6fSS (stage SS) followed by 6eRR (RR = -VkResult).
+// The outcome is a short text for the kernel's report row:
+// "T s<stage> r<VkResult> v<fill words> c<compute words> g<triangle pixels>/<stray pixels> <first Vulkan error message>".
+#pragma once
+#define VK_NO_PROTOTYPES 1
+#include <vulkan/vulkan_core.h>
+#include "NativeTurnipShaders.h"   // generated: scripts/gen-turnip-smoke-shaders.py
+#include <dlfcn.h>
+#include <mach/mach.h>
+#include <mach-o/dyld.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+// Vulkan create-info structs are written as {sType} with every other member zero.
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wmissing-field-initializers"
+namespace turnip {
+
+static char gFirstError[96];
+
+static VKAPI_ATTR VkBool32 VKAPI_CALL onMessage(VkDebugUtilsMessageSeverityFlagBitsEXT severity, VkDebugUtilsMessageTypeFlagsEXT,
+                                                const VkDebugUtilsMessengerCallbackDataEXT *data, void *) {
+    if ((severity & VK_DEBUG_UTILS_MESSAGE_SEVERITY_ERROR_BIT_EXT) && !gFirstError[0] && data && data->pMessage)
+        snprintf(gFirstError, sizeof gFirstError, "%s", data->pMessage);
+    return VK_FALSE;
+}
+
+struct Result {
+    int stage = 0;          // first setup failure (0 = none): 1 library .. 9 fence wait
+    int vkResult = 0;
+    int verified = -1;      // fill test: words of 1024 that hold the expected value (-1 = not run)
+    int computeWords = -1;  // compute test: words of 1024 written by the shader with the expected value (-1 = not run)
+    int computeStage = 0;   // first failing step of the compute test (0 = none)
+    int renderTriangle = -1, renderOther = -1;  // render test: triangle-colour pixels, pixels that are neither colour (-1 = not run)
+    int renderStage = 0;
+    bool ok = false;
+};
+
+// Device-level entry points the tests use, resolved once through vkGetDeviceProcAddr.
+#define TURNIP_DEVICE_FNS(X) \
+    X(vkDestroyDevice) X(vkGetDeviceQueue) X(vkCreateCommandPool) X(vkDestroyCommandPool) X(vkAllocateCommandBuffers) \
+    X(vkResetCommandBuffer) X(vkBeginCommandBuffer) X(vkEndCommandBuffer) X(vkCmdFillBuffer) X(vkCreateBuffer) X(vkDestroyBuffer) \
+    X(vkGetBufferMemoryRequirements) X(vkAllocateMemory) X(vkFreeMemory) X(vkBindBufferMemory) X(vkMapMemory) X(vkUnmapMemory) \
+    X(vkCreateFence) X(vkDestroyFence) X(vkQueueSubmit) X(vkWaitForFences) X(vkDeviceWaitIdle) X(vkCreateShaderModule) \
+    X(vkDestroyShaderModule) X(vkCreateDescriptorSetLayout) X(vkDestroyDescriptorSetLayout) X(vkCreatePipelineLayout) \
+    X(vkDestroyPipelineLayout) X(vkCreateComputePipelines) X(vkCreateGraphicsPipelines) X(vkDestroyPipeline) \
+    X(vkCreateDescriptorPool) X(vkDestroyDescriptorPool) X(vkAllocateDescriptorSets) X(vkUpdateDescriptorSets) \
+    X(vkCmdBindPipeline) X(vkCmdBindDescriptorSets) X(vkCmdPushConstants) X(vkCmdDispatch) X(vkCmdPipelineBarrier) \
+    X(vkCreateImage) X(vkDestroyImage) X(vkGetImageMemoryRequirements) X(vkBindImageMemory) X(vkCreateImageView) \
+    X(vkDestroyImageView) X(vkCreateRenderPass) X(vkDestroyRenderPass) X(vkCreateFramebuffer) X(vkDestroyFramebuffer) \
+    X(vkCmdBeginRenderPass) X(vkCmdEndRenderPass) X(vkCmdDraw) X(vkCmdCopyImageToBuffer)
+
+struct Device {
+    VkDevice device = nullptr;
+    VkQueue queue = nullptr;
+    VkCommandPool pool = nullptr;
+    VkCommandBuffer cmd = nullptr;
+    VkPhysicalDeviceMemoryProperties memory = {};
+#define TURNIP_DECLARE(name) PFN_##name name = nullptr;
+    TURNIP_DEVICE_FNS(TURNIP_DECLARE)
+#undef TURNIP_DECLARE
+
+    uint32_t memoryType(uint32_t bits, VkMemoryPropertyFlags flags) const {
+        for (uint32_t i = 0; i < memory.memoryTypeCount; ++i)
+            if ((bits & (1u << i)) && (memory.memoryTypes[i].propertyFlags & flags) == flags) return i;
+        return UINT32_MAX;
+    }
+    // Records into the one command buffer, submits it with a fresh fence and waits up to five seconds.
+    VkResult submitAndWait() {
+        VkFenceCreateInfo fci = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+        VkFence fence = nullptr;
+        VkResult r = vkCreateFence(device, &fci, nullptr, &fence);
+        if (r != VK_SUCCESS) return r;
+        VkSubmitInfo si = {VK_STRUCTURE_TYPE_SUBMIT_INFO};
+        si.commandBufferCount = 1;
+        si.pCommandBuffers = &cmd;
+        r = vkQueueSubmit(queue, 1, &si, fence);
+        if (r == VK_SUCCESS) r = vkWaitForFences(device, 1, &fence, VK_TRUE, 5000000000ull);
+        vkDestroyFence(device, fence, nullptr);
+        return r;
+    }
+    VkResult begin() {
+        vkResetCommandBuffer(cmd, 0);
+        VkCommandBufferBeginInfo bi = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+        bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+        return vkBeginCommandBuffer(cmd, &bi);
+    }
+};
+
+// A host-visible buffer with its memory, mapped for the CPU.
+struct HostBuffer {
+    VkBuffer buffer = nullptr;
+    VkDeviceMemory memory = nullptr;
+    volatile uint32_t *words = nullptr;
+    VkResult create(Device &d, VkDeviceSize bytes, VkBufferUsageFlags usage) {
+        VkBufferCreateInfo bci = {VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+        bci.size = bytes;
+        bci.usage = usage;
+        bci.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        VkResult r = d.vkCreateBuffer(d.device, &bci, nullptr, &buffer);
+        if (r != VK_SUCCESS) return r;
+        VkMemoryRequirements req = {};
+        d.vkGetBufferMemoryRequirements(d.device, buffer, &req);
+        const uint32_t type = d.memoryType(req.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+        if (type == UINT32_MAX) return VK_ERROR_FEATURE_NOT_PRESENT;
+        VkMemoryAllocateInfo mai = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        mai.allocationSize = req.size;
+        mai.memoryTypeIndex = type;
+        r = d.vkAllocateMemory(d.device, &mai, nullptr, &memory);
+        if (r == VK_SUCCESS) r = d.vkBindBufferMemory(d.device, buffer, memory, 0);
+        void *mapped = nullptr;
+        if (r == VK_SUCCESS) r = d.vkMapMemory(d.device, memory, 0, bytes, 0, &mapped);
+        words = static_cast<volatile uint32_t *>(mapped);
+        return r != VK_SUCCESS ? r : (words ? VK_SUCCESS : VK_ERROR_MEMORY_MAP_FAILED);
+    }
+    void destroy(Device &d) {
+        if (words) d.vkUnmapMemory(d.device, memory);
+        if (buffer) d.vkDestroyBuffer(d.device, buffer, nullptr);
+        if (memory) d.vkFreeMemory(d.device, memory, nullptr);
+        *this = HostBuffer();
+    }
+};
+
+static VkShaderModule shaderModule(Device &d, const uint32_t *words, size_t bytes) {
+    VkShaderModuleCreateInfo ci = {VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+    ci.codeSize = bytes;
+    ci.pCode = words;
+    VkShaderModule module = nullptr;
+    return d.vkCreateShaderModule(d.device, &ci, nullptr, &module) == VK_SUCCESS ? module : nullptr;
+}
+
+static void hostBarrier(Device &d, VkPipelineStageFlags from, VkAccessFlags access) {
+    VkMemoryBarrier barrier = {VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+    barrier.srcAccessMask = access;
+    barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+    d.vkCmdPipelineBarrier(d.cmd, from, VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+}
+
+// Fill: vkCmdFillBuffer of the first half of a 4 KiB buffer (Turnip implements it with its own internal blit). Returns verified words or < 0.
+template <typename Marker>
+static int fillTest(Device &d, Marker &mark, int &failStage, VkResult &failResult) {
+    constexpr VkDeviceSize kBytes = 4096;
+    constexpr uint32_t kPattern = 0xc0ffee42u;
+    HostBuffer b;
+    VkResult r = b.create(d, kBytes, VK_BUFFER_USAGE_TRANSFER_DST_BIT);
+    if (r != VK_SUCCESS) {b.destroy(d); failStage = 7; failResult = r; return -1;}
+    for (unsigned i = 0; i < kBytes / 4; ++i) b.words[i] = 0xdeadbeef;
+    mark(0x6007);
+    if ((r = d.begin()) != VK_SUCCESS) {b.destroy(d); failStage = 6; failResult = r; return -1;}
+    d.vkCmdFillBuffer(d.cmd, b.buffer, 0, kBytes / 2, kPattern);   // the first half only: the second half must keep 0xdeadbeef
+    hostBarrier(d, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT);
+    if ((r = d.vkEndCommandBuffer(d.cmd)) != VK_SUCCESS) {b.destroy(d); failStage = 6; failResult = r; return -1;}
+    mark(0x6006);
+    mark(0x6008);
+    if ((r = d.submitAndWait()) != VK_SUCCESS) {b.destroy(d); failStage = 9; failResult = r; return -1;}
+    mark(0x6009);
+    int good = 0;
+    for (unsigned i = 0; i < kBytes / 8; ++i) good += b.words[i] == kPattern;
+    for (unsigned i = kBytes / 8; i < kBytes / 4; ++i) good += b.words[i] == 0xdeadbeefu;
+    if (good == int(kBytes / 4)) mark(0x600a);
+    b.destroy(d);
+    return good;
+}
+
+// Compute: 16 workgroups of 64 invocations each write v[i] = i * 3 + 0x1000 (push constants) into a storage buffer.
+template <typename Marker>
+static int computeTest(Device &d, Marker &mark, int &stage) {
+    constexpr uint32_t kWords = 1024, kMul = 3, kAdd = 0x1000;
+    mark(0x6100);
+    HostBuffer b;
+    VkShaderModule module = nullptr;
+    VkDescriptorSetLayout setLayout = nullptr;
+    VkPipelineLayout layout = nullptr;
+    VkPipeline pipeline = nullptr;
+    VkDescriptorPool pool = nullptr;
+    int result = -1;
+    auto fail = [&](int s) {stage = s; mark(0x61f0 | s);};
+    do {
+        if (b.create(d, kWords * 4, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT) != VK_SUCCESS) {fail(1); break;}
+        for (uint32_t i = 0; i < kWords; ++i) b.words[i] = 0xdeadbeef;
+        if (!(module = shaderModule(d, kSpv_smoke_fill_comp, sizeof kSpv_smoke_fill_comp))) {fail(2); break;}
+        VkDescriptorSetLayoutBinding binding = {0, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr};
+        VkDescriptorSetLayoutCreateInfo dsl = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+        dsl.bindingCount = 1;
+        dsl.pBindings = &binding;
+        if (d.vkCreateDescriptorSetLayout(d.device, &dsl, nullptr, &setLayout) != VK_SUCCESS) {fail(3); break;}
+        VkPushConstantRange push = {VK_SHADER_STAGE_COMPUTE_BIT, 0, 8};
+        VkPipelineLayoutCreateInfo pl = {VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+        pl.setLayoutCount = 1;
+        pl.pSetLayouts = &setLayout;
+        pl.pushConstantRangeCount = 1;
+        pl.pPushConstantRanges = &push;
+        if (d.vkCreatePipelineLayout(d.device, &pl, nullptr, &layout) != VK_SUCCESS) {fail(4); break;}
+        VkComputePipelineCreateInfo cp = {VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+        cp.stage = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_COMPUTE_BIT, module, "main", nullptr};
+        cp.layout = layout;
+        if (d.vkCreateComputePipelines(d.device, nullptr, 1, &cp, nullptr, &pipeline) != VK_SUCCESS) {fail(5); break;}
+        mark(0x6101);
+        VkDescriptorPoolSize size = {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1};
+        VkDescriptorPoolCreateInfo dp = {VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+        dp.maxSets = 1;
+        dp.poolSizeCount = 1;
+        dp.pPoolSizes = &size;
+        if (d.vkCreateDescriptorPool(d.device, &dp, nullptr, &pool) != VK_SUCCESS) {fail(6); break;}
+        VkDescriptorSetAllocateInfo da = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+        da.descriptorPool = pool;
+        da.descriptorSetCount = 1;
+        da.pSetLayouts = &setLayout;
+        VkDescriptorSet set = nullptr;
+        if (d.vkAllocateDescriptorSets(d.device, &da, &set) != VK_SUCCESS) {fail(6); break;}
+        VkDescriptorBufferInfo info = {b.buffer, 0, kWords * 4};
+        VkWriteDescriptorSet write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+        write.dstSet = set;
+        write.descriptorCount = 1;
+        write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+        write.pBufferInfo = &info;
+        d.vkUpdateDescriptorSets(d.device, 1, &write, 0, nullptr);
+        if (d.begin() != VK_SUCCESS) {fail(7); break;}
+        const uint32_t constants[2] = {kMul, kAdd};
+        d.vkCmdBindPipeline(d.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+        d.vkCmdBindDescriptorSets(d.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, layout, 0, 1, &set, 0, nullptr);
+        d.vkCmdPushConstants(d.cmd, layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof constants, constants);
+        d.vkCmdDispatch(d.cmd, kWords / 64, 1, 1);
+        hostBarrier(d, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT);
+        if (d.vkEndCommandBuffer(d.cmd) != VK_SUCCESS) {fail(7); break;}
+        mark(0x6102);
+        if (d.submitAndWait() != VK_SUCCESS) {fail(8); break;}
+        mark(0x6103);
+        int good = 0;
+        for (uint32_t i = 0; i < kWords; ++i) good += b.words[i] == i * kMul + kAdd;
+        result = good;
+        if (good == int(kWords)) mark(0x6104);
+    } while (false);
+    if (pipeline) d.vkDestroyPipeline(d.device, pipeline, nullptr);
+    if (pool) d.vkDestroyDescriptorPool(d.device, pool, nullptr);
+    if (layout) d.vkDestroyPipelineLayout(d.device, layout, nullptr);
+    if (setLayout) d.vkDestroyDescriptorSetLayout(d.device, setLayout, nullptr);
+    if (module) d.vkDestroyShaderModule(d.device, module, nullptr);
+    b.destroy(d);
+    return result;
+}
+
+// Render: a 64x64 RGBA8 colour attachment cleared to blue, one triangle drawn in orange (push constant), copied to a host buffer.
+// The triangle covers 512 pixels in exact arithmetic; every other pixel must keep the clear colour.
+template <typename Marker>
+static void renderTest(Device &d, Marker &mark, int &stage, int &triangle, int &other) {
+    constexpr uint32_t kSize = 64;
+    mark(0x6200);
+    HostBuffer b;
+    VkImage image = nullptr;
+    VkDeviceMemory imageMemory = nullptr;
+    VkImageView view = nullptr;
+    VkRenderPass pass = nullptr;
+    VkFramebuffer framebuffer = nullptr;
+    VkShaderModule vs = nullptr, fs = nullptr;
+    VkPipelineLayout layout = nullptr;
+    VkPipeline pipeline = nullptr;
+    auto fail = [&](int s) {stage = s; mark(0x62f0 | s);};
+    do {
+        if (b.create(d, kSize * kSize * 4, VK_BUFFER_USAGE_TRANSFER_DST_BIT) != VK_SUCCESS) {fail(1); break;}
+        for (uint32_t i = 0; i < kSize * kSize; ++i) b.words[i] = 0x5a5a5a5a;
+        VkImageCreateInfo ic = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+        ic.imageType = VK_IMAGE_TYPE_2D;
+        ic.format = VK_FORMAT_R8G8B8A8_UNORM;
+        ic.extent = {kSize, kSize, 1};
+        ic.mipLevels = 1;
+        ic.arrayLayers = 1;
+        ic.samples = VK_SAMPLE_COUNT_1_BIT;
+        ic.tiling = VK_IMAGE_TILING_OPTIMAL;
+        ic.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+        ic.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        if (d.vkCreateImage(d.device, &ic, nullptr, &image) != VK_SUCCESS) {fail(2); break;}
+        VkMemoryRequirements req = {};
+        d.vkGetImageMemoryRequirements(d.device, image, &req);
+        uint32_t type = d.memoryType(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        if (type == UINT32_MAX) type = d.memoryType(req.memoryTypeBits, 0);
+        VkMemoryAllocateInfo mai = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        mai.allocationSize = req.size;
+        mai.memoryTypeIndex = type;
+        if (type == UINT32_MAX || d.vkAllocateMemory(d.device, &mai, nullptr, &imageMemory) != VK_SUCCESS ||
+            d.vkBindImageMemory(d.device, image, imageMemory, 0) != VK_SUCCESS) {fail(2); break;}
+        VkImageViewCreateInfo vc = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        vc.image = image;
+        vc.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        vc.format = ic.format;
+        vc.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+        if (d.vkCreateImageView(d.device, &vc, nullptr, &view) != VK_SUCCESS) {fail(3); break;}
+        VkAttachmentDescription attachment = {0, ic.format, VK_SAMPLE_COUNT_1_BIT, VK_ATTACHMENT_LOAD_OP_CLEAR, VK_ATTACHMENT_STORE_OP_STORE,
+                                              VK_ATTACHMENT_LOAD_OP_DONT_CARE, VK_ATTACHMENT_STORE_OP_DONT_CARE, VK_IMAGE_LAYOUT_UNDEFINED,
+                                              VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL};
+        VkAttachmentReference ref = {0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+        VkSubpassDescription subpass = {};
+        subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+        subpass.colorAttachmentCount = 1;
+        subpass.pColorAttachments = &ref;
+        VkSubpassDependency after = {0, VK_SUBPASS_EXTERNAL, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                     VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT, 0};
+        VkRenderPassCreateInfo rp = {VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+        rp.attachmentCount = 1;
+        rp.pAttachments = &attachment;
+        rp.subpassCount = 1;
+        rp.pSubpasses = &subpass;
+        rp.dependencyCount = 1;
+        rp.pDependencies = &after;
+        if (d.vkCreateRenderPass(d.device, &rp, nullptr, &pass) != VK_SUCCESS) {fail(4); break;}
+        VkFramebufferCreateInfo fb = {VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+        fb.renderPass = pass;
+        fb.attachmentCount = 1;
+        fb.pAttachments = &view;
+        fb.width = kSize;
+        fb.height = kSize;
+        fb.layers = 1;
+        if (d.vkCreateFramebuffer(d.device, &fb, nullptr, &framebuffer) != VK_SUCCESS) {fail(4); break;}
+        vs = shaderModule(d, kSpv_smoke_triangle_vert, sizeof kSpv_smoke_triangle_vert);
+        fs = shaderModule(d, kSpv_smoke_triangle_frag, sizeof kSpv_smoke_triangle_frag);
+        if (!vs || !fs) {fail(5); break;}
+        VkPushConstantRange push = {VK_SHADER_STAGE_FRAGMENT_BIT, 0, 16};
+        VkPipelineLayoutCreateInfo pl = {VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+        pl.pushConstantRangeCount = 1;
+        pl.pPushConstantRanges = &push;
+        if (d.vkCreatePipelineLayout(d.device, &pl, nullptr, &layout) != VK_SUCCESS) {fail(6); break;}
+        VkPipelineShaderStageCreateInfo stages[2] = {
+            {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_VERTEX_BIT, vs, "main", nullptr},
+            {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_FRAGMENT_BIT, fs, "main", nullptr}};
+        VkPipelineVertexInputStateCreateInfo vi = {VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+        VkPipelineInputAssemblyStateCreateInfo ia = {VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+        ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+        VkViewport viewport = {0, 0, float(kSize), float(kSize), 0, 1};
+        VkRect2D scissor = {{0, 0}, {kSize, kSize}};
+        VkPipelineViewportStateCreateInfo vp = {VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+        vp.viewportCount = 1;
+        vp.pViewports = &viewport;
+        vp.scissorCount = 1;
+        vp.pScissors = &scissor;
+        VkPipelineRasterizationStateCreateInfo rs = {VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+        rs.polygonMode = VK_POLYGON_MODE_FILL;
+        rs.cullMode = VK_CULL_MODE_NONE;
+        rs.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+        rs.lineWidth = 1.0f;
+        VkPipelineMultisampleStateCreateInfo ms = {VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+        ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+        VkPipelineColorBlendAttachmentState blend = {};
+        blend.colorWriteMask = 0xf;
+        VkPipelineColorBlendStateCreateInfo cb = {VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+        cb.attachmentCount = 1;
+        cb.pAttachments = &blend;
+        VkGraphicsPipelineCreateInfo gp = {VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+        gp.stageCount = 2;
+        gp.pStages = stages;
+        gp.pVertexInputState = &vi;
+        gp.pInputAssemblyState = &ia;
+        gp.pViewportState = &vp;
+        gp.pRasterizationState = &rs;
+        gp.pMultisampleState = &ms;
+        gp.pColorBlendState = &cb;
+        gp.layout = layout;
+        gp.renderPass = pass;
+        if (d.vkCreateGraphicsPipelines(d.device, nullptr, 1, &gp, nullptr, &pipeline) != VK_SUCCESS) {fail(7); break;}
+        mark(0x6201);
+        if (d.begin() != VK_SUCCESS) {fail(8); break;}
+        VkClearValue clear = {};
+        clear.color.float32[2] = 1.0f;
+        clear.color.float32[3] = 1.0f;
+        VkRenderPassBeginInfo rb = {VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+        rb.renderPass = pass;
+        rb.framebuffer = framebuffer;
+        rb.renderArea = scissor;
+        rb.clearValueCount = 1;
+        rb.pClearValues = &clear;
+        d.vkCmdBeginRenderPass(d.cmd, &rb, VK_SUBPASS_CONTENTS_INLINE);
+        d.vkCmdBindPipeline(d.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+        const float color[4] = {1.0f, 0.5f, 0.0f, 1.0f};
+        d.vkCmdPushConstants(d.cmd, layout, VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof color, color);
+        d.vkCmdDraw(d.cmd, 3, 1, 0, 0);
+        d.vkCmdEndRenderPass(d.cmd);
+        VkBufferImageCopy copy = {};
+        copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        copy.imageExtent = {kSize, kSize, 1};
+        d.vkCmdCopyImageToBuffer(d.cmd, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, b.buffer, 1, &copy);
+        hostBarrier(d, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT);
+        if (d.vkEndCommandBuffer(d.cmd) != VK_SUCCESS) {fail(8); break;}
+        mark(0x6202);
+        if (d.submitAndWait() != VK_SUCCESS) {fail(9); break;}
+        mark(0x6203);
+        // RGBA8 little-endian words: clear = (0, 0, 255, 255), triangle = (255, 127 or 128, 0, 255).
+        int tri = 0, rest = 0;
+        for (uint32_t i = 0; i < kSize * kSize; ++i) {
+            const uint32_t px = b.words[i];
+            if (px == 0xffff0000u) continue;
+            if (px == 0xff0080ffu || px == 0xff007fffu) ++tri;
+            else ++rest;
+        }
+        triangle = tri;
+        other = rest;
+        if (rest == 0 && tri >= 480 && tri <= 544) mark(0x6204);
+    } while (false);
+    if (pipeline) d.vkDestroyPipeline(d.device, pipeline, nullptr);
+    if (layout) d.vkDestroyPipelineLayout(d.device, layout, nullptr);
+    if (vs) d.vkDestroyShaderModule(d.device, vs, nullptr);
+    if (fs) d.vkDestroyShaderModule(d.device, fs, nullptr);
+    if (framebuffer) d.vkDestroyFramebuffer(d.device, framebuffer, nullptr);
+    if (pass) d.vkDestroyRenderPass(d.device, pass, nullptr);
+    if (view) d.vkDestroyImageView(d.device, view, nullptr);
+    if (image) d.vkDestroyImage(d.device, image, nullptr);
+    if (imageMemory) d.vkFreeMemory(d.device, imageMemory, nullptr);
+    b.destroy(d);
+}
+
+template <typename Marker>
+static Result run(Marker &&mark, const char *libraryPath) {
+    Result out;
+    auto fail = [&](int stage, int result) {
+        out.stage = stage;
+        out.vkResult = result;
+        mark(0x6f00 | stage);
+        mark(0x6e00 | ((-result) & 0xff));
+        return out;
+    };
+    // The Darwin backend reaches the driver the same way the plugin does: the AGX accelerator service with open type 0x4147, ABI methods through
+    // an admitted selector. Nothing to configure; set here only so the choice is visible. The shader disk cache is off: this runs inside a
+    // system process whose home directory is not ours to fill.
+    setenv("TU_DARWIN_SERVICE", "IOAcceleratorES", 0);
+    setenv("MESA_SHADER_CACHE_DISABLE", "true", 0);
+    // Concurrent binning (BV running ahead of BR) is a performance feature; its barriers make BR wait for BV timestamps. int-058's
+    // first fill hung with the ring stopped inside the IB (no fault), before the kernel framed IBs for both threads. Keep it off
+    // until a run with the framing has passed.
+    setenv("TU_DEBUG", "nocb", 0);
+
+    void *lib = dlopen(libraryPath, RTLD_NOW | RTLD_LOCAL);
+    if (!lib) return fail(1, -1);
+    mark(0x6001);
+    auto gipa = reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(lib, "vk_icdGetInstanceProcAddr"));
+    if (!gipa) return fail(2, -2);
+    auto createInstance = reinterpret_cast<PFN_vkCreateInstance>(gipa(nullptr, "vkCreateInstance"));
+    if (!createInstance) return fail(2, -3);
+    mark(0x6002);
+
+    const char *extensions[] = {VK_EXT_DEBUG_UTILS_EXTENSION_NAME};
+    VkDebugUtilsMessengerCreateInfoEXT messenger = {VK_STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CREATE_INFO_EXT};
+    messenger.messageSeverity = VK_DEBUG_UTILS_MESSAGE_SEVERITY_ERROR_BIT_EXT;
+    messenger.messageType = VK_DEBUG_UTILS_MESSAGE_TYPE_GENERAL_BIT_EXT | VK_DEBUG_UTILS_MESSAGE_TYPE_VALIDATION_BIT_EXT;
+    messenger.pfnUserCallback = onMessage;
+    VkApplicationInfo app = {VK_STRUCTURE_TYPE_APPLICATION_INFO};
+    app.pApplicationName = "NativeAdrenoMetal";
+    app.apiVersion = VK_API_VERSION_1_1;
+    VkInstanceCreateInfo ici = {VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+    ici.pNext = &messenger;
+    ici.pApplicationInfo = &app;
+    ici.enabledExtensionCount = 1;
+    ici.ppEnabledExtensionNames = extensions;
+    VkInstance instance = nullptr;
+    VkResult r = createInstance(&ici, nullptr, &instance);
+    if (r != VK_SUCCESS) return fail(3, r);
+    mark(0x6003);
+
+#define INSTANCE_FN(name) auto name = reinterpret_cast<PFN_##name>(gipa(instance, #name)); if (!name) return fail(3, -4)
+    INSTANCE_FN(vkEnumeratePhysicalDevices);
+    INSTANCE_FN(vkGetPhysicalDeviceMemoryProperties);
+    INSTANCE_FN(vkGetPhysicalDeviceQueueFamilyProperties);
+    INSTANCE_FN(vkCreateDevice);
+    INSTANCE_FN(vkGetDeviceProcAddr);
+    INSTANCE_FN(vkDestroyInstance);
+#undef INSTANCE_FN
+
+    uint32_t count = 1;
+    VkPhysicalDevice physical = nullptr;
+    r = vkEnumeratePhysicalDevices(instance, &count, &physical);
+    if ((r != VK_SUCCESS && r != VK_INCOMPLETE) || !count || !physical) return fail(4, r == VK_SUCCESS ? -5 : r);
+    mark(0x6004);
+
+    uint32_t families = 0;
+    vkGetPhysicalDeviceQueueFamilyProperties(physical, &families, nullptr);
+    if (!families) return fail(4, -6);
+    VkQueueFamilyProperties family[8] = {};
+    if (families > 8) families = 8;
+    vkGetPhysicalDeviceQueueFamilyProperties(physical, &families, family);
+    uint32_t queueFamily = families;
+    for (uint32_t i = 0; i < families && queueFamily == families; ++i)
+        if (family[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) queueFamily = i;
+    if (queueFamily == families) return fail(4, -7);
+
+    float priority = 1.0f;
+    VkDeviceQueueCreateInfo qci = {VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+    qci.queueFamilyIndex = queueFamily;
+    qci.queueCount = 1;
+    qci.pQueuePriorities = &priority;
+    VkDeviceCreateInfo dci = {VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+    dci.queueCreateInfoCount = 1;
+    dci.pQueueCreateInfos = &qci;
+    Device d;
+    r = vkCreateDevice(physical, &dci, nullptr, &d.device);
+    if (r != VK_SUCCESS) return fail(5, r);
+    mark(0x6005);
+#define TURNIP_RESOLVE(name) d.name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(d.device, #name)); if (!d.name) return fail(5, -8);
+    TURNIP_DEVICE_FNS(TURNIP_RESOLVE)
+#undef TURNIP_RESOLVE
+    vkGetPhysicalDeviceMemoryProperties(physical, &d.memory);
+    d.vkGetDeviceQueue(d.device, queueFamily, 0, &d.queue);
+    VkCommandPoolCreateInfo pci = {VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+    pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    pci.queueFamilyIndex = queueFamily;
+    r = d.vkCreateCommandPool(d.device, &pci, nullptr, &d.pool);
+    if (r != VK_SUCCESS) return fail(6, r);
+    VkCommandBufferAllocateInfo cai = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+    cai.commandPool = d.pool;
+    cai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cai.commandBufferCount = 1;
+    r = d.vkAllocateCommandBuffers(d.device, &cai, &d.cmd);
+    if (r != VK_SUCCESS) return fail(6, r);
+
+    // The three tests are independent: a failed or unverified one does not stop the next, unless the GPU stopped retiring work (fence timeout).
+    int failStage = 0;
+    VkResult failResult = VK_SUCCESS;
+    out.verified = fillTest(d, mark, failStage, failResult);
+    if (failStage) {
+        fail(failStage, failResult);
+    }
+    if (failStage != 9) {
+        out.computeWords = computeTest(d, mark, out.computeStage);
+        if (out.computeStage != 8) renderTest(d, mark, out.renderStage, out.renderTriangle, out.renderOther);
+    }
+
+    d.vkDeviceWaitIdle(d.device);
+    d.vkDestroyCommandPool(d.device, d.pool, nullptr);
+    d.vkDestroyDevice(d.device, nullptr);
+    vkDestroyInstance(instance, nullptr);
+    mark(0x600b);
+    out.ok = !failStage && out.verified == 1024 && out.computeWords == 1024 && out.renderOther == 0 && out.renderTriangle >= 480 &&
+             out.renderTriangle <= 544;
+    return out;
+}
+
+// Watchdog. run() executes on a worker thread; if it has not returned after 15, 45 and 90 seconds, the calling thread samples the worker and
+// sends "W <last marker> s<run state> u<user us>/k<system us> over 300 ms, then the stack": the PC, LR and frame-pointer return addresses, each
+// as <image letter><offset in that image> (v = libvulkan_freedreno.dylib; offsets resolve against the unstripped build). A worker that is
+// running in the kernel (system time only, or no time at all: a core parked by the panic screen) is not suspended, because thread_suspend
+// would wait for it forever; its line ends in "kern".
+struct Watched {
+    const char *libraryPath;
+    void (*mark)(void *, uint32_t);
+    void *markContext;
+    volatile uint32_t lastMark;
+    volatile int done;
+    Result result;
+};
+
+static void *watchedWorker(void *argument) {
+    Watched *w = static_cast<Watched *>(argument);
+    w->result = run([w](uint32_t value) { w->lastMark = value; w->mark(w->markContext, value); }, w->libraryPath);
+    __atomic_store_n(&w->done, 1, __ATOMIC_RELEASE);
+    return nullptr;
+}
+
+static size_t frameText(char *out, size_t size, uint64_t address) {
+    Dl_info info = {};
+    if (!address || !dladdr(reinterpret_cast<const void *>(address), &info) || !info.dli_fbase)
+        return (size_t)snprintf(out, size, " ?%llx", (unsigned long long)address);
+    const char *name = info.dli_fname ? strrchr(info.dli_fname, '/') : nullptr;
+    name = name ? name + 1 : (info.dli_fname ? info.dli_fname : "?");
+    const char tag = !strncmp(name, "libvulkan", 9) ? 'v' : name[0];
+    return (size_t)snprintf(out, size, " %c%llx", tag, (unsigned long long)(address - reinterpret_cast<uint64_t>(info.dli_fbase)));
+}
+
+static void sample(Watched &w, pthread_t worker, char *text, size_t size) {
+    const mach_port_t thread = pthread_mach_thread_np(worker);
+    thread_basic_info_data_t a = {}, b = {};
+    mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
+    thread_info(thread, THREAD_BASIC_INFO, reinterpret_cast<thread_info_t>(&a), &count);
+    usleep(300000);
+    count = THREAD_BASIC_INFO_COUNT;
+    thread_info(thread, THREAD_BASIC_INFO, reinterpret_cast<thread_info_t>(&b), &count);
+    auto us = [](time_value_t t) { return int64_t(t.seconds) * 1000000 + t.microseconds; };
+    const int64_t du = us(b.user_time) - us(a.user_time), dk = us(b.system_time) - us(a.system_time);
+    size_t at = (size_t)snprintf(text, size, "W %x s%d u%lld/k%lld", unsigned(w.lastMark), b.run_state, (long long)du, (long long)dk);
+    if (b.run_state == TH_STATE_RUNNING && du <= 0) {
+        snprintf(text + at, size - at, " kern");
+        return;
+    }
+    if (thread_suspend(thread) != KERN_SUCCESS) {snprintf(text + at, size - at, " nosusp"); return;}
+    arm_thread_state64_t state = {};
+    count = ARM_THREAD_STATE64_COUNT;
+    if (thread_get_state(thread, ARM_THREAD_STATE64, reinterpret_cast<thread_state_t>(&state), &count) == KERN_SUCCESS) {
+        const uint64_t pc = arm_thread_state64_get_pc(state), lr = arm_thread_state64_get_lr(state);
+        uint64_t fp = arm_thread_state64_get_fp(state);
+        at += frameText(text + at, size - at, pc);
+        if (at < size) at += frameText(text + at, size - at, lr);
+        const uint64_t low = reinterpret_cast<uint64_t>(pthread_get_stackaddr_np(worker)) - pthread_get_stacksize_np(worker);
+        const uint64_t high = reinterpret_cast<uint64_t>(pthread_get_stackaddr_np(worker));
+        for (unsigned i = 0; i < 8 && at + 4 < size && fp >= low && fp + 16 <= high && !(fp & 7); ++i) {
+            const uint64_t next = reinterpret_cast<const uint64_t *>(fp)[0], ret = reinterpret_cast<const uint64_t *>(fp)[1];
+            if (ret != lr || i) at += frameText(text + at, size - at, ret);
+            if (next <= fp) break;
+            fp = next;
+        }
+    }
+    thread_resume(thread);
+}
+
+template <typename Marker, typename Reporter>
+static Result runWatched(Marker &mark, Reporter &&report, const char *libraryPath) {
+    Watched *w = new Watched{};
+    w->libraryPath = libraryPath;
+    w->markContext = &mark;
+    w->mark = [](void *context, uint32_t value) { (*static_cast<Marker *>(context))(value); };
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, 8u << 20);   // Mesa's NIR/ir3 passes recurse; the default 512 KiB secondary stack is small
+    pthread_t worker;
+    const bool started = pthread_create(&worker, &attr, watchedWorker, w) == 0;
+    pthread_attr_destroy(&attr);
+    if (!started) {Result r; r.stage = 0; r.vkResult = -12; return r;}
+    static const unsigned checkpoints[] = {15, 45, 90};
+    unsigned next = 0;
+    for (unsigned tenths = 0; !__atomic_load_n(&w->done, __ATOMIC_ACQUIRE); ++tenths) {
+        usleep(100000);
+        if (next < 3 && tenths == checkpoints[next] * 10) {
+            char text[64] = {};
+            sample(*w, worker, text, sizeof text);
+            report(text);
+            ++next;
+        }
+    }
+    pthread_join(worker, nullptr);
+    Result result = w->result;
+    delete w;
+    return result;
+}
+
+// Path of libvulkan_freedreno.dylib: next to the image this code is part of (the plugin binary inside the bundle).
+static bool libraryPath(char *path, size_t size) {
+    Dl_info info = {};
+    if (!dladdr(reinterpret_cast<const void *>(&libraryPath), &info) || !info.dli_fname) return false;
+    snprintf(path, size, "%s", info.dli_fname);
+    char *slash = strrchr(path, '/');
+    if (!slash) return false;
+    snprintf(slash + 1, size - size_t(slash + 1 - path), "libvulkan_freedreno.dylib");
+    return true;
+}
+
+}  // namespace turnip
