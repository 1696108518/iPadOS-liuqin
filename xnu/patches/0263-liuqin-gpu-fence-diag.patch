+void NativeAdrenoRing::debugState(const char *tag)
+{
+    if(!attached_ || !fence_) {
+        IOLog("NativeAdrenoRing diag: %s not attached\n",tag?tag:"state");
+        return;
+    }
+    /* The CP wrote the memptrs page; drop what this CPU may still cache. */
+    (void)cache_.acquire(cache_.cookie,fence_,fence_bytes_);
+    uint32_t rptr=0xffffffffu,wptr=0xffffffffu,fault=0xffffffffu,cpint=0xffffffffu,rbbm=0xffffffffu;
+    (void)io_.read32(io_.cookie,RingRptr,&rptr);
+    (void)io_.read32(io_.cookie,RingWptr,&wptr);
+    (void)io_.read32(io_.cookie,0x0821,&fault);   /* CP_HW_FAULT_STATUS */
+    (void)io_.read32(io_.cookie,0x0823,&cpint);   /* CP_INTERRUPT_STATUS */
+    (void)io_.read32(io_.cookie,0x0201,&rbbm);    /* RBBM_INT_0_STATUS */
+    IOLog("NativeAdrenoRing diag: %s rptr=%u wptr=%u next=%u seqno=%u completed=%u "
+        "memptrs %08x %08x %08x %08x bv %08x %08x | cp_fault=%08x cp_int=%08x rbbm_int=%08x\n",
+        tag?tag:"state",(unsigned)rptr,(unsigned)wptr,(unsigned)next_,
+        (unsigned)seqno_,(unsigned)completed_,
+        (unsigned)fence_[0],(unsigned)fence_[1],(unsigned)fence_[2],(unsigned)fence_[3],
+        (unsigned)fence_[12],(unsigned)fence_[13],fault,cpint,rbbm);
+}
