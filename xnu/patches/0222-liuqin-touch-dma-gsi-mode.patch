+ * SE_IRQ_EN stays 0: this port installs no handler for the QUP interrupt line,
+ * and the transfer is polled through SE_DMA_*_IRQ_STAT, LEN_IN and GENI_STATUS,
+ * so routing an interrupt to the CPU can only hurt. */
 static void
 tch_dma_mode(void)
 {
+	uint32_t v;
+
 	tch_irq_clear();
+	tch_wr(tch.se, SE_IRQ_EN, 0);
+	v = tch_rd(tch.se, SE_GENI_M_IRQ_EN);
+	tch_wr(tch.se, SE_GENI_M_IRQ_EN, v & ~(M_CMD_DONE_EN |
+	    M_TX_FIFO_WATERMARK_EN | M_RX_FIFO_WATERMARK_EN | M_RX_FIFO_LAST_EN));
 	tch_wr(tch.se, SE_GENI_DMA_MODE_EN,
 	    tch_rd(tch.se, SE_GENI_DMA_MODE_EN) | GENI_DMA_MODE_EN);
