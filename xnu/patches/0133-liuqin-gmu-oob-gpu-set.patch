  * started with CP_SQE_CNTL before a7xx_cp_init (CP_THREAD_CONTROL plus
  * CP_ME_INIT with the power-up register list) is submitted through the ring.
  * The ring itself already programmed CP_RB_BASE/CNTL/RPTR_ADDR. */
+IOReturn NativeAdrenoGpuService::powerGx()
+{
+    if(!gmu_io_bound_)return kIOReturnNotReady;
+    if(gmu_io_.write32(gmu_io_.cookie,ShengGmuCore,
+        size_t(REG_GMU_HOST2GMU_INTR_SET)*4u,1u<<30))return kIOReturnIOError;
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    IOReturn status=kIOReturnTimeout;
+    uint32_t info=0;
+    for(unsigned i=0;i<200;++i) {
+        if(gmu_io_.read32(gmu_io_.cookie,ShengGmuCore,
+            size_t(REG_GMU_GMU2HOST_INTR_INFO)*4u,&info))return kIOReturnIOError;
+        if(info&(1u<<31)) {status=kIOReturnSuccess;break;}
+        IOSleep(1);
+    }
+    (void)gmu_io_.write32(gmu_io_.cookie,ShengGmuCore,
+        size_t(REG_GMU_GMU2HOST_INTR_CLR)*4u,1u<<31);
+    IOLog("NativeAdreno: OOB GPU_SET %s (intr=0x%x)\n",status?"NOT ACKED":"acked",info);
+    return status;
+}
