+/* a6xx_hw_init for the A730 in the order the ladder's step 20 verified on this
+ * device: the RBBM/UCHE/CP configuration, CP_SQE_INSTR_BASE, then the SQE is
+ * started with CP_SQE_CNTL before a7xx_cp_init (CP_THREAD_CONTROL plus
+ * CP_ME_INIT with the power-up register list) is submitted through the ring.
+ * The ring itself already programmed CP_RB_BASE/CNTL/RPTR_ADDR. */
+IOReturn NativeAdrenoGpuService::startCp(NativeAdrenoGpuWindow &window,
+    const NativeAdrenoRingIo &io,const NativeAdrenoGpuBuffer *b,void *pwrup_cpu)
+{
+    if(!b || !pwrup_cpu)return kIOReturnBadArgument;
+    struct {uint32_t reg,value;} const regs[]={
+        {0x0016,0},                                  /* RBBM_GBIF_HALT */
+        {0xf803,0},                                  /* RBBM_SECVID_TSB_CNTL */
+        {0xf802,0},                                  /* RBBM_SECVID_TSB_SIZE */
+        {0xf800,0},{0xf801,0},                       /* RBBM_SECVID_TSB_TRUSTED_BASE */
+        {0x0011,0x02120212},                         /* RBBM_GBIF_CLIENT_QOS_CNTL */
+        {0x0e3a,0x10240e0},                          /* UCHE_GBIF_GX_CONFIG */
+        {0x050b,0xffffffff},                         /* RBBM_PERFCTR_GPU_BUSY_MASKED */
+        {0x0e17,1u<<23},                             /* UCHE_CACHE_WAYS */
+        {0x098d,1},                                  /* CP_AHB_CNTL */
+        {0x0500,1},                                  /* RBBM_PERFCTR_CNTL */
+        {0x8e08,(1u<<11)|(1u<<4)|(3u<<1)},           /* RB_NC_MODE_CNTL */
+        {0xb604,3u<<1},                              /* TPL1_NC_MODE_CNTL */
+        {0xae02,(2u<<4)|(3u<<1)},                    /* SP_NC_MODE_CNTL */
+        {0x8602,3u<<5},                              /* GRAS_NC_MODE_CNTL */
+        {0x0e01,3u<<21},                             /* UCHE_MODE_CNTL */
+        {0x0534,1},                                  /* RBBM_NC_MODE_CNTL */
+        {0x001f,(1u<<30)|0xcfffff},                  /* RBBM_INTERFACE_HANG_INT_CNTL */
+        {0x0e19,(1u<<7)|1},                          /* UCHE_CLIENT_PF */
+        {0x0e3c,(6u<<16)|(6u<<12)|(9u<<8)|(1u<<3)|(1u<<2)|2u}, /* UCHE_CMDQ_CONFIG */
+        {0x0844,0x6f},                               /* CP_APRIV_CNTL */
+        {0x0ad0,0x0f},                               /* CP_BV_APRIV_CNTL */
+        {0x0b31,0x0f},                               /* CP_LPAC_APRIV_CNTL */
+        {0x0e09,0xfffff000},{0x0e0a,0x0001ffff},     /* UCHE_TRAP_BASE */
+        {0x0e07,0xfffff000},{0x0e08,0x0001ffff},     /* UCHE_WRITE_THRU_BASE */
+        {0x0830,(uint32_t)GpuSqeIova},{0x0831,0},    /* CP_SQE_INSTR_BASE */
+    };
+    for(unsigned i=0;i<sizeof(regs)/sizeof(regs[0]);++i)
+        if(gpu_write32(&window,regs[i].reg,regs[i].value)) {
+            IOLog("NativeAdreno: CP init write 0x%x failed\n",regs[i].reg);
+            return kIOReturnIOError;
+        }
+    uint32_t eco=0;
+    if(!gpu_read32(&window,0x8e28,&eco))
+        (void)gpu_write32(&window,0x8e28,eco|(1u<<11)); /* RB_CMP_DBG_ECO_CNTL */
+    IOLog("NativeAdreno: CP registers written, starting the SQE\n");
+    if(gpu_write32(&window,0x0808,1))return kIOReturnIOError; /* CP_SQE_CNTL */
+    IOSleep(20);
+    uint32_t rbbm=~0u,fault=~0u,rptr=~0u;
+    (void)gpu_read32(&window,0x0210,&rbbm);
+    (void)gpu_read32(&window,0x0821,&fault);
+    (void)gpu_read32(&window,0x0806,&rptr);
+    IOLog("NativeAdreno: CP SQE alive rbbm=0x%x hw_fault=0x%x rptr=%u\n",rbbm,fault,rptr);
+    size_t list_bytes=0;
+    if(NativeAdrenoPwrupList::buildA740(gpu_read32,&window,
+        static_cast<uint8_t *>(pwrup_cpu),0x1000,&list_bytes)) {
+        IOLog("NativeAdreno: CP power-up list refused\n");
+        return kIOReturnIOError;
+    }
+    IOReturn status=maintainPhysical(b[3].physical,0x1000,NativeAdrenoClean)?
+        kIOReturnIOError:kIOReturnSuccess;
+    NativeAdrenoCpInit cp;
+    NativeAdrenoCpInitConfig config{GpuSqeIova,GpuPwrupIova,1};
+    uint32_t start_fence=0;
+    if(!status)status=cp.run(&io,&ring_,&config,&start_fence);
+    if(!status) {
+        uint32_t observed=0;
+        NativeAdrenoRingClock clock{nullptr,ring_now,nullptr};
+        const NativeAdrenoRingFence fence=ring_.wait(start_fence,&clock,2000,&observed);
+        if(fence!=NativeAdrenoRingFenceComplete) {
+            IOLog("NativeAdreno: CP start fence %u not observed (%u, observed %u)\n",
+                start_fence,unsigned(fence),observed);
+            status=kIOReturnTimeout;
+        }
+    }
+    if(status) {
+        IOLog("NativeAdreno: CP start stopped at 0x%x (rbbm=0x%x hw_fault=0x%x)\n",
+            status,rbbm,fault);
+        return status;
+    }
+    IOLog("NativeAdreno: CP started fence=%u list=%u bytes\n",start_fence,unsigned(list_bytes));
+    return kIOReturnSuccess;
 }
